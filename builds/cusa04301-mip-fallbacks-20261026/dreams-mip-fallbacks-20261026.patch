+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <optional>
+#include "video_core/amdgpu/resource.h"
+
+namespace VideoCore {
+
+// A sampler may be shared by several images. Only use a sampler-side fallback
+// when every sampled view has the same effective minimum in view-relative units.
+// Call Add after cache aliases have resolved to their final backing image.
+struct CommonViewMinLod {
+    explicit CommonViewMinLod(bool native_supported) : blocked{native_supported} {}
+
+    void Add(u32 base, u32 levels, u32 minimum) {
+        if (blocked) {
+            return;
+        }
+        if (base >= 16 || levels == 0 || levels > 16 - base) {
+            blocked = true;
+            return;
+        }
+        const u32 first = base * 256;
+        const u32 last = (base + levels - 1) * 256;
+        const u32 relative = std::clamp(minimum, first, last) - first;
+        if (common && *common != relative) {
+            blocked = true;
+        } else {
+            common = relative;
+        }
+    }
+
+    bool Apply(AmdGpu::Sampler& sampler) const {
+        // Changing lambda must not change the spatial filter or anisotropy.
+        if (blocked || !common || *common == 0 ||
+            sampler.xy_min_filter != sampler.xy_mag_filter ||
+            AmdGpu::IsAnisoFilter(sampler.xy_min_filter) ||
+            sampler.min_lod > sampler.max_lod ||
+            sampler.mip_filter.Value() > AmdGpu::MipFilter::Linear) {
+            return false;
+        }
+        u32 minimum = sampler.min_lod.Value();
+        u32 maximum = sampler.max_lod.Value();
+        if (sampler.mip_filter == AmdGpu::MipFilter::None) {
+            // Preserve the existing no-mip sampler's [0, .25] clamp before
+            // applying the view minimum. The view clamp comes after it.
+            minimum = std::min(minimum, 64u);
+            maximum = std::min(maximum, 64u);
+            sampler.mip_filter.Assign(AmdGpu::MipFilter::Point);
+        }
+        sampler.min_lod.Assign(std::max(minimum, *common));
+        sampler.max_lod.Assign(std::max(maximum, *common));
+        return true;
+    }
+
+private:
+    std::optional<u32> common;
+    bool blocked{};
+};
+
+} // namespace VideoCore
