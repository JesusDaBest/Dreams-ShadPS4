+inline bool SupportsViewMinLodRead(const ImageResource& desc, const AmdGpu::Image& image) {
+    const auto type = image.GetViewType(desc.is_array);
+    return !desc.is_written && !desc.is_atomic && !desc.is_depth && !image.IsCube() &&
+           desc.mip_fallback_mode == MipStorageFallbackMode::None &&
+           (type == AmdGpu::ImageType::Color2D || type == AmdGpu::ImageType::Color2DArray);
+}
+
+inline u32 ViewMinLodInteger(const ImageResource& desc, const AmdGpu::Image& image) {
+    if (!SupportsViewMinLodRead(desc, image)) return 0;
+    const u32 base = image.base_level;
+    const u32 last = base + image.NumViewLevels(desc.is_array) - 1;
+    return std::clamp(u32(image.min_lod) / 256u, base, last) - base;
+}
