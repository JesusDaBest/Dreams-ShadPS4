--- /dev/null
+++ b/src/video_core/amdgpu/dreams_display_wait.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+
+namespace DreamsDisplayWait {
+
+// shadPS4 has one Liverpool and one VideoOut port per process. Only the
+// command processor publishes a registration. Producers compare its identity.
+inline std::atomic<const void*> waiting_port{};
+
+class Registration {
+public:
+    explicit Registration(const void* port) { waiting_port.store(port); }
+    ~Registration() { waiting_port.store(nullptr); }
+    Registration(const Registration&) = delete;
+    Registration& operator=(const Registration&) = delete;
+};
+
+template <typename Ready, typename HasWork>
+bool WaitForLabelOrCommands(std::mutex& submit_mutex, std::condition_variable_any& submit_cv,
+                            const void* port, Ready&& label_ready, HasWork&& has_work) {
+    // Publish before inspecting the label. A concurrent release either happens
+    // before the first check or queues a notification under submit_mutex.
+    const Registration registration{port};
+    std::unique_lock lock{submit_mutex};
+    bool ready{};
+    submit_cv.wait(lock, [&] {
+        ready = label_ready();
+        return ready || has_work();
+    });
+    return ready;
+}
+
+} // namespace DreamsDisplayWait
