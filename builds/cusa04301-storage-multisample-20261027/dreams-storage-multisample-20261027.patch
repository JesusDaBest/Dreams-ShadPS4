+
+// Older shaders could reach the cache without the capability required by
+// their multisampled storage image. Keep every other cached shader; only
+// these invalid binaries must compile again. Specialization is persisted,
+// so this check never dereferences a guest descriptor during cache warmup.
+bool CachedStorageCapabilitiesMatch(const Shader::StageSpecialization& spec,
+                                    std::span<const u32> words) {
+    const bool requires_multisample = std::ranges::any_of(spec.images, [](const auto& image) {
+        return image.is_storage && (image.type == AmdGpu::ImageType::Color2DMsaa ||
+                                    image.type == AmdGpu::ImageType::Color2DMsaaArray);
+    });
+    if (!requires_multisample) {
+        return true;
+    }
+    // Capabilities are the first instruction section after the SPIR-V header.
+    for (size_t offset = 5; offset < words.size();) {
+        const u32 count = words[offset] >> 16;
+        if (count != 2 || count > words.size() - offset ||
+            (words[offset] & 0xffff) != static_cast<u32>(spv::Op::OpCapability)) {
+            break;
+        }
+        if (words[offset + 1] == static_cast<u32>(spv::Capability::StorageImageMultisample)) {
+            return true;
+        }
+        offset += count;
+    }
+    return false;
 }
 
