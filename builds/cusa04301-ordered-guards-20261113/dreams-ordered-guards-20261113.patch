+        const std::array regions{
+            DreamsBoundBufferCaptureRegion{frozen[1],push.buf_offsets[1],records},
+            DreamsBoundBufferCaptureRegion{frozen[5],push.buf_offsets[5],flat},
+            DreamsBoundBufferCaptureRegion{bindings[4],1024*4,counter}};
