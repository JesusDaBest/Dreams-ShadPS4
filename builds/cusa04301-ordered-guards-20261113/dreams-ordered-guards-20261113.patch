+                .srcAccessMask=vk::AccessFlagBits2::eTransferWrite,
+                .dstStageMask=vk::PipelineStageFlagBits2::eComputeShader|vk::PipelineStageFlagBits2::eTransfer,
+                .dstAccessMask=vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eTransferRead,
+                .buffer=frozen[slot].buffer,.offset=0,.size=sizes[k]};
