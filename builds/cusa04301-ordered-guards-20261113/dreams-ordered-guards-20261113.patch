+        return fmt::format("accepted\t{}\nreason\t{}\nR\t{}\nD\t{}\ncounter\t{}\n"
+            "max_records\t{}\nlookup_hash\t{}\noutput_begin\t{}\noutput_end\t{}\n"
+            "private_input_snapshots\t{}\ninjected_overlap\t{}\n",
