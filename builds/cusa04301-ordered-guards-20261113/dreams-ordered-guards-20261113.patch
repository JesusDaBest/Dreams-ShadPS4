+                VideoCore::MemoryUsage::DeviceLocal,0,VideoCore::AllFlags,sizes[k]));
+            frozen[slot]={proof->storage.back()->Handle(),0,sizes[k]};
+            pre[k]={.srcStageMask=vk::PipelineStageFlagBits2::eAllCommands|vk::PipelineStageFlagBits2::eHost,
