+        if(std::memcmp(flat.data(),cs.flattened_ud_buf.data(),flat.size())!=0)
+            return reject("252 GPU/host scalar mismatch");
+        std::memcpy(&input.counter,counter.data(),4);proof->counter=input.counter;
+        input.source_records=records;
+        proof->result=Alias252::Check(input);
+        if(proof->result.safe) for(u32 slot:slots)bindings[slot]=frozen[slot];
