+       cs.flattened_ud_buf.size()!=46 || cs.buffers[4].buffer_type!=Shader::BufferType::GdsBuffer ||
+       cs.buffers[5].buffer_type!=Shader::BufferType::Flatbuf || push.buf_offsets[4]!=0)
