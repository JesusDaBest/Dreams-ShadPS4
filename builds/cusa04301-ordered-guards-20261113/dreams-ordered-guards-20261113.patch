+       regs.num_thread_y.full!=1 || regs.num_thread_z.full!=1 ||
+       !regs.dim_x || regs.dim_x>65536 || regs.dim_y!=1 || regs.dim_z!=1 ||
+       regs.start_x || regs.start_y || regs.start_z || regs.settings.tgid_enable!=1 ||
+       !Shader::DreamsCompat::HasOrderedWaveLaunch(regs.dispatch_initiator))
