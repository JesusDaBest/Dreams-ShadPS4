+void AuditPrimaryOrderedReplay(const IR::Program& program, const RuntimeInfo& runtime) {
+    if (program.info.pgm_hash != DreamsCompat::QueueProducerShader ||
+        !DreamsCompat::UseAdditionalExactOrderedCountReplay(program.info.pgm_hash)) return;
+    if (runtime.cs_info.tgid_enable!=std::array<bool,3>{true,false,false} ||
+        runtime.cs_info.workgroup_size!=std::array<u32,3>{64,1,1} ||
+        !(runtime.cs_info.tg_size_enable || runtime.cs_info.ordered_append_enable)) return;
+    for (const auto& node:program.syntax_list)
+        ASSERT_MSG(node.type != IR::AbstractSyntaxNode::Type::Loop &&
+                   node.type != IR::AbstractSyntaxNode::Type::Repeat,"2bf replay gained a loop");
+    bool before=true;u32 docs=0,stores=0;
+    for (const auto* block:program.blocks) for (const auto& inst:block->Instructions()) {
+        const auto op=inst.GetOpcode();const auto name=IR::NameOf(op);
+        if (op==IR::Opcode::DataOrderedCount) {
+            ASSERT_MSG(inst.Arg(0).IsImmediate() && inst.Arg(0).U32()==322,
+                       "2bf counter changed");before=false;++docs;continue;
+        }
+        ASSERT_MSG(name.find("Atomic")==std::string_view::npos &&
+                   name.find("Shared")==std::string_view::npos &&
+                   name.find("Image")==std::string_view::npos,"2bf replay gained shared side effects");
+        if (!before) continue;
+        if (name.starts_with("LoadBuffer"))
+            ASSERT_MSG(inst.Arg(0).IsImmediate() &&
+                       (inst.Arg(0).U32()==3 || inst.Arg(0).U32()==4),"2bf pre-DOC read binding changed");
+        if (name.starts_with("StoreBuffer")) {
+            ASSERT_MSG(inst.Arg(0).IsImmediate() && inst.Arg(0).U32()==2 &&
+                       (op==IR::Opcode::StoreBufferU32 || op==IR::Opcode::StoreBufferU32x3 ||
+                        op==IR::Opcode::StoreBufferU32x4),"2bf pre-DOC store changed");++stores;
+        }
+    }
+    ASSERT_MSG(docs==1 && stores==34,"2bf replay store/DOC shape changed: {} {}",stores,docs);
 }
 
