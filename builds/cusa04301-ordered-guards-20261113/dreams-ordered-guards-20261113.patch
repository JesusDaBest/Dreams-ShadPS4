+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+namespace Alias252 {
+using U64 = uint64_t;
+struct Range { U64 base{}, bytes{}, bound{}; uint32_t stride{}; };
+struct Input {
+    std::array<Range, 4> buffers;
+    uint32_t groups{}, roots{}, divisor{}, counter{};
+    std::span<const uint8_t> source_records;
+};
+struct Result {
+    bool safe{};
+    const char* reason{"unproved"};
+    U64 output_begin{}, output_end{}, maximum_records{}, lookup_hash{};
+    uint32_t valid_roots{};
+};
+inline bool Disjoint(U64 a, U64 n, U64 b, U64 m) {
+    return a < b ? n <= b-a : m <= a-b;
+}
+inline Result Check(const Input& in) {
+    Result result;
+    const auto reject=[&](const char* why) {result.reason=why;return result;};
+    constexpr U64 Limit=U64{1}<<40;
+    if (!in.groups || in.groups>65536 || !in.roots ||
+        (in.divisor!=3 && in.divisor!=6)) return reject("unsupported scalar domain");
+    const auto& b=in.buffers;
+    if (b[0].stride!=8 || b[1].stride!=72 || b[2].stride!=168 || b[3].stride!=0)
+        return reject("descriptor layout");
+    for (const auto& r:b) if (!r.base || !r.bytes || r.base>=Limit || r.bytes>Limit-r.base)
+        return reject("guest address overflow");
+    const U64 n=U64{in.groups}*64;
+    const U64 q_limit=std::min<U64>(in.roots,(n+in.divisor-1)/in.divisor);
+    if (U64{in.roots}*72>b[1].bytes || q_limit*72>b[1].bound ||
+        q_limit*72>in.source_records.size()) return reject("missing source records");
+    std::array<uint32_t,24575> indices{};
+    if(q_limit>indices.size()) return reject("root proof capacity");
+    result.lookup_hash=14695981039346656037ull;
+    for(U64 i=0;i<q_limit*72;i++) {
+        result.lookup_hash^=in.source_records[i];result.lookup_hash*=1099511628211ull;
+    }
+    const auto covered=[&](unsigned slot,U64 offset,U64 bytes) {
+        return offset<=b[slot].bytes && bytes<=b[slot].bytes-offset &&
+               offset<=b[slot].bound && bytes<=b[slot].bound-offset;
+    };
+    for(U64 q=0;q<q_limit;q++) {
+        uint32_t j;std::memcpy(&j,in.source_records.data()+q*72+64,4);indices[q]=j;
+        if(j==0xffffffffu)continue;
+        if(U64{j}*168+24>(U64{1}<<32) || !covered(2,U64{j}*168,24))
+            return reject("lookup record bounds");
+        ++result.valid_roots;
+        result.maximum_records+=std::min<U64>(in.divisor,n-q*in.divisor);
+    }
+    if(U64{in.counter}+result.maximum_records>0xffffffffu)
+        return reject("counter overflow");
+    const U64 output_start=U64{in.counter}*8;
+    const U64 output_bytes=result.maximum_records*8;
+    if(!covered(0,output_start,output_bytes))return reject("output capacity");
+    result.output_begin=b[0].base+output_start;result.output_end=result.output_begin+output_bytes;
+    const auto disjoint=[&](unsigned slot,U64 offset,U64 bytes) {
+        return covered(slot,offset,bytes) && (!output_bytes ||
+            Disjoint(b[slot].base+offset,bytes,result.output_begin,output_bytes));
+    };
+    for(U64 q=0;q<q_limit;q++) {
+        if(!disjoint(1,q*72+64,4))return reject("source-index/output overlap");
+        if(indices[q]==0xffffffffu)continue;
+        if(!disjoint(1,q*72,32))return reject("source-transform/output overlap");
+        if(!disjoint(2,U64{indices[q]}*168,24))return reject("lookup/output overlap");
+        const U64 lanes=std::min<U64>(in.divisor,n-q*in.divisor);
+        if(!disjoint(3,0,lanes*16) || !disjoint(3,96,lanes*16))
+            return reject("vector-table/output overlap or bounds");
+    }
+    result.safe=true;result.reason="proved disjoint";return result;
+}
