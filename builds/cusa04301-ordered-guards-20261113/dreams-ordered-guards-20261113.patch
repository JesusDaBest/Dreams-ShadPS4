+static void LogDreamsAtomicFallback(const Shader::Info& cs, const auto& regs, bool indirect,
+                                   bool subgroup64, const char* replay_rejection) {
+    if (!cs.uses_ordered_count || Common::ElfInfo::Instance().GameSerial() != "CUSA04301")
+        return;
+    const char* reason = !subgroup64 ? "subgroup64 unavailable" :
+        !Shader::DreamsCompat::HasOrderedWaveLaunch(regs.dispatch_initiator) ? "non-ordered initiator" :
+        (regs.start_x || regs.start_y || regs.start_z) ? "nonzero workgroup start" :
+        replay_rejection ? replay_rejection : "kernel shape/feature gate; see route inventory";
+    if (!replay_rejection && Shader::DreamsCompat::AdditionalOrderedKernelFor(cs.pgm_hash).docs) {
+        const bool indirect_supported = cs.pgm_hash == 0xfff20d00 || cs.pgm_hash == 0xbce8c0fe ||
+            cs.pgm_hash == 0x6f408bbc || cs.pgm_hash == 0xa25580f7 || cs.pgm_hash == 0x4bc902cf;
+        if (indirect && !indirect_supported) reason = "indirect kernel not audited";
+        else if (regs.num_thread_x.full != 64 || regs.num_thread_y.full != 1 ||
+                 regs.num_thread_z.full != 1) reason = "unsupported local shape; requires one 64-lane wave";
+        else if (!indirect && (!regs.dim_x || regs.dim_y != 1 || regs.dim_z != 1 ||
+            regs.dim_x > (cs.pgm_hash == 0x4bc902cf ? Shader::DreamsCompat::StatefulOrderedMaxGroups :
+                                                   Shader::DreamsCompat::MaxTraversalWorkgroups)))
+            reason = "unsupported direct dimensions/capacity";
+    }
+    // Once per shader, route and reason. Bound diagnostic storage for unrecognized programs.
+    static std::map<std::tuple<u64, bool, std::string_view>, bool> logged;
+    const auto key = std::make_tuple(cs.pgm_hash, indirect, std::string_view{reason});
+    if (logged.contains(key) || logged.size() >= 256) return;
+    logged.emplace(key, true);
+    LOG_WARNING(Render_Vulkan,
+        "Dreams DOC atomic fallback hash={:#x} indirect={} reason={} initiator={:#x} "
+        "start={}x{}x{} local={}x{}x{} register_dims={}x{}x{} (indirect dimensions GPU-owned)",
+        cs.pgm_hash, indirect, reason, regs.dispatch_initiator,
+        regs.start_x, regs.start_y, regs.start_z, regs.num_thread_x.full,
+        regs.num_thread_y.full, regs.num_thread_z.full, regs.dim_x, regs.dim_y, regs.dim_z);
+}
