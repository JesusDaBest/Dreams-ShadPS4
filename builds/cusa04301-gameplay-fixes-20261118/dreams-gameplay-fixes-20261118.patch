+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+namespace DreamsLogoGraphics {
+
+inline std::atomic_uint active_decoders{};
+
+class PlaybackScope {
+public:
+    explicit PlaybackScope(bool logo) : active{logo} {
+        if (active) {
+            active_decoders.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+
+    ~PlaybackScope() {
+        if (active) {
+            active_decoders.fetch_sub(1, std::memory_order_relaxed);
+        }
+    }
+
+    PlaybackScope(const PlaybackScope&) = delete;
+    PlaybackScope& operator=(const PlaybackScope&) = delete;
+
+private:
+    const bool active;
+};
+
+} // namespace DreamsLogoGraphics
