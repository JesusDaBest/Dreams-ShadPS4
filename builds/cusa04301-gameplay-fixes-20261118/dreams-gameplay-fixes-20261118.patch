+    std::uint8_t* destination;
+    const std::uint8_t* source;
+    std::size_t bytes;
+
+    static void CALLBACK Run(PTP_CALLBACK_INSTANCE, void* context, PTP_WORK) {
+        const auto& copy = *static_cast<const CopyWork*>(context);
+        std::memcpy(copy.destination, copy.source, copy.bytes);
+    }
+};
+
+static bool TryParallelCopy(std::uint8_t* destination, const std::uint8_t* source,
