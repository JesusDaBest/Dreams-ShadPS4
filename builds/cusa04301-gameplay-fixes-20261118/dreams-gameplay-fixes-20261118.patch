+    case 0x231c0061c: return &Counters;
+    case 0x231c00704:
+    case 0x231c00708: return &Model;
+    case 0x23d8c2600: return &Contact;
+    case 0x23b676030: return setting == 4 ? &SceneList : nullptr;
+    default: return nullptr;
+    }
+}
+
+constexpr bool Accept(const Rule& rule, unsigned setting, Word address, Word bytes, Word tick,
+                      Word current_tick, const auto& copies) {
+    if (address != rule.window || bytes != rule.window_bytes || !tick || tick >= current_tick ||
+        copies.empty() || copies.size() > 2) {
+        return false;
+    }
+    if (rule.result == Result::SceneList) {
+        // Only an already submitted single-range snapshot covering the fault may leave
+        // the command processor. The caller revalidates the version before consuming it.
+        const auto& copy = copies.front();
+        const Word offset = rule.source - address;
+        return setting == 4 && copies.size() == 1 && copy.dstOffset == 0 &&
+               copy.srcOffset % 4 == 0 && copy.size % 4 == 0 && copy.size <= 0x20000 &&
+               copy.srcOffset <= offset && copy.size <= bytes - copy.srcOffset &&
+               offset - copy.srcOffset + rule.bytes <= copy.size;
+    }
+    if (copies.size() == 2 && (setting < 2 || rule.result != Result::Counter)) {
+        return false;
+    }
+    Word source_end = 0;
+    Word staging_offset = 0;
+    bool matching_result = false;
+    for (const auto& copy : copies) {
+        if (!copy.size || copy.size % 4 || copy.srcOffset % 4 ||
+            copy.srcOffset < source_end || copy.srcOffset >= bytes ||
+            copy.size > bytes - copy.srcOffset || copy.dstOffset != staging_offset) {
+            return false;
+        }
+        const bool expected = copy.srcOffset == rule.source - rule.window &&
+                              (copy.size == rule.bytes || copy.size == rule.alternate_bytes);
+        if (!expected && (copies.size() != 2 || copy.size != 4 ||
+                          copy.srcOffset < 0x500 || copy.srcOffset >= 0x800)) {
+            return false;
+        }
+        matching_result |= expected;
+        source_end = copy.srcOffset + copy.size;
+        staging_offset += (copy.size + 63) & ~Word{63};
+    }
+    return matching_result;
+}
+
+namespace Checks {
+struct Copy { Word srcOffset, dstOffset, size; };
+static_assert(Request(SceneList.source, 8, false, 4) == &SceneList);
+static_assert(Request(SceneList.source, 8, false, 3) == nullptr);
+static_assert(Request(SceneList.source, 8, true, 4) == nullptr);
+static_assert(Accept(SceneList, 4, SceneList.window, 0x80000, 19, 20,
+                     std::array{Copy{0x22000, 0, 56}}));
+static_assert(!Accept(SceneList, 4, SceneList.window, 0x80000, 19, 20,
+                      std::array{Copy{0x22000, 0, 52}}));
+static_assert(!Accept(SceneList, 4, SceneList.window, 0x80000, 19, 20,
+                      std::array{Copy{0x22000, 64, 56}}));
+static_assert(!Accept(SceneList, 4, SceneList.window, 0x80000, 20, 20,
+                      std::array{Copy{0x22000, 0, 56}}));
+static_assert(!Accept(SceneList, 4, SceneList.window, 0x80000, 19, 20,
+                      std::array{Copy{0x22000, 0, 56}, Copy{0x23000, 64, 4}}));
+static_assert(Request(0x231c00608, 8, false, 1) == &Counters);
+static_assert(Request(0x231c0061c, 8, false, 1) == nullptr);
+static_assert(Request(0x231c0061c, 8, false, 2) == &Counters);
+static_assert(Request(0x23d8c2600, 8, false, 3) == &Contact);
+static_assert(Request(0x231c0061c, 8, false, 3) == &Counters);
+static_assert(Accept(Counters, 1, Counters.window, 0x10000, 19, 20, std::array{Copy{0x600, 0, 180}}));
+static_assert(Accept(Counters, 2, Counters.window, 0x10000, 19, 20,
+                     std::array{Copy{0x600, 0, 180}, Copy{0x700, 192, 4}}));
+static_assert(!Accept(Counters, 1, Counters.window, 0x10000, 19, 20,
+                      std::array{Copy{0x600, 0, 180}, Copy{0x700, 192, 4}}));
+static_assert(!Accept(Counters, 2, Counters.window, 0x10000, 19, 20,
+                      std::array{Copy{0x600, 0, 180}, Copy{0x680, 192, 4}}));
+static_assert(!Accept(Counters, 2, Counters.window, 0x10000, 19, 20,
+                      std::array{Copy{0x600, 0, 180}, Copy{0x700, 184, 4}}));
+static_assert(!Accept(Counters, 2, Counters.window, 0x10000, 20, 20, std::array{Copy{0x600, 0, 180}}));
+static_assert(Accept(Contact, 2, Contact.window, 0x80000, 19, 20, std::array{Copy{0x42600, 0, 272}}));
+static_assert(!Accept(Contact, 2, Contact.window, 0x80000, 19, 20, std::array{Copy{0x42604, 0, 272}}));
+}
