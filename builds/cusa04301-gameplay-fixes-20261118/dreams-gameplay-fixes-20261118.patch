+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+
+namespace DreamsHostUpload {
+
+inline thread_local bool allow_parallel_copy{};
+
+class ParallelScope {
+public:
+    explicit ParallelScope(bool value) : previous{allow_parallel_copy} {
+        allow_parallel_copy = value;
+    }
+    ~ParallelScope() { allow_parallel_copy = previous; }
+
+    ParallelScope(const ParallelScope&) = delete;
+    ParallelScope& operator=(const ParallelScope&) = delete;
+
+private:
+    bool previous;
+};
+
+} // namespace DreamsHostUpload
+
+namespace DreamsStagedUpload {
+
+inline thread_local bool* readable_copy{};
+
+class CopyScope {
+public:
+    explicit CopyScope(bool& result) : previous{readable_copy} { readable_copy = &result; }
+    ~CopyScope() { readable_copy = previous; }
+
+    CopyScope(const CopyScope&) = delete;
+    CopyScope& operator=(const CopyScope&) = delete;
+
+private:
+    bool* previous;
+};
+
+} // namespace DreamsStagedUpload
