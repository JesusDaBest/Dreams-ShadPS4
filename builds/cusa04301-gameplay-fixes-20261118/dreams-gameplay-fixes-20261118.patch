+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+#include <windows.h>
+
+#include "core/dreams_host_upload.h"
+#include "core/memory.h"
+
+namespace DreamsStagedUpload {
+
+class CopyBatch {
+public:
+    CopyBatch(Core::MemoryManager& memory, VAddr base) : memory{memory}, base{base} {}
+    ~CopyBatch() {
+        for (const auto work : workers) {
+            if (work) CloseThreadpoolWork(work);
+        }
+    }
+
+    CopyBatch(const CopyBatch&) = delete;
+    CopyBatch& operator=(const CopyBatch&) = delete;
+
+    bool Prepare(unsigned parts) {
+        if (!parts || parts > segments.size()) return false;
+        count = parts;
+        for (auto& work : workers) {
+            work = CreateThreadpoolWork(Run, this, nullptr);
+            if (!work) return false;
+        }
+        return true;
+    }
+
+    void Start(u8* staging) {
+        destination = staging;
+        for (const auto work : workers) {
+            SubmitThreadpoolWork(work);
+        }
+    }
+
+    void Enqueue(VAddr address, u64 bytes) {
+        segments[published] = Segment{address, bytes, false};
+        ready.store(++published, std::memory_order_release);
+        ready.notify_all();
+    }
+
+    void Finish() {
+        for (const auto work : workers) {
+            WaitForThreadpoolWorkCallbacks(work, FALSE);
+        }
+        for (unsigned i = 0; i < count; ++i) {
+            const auto& part = segments[i];
+            if (!part.copied) {
+                memory.CopySparseMemory(part.address, destination + (part.address - base), part.bytes);
+            }
+        }
+    }
+
+private:
+    struct Segment {
+        VAddr address{};
+        u64 bytes{};
+        bool copied{};
+    };
+
+    static void CALLBACK Run(PTP_CALLBACK_INSTANCE, void* context, PTP_WORK) {
+        auto& job = *static_cast<CopyBatch*>(context);
+        for (;;) {
+            const auto index = job.next.fetch_add(1, std::memory_order_relaxed);
+            if (index >= job.count) return;
+            auto available = job.ready.load(std::memory_order_acquire);
+            while (available <= index) {
+                job.ready.wait(available, std::memory_order_acquire);
+                available = job.ready.load(std::memory_order_acquire);
+            }
+            auto& part = job.segments[index];
+            part.copied = true;
+            const CopyScope scope{part.copied};
+            job.memory.CopySparseMemory(part.address, job.destination + (part.address - job.base),
+                                        part.bytes);
+        }
+    }
+
+    Core::MemoryManager& memory;
+    VAddr base;
+    u8* destination{};
+    std::array<Segment, 33> segments{}; // 128 MiB can cross 33 four-MiB tracker regions.
+    std::array<PTP_WORK, 2> workers{};
+    unsigned published{}, count{};
+    std::atomic<unsigned> ready{}, next{};
+};
+
+} // namespace DreamsStagedUpload
