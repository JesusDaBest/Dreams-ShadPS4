+        return false;
+    }
+    if (!AreReadOnlyViews(source, size)) {
+        return false;
+    }
+    const std::size_t first = (size / 2) & ~std::size_t{63};
+    CopyWork second{destination + first, source + first, size - first};
+    const auto work = CreateThreadpoolWork(CopyWork::Run, &second, nullptr);
+    if (!work) {
+        return false;
+    }
+    SubmitThreadpoolWork(work);
+    std::memcpy(destination, source, first);
+    WaitForThreadpoolWorkCallbacks(work, FALSE);
+    CloseThreadpoolWork(work);
+    return true;
+}
