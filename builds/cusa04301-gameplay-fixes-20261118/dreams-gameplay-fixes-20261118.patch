+// Uploads opted in by BufferCache hold the affected page tracker locks. The caller also
+// holds MemoryManager's mapping lock, so its read-only Windows views stay readable.
+// Let the original thread handle faults for other views, where emulation may need to wait.
+static bool AreReadOnlyViews(const std::uint8_t* source, std::size_t bytes) {
+    auto address = reinterpret_cast<std::uintptr_t>(source);
+    while (bytes) {
+        MEMORY_BASIC_INFORMATION view{};
+        if (VirtualQuery(reinterpret_cast<const void*>(address), &view, sizeof(view)) != sizeof(view) ||
+            view.State != MEM_COMMIT || view.Protect != PAGE_READONLY) {
+            return false;
+        }
+        const auto begin = reinterpret_cast<std::uintptr_t>(view.BaseAddress);
+        if (address < begin || address - begin >= view.RegionSize) {
+            return false;
+        }
+        const auto remaining = view.RegionSize - (address - begin);
+        if (bytes <= remaining) {
+            return true;
+        }
+        address += remaining;
+        bytes -= remaining;
+    }
+    return true;
+}
