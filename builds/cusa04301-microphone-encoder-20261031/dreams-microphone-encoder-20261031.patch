+/* Minimal host adapter. The upstream encoder uses only this owned byte buffer. */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+typedef struct { uint8_t *data; size_t len, cap; } buf_t;
+static inline bool buf_reserve(buf_t *b, size_t n) {
+    if (n <= b->cap) return true;
+    void *p = realloc(b->data, n);
+    if (!p) return false;
+    b->data = p; b->cap = n; return true;
+}
