+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include "common/types.h"
+
+namespace Core::Loader { class SymbolsResolver; }
+namespace Libraries::At9Enc {
+
+// Layout and calling convention recovered from Dreams CUSA04301's callers.
+// Field names beyond the observed audio dimensions are deliberately neutral.
+struct EncodeParam {
+    u32 size;
+    s32 channels;
+    s32 sample_rate;
+    s32 bitrate_kbps;
+    u32 frame_mode;
+    u32 pcm_mode;
+    u32 options[7];
+};
+static_assert(sizeof(EncodeParam) == 52);
+s32 PS4_SYSV_ABI sceAt9EncQueryMemSize(const EncodeParam*, s32* bytes, s32* error);
+s32 PS4_SYSV_ABI sceAt9EncCreateEncoder(void* work, const EncodeParam*, s32 bytes, s32* error);
+s32 PS4_SYSV_ABI sceAt9EncClearContext(void* work, s32* error);
+s32 PS4_SYSV_ABI sceAt9EncEncode(void* work, const s16* input, u8* output,
+    s32 input_bytes, s32 output_capacity, s32* output_bytes, s32* consumed_bytes, s32* error);
+void RegisterLib(Core::Loader::SymbolsResolver* sym);
+}
