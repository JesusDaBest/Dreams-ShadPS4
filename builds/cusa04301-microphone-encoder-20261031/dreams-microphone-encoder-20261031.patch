+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "core/libraries/audio/at9enc.h"
+#include "at9_stream.h"
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <vector>
+#ifndef AT9_ENCODER_TEST
+#include "common/logging/log.h"
+#include "core/libraries/libs.h"
+#endif
+
+namespace Libraries::At9Enc {
+namespace {
+constexpr std::array<u32, 7> ObservedOptions{0, 0, 0xffffff01, 0xffffff01, 4, 1, 0};
+bool Supported(const EncodeParam* p) {
+    return p && p->size == sizeof(EncodeParam) && (p->channels == 1 || p->channels == 2) &&
+        p->sample_rate == 48000 && p->bitrate_kbps == 96 * p->channels &&
+        p->frame_mode == 2 && p->pcm_mode == 4 &&
+        std::equal(ObservedOptions.begin(), ObservedOptions.end(), p->options);
+}
+s32 Result(s32 result, s32* error) {
+    // A negative failure is required by the observed ABI. Do not report success
+    // or consume PCM for unsupported configurations.
+    if (error) *error = result;
+    return result;
+}
+}
+
+s32 PS4_SYSV_ABI sceAt9EncQueryMemSize(const EncodeParam* param, s32* bytes, s32* error) {
+    if (bytes) *bytes = 0;
+    if (!Supported(param) || !bytes || at9_context_size() > std::numeric_limits<s32>::max()) {
+        return Result(-1, error);
+    }
+    *bytes = static_cast<s32>(at9_context_size());
+    return Result(0, error);
+}
+
+s32 PS4_SYSV_ABI sceAt9EncCreateEncoder(void* work, const EncodeParam* param, s32 bytes, s32* error) {
+    if (!Supported(param) || bytes < 0) return Result(-1, error);
+    const auto result = at9_context_create(work, static_cast<size_t>(bytes), param->channels, param->bitrate_kbps);
+#ifndef AT9_ENCODER_TEST
+    if (result == 0) {
+        LOG_INFO(Lib_AudioIn, "ATRAC9 software encoder ready: {} channels, {} Hz, {} kb/s",
+                 param->channels, param->sample_rate, param->bitrate_kbps);
+    } else {
+        LOG_ERROR(Lib_AudioIn, "ATRAC9 software encoder creation failed: {}", result);
+    }
+#endif
+    return Result(result, error);
+}
+
+s32 PS4_SYSV_ABI sceAt9EncClearContext(void* work, s32* error) {
+    return Result(at9_context_reset(work), error);
+}
+
+s32 PS4_SYSV_ABI sceAt9EncEncode(void* work, const s16* input, u8* output,
+        s32 input_bytes, s32 output_capacity, s32* output_bytes, s32* consumed_bytes, s32* error) {
+    // Search tables are reusable scratch, not persistent codec state. A lazy
+    // thread-local allocation avoids consuming Dreams' fixed recording arena
+    // and is released with its host thread; no per-recording handle registry.
+    if (output_bytes) *output_bytes = 0;
+    if (consumed_bytes) *consumed_bytes = 0;
+    try {
+        thread_local std::vector<u64> scratch((at9_stream_work_size() + sizeof(u64)-1) / sizeof(u64));
+        return Result(at9_context_encode(work, scratch.data(), scratch.size()*sizeof(u64),
+            input, input_bytes, output, output_capacity, output_bytes, consumed_bytes), error);
+    } catch (const std::bad_alloc&) {
+        return Result(-2, error);
+    }
+}
+
+#ifndef AT9_ENCODER_TEST
+void RegisterLib(Core::Loader::SymbolsResolver* sym) {
+    LIB_FUNCTION("1iDLkHJ4gbA", "libSceAt9Enc", 1, "libSceAt9Enc", sceAt9EncQueryMemSize);
+    LIB_FUNCTION("gujP4afE9dQ", "libSceAt9Enc", 1, "libSceAt9Enc", sceAt9EncCreateEncoder);
+    LIB_FUNCTION("ZE8DFcSverk", "libSceAt9Enc", 1, "libSceAt9Enc", sceAt9EncClearContext);
+    LIB_FUNCTION("WBgTbIYvODM", "libSceAt9Enc", 1, "libSceAt9Enc", sceAt9EncEncode);
+}
+#endif
+}
