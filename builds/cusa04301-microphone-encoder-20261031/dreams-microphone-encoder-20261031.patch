+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Raw 48 kHz, four-frame superframes, persistent MDCT history.
+ * No whole-recording buffer, gain normalization, fade, or file-size limit. */
+#include "at9_stream.h"
+#define STREAM_MAGIC UINT64_C(0x3954414d525453)
+typedef struct {
+    uint64_t magic;
+    arena_t arena;
+    enc_t *encoder;
+    int pending;
+    double samples[2][N + SUPERFRAME_SAMPLES];
+} stream_t;
+
+size_t at9_stream_work_size(void) {
+    /* Maximum 512-byte superframe. Include every quantisation-unit candidate
+     * cache and padding for every allocation; all storage belongs to the caller. */
+    return (sizeof(stream_t) + sizeof(enc_t) +
+        (N / 2 + 2 * N) * (sizeof(uint32_t) + sizeof(cplx_t) / 2) +
+        (512 + 1) * (FRAMES * (3 * sizeof(int) + sizeof(double)) +
+                     3 * sizeof(double) + sizeof(int)) +
+        (UNITS + 1) * sizeof(cand_t) * 4 * 30 * 31 + 4096 + 7) & ~(size_t)7;
+}
+
+int at9_stream_create(void *work, size_t size, int channels, int bitrate) {
+    if (!work || ((uintptr_t)work & 7) || size < at9_stream_work_size() ||
+        (channels != 1 && channels != 2) ||
+        !frame_bytes_for(bitrate) || (channels == 1 && bitrate > 96)) return -1;
+    stream_t *s = work;
+    memset(s, 0, sizeof(*s));
+    s->arena = (arena_t){(unsigned char *)work, size, sizeof(*s)};
+    s->encoder = enc_new_arena(bitrate, channels, &s->arena);
+    if (!s->encoder) return -2;
+    s->magic = STREAM_MAGIC;
+    return 0;
+}
+
+static stream_t *stream_check(void *work) {
+    if (!work || ((uintptr_t)work & 7)) return NULL;
+    stream_t *s = work;
+    if (s->magic != STREAM_MAGIC || s->arena.base != work ||
+        s->arena.size < at9_stream_work_size() || s->arena.used > s->arena.size ||
+        (unsigned char *)s->encoder != s->arena.base + ((sizeof(*s) + 7) & ~(size_t)7)) return NULL;
+    return s;
+}
+
+int at9_stream_reset(void *work) {
+    stream_t *s = stream_check(work);
+    if (!s) return -1;
+    s->pending = 0;
+    memset(s->samples, 0, sizeof(s->samples));
+    return 0;
+}
+
+int at9_stream_config(void *work, unsigned char config[4]) {
+    stream_t *s = stream_check(work);
+    if (!s || !config) return -1;
+    enc_t *e=s->encoder;
+    uint32_t c = 0xfeu << 24 | 7u << 20 | (e->channels == 2 ? 2u : 0u) << 17 |
+        (uint32_t)(e->frame_bytes - 1) << 5 | 2u << 3;
+    for (int i=0;i<4;i++) config[i]=(uint8_t)(c>>(24-8*i));
+    return 0;
+}
+
+int at9_stream_encode(void *work, const int16_t *input, int input_bytes,
+                     unsigned char *output, int output_capacity,
+                     int *output_bytes, int *consumed_bytes) {
+    if (output_bytes) *output_bytes=0;
+    if (consumed_bytes) *consumed_bytes=0;
+    stream_t *s=stream_check(work);
+    if (!s || !output_bytes || !consumed_bytes || input_bytes<0 ||
+        (!input && input_bytes) || !output || output_capacity<0) return -1;
+    enc_t *e=s->encoder;
+    const int channels=e->channels;
+    if (input_bytes % (2*channels)) return -1;
+    int count=input_bytes/(2*channels);
+    if (count>SUPERFRAME_SAMPLES-s->pending) count=SUPERFRAME_SAMPLES-s->pending;
+    if (s->pending+count==SUPERFRAME_SAMPLES && output_capacity<e->superframe_bytes) return -3;
+    for (int i=0;i<count;i++)
+        for (int ch=0;ch<channels;ch++)
+            s->samples[ch][N+s->pending+i]=(double)input[i*channels+ch]/32768.0;
+    s->pending+=count;
+    *consumed_bytes=count*2*channels;
+    if (s->pending<SUPERFRAME_SAMPLES) return 0;
+    analyse_offset(e,s->samples[0],s->samples[1],N+SUPERFRAME_SAMPLES,0);
+    /* Fixed full supported bandwidth avoids requiring future audio/lookahead. */
+    int band=e->max_band;
+    char error[160];
+    for (;;) {
+        int result=encode_superframe(e,band,output,error,sizeof(error));
+        if (result==0) break;
+        if (result<0 || band<=3) { *consumed_bytes=0; s->pending=0; return -2; }
+        band--;
+    }
+    for (int ch=0;ch<channels;ch++)
+        memmove(s->samples[ch],s->samples[ch]+SUPERFRAME_SAMPLES,N*sizeof(double));
+    s->pending=0;
+    *output_bytes=e->superframe_bytes;
+    return 0;
+}
+
+/* Dreams allocates both recording contexts from a fixed 168,232-byte arena.
+ * The search tables are scratch, not recording history. Keep only PCM history
+ * in that arena and borrow one reusable host scratch block per encoding thread. */
+#define CONTEXT_MAGIC UINT64_C(0x395441585443)
+typedef struct {
+    uint64_t magic;
+    int channels, bitrate, pending;
+    double samples[2][N + SUPERFRAME_SAMPLES];
+} context_t;
+
+size_t at9_context_size(void) { return sizeof(context_t); }
+static context_t *context_check(void *context) {
+    if (!context || ((uintptr_t)context & 7)) return NULL;
+    context_t *c=context;
+    if (c->magic!=CONTEXT_MAGIC || (c->channels!=1 && c->channels!=2) ||
+        c->bitrate!=96*c->channels || c->pending<0 || c->pending>=SUPERFRAME_SAMPLES) return NULL;
+    return c;
+}
+int at9_context_create(void *context, size_t bytes, int channels, int bitrate) {
+    if (!context || ((uintptr_t)context & 7) || bytes<sizeof(context_t) ||
+        (channels!=1 && channels!=2) || bitrate!=96*channels) return -1;
+    context_t *c=context;memset(c,0,sizeof(*c));
+    c->magic=CONTEXT_MAGIC;c->channels=channels;c->bitrate=bitrate;
+    return 0;
+}
+int at9_context_reset(void *context) {
+    context_t *c=context_check(context);if (!c) return -1;
+    c->pending=0;memset(c->samples,0,sizeof(c->samples));return 0;
+}
+int at9_context_encode(void *context, void *scratch, size_t scratch_bytes,
+    const int16_t *input, int input_bytes, unsigned char *output, int output_capacity,
+    int *output_bytes, int *consumed_bytes) {
+    if (output_bytes) *output_bytes=0;
+    if (consumed_bytes) *consumed_bytes=0;
+    context_t *c=context_check(context);
+    if (!c || !scratch || ((uintptr_t)scratch&7) || scratch_bytes<at9_stream_work_size()) return -1;
+    stream_t *s=stream_check(scratch);
+    if (!s || s->encoder->channels!=c->channels || s->encoder->superframe_bytes!=c->bitrate*8/3) {
+        int result=at9_stream_create(scratch,scratch_bytes,c->channels,c->bitrate);
+        if (result) return result;
+        s=scratch;
+    }
+    s->pending=c->pending;memcpy(s->samples,c->samples,sizeof(c->samples));
+    int result=at9_stream_encode(s,input,input_bytes,output,output_capacity,output_bytes,consumed_bytes);
+    if (!result) { c->pending=s->pending;memcpy(c->samples,s->samples,sizeof(c->samples)); }
+    return result;
+}
