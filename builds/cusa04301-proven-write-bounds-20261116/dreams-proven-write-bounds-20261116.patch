+inline thread_local std::array<StageContext,6> stages;
+inline thread_local unsigned nesting{};
+struct LaunchScope {
+    P::Launch previous;
+    std::unique_ptr<std::array<StageContext,6>> previous_stages;
+    explicit LaunchScope(P::Launch value):previous(launch) {
+        if(nesting)previous_stages=std::make_unique<std::array<StageContext,6>>(stages);
+        ++nesting;launch=value;
