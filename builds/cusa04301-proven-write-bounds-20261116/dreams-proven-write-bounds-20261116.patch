+    ~LaunchScope(){if(previous_stages)stages=std::move(*previous_stages);launch=previous;--nesting;}
+};
+inline void BeginBindings(){for(auto& s:stages)s.identity=nullptr;}
+class Cache {
+    struct Entry {
+        std::unique_ptr<P::Module> module;
+        struct Shape {P::Launch launch;P::Result result;};
+        std::vector<Shape> shapes;
+        size_t next_shape{};
+    };
+    std::map<std::pair<std::uintptr_t,size_t>,Entry> entries;
+    size_t stored_words{};
+    P::Result unavailable;
+public:
+    const P::Result& Get(std::span<const P::U32> code,P::Launch dimensions) {
+        if(code.empty()||code.size()>1024*1024)return unavailable;
+        const auto key=std::make_pair(reinterpret_cast<std::uintptr_t>(code.data()),code.size());
+        auto it=entries.find(key);
+        if(it==entries.end()) {
+            if(entries.size()>=256||stored_words+code.size()>8*1024*1024)return unavailable;
+            it=entries.emplace(key,Entry{}).first;stored_words+=code.size();
+        }
+        auto& entry=it->second;
