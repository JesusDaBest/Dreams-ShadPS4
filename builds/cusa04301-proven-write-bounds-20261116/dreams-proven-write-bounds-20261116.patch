+        if(!entry.module||!entry.module->Matches(code)) {
+            entry.module=std::make_unique<P::Module>(code);entry.shapes.clear();entry.next_shape=0;
+        }
+        for(const auto& shape:entry.shapes)if(shape.launch==dimensions)return shape.result;
+        // The proof depends on the immutable module and launch shape only, never input contents.
+        if(entry.shapes.size()<8){entry.shapes.push_back({dimensions,entry.module->Evaluate(dimensions)});return entry.shapes.back().result;}
+        auto& shape=entry.shapes[entry.next_shape++%entry.shapes.size()];
+        shape={dimensions,entry.module->Evaluate(dimensions)};return shape.result;
+    }
+};
+inline thread_local Cache cache;
+inline void Prepare(const void* identity,P::U64 hash,P::U32 stage,bool compute,bool excluded,
+                    P::U32 binding_base,P::U32 alignment,P::U64 page_size,
+                    std::span<const P::U32> code) {
+    if(stage>=stages.size())return;
+    auto& out=stages[stage];out.identity=nullptr;
+    if(excluded||!P::AuditedKernel(hash)||!alignment||!std::has_single_bit(alignment)||
+       page_size%alignment)return;
+    const auto evaluated=compute?launch:P::Launch{};
+    const auto& result=cache.Get(code,evaluated);
+    if(!result.valid)return;
+    out.identity=identity;out.hash=hash;out.base=binding_base;out.alignment=alignment;
+    out.compute=compute;out.evaluated_launch=evaluated;out.result=result;
+}
+inline std::optional<P::U32> Bound(const void* identity,P::U64 hash,P::U32 stage,P::U32 binding,
+                                P::U64 address,P::U64 size,bool unusual,bool formatted) {
+    if(stage>=stages.size()||unusual||formatted||!address||!size||
+       size>0xffffffffull||size%4)return {};
+    const auto& s=stages[stage];
+    if(s.identity!=identity||s.hash!=hash||!s.alignment||address%s.alignment||
+       (s.compute&&s.evaluated_launch!=launch)||binding>=P::MaxBindings||
+       s.base>=P::MaxBindings-binding)return {};
+    const auto at=s.base+binding;
+    if(!s.result.valid||!s.result.declared[at]||s.result.end[at]>0xfffffffcul)return {};
