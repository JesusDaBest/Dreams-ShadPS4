+// A merged IMAGE_LOAD_MIP and ordinary writer cannot use a storage-image
+// LOD operand on hosts without image-load/store-LOD. Keep the writer binding,
+// and give only those failing reads an ordinary fetched-image view of the same
+// backing. PatchImageArgs then retains the explicit LOD and view swizzle.
+void SeparateStorageLodReads(IR::Program& program, const Profile& profile) {
+    if (profile.supports_image_load_store_lod) {
+        return;
+    }
+    std::array<u32, NUM_IMAGES> read_bindings;
+    read_bindings.fill(~0u);
+    auto& images = program.info.images;
+    for (IR::Block* const block : program.post_order_blocks) {
+        for (IR::Inst& inst : block->Instructions()) {
+            if (inst.GetOpcode() != IR::Opcode::ImageRead ||
+                !inst.Flags<IR::TextureInstInfo>().has_lod) {
+                continue;
+            }
+            const u32 binding = inst.Arg(0).U32();
+            const auto image = images[binding];
+            if (!image.is_written || image.mip_fallback_mode != MipStorageFallbackMode::None) {
+                continue;
+            }
+            auto& read_binding = read_bindings[binding];
+            if (read_binding == ~0u) {
+                ASSERT_MSG(images.size() < images.capacity(), "No binding for storage mip read");
+                auto read_image = image;
+                read_image.is_written = false;
+                read_image.is_atomic = false;
+                read_image.is_integer_atomic = false;
+                read_binding = static_cast<u32>(images.size());
+                images.push_back(read_image);
+            }
+            inst.SetArg(0, IR::Value{read_binding});
+        }
+    }
