+static bool NeedsShaderWriteRefresh(const Pipeline* pipeline,
+                                    const VideoCore::BufferCache& cache,
+                                    Core::MemoryManager* memory) {
+    for (const auto* stage : pipeline->GetStages()) {
+        if (!stage) continue;
+        for (u32 i = 0; i < stage->buffers.size(); ++i) {
+            const auto& desc = stage->buffers[i];
+            if (desc.IsSpecial() || !desc.is_written) continue;
+            const auto sharp = desc.GetSharp(*stage);
+            if (!sharp.base_address || !sharp.GetSize()) continue;
+            const u32 size = ResolveGuestBufferBindingSize(memory, *stage, i, desc, sharp);
+            const u32 written = desc.is_formatted ? size :
+                std::min(size, DreamsLinearWriteSize(*stage, i, desc, sharp, size));
+            if (written && !cache.IsRegionGpuModifiedFully(sharp.base_address, written)) {
+                return true;
+            }
+        }
+    }
+    return false;
