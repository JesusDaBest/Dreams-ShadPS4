+static vk::DescriptorBufferInfo UploadTilingParameters(const Vulkan::Instance& instance,
+                                                      Vulkan::Scheduler& scheduler,
+                                                      StreamBuffer& stream_buffer,
+                                                      const TilingInfo& params) {
+    // Both callers already hold image references and borrowed source/destination
+    // buffers. Submitting here could let completion callbacks retire those resources.
+    const auto [data, offset] =
+        stream_buffer.Map(sizeof(params), instance.UniformMinAlignment(), false);
+    if (data) {
+        std::memcpy(data, &params, sizeof(params));
+        stream_buffer.Commit();
+        return {stream_buffer.Handle(), offset, sizeof(params)};
+    }
+
+    // A busy ring needs only an owned parameter block, not a queue submission.
+    Buffer temporary{instance, scheduler, MemoryUsage::Upload, 0,
+                     vk::BufferUsageFlagBits::eUniformBuffer, sizeof(params)};
+    std::memcpy(temporary.mapped_data.data(), &params, sizeof(params));
+    if (!temporary.is_coherent) {
+        const auto result = vmaFlushAllocation(instance.GetAllocator(),
+                                               temporary.buffer.allocation, 0, sizeof(params));
+        ASSERT_MSG(result == VK_SUCCESS, "Failed flushing tiling parameters: {}",
+                   vk::to_string(vk::Result{result}));
+    }
+    const vk::DescriptorBufferInfo descriptor{temporary.Handle(), 0, sizeof(params)};
+    scheduler.DeferOperation([buffer = std::move(temporary)]() mutable {});
+    return descriptor;
