+void BufferCache::ReadCachedMemory(VAddr device_addr, u64 size,
+                                   std::source_location caller) {
+    if (!size) {
+        return;
+    }
+    liverpool->SendCommand<true>([&] {
+        struct CachedRange {
+            VAddr address;
+            u64 size;
+        };
+        boost::container::small_vector<CachedRange, 8> ranges;
+        // A readback may submit work and run completed fault callbacks. Those
+        // callbacks can join buffers and erase buffer_ranges entries, so finish
+        // traversing the live map before any operation that can submit.
+        buffer_ranges.ForEachInRange(device_addr, size,
+                                     [&](VAddr first, VAddr last, BufferId) {
+                                         ranges.push_back({first, last - first});
+                                     });
+        for (const auto& range : ranges) {
+            // Resolve again after each completion. Save addresses, not Buffer
+            // references or IDs: an earlier read can retire or move them.
+            const BufferId id = page_table[range.address >> CACHING_PAGEBITS].buffer_id;
+            if (IsBufferInvalid(id)) {
+                continue;
+            }
+            Buffer& buffer = slot_buffers[id];
+            if (!buffer.IsInBounds(range.address, range.size) ||
+                !IsRegionGpuModified(range.address, range.size)) {
+                continue;
+            }
+            // Keep the request inside an existing allocation; do not merge
+            // buffers just to cover CPU-only gaps in a texture's guest range.
+            const auto handle = buffer.Handle();
+            const auto access = buffer.access_mask;
+            const auto stage = buffer.stage;
+            // BindBuffers updates access tracking while retaining its barriers
+            // until Pipeline::BindResources. A hash readback can run between
+            // those steps, so the tracked access may describe a future read,
+            // not the GPU write that produced the bytes being downloaded.
+            // Make prior writes available here, before the copy is recorded.
+            scheduler.EndRendering();
+            auto before = *buffer.GetBarrier(vk::AccessFlagBits2::eTransferRead,
+                                            vk::PipelineStageFlagBits2::eTransfer, 0, true);
+            before.srcStageMask = vk::PipelineStageFlagBits2::eAllCommands;
+            before.srcAccessMask = vk::AccessFlagBits2::eMemoryWrite;
+            scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+                .bufferMemoryBarrierCount = 1,
+                .pBufferMemoryBarriers = &before,
+            });
+            ReadMemory(range.address, range.size, false, caller);
+            // Completion can retire this allocation, or relocate SlotVector
+            // storage even when its ID survives. Reacquire the current object
+            // and restore access only for the same active GPU buffer.
+            const BufferId current_id =
+                page_table[range.address >> CACHING_PAGEBITS].buffer_id;
+            if (current_id != id || IsBufferInvalid(current_id)) {
+                continue;
+            }
+            Buffer& current = slot_buffers[current_id];
+            if (current.Handle() != handle) {
+                continue;
+            }
+            if (auto barrier = current.GetBarrier(access, stage)) {
+                scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+                    .bufferMemoryBarrierCount = 1,
+                    .pBufferMemoryBarriers = &*barrier,
+                });
+            }
+        }
+    });
