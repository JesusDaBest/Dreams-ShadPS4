+    if (ptr == nullptr || size == 0 || Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return false;
+    }
+    const auto begin = reinterpret_cast<u64>(ptr);
+    const auto end = begin + size;
+    constexpr u64 avplayer_begin = 0x322000000ull;
+    constexpr u64 avplayer_end = 0x325000000ull;
+    return begin < avplayer_end && end > avplayer_begin;
+}
+
+void LogDreamsAvPlayerCopy(const char* name, void* dest, const void* src, size_t size) {
+    if (!OverlapsAvPlayerTextureRange(src, size) && !OverlapsAvPlayerTextureRange(dest, size)) {
