+void DumpCallerBytes(const void* return_address) {
+    if (g_avplayer_video_caller_dumped.exchange(true, std::memory_order_relaxed)) {
+        return;
+    }
+    constexpr u64 bytes_before = 0x80;
+    constexpr u64 bytes_to_dump = 0x800;
+    const auto return_addr = reinterpret_cast<u64>(return_address);
+    const auto start_addr = return_addr - bytes_before;
+    std::array<unsigned char, bytes_to_dump> bytes{};
+    std::memcpy(bytes.data(), reinterpret_cast<const void*>(start_addr), bytes.size());
+
+    std::string dump;
+    dump.reserve(bytes.size() * 3);
+    for (const auto byte : bytes) {
+        fmt::format_to(std::back_inserter(dump), "{:02x}", byte);
+    }
+    LOG_INFO(Lib_AvPlayer, "AVPlayer video caller bytes: start={:#x} return={:#x} bytes={}",
+             start_addr, return_addr, dump);
+}
