+    if (enabled == nullptr || std::string_view{enabled} != "1") {
+        return;
+    }
+
+    std::call_once(g_dreams_frame_shower_once, [] {
+        g_dreams_frame_shower_thread = std::make_unique<std::jthread>(DreamsFrameShowerThread);
+    });
+}
