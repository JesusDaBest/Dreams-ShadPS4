+namespace {
+void DreamsFrameShowerThread(std::stop_token stop) {
+    Common::SetCurrentThreadName("shadPS4:DreamsFrameShower");
+
+    if (SDL_WasInit(SDL_INIT_VIDEO) == 0 && !SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+        LOG_ERROR(Lib_AvPlayer, "Dreams frame shower: SDL video init failed: {}", SDL_GetError());
+        return;
+    }
+
+    constexpr u32 preview_width = 1280;
+    constexpr u32 preview_height = 720;
+    SDL_Window* window =
+        SDL_CreateWindow("Dreams AVPlayer Frame Shower", preview_width, preview_height,
+                         SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALWAYS_ON_TOP);
+    if (window == nullptr) {
+        LOG_ERROR(Lib_AvPlayer, "Dreams frame shower: window creation failed: {}", SDL_GetError());
+        return;
+    }
+    SDL_SetWindowPosition(window, 40, 40);
+    SDL_ShowWindow(window);
+    SDL_RaiseWindow(window);
+    SDL_SetWindowAlwaysOnTop(window, true);
+
+    SDL_Renderer* renderer = SDL_CreateRenderer(window, nullptr);
+    if (renderer == nullptr) {
+        LOG_ERROR(Lib_AvPlayer, "Dreams frame shower: renderer creation failed: {}",
+                  SDL_GetError());
+        SDL_DestroyWindow(window);
+        return;
+    }
+
+    SDL_Texture* texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_BGRA8888,
+                                             SDL_TEXTUREACCESS_STREAMING, preview_width,
+                                             preview_height);
+    if (texture == nullptr) {
+        LOG_ERROR(Lib_AvPlayer, "Dreams frame shower: texture creation failed: {}",
+                  SDL_GetError());
+        SDL_DestroyRenderer(renderer);
+        SDL_DestroyWindow(window);
+        return;
+    }
+
+    std::vector<u32> pixels(static_cast<size_t>(preview_width) * preview_height);
+    LOG_INFO(Lib_AvPlayer, "Dreams frame shower started at {}x{}", preview_width, preview_height);
+    while (!stop.stop_requested()) {
+        SDL_PumpEvents();
+        if (BlitDreamsVideoSnapshotToB8G8R8A8(pixels.data(), preview_width, preview_width,
+                                              preview_height)) {
+            SDL_UpdateTexture(texture, nullptr, pixels.data(), preview_width * sizeof(u32));
+            SDL_RenderClear(renderer);
+            SDL_RenderTexture(renderer, texture, nullptr, nullptr);
+            SDL_RenderPresent(renderer);
+            SDL_RaiseWindow(window);
+        }
+        SDL_Delay(16);
+    }
+
+    SDL_DestroyTexture(texture);
+    SDL_DestroyRenderer(renderer);
+    SDL_DestroyWindow(window);
+}
+
+void EnsureDreamsFrameShowerStarted() {
