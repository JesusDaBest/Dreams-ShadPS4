+bool BlitDreamsVideoSnapshotToA2R10G10B10(void* dst, u32 dst_pitch_pixels, u32 dst_width,
+                                          u32 dst_height) {
+    std::vector<u8> nv12;
+    u32 src_width = 0;
+    u32 src_height = 0;
+    u32 src_pitch = 0;
+    u64 generation = 0;
+    {
+        std::scoped_lock lock{g_dreams_video_snapshot.mutex};
+        if (g_dreams_video_snapshot.nv12.empty()) {
+            return false;
+        }
+        nv12 = g_dreams_video_snapshot.nv12;
+        src_width = g_dreams_video_snapshot.width;
+        src_height = g_dreams_video_snapshot.height;
+        src_pitch = g_dreams_video_snapshot.pitch;
+        generation = g_dreams_video_snapshot.generation;
+    }
+
+    if (dst == nullptr || src_width == 0 || src_height == 0 || src_pitch == 0) {
+        return false;
+    }
+
+    const u32 width = std::min(src_width, dst_width);
+    const u32 height = std::min(src_height, dst_height);
+    auto* out = static_cast<u32*>(dst);
+    const u8* luma = nv12.data();
+    const u8* chroma = nv12.data() + static_cast<u64>(src_pitch) * src_height;
+
+    for (u32 y = 0; y < height; ++y) {
+        auto* out_row = out + static_cast<u64>(y) * dst_pitch_pixels;
+        const u8* y_row = luma + static_cast<u64>(y) * src_pitch;
+        const u8* uv_row = chroma + static_cast<u64>(y / 2) * src_pitch;
+        for (u32 x = 0; x < width; ++x) {
+            const s32 yy = static_cast<s32>(y_row[x]) - 16;
+            const s32 uu = static_cast<s32>(uv_row[x & ~1u]) - 128;
+            const s32 vv = static_cast<s32>(uv_row[(x & ~1u) + 1]) - 128;
+            const s32 c = std::max(0, yy);
+            const u32 r = static_cast<u32>(Clamp8((298 * c + 409 * vv + 128) >> 8)) * 4;
+            const u32 g = static_cast<u32>(Clamp8((298 * c - 100 * uu - 208 * vv + 128) >> 8)) * 4;
+            const u32 b = static_cast<u32>(Clamp8((298 * c + 516 * uu + 128) >> 8)) * 4;
+            out_row[x] = (3u << 30) | (std::min(r, 1023u) << 20) | (std::min(g, 1023u) << 10) |
+                         std::min(b, 1023u);
+        }
+    }
+
+    static std::atomic<u32> blit_logs{};
+    const auto logged = blit_logs.fetch_add(1, std::memory_order_relaxed);
+    if (logged < 8) {
+        LOG_INFO(Lib_AvPlayer,
+                 "Blitted Dreams AVPlayer snapshot to video-out buffer: generation={} size={}x{} "
+                 "dst={}x{} pitch={}",
+                 generation, width, height, dst_width, dst_height, dst_pitch_pixels);
+    }
+    return true;
+}
+
+bool BlitDreamsVideoSnapshotToB8G8R8A8(void* dst, u32 dst_pitch_pixels, u32 dst_width,
