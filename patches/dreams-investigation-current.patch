+
+    auto* out = static_cast<u32*>(dst);
+    const u8* luma = nv12.data();
+    const u8* chroma = nv12.data() + static_cast<u64>(src_pitch) * src_height;
+
+    for (u32 y = 0; y < dst_height; ++y) {
+        const u32 sy = std::min((static_cast<u64>(y) * src_height) / dst_height,
+                                static_cast<u64>(src_height - 1));
+        auto* out_row = out + static_cast<u64>(y) * dst_pitch_pixels;
+        const u8* y_row = luma + static_cast<u64>(sy) * src_pitch;
+        const u8* uv_row = chroma + static_cast<u64>(sy / 2) * src_pitch;
+        for (u32 x = 0; x < dst_width; ++x) {
+            const u32 sx = std::min((static_cast<u64>(x) * src_width) / dst_width,
+                                    static_cast<u64>(src_width - 1));
+            const s32 yy = static_cast<s32>(y_row[sx]) - 16;
+            const s32 uu = static_cast<s32>(uv_row[sx & ~1u]) - 128;
+            const s32 vv = static_cast<s32>(uv_row[(sx & ~1u) + 1]) - 128;
+            const s32 c = std::max(0, yy);
+            const u8 r = Clamp8((298 * c + 409 * vv + 128) >> 8);
+            const u8 g = Clamp8((298 * c - 100 * uu - 208 * vv + 128) >> 8);
+            const u8 b = Clamp8((298 * c + 516 * uu + 128) >> 8);
+            out_row[x] = (255u << 24) | (static_cast<u32>(r) << 16) |
