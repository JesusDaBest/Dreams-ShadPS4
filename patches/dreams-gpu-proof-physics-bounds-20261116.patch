+#pragma once
+#include <vulkan/vulkan.h>
+#include <array>
+#include <cstdint>
+#include <span>
+
+#define DREAMS_DOC_LOOKBACK_FUNCTIONS(X) \
+    X(vkCreateDescriptorSetLayout) X(vkDestroyDescriptorSetLayout) \
+    X(vkCreatePipelineLayout) X(vkDestroyPipelineLayout) \
+    X(vkCreateShaderModule) X(vkDestroyShaderModule) \
+    X(vkCreateComputePipelines) X(vkDestroyPipeline) \
+    X(vkCreateDescriptorPool) X(vkDestroyDescriptorPool) \
+    X(vkAllocateDescriptorSets) X(vkUpdateDescriptorSets) \
+    X(vkCmdPipelineBarrier2) X(vkCmdCopyBuffer) X(vkCmdFillBuffer) \
+    X(vkCmdBindDescriptorSets) X(vkCmdPushConstants) X(vkCmdBindPipeline) X(vkCmdDispatch)
+
+// Independent host pass. It uses the existing GDS private scratch allocation;
+// no guest memory, CPU readback, per-dispatch allocation or shader replay.
+namespace DreamsSinglePassDoc {
+class Pass {
+public:
+    static constexpr uint32_t MaxGroups = 256;
+    static constexpr VkDeviceSize ScratchOffset = 16384ull * 4;
+    static constexpr VkDeviceSize ScratchBytes = 8192ull;
+    Pass() = default;
+    Pass(const Pass&) = delete;
+    Pass& operator=(const Pass&) = delete;
+    ~Pass() { Reset(); }
+
+    VkResult Create(VkDevice dev, PFN_vkGetDeviceProcAddr get,
+                    VkDescriptorSetLayout guest_layout, std::span<const uint32_t> code) {
+        if (device || !dev || !get || code.empty()) return VK_ERROR_INITIALIZATION_FAILED;
+        device = dev;
+#define LOAD(name) name = reinterpret_cast<PFN_##name>(get(dev, #name)); if (!name) return VK_ERROR_INITIALIZATION_FAILED;
+        DREAMS_DOC_LOOKBACK_FUNCTIONS(LOAD)
+#undef LOAD
+        VkDescriptorSetLayoutBinding binding{0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1,
+                                            VK_SHADER_STAGE_COMPUTE_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo dci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        dci.bindingCount = 1; dci.pBindings = &binding;
+        auto result = vkCreateDescriptorSetLayout(device, &dci, nullptr, &state_layout);
+        if (result != VK_SUCCESS) return result;
+        std::array sets{guest_layout, state_layout};
+        VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT, 0, 128};
+        VkPipelineLayoutCreateInfo pci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        pci.setLayoutCount = 2; pci.pSetLayouts = sets.data();
+        pci.pushConstantRangeCount = 1; pci.pPushConstantRanges = &push;
+        result = vkCreatePipelineLayout(device, &pci, nullptr, &layout);
+        if (result != VK_SUCCESS) return result;
+        VkShaderModuleCreateInfo sci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        sci.codeSize = code.size_bytes(); sci.pCode = code.data();
+        VkShaderModule module{};
+        result = vkCreateShaderModule(device, &sci, nullptr, &module);
+        if (result != VK_SUCCESS) return result;
+        VkPipelineShaderStageRequiredSubgroupSizeCreateInfo subgroup{
+            VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO};
+        subgroup.requiredSubgroupSize = 64;
+        VkComputePipelineCreateInfo ci{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        ci.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        ci.stage.pNext = &subgroup;
+        ci.stage.flags = VK_PIPELINE_SHADER_STAGE_CREATE_REQUIRE_FULL_SUBGROUPS_BIT;
+        ci.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT; ci.stage.module = module; ci.stage.pName = "main";
+        ci.layout = layout;
+        result = vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &ci, nullptr, &pipeline);
+        vkDestroyShaderModule(device, module, nullptr);
+        if (result != VK_SUCCESS) return result;
+        VkDescriptorPoolSize pool_size{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1};
+        VkDescriptorPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        pool_info.maxSets = 1; pool_info.poolSizeCount = 1; pool_info.pPoolSizes = &pool_size;
+        result = vkCreateDescriptorPool(device, &pool_info, nullptr, &pool);
+        if (result != VK_SUCCESS) return result;
+        VkDescriptorSetAllocateInfo allocate{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        allocate.descriptorPool = pool; allocate.descriptorSetCount = 1;
+        allocate.pSetLayouts = &state_layout;
+        return vkAllocateDescriptorSets(device, &allocate, &state_set);
+    }
+
+    bool Record(VkCommandBuffer cmd, VkBuffer gds, VkDeviceSize gds_bytes,
+                uint32_t groups, std::span<const uint8_t> push) {
+        if (!pipeline || !state_set || !cmd || !gds || !groups || groups > MaxGroups ||
+            gds_bytes < ScratchOffset + ScratchBytes || push.size() != 128 ||
+            (bound_gds && bound_gds != gds)) return false;
+        if (!bound_gds) {
+            VkDescriptorBufferInfo buffer{gds, ScratchOffset, ScratchBytes};
+            VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+            write.dstSet = state_set; write.dstBinding = 0; write.descriptorCount = 1;
+            write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; write.pBufferInfo = &buffer;
+            vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+            bound_gds = gds;
+        }
+        std::array<VkBufferMemoryBarrier2, 2> barriers{};
+        for (auto& barrier : barriers) {
+            barrier = {VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2};
+            barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+            barrier.srcAccessMask = VK_ACCESS_2_SHADER_STORAGE_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
+                                    VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+            barrier.dstStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+            barrier.dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+            barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            barrier.buffer = gds;
+        }
+        barriers[0].offset = 736ull * 4; barriers[0].size = 8;
+        barriers[1].offset = ScratchOffset; barriers[1].size = ScratchBytes;
+        VkDependencyInfo dependency{VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+        dependency.bufferMemoryBarrierCount = 2; dependency.pBufferMemoryBarriers = barriers.data();
+        vkCmdPipelineBarrier2(cmd, &dependency);
+        VkBufferCopy seed{736ull * 4, ScratchOffset, 8};
+        vkCmdCopyBuffer(cmd, gds, gds, 1, &seed);
+        vkCmdFillBuffer(cmd, gds, ScratchOffset + 8, uint64_t(groups) * 8, 0);
+        vkCmdFillBuffer(cmd, gds, ScratchOffset + 4096, 8, 0);
+        for (auto& barrier : barriers) {
+            barrier.srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+            barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+            barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+            barrier.dstAccessMask = VK_ACCESS_2_SHADER_STORAGE_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT;
+        }
+        vkCmdPipelineBarrier2(cmd, &dependency);
+        // Set zero remains compatible with the original guest pipeline layout.
+        vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, layout, 1, 1, &state_set, 0, nullptr);
+        vkCmdPushConstants(cmd, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, 128, push.data());
+        vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+        vkCmdDispatch(cmd, groups, 1, 1);
+        for (auto& barrier : barriers) {
+            barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+            barrier.srcAccessMask = VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT;
+            barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+            barrier.dstAccessMask = VK_ACCESS_2_SHADER_STORAGE_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT;
+        }
+        vkCmdPipelineBarrier2(cmd, &dependency);
+        ++dispatches;
+        return true;
+    }
+
+    uint64_t dispatches{};
+private:
+#define DECLARE(name) PFN_##name name{};
+    DREAMS_DOC_LOOKBACK_FUNCTIONS(DECLARE)
+#undef DECLARE
+    void Reset() {
+        if (!device) return;
+        if (pool) vkDestroyDescriptorPool(device, pool, nullptr);
+        if (pipeline) vkDestroyPipeline(device, pipeline, nullptr);
+        if (layout) vkDestroyPipelineLayout(device, layout, nullptr);
+        if (state_layout) vkDestroyDescriptorSetLayout(device, state_layout, nullptr);
+        device = {}; pool = {}; pipeline = {}; layout = {}; state_layout = {};
+    }
+    VkDevice device{};
+    VkPipeline pipeline{};
+    VkPipelineLayout layout{};
+    VkDescriptorSetLayout state_layout{};
+    VkDescriptorPool pool{};
+    VkDescriptorSet state_set{};
+    VkBuffer bound_gds{};
+#undef DREAMS_DOC_LOOKBACK_FUNCTIONS
+};
+} // namespace DreamsSinglePassDoc
