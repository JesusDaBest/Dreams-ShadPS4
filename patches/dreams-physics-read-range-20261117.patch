--- /dev/null
+++ b/src/video_core/renderer_vulkan/e165_read_range.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace Vulkan::DreamsE165Reads {
+
+struct Range {
+    std::uint64_t address{};
+    std::uint32_t size{};
+};
+
+// The two audited modules read four dwords per loop iteration, i in [0, flat[80]).
+// Their 32-bit byte offset is (i * 16 + 240). Reject wrapping input counts.
+// flat[80] is from the same stream-buffer copy bound by BindBuffers, not a CPU
+// estimate of a GPU-owned counter. No readback is required.
+inline std::optional<Range> Bound(std::span<const std::uint32_t> ud,
+                                  std::span<const std::uint32_t> flat) {
+    if (ud.size() < 2 || flat.size() < 81) {
+        return {};
+    }
+    const std::uint64_t count = flat[80];
+    if (count == 0) {
+        return Range{}; // The physical-load helper is never called.
+    }
+    constexpr std::uint64_t Offset = 240;
+    constexpr std::uint64_t OffsetLimit = std::uint64_t{1} << 32;
+    constexpr std::uint64_t AddressLimit = std::uint64_t{1} << 40;
+    // Larger tables retain the original
+    // scan instead of requesting a potentially very large joined allocation.
+    constexpr std::uint64_t MaxRecords = 65536; // At most one MiB of table data.
+    if (count > MaxRecords || count > (OffsetLimit - Offset) / 16) {
+        return {};
+    }
+    const std::uint64_t size = count * 16;
+    const std::uint64_t base = std::uint64_t{ud[0]} | (std::uint64_t{ud[1]} << 32);
+    if (!base || (base & 3) || base >= AddressLimit || Offset > AddressLimit - base ||
+        size > AddressLimit - base - Offset) {
+        return {};
+    }
+    return Range{base + Offset, static_cast<std::uint32_t>(size)};
+}
+} // namespace Vulkan::DreamsE165Reads
