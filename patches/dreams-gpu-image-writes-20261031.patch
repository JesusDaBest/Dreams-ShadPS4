+void TextureCache::CopyGpuFillToPartialImages(VAddr address, u32 size, vk::Buffer buffer,
+                                           u64 buffer_offset) {
+    CopyGpuWriteToPartialImages(address, size, buffer, buffer_offset, false);
+}
+
+void TextureCache::CopyGpuWriteToPartialImages(VAddr address, u32 size, vk::Buffer buffer,
+                                            u64 buffer_offset, bool invalidate_exact_base) {
+    if (!size || address > ~VAddr{0} - size || buffer_offset > ~u64{0} - size) {
+        return;
+    }
+    std::scoped_lock lock{mutex};
+    bool copied = false;
+    ForEachImageInRegion(address, size, [&](ImageId image_id, Image& image) {
+        if (!image.SafeToDownload() || image.backing->num_samples != 1 ||
+            image.backing->image.image_ci.format != image.info.pixel_format) {
+            if (invalidate_exact_base && image.info.guest_address == address) {
+                image.flags |= ImageFlagBits::GpuDirty;
+            }
+            return;
+        }
+        const auto copies = PlanPartialLinearFill(image.info, address, size, buffer_offset);
+        if (copies.empty()) {
+            if (invalidate_exact_base && image.info.guest_address == address) {
+                image.flags |= ImageFlagBits::GpuDirty;
+            }
+            return;
+        }
+        if (!copied) {
+            scheduler.EndRendering();
+            const vk::BufferMemoryBarrier2 barrier{
+                .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+                .dstStageMask = vk::PipelineStageFlagBits2::eCopy,
+                .dstAccessMask = vk::AccessFlagBits2::eTransferRead,
+                .buffer = buffer, .offset = buffer_offset, .size = size,
+            };
+            scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+                .bufferMemoryBarrierCount = 1, .pBufferMemoryBarriers = &barrier});
+            copied = true;
+        }
+        image.Transit(vk::ImageLayout::eTransferDstOptimal, vk::AccessFlagBits2::eTransferWrite, {});
+        scheduler.CommandBuffer().copyBufferToImage(buffer, image.GetImage(),
+                                                    vk::ImageLayout::eTransferDstOptimal, copies);
+        image.Transit(vk::ImageLayout::eGeneral,
+                      vk::AccessFlagBits2::eShaderRead | vk::AccessFlagBits2::eTransferRead, {});
+    });
+    if (copied) {
+        const vk::BufferMemoryBarrier2 barrier{
+            .srcStageMask = vk::PipelineStageFlagBits2::eCopy,
+            .srcAccessMask = vk::AccessFlagBits2::eTransferRead,
+            .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+            .buffer = buffer, .offset = buffer_offset, .size = size,
+        };
+        scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+            .bufferMemoryBarrierCount = 1, .pBufferMemoryBarriers = &barrier});
+    }
+}
+
+void TextureCache::PrepareImagesForGpuCopy(VAddr address, u32 size) {
+    if (!size || address > ~VAddr{0} - size) {
+        return;
+    }
+    std::scoped_lock lock{mutex};
+    ForEachImageInRegion(address, size, [&](ImageId image_id, Image& image) {
+        const VAddr start = image.info.guest_address;
+        const bool full = start >= address && start - address <= size &&
+                          image.info.guest_size <= size - (start - address);
+        if (start != address && !full) {
+            return;
+        }
+        // Keep a valid partial destination until the copy can patch its changed
+        // texels. Cached buffers are page-aligned, so the guest address has the
+        // same texel alignment as the eventual buffer offset.
+        if (!full && image.SafeToDownload() && image.backing->num_samples == 1 &&
+            image.backing->image.image_ci.format == image.info.pixel_format &&
+            !PlanPartialLinearFill(image.info, address, size, address).empty()) {
+            return;
+        }
+        // Full writes and unsupported partial layouts retain the old path.
+        if (TraceDreamsVolumeRefreshes() && IsDreamsVolumeTraceCandidate(image.info)) {
+            auto& stats = GetDreamsVolumeRefreshStats(image.info);
+            const u64 count = ++stats.gpu_invalidations;
+            LogDreamsVolumeCacheEvent(image, stats, "gpu-invalidate", count, address, size);
+        }
+        image.flags |= ImageFlagBits::GpuDirty;
+    });
+}
+
+void TextureCache::InvalidateImagesFullyWrittenByGPU(VAddr address, size_t size) {
+    std::scoped_lock lock{mutex};
+    ForEachImageInRegion(address, size, [&](ImageId image_id, Image& image) {
+        const VAddr start = image.info.guest_address;
+        if (start < address || start - address > size ||
+            image.info.guest_size > size - (start - address)) {
+            return;
+        }
+        if (TraceDreamsVolumeRefreshes() && IsDreamsVolumeTraceCandidate(image.info)) {
+            auto& stats = GetDreamsVolumeRefreshStats(image.info);
+            const u64 count = ++stats.gpu_invalidations;
+            LogDreamsVolumeCacheEvent(image, stats, "gpu-invalidate", count, address, size);
+        }
+        image.flags |= ImageFlagBits::GpuDirty;
+    });
+}
