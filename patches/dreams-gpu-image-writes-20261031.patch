+// Map a texel-aligned GPU fill onto only the visible pixels it covers. The
+// buffer can contain stale data outside that range; never upload it wholesale.
+static std::vector<vk::BufferImageCopy> PlanPartialLinearFill(
+    const ImageInfo& info, VAddr address, u64 size, u64 buffer_offset) {
+    if (!size || address > ~VAddr{0} - size ||
+        info.guest_address > ~VAddr{0} - info.guest_size ||
+        buffer_offset > ~u64{0} - size || !info.guest_size ||
+        info.props.is_tiled || info.props.is_block || info.props.is_volume ||
+        info.props.is_depth || info.props.has_stencil || info.num_samples != 1 ||
+        info.tile_mode != AmdGpu::TileMode::DisplayLinearAligned ||
+        info.array_mode != AmdGpu::ArrayMode::ArrayLinearAligned ||
+        info.alt_tile || info.bank_swizzle || info.size.depth != 1 ||
+        !info.size.width || !info.size.height || !info.resources.layers ||
+        !info.resources.levels || info.resources.levels > info.mips_layout.size()) {
+        return {};
+    }
+    u32 pixel_bytes{};
+    switch (info.pixel_format) {
+    case vk::Format::eR8G8B8A8Unorm: pixel_bytes = 4; break;
+    case vk::Format::eR16G16B16A16Sfloat:
+    case vk::Format::eR32G32Uint: pixel_bytes = 8; break;
+    case vk::Format::eR32G32B32A32Uint: pixel_bytes = 16; break;
+    default: return {};
+    }
+    if (info.num_bits != pixel_bytes * 8) {
+        return {};
+    }
+    const u64 begin = std::max(address, info.guest_address);
+    const u64 end = std::min(address + size, info.guest_address + info.guest_size);
+    if (begin >= end || (begin == info.guest_address &&
+                        end == info.guest_address + info.guest_size) ||
+        (begin - info.guest_address) % pixel_bytes ||
+        (end - info.guest_address) % pixel_bytes ||
+        (buffer_offset + (begin - address)) % pixel_bytes) {
+        return {};
+    }
+    std::vector<vk::BufferImageCopy> copies;
+    u64 previous_end{};
+    for (u32 level = 0; level < info.resources.levels; ++level) {
+        const auto& mip = info.mips_layout[level];
+        const u32 width = std::max(info.size.width >> level, 1u);
+        const u32 height = std::max(info.size.height >> level, 1u);
+        const u64 row_bytes = u64(mip.pitch) * pixel_bytes;
+        // Division guards keep validation overflow-free even for bad metadata.
+        if (mip.pitch < width || mip.height < height || !mip.size ||
+            mip.offset < previous_end || mip.offset % pixel_bytes || mip.offset > info.guest_size ||
+            mip.size > info.guest_size - mip.offset ||
+            row_bytes > mip.size / mip.height ||
+            row_bytes * mip.height != mip.size / info.resources.layers ||
+            mip.size % info.resources.layers) {
+            return {};
+        }
+        previous_end = u64(mip.offset) + mip.size;
+        const u64 layer_bytes = row_bytes * mip.height;
+        const u64 mip_address = info.guest_address + mip.offset;
+        if (begin >= mip_address + mip.size || end <= mip_address) {
+            continue;
+        }
+        const u32 first_layer = u32((std::max(begin, mip_address) - mip_address) / layer_bytes);
+        const u32 last_layer = u32((std::min(end, mip_address + mip.size) - 1 - mip_address) / layer_bytes);
+        for (u32 layer = first_layer; layer <= last_layer; ++layer) {
+            const u64 layer_address = mip_address + layer_bytes * layer;
+            const u32 first_row = u32((std::max(begin, layer_address) - layer_address) / row_bytes);
+            const u32 last_row = std::min(height - 1, u32(
+                (std::min(end, layer_address + layer_bytes) - 1 - layer_address) / row_bytes));
+            for (u32 y = first_row; y <= last_row; ++y) {
+                const u64 row_address = layer_address + u64(y) * row_bytes;
+                const u64 left = std::max(begin, row_address);
+                const u64 right = std::min(end, row_address + u64(width) * pixel_bytes);
+                if (left >= right) {
+                    continue;
+                }
+                const u32 x = u32((left - row_address) / pixel_bytes);
+                const u32 count = u32((right - left) / pixel_bytes);
+                const u64 offset = buffer_offset + (left - address);
+                if (!copies.empty()) {
+                    auto& last = copies.back();
+                    if (x == 0 && count == width && last.imageOffset.x == 0 &&
+                        last.imageExtent.width == width &&
+                        last.imageSubresource.mipLevel == level &&
+                        last.imageSubresource.baseArrayLayer == layer &&
+                        last.imageOffset.y + last.imageExtent.height == y &&
+                        last.bufferOffset + u64(last.imageExtent.height) * row_bytes == offset) {
+                        ++last.imageExtent.height;
+                        continue;
+                    }
+                }
+                copies.push_back(vk::BufferImageCopy{
+                    .bufferOffset = offset,
+                    .bufferRowLength = mip.pitch,
+                    .bufferImageHeight = mip.height,
+                    .imageSubresource = {vk::ImageAspectFlagBits::eColor, level, layer, 1},
+                    .imageOffset = {s32(x), s32(y), 0},
+                    .imageExtent = {count, 1, 1},
+                });
+            }
+        }
+    }
+    return copies;
+}
