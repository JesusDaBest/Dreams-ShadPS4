+
+constexpr u64 TraversalShader = 0xb535c6c8;
+constexpr u64 QueueProducerShader = 0x2bfebd3c;
+constexpr u64 QueueProducerShaderAlt = 0x692f0f7f;
+constexpr u64 CompactClassifyShader = 0xcbac06d2;
