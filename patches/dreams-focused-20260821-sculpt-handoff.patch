+struct DreamsSceneGraphicsBindingTraceKey {
+    u64 generation{};
+    u64 shader_hash{};
+    Shader::LogicalStage stage{};
+    u32 binding_index{};
+    VAddr base{};
+    u64 size{};
+
+    bool operator==(const DreamsSceneGraphicsBindingTraceKey&) const = default;
