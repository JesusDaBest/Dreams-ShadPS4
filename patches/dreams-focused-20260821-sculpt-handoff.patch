+                "Dreams {} stack #{} direct={} guest={:#x},{:#x},{:#x},{:#x},{:#x},{:#x},"
+                "{:#x},{:#x}",
+                api, trace_index, direct, guest_callers[0], guest_callers[1], guest_callers[2],
+                guest_callers[3], guest_callers[4], guest_callers[5], guest_callers[6],
+                guest_callers[7]);
+}
