+struct DreamsGraphicsPipelineTraceKey {
+    std::array<u64, Shader::MaxStageTypes> hashes{};
+    u32 primitive{};
+    u32 mrt_mask{};
+    bool indirect{};
+    bool indexed{};
+
+    bool operator==(const DreamsGraphicsPipelineTraceKey&) const = default;
+};
