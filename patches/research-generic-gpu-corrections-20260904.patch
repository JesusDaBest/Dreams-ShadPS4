diff --git a/src/video_core/buffer_cache/buffer_access_state.h b/src/video_core/buffer_cache/buffer_access_state.h
new file mode 100644
index 0000000..9c70cb2
--- /dev/null
+++ b/src/video_core/buffer_cache/buffer_access_state.h
@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: Copyright 2024 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cassert>
+#include <optional>
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace VideoCore {
+
+inline std::optional<vk::BufferMemoryBarrier2> GetBufferBarrier(
+    vk::Buffer buffer, u64 size_bytes, vk::AccessFlags2& access_mask,
+    vk::PipelineStageFlagBits2& stage, vk::AccessFlags2 dst_access_mask,
+    vk::PipelineStageFlagBits2 dst_stage, [[maybe_unused]] u32 offset = 0,
+    bool force_dependency = false) {
+    assert(offset < size_bytes);
+
+    constexpr auto write_flags = vk::AccessFlagBits2::eTransferWrite |
+                                 vk::AccessFlagBits2::eShaderWrite |
+                                 vk::AccessFlagBits2::eShaderStorageWrite |
+                                 vk::AccessFlagBits2::eHostWrite |
+                                 vk::AccessFlagBits2::eMemoryWrite;
+    const bool previous_access_writes = static_cast<bool>(access_mask & write_flags);
+    if (!force_dependency && !previous_access_writes && dst_access_mask == access_mask &&
+        stage == dst_stage) {
+        return {};
+    }
+
+    const auto barrier = vk::BufferMemoryBarrier2{
+        .srcStageMask = stage,
+        .srcAccessMask = access_mask,
+        .dstStageMask = dst_stage,
+        .dstAccessMask = dst_access_mask,
+        .buffer = buffer,
+        .offset = 0,
+        .size = size_bytes,
+    };
+    access_mask = dst_access_mask;
+    stage = dst_stage;
+    return barrier;
+}
+
+}
