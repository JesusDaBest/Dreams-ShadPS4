+constexpr std::string_view DREAMS_OFFLINE_ONLINE_ID = "DreamsOffline";
+constexpr OrbisNpAccountId DREAMS_OFFLINE_ACCOUNT_ID = 0x4301;
+
+static bool UseDreamsOfflineIdentity() {
+    const char* value = std::getenv("SHADPS4_DREAMS_FAKE_PSN");
+    return value == nullptr || *value == '\0' || std::string_view{value} == "1" ||
+           std::string_view{value} == "offline" || std::string_view{value} == "local";
+}
+
+static bool UseDreamsOnlineState() {
+    const char* value = std::getenv("SHADPS4_DREAMS_FAKE_PSN");
+    return value != nullptr && std::string_view{value} == "1";
+}
+
+static bool UseDreamsLocalAvailability() {
+    const char* value = std::getenv("SHADPS4_DREAMS_FAKE_PSN");
+    return value != nullptr && std::string_view{value} == "local";
+}
+
+static bool IsDreamsOfflineUser(Libraries::UserService::OrbisUserServiceUserId user_id) {
+    if (!UseDreamsOfflineIdentity() || g_shadnet_enabled ||
+        Common::ElfInfo::Instance().GameSerial() != DREAMS_TITLE_ID) {
+        return false;
+    }
+    const User* user = UserManagement.GetUserByID(user_id);
+    return user != nullptr && user->logged_in;
+}
+
+static bool IsEffectiveSignedIn(Libraries::UserService::OrbisUserServiceUserId user_id) {
+    return IsDreamsOfflineUser(user_id) ||
+           (g_shadnet_enabled &&
+            Libraries::Np::NpHandler::GetInstance().IsPsnSignedIn(user_id));
+}
+
+static bool IsEffectiveNetworkSignedIn(
+    Libraries::UserService::OrbisUserServiceUserId user_id) {
+    if (IsDreamsOfflineUser(user_id)) {
+        return UseDreamsOnlineState();
+    }
+    return g_shadnet_enabled &&
+           Libraries::Np::NpHandler::GetInstance().IsPsnSignedIn(user_id);
+}
+
+static OrbisNpId GetEffectiveNpId(Libraries::UserService::OrbisUserServiceUserId user_id) {
+    if (IsDreamsOfflineUser(user_id)) {
+        OrbisNpId np_id{};
+        SetNpId(np_id, DREAMS_OFFLINE_ONLINE_ID);
+        return np_id;
+    }
+    return Libraries::Np::NpHandler::GetInstance().GetNpId(user_id);
+}
+
+static OrbisNpAccountId
+GetEffectiveAccountId(Libraries::UserService::OrbisUserServiceUserId user_id) {
+    return IsDreamsOfflineUser(user_id)
+               ? DREAMS_OFFLINE_ACCOUNT_ID
+               : Libraries::Np::NpHandler::GetInstance().GetAccountId(user_id);
+}
+
+static Libraries::UserService::OrbisUserServiceUserId GetDreamsOfflineUserId() {
+    if (!UseDreamsOfflineIdentity() || g_shadnet_enabled ||
+        Common::ElfInfo::Instance().GameSerial() != DREAMS_TITLE_ID) {
+        return Libraries::UserService::ORBIS_USER_SERVICE_USER_ID_INVALID;
+    }
+    for (const User* user : UserManagement.GetLoggedInUsers()) {
+        if (user != nullptr) {
+            return user->user_id;
+        }
+    }
+    return Libraries::UserService::ORBIS_USER_SERVICE_USER_ID_INVALID;
+}
+
+static Libraries::UserService::OrbisUserServiceUserId
+GetEffectiveUserIdByOnlineId(const OrbisNpOnlineId& online_id) {
+    OrbisNpOnlineId offline_id{};
+    SetNpOnlineId(offline_id, DREAMS_OFFLINE_ONLINE_ID);
+    if (std::memcmp(&online_id, &offline_id, sizeof(online_id)) == 0) {
+        const auto user_id = GetDreamsOfflineUserId();
+        if (user_id != Libraries::UserService::ORBIS_USER_SERVICE_USER_ID_INVALID) {
+            return user_id;
+        }
+    }
+    return Libraries::Np::NpHandler::GetInstance().GetUserIdByOnlineId(online_id);
+}
