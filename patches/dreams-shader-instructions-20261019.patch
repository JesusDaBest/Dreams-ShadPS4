+        return u32(std::min(bytes,declared_size));
+    }
+    if(hash==0xd9a5eaaf){
+        // Four current-IR stores cover one 48-byte record per global X invocation.
+        if(binding!=0||sharp_idx!=53||stride!=48)return {};
+        const u64 bytes=u64(c.groups_x)*64*48;
+        if(bytes>0xffffffffull)return {};
+        return u32(std::min(bytes,declared_size));
+    }
+    struct Entry{u32 binding,sharp_idx,stride;};
+    constexpr std::array<Entry,6> entries{{{0,88,16},{1,92,16},{2,96,12},{3,100,16},{9,124,16},{16,152,16}}};
+    for(const auto& e:entries)if(e.binding==binding){
+        if(sharp_idx!=e.sharp_idx||stride!=e.stride)return {};
+        const u64 bytes=u64(c.groups_x)*64*stride;
+        if(bytes>0xffffffffull)return {}; // Keep guest 32-bit index arithmetic non-wrapping.
+        return u32(std::min(bytes,declared_size)); // Conservatively include vec3 record padding.
+    }
+    return {};
+}
