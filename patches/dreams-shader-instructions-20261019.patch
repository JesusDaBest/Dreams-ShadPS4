+// Opt-in source recorder only. Exact existing GPU bindings, no guest writes.
+namespace SourceGenerationCapture {
+constexpr u64 MaxBufferBytes = 64_MB, MaxCaptureBytes = 256_MB;
+static bool IsInput(u32 index) {
+    // Include packed surface attributes, lookup, source field, and input keys.
+    return index == 4 || (index >= 6 && index <= 14);
+}
+static bool Save(Scheduler& scheduler, VideoCore::BufferCache& cache,
+                 vk::DescriptorBufferInfo binding, u64 declared, u64& used,
+                 const std::filesystem::path& path, u64 budget = MaxCaptureBytes) {
+    if (!declared || declared > MaxBufferBytes || !binding.buffer ||
+        binding.range == VK_WHOLE_SIZE || binding.range < declared ||
+        budget > 384_MB || used > budget || declared > budget - used ||
+        binding.offset > std::numeric_limits<u64>::max() - binding.range) return false;
+    const u64 adjustment = binding.range - declared;
+    std::vector<u8> data(static_cast<size_t>(declared));
+    used += declared;
+    for (u64 offset = 0; offset < declared; offset += 16_MB) {
+        const u64 bytes = std::min<u64>(16_MB, declared - offset);
+        if (!ReadDreamsBoundBufferForCapture(scheduler, cache, binding,
+                adjustment + offset, std::span<u8>{data}.subspan(offset, bytes))) return false;
+    }
+    u64 hash{};
+    return WriteDreamsCaptureBytes(path, data, hash);
+}
+} // namespace SourceGenerationCapture
