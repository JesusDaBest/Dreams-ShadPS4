+        exception->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+        exception->ExceptionRecord->NumberParameters < 2 ||
+        exception->ExceptionRecord->ExceptionInformation[0] != 0) return false;
