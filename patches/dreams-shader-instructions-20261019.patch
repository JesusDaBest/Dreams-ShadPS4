+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// 84aa checkpoints every source before any in-place destination store. Oversized dispatches
+// must retain that property: interleaving collect/replay chunks can destroy unread sources.
+// Use a private backing for this dispatch's counter and checkpoints, then publish only the
+// guest counter. No other GDS contents are copied or replaced.
+namespace DreamsLargeSculptCopy {
+constexpr u32 MaxGroups = 65535; // Guaranteed direct-dispatch X limit, below the prefix limit.
+constexpr u64 CounterOffset = u64{Shader::DreamsCompat::SculptOrderedCounterIndex} * sizeof(u32);
+
+constexpr u64 StorageBytes(u32 groups) {
+    return groups != 0 && groups <= MaxGroups
+               ? (u64{Shader::DreamsCompat::SculptOrderedStateBaseDword} +
+                  u64{groups} * Shader::DreamsCompat::SculptOrderedStateDwordsPerWorkgroup) *
+                     sizeof(u32)
+               : 0;
+}
+static_assert(StorageBytes(MaxGroups) < 128ULL * 1024 * 1024);
+static_assert(Shader::DreamsCompat::OrderedScratchStreamBaseDword(
+                  Shader::DreamsCompat::SculptOrderedScratchStream) +
+                  u64{MaxGroups} * Shader::DreamsCompat::OrderedEntryDwords <=
+              Shader::DreamsCompat::SculptOrderedStateBaseDword);
+
+template <typename BindPhase, typename Scan>
+void Run(vk::CommandBuffer cmd, vk::Buffer guest_gds, vk::Buffer private_gds, u32 groups,
+         BindPhase&& bind_phase, Scan&& scan) {
+    const auto barrier = [&](vk::PipelineStageFlags2 src_stage, vk::AccessFlags2 src_access,
+                             vk::PipelineStageFlags2 dst_stage, vk::AccessFlags2 dst_access) {
+        const vk::MemoryBarrier2 memory{
+            .srcStageMask = src_stage,
+            .srcAccessMask = src_access,
+            .dstStageMask = dst_stage,
+            .dstAccessMask = dst_access,
+        };
+        cmd.pipelineBarrier2(vk::DependencyInfo{.memoryBarrierCount = 1,
+                                               .pMemoryBarriers = &memory});
+    };
+    constexpr auto Compute = vk::PipelineStageFlagBits2::eComputeShader;
+    constexpr auto Transfer = vk::PipelineStageFlagBits2::eTransfer;
+    constexpr auto ReadWrite = vk::AccessFlagBits2::eShaderStorageRead |
+                               vk::AccessFlagBits2::eShaderStorageWrite;
+    const vk::BufferCopy counter_copy{.srcOffset = CounterOffset,
+                                      .dstOffset = CounterOffset,
+                                      .size = sizeof(u32)};
+
+    barrier(vk::PipelineStageFlagBits2::eAllCommands, vk::AccessFlagBits2::eMemoryWrite,
+            Transfer, vk::AccessFlagBits2::eTransferRead);
+    cmd.copyBuffer(guest_gds, private_gds, counter_copy);
+    barrier(Transfer, vk::AccessFlagBits2::eTransferWrite, Compute, ReadWrite);
+
+    bind_phase(Shader::DreamsCompat::OrderedPhaseCollect);
+    cmd.dispatch(groups, 1, 1);
+    // Includes the image and byte-record source reads, as well as checkpoint writes.
+    barrier(Compute, ReadWrite, Compute, ReadWrite);
+    scan();
+    barrier(Compute, vk::AccessFlagBits2::eShaderStorageWrite, Compute,
+            vk::AccessFlagBits2::eShaderStorageRead);
+    bind_phase(Shader::DreamsCompat::OrderedPhaseReplay);
+    cmd.dispatch(groups, 1, 1);
+
+    barrier(vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+            Transfer, vk::AccessFlagBits2::eTransferRead | vk::AccessFlagBits2::eTransferWrite);
+    cmd.copyBuffer(private_gds, guest_gds, counter_copy);
+    barrier(Transfer, vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite);
+}
+// Each buffer contains at most MaxGroups checkpoints. All segments finish collecting before
+// the first replay, so in-place compaction cannot destroy a later segment's unread sources.
+// The prefix counter is carried between segments; only its final value is published to GDS.
+template <typename BindPhase, typename Scan>
+void RunSegmented(vk::CommandBuffer cmd, vk::Buffer guest_gds,
+                  std::span<const vk::Buffer> segments, u32 groups,
+                  BindPhase&& bind_phase, Scan&& scan) {
+    const auto barrier = [&](vk::PipelineStageFlags2 src_stage, vk::AccessFlags2 src_access,
+                             vk::PipelineStageFlags2 dst_stage, vk::AccessFlags2 dst_access) {
+        const vk::MemoryBarrier2 memory{.srcStageMask = src_stage, .srcAccessMask = src_access,
+                                        .dstStageMask = dst_stage, .dstAccessMask = dst_access};
+        cmd.pipelineBarrier2(vk::DependencyInfo{.memoryBarrierCount = 1,
+                                               .pMemoryBarriers = &memory});
+    };
+    constexpr auto Compute = vk::PipelineStageFlagBits2::eComputeShader;
+    constexpr auto Transfer = vk::PipelineStageFlagBits2::eTransfer;
+    constexpr auto ReadWrite = vk::AccessFlagBits2::eShaderStorageRead |
+                               vk::AccessFlagBits2::eShaderStorageWrite;
+    const vk::BufferCopy counter_copy{.srcOffset = CounterOffset,
+                                      .dstOffset = CounterOffset, .size = sizeof(u32)};
+    barrier(vk::PipelineStageFlagBits2::eAllCommands, vk::AccessFlagBits2::eMemoryWrite,
+            Transfer, vk::AccessFlagBits2::eTransferRead);
+    for (u32 segment = 0, base = 0; base < groups; ++segment) {
+        const u32 count = std::min(MaxGroups, groups - base);
+        cmd.copyBuffer(segment == 0 ? guest_gds : segments[segment - 1], segments[segment],
+                       counter_copy);
+        barrier(Transfer, vk::AccessFlagBits2::eTransferWrite, Compute, ReadWrite);
+        bind_phase(Shader::DreamsCompat::OrderedPhaseCollect, segment, base, count);
+        cmd.dispatch(count, 1, 1);
+        barrier(Compute, ReadWrite, Compute, ReadWrite);
+        scan(segment, count);
+        barrier(Compute, vk::AccessFlagBits2::eShaderStorageWrite,
+                Transfer, vk::AccessFlagBits2::eTransferRead);
+        base += count;
+    }
+    barrier(Compute, vk::AccessFlagBits2::eShaderStorageWrite, Compute,
+            vk::AccessFlagBits2::eShaderStorageRead);
+    for (u32 segment = 0, base = 0; base < groups; ++segment) {
+        const u32 count = std::min(MaxGroups, groups - base);
+        bind_phase(Shader::DreamsCompat::OrderedPhaseReplay, segment, base, count);
+        cmd.dispatch(count, 1, 1);
+        base += count;
+    }
+    barrier(vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+            Transfer, vk::AccessFlagBits2::eTransferRead | vk::AccessFlagBits2::eTransferWrite);
+    cmd.copyBuffer(segments.back(), guest_gds, counter_copy);
+    barrier(Transfer, vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite);
+}
+
