+// Observe the reachable hierarchy, including children rejected by the selector.
+// Uses only already-bound GPU buffers; no guest data or selection is changed.
+constexpr u32 MaxHierarchyBricks = 32768;
+
+static std::vector<u32> Hierarchy(Session& session, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo children,
+    vk::DescriptorBufferInfo metadata, vk::DescriptorBufferInfo positions,
+    std::span<const u32> roots) {
+    if (roots.empty() || roots.size() > 16 || children.range == VK_WHOLE_SIZE ||
+        metadata.range == VK_WHOLE_SIZE || positions.range == VK_WHOLE_SIZE) {
+        session.ok = false;
+        session.metadata += "hierarchy_failed\tinvalid-roots-or-binding\n";
+        return {};
+    }
+    const u64 capacity = std::min({children.range / 24, metadata.range / 16,
+                                  positions.range / 4, u64{1048576}});
+    std::vector<u8> seen(static_cast<size_t>(capacity));
+    std::vector<u8> levels(static_cast<size_t>(capacity), 16);
+    std::vector<std::pair<u32,u32>> links_to_check;
+    std::vector<u32> all, pending = Unique({roots.begin(), roots.end()});
+    std::vector<u32> parent_level(pending.size(), 16);
+    std::string edges = "parent\tslot\tchild\tparent_level\n";
+    for (u32 depth = 0; !pending.empty() && depth < 16; ++depth) {
+        std::vector<u32> next, next_parent;
+        for (size_t first = 0; first < pending.size(); first += MaxBricks) {
+            const size_t count = std::min<size_t>(MaxBricks, pending.size() - first);
+            const std::span<const u32> batch{pending.data() + first, count};
+            for (u32 id : batch) {
+                if (id >= capacity || all.size() >= MaxHierarchyBricks) {
+                    session.ok = false;
+                    session.metadata += "hierarchy_failed\tinvalid-index-or-node-budget\n";
+                    return {};
+                }
+                all.push_back(id);
+                seen[id] = 1;
+            }
+            const auto prefix = fmt::format("hierarchy-{:02}-{:03}", depth, first / MaxBricks);
+            const auto pos = Records(session, prefix + "-positions", scheduler, cache,
+                                     positions, 0, batch, 4);
+            const auto meta = Records(session, prefix + "-metadata", scheduler, cache,
+                                      metadata, 0, batch, 16);
+            const auto links = Records(session, prefix + "-children", scheduler, cache,
+                                       children, 0, batch, 24);
+            if (pos.size() != count * 4 || meta.size() != count * 16 || links.size() != count * 24)
+                return {};
+            for (size_t n = 0; n < count; ++n) {
+                const u32 level = (Word(pos, n) >> 27) & 15;
+                levels[batch[n]] = static_cast<u8>(level);
+                if (level >= parent_level[first + n]) {
+                    session.ok = false;
+                    session.metadata += "hierarchy_failed\tnon-decreasing-child-level\n";
+                    return {};
+                }
+                if (!level) continue;
+                for (u32 slot = 0; slot < 8; ++slot) {
+                    const size_t at = n * 24 + slot * 3;
+                    const u32 child = u32{links[at]} | (u32{links[at + 1]} << 8) |
+                                      (u32{links[at + 2]} << 16);
+                    if (child & 0x800000) continue; // Same empty-child test as the guest shader.
+                    edges += fmt::format("{}\t{}\t{}\t{}\n", batch[n], slot, child, level);
+                    if (child >= capacity) {
+                        session.ok = false;
+                        session.metadata += "hierarchy_failed\tchild-out-of-range\n";
+                        return {};
+                    }
+                    links_to_check.emplace_back(batch[n], child);
+                    if (!seen[child]) {
+                        if (all.size() + next.size() >= MaxHierarchyBricks) {
+                            session.ok = false;
+                            session.metadata += "hierarchy_failed\tnode-budget\n";
+                            return {};
+                        }
+                        seen[child] = 1;
+                        next.push_back(child);
+                        next_parent.push_back(level);
+                    }
+                }
+            }
+        }
+        pending = std::move(next);
+        parent_level = std::move(next_parent);
+    }
+    if (!pending.empty()) {
+        session.ok = false;
+        session.metadata += "hierarchy_failed\tdepth-budget\n";
+        return {};
+    }
+    for (const auto& [parent, child] : links_to_check) {
+        if (levels[child] >= levels[parent]) {
+            session.ok = false;
+            session.metadata += "hierarchy_failed\tnon-decreasing-shared-child-level\n";
+            return {};
+        }
+    }
+    session.ok &= WriteDreamsCaptureText(session.output / "hierarchy-edges.tsv", edges);
+    session.metadata += fmt::format("hierarchy_complete\t{}\tnodes\t{}\n", session.ok, all.size());
+    return session.ok ? Unique(std::move(all)) : std::vector<u32>{};
+}
+
+static void HierarchyCells(Session& session, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo cells, std::span<const u32> ids) {
+    for (size_t first = 0; first < ids.size(); first += MaxBricks) {
