+// Bounded private diagnostic. Does not change submission order or add render-time waits.
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <limits>
+
+namespace Vulkan::DreamsSubmissionSpan {
+using Word = std::uint64_t;
+inline constexpr std::size_t Capacity = 512;
+inline Word Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_SUBMISSION_SPAN_DIR");
+        return value ? std::filesystem::path{value} : std::filesystem::path{};
+    }();
+    return path;
+}
+struct Entry {
+    Word tick{}, begin_ns{}, submit_enter_ns{}, queue_enter_ns{}, queue_return_ns{}, submit_return_ns{};
+    Word known_before{}, known_after{}, wait_count{}, signal_count{};
+    std::array<Word, 2> wait_handles{}, wait_values{};
+    Word gpu_begin{}, gpu_end{};
+    int result{};
+    bool available{};
+};
+struct State {
+    vk::Device device;
+    vk::UniqueQueryPool pool;
+    std::array<Entry, Capacity> entries{};
+    Word owner{}, deadline{}, last_submitted{};
+    std::size_t count{};
+    unsigned valid_bits{};
+    double period_ns{};
+    bool stopped{}, reported{};
+};
+class Recorder {
+public:
+    using Token = Entry*;
+    template <typename Instance>
+    void Begin(const Instance& instance, Word owner, vk::CommandBuffer command,
+               Word tick, bool allowed) {
+        if (!allowed || Root().empty() || (state && state->stopped)) return;
+        try {
+            const Word now = Now();
+            if (!state) {
+                if (now < next_check) return;
+                next_check = now + 100'000'000;
+                std::error_code error;
+                if (!std::filesystem::exists(Root() / "arm.request", error)) return;
+                state = std::make_unique<State>();
+                state->owner = owner;
+                state->device = instance.GetDevice();
+                const auto physical = instance.GetPhysicalDevice();
+                const auto families = physical.getQueueFamilyProperties();
+                const auto family = instance.GetGraphicsQueueFamilyIndex();
+                if (family >= families.size() || !families[family].timestampValidBits) {
+                    state->stopped = true;
+                    Report("timestamps-unsupported");
+                    return;
+                }
+                state->valid_bits = families[family].timestampValidBits;
+                state->period_ns = physical.getProperties().limits.timestampPeriod;
+                auto [result, pool] = state->device.createQueryPoolUnique(vk::QueryPoolCreateInfo{
+                    .queryType = vk::QueryType::eTimestamp, .queryCount = Capacity * 2});
+                if (result != vk::Result::eSuccess) {
+                    state->stopped = true;
+                    Report("allocation-failed");
+                    return;
+                }
+                state->pool = std::move(pool);
+                state->deadline = now + 1'000'000'000;
+            }
+            if (now >= state->deadline || state->count == Capacity) {
+                state->stopped = true;
+                return;
+            }
+            current = &state->entries[state->count];
+            *current = Entry{.tick = tick, .begin_ns = now};
+            command.resetQueryPool(*state->pool, state->count * 2, 2);
+            command.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe,
+                                   *state->pool, state->count * 2);
+        } catch (...) {
+            // Allocation / filesystem failure happens before recording query commands.
+            if (state && !state->count) {
+                current = nullptr;
+                state->stopped = true;
+                Report("setup-failed");
+            }
+        }
+    }
+    Token EnterSubmit() {
+        if (current) current->submit_enter_ns = Now();
+        return current;
+    }
+    // Called after the existing EndRendering, before ending this command buffer.
+    void End(vk::CommandBuffer command, Token token) {
+        if (!token) return;
+        command.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe,
+                               *state->pool, state->count * 2 + 1);
+        ++state->count;
+        current = nullptr;
+        if (state->count == Capacity || Now() >= state->deadline) state->stopped = true;
+    }
+    void EnterQueue(Token token, Word known, unsigned waits, unsigned signals,
+                    const vk::Semaphore* handles, const Word* values) {
+        if (!token) return;
+        token->known_before = known;
+        token->wait_count = waits;
+        token->signal_count = signals;
+        for (unsigned i = 0; i < waits && i < token->wait_handles.size(); ++i) {
+            token->wait_handles[i] = reinterpret_cast<Word>(static_cast<VkSemaphore>(handles[i]));
+            token->wait_values[i] = values[i];
+        }
+        token->queue_enter_ns = Now();
+    }
+    void ReturnQueue(Token token, int result) {
+        if (!token) return;
+        token->queue_return_ns = Now();
+        token->result = result;
+        if (result == int(vk::Result::eSuccess)) state->last_submitted = token->tick;
+    }
+    void ReturnSubmit(Token token, Word known) {
+        if (token) {
+            token->submit_return_ns = Now();
+            token->known_after = known;
+        }
+        Collect(known);
+    }
+    // Only consumes already completed queries. No QUERY_RESULT_WAIT or extra semaphore refresh.
+    void Collect(Word known) {
+        if (!state || !state->stopped || state->reported || known < state->last_submitted) return;
+        if (state->pool && state->count) {
+            std::array<Word, Capacity * 4> values{};
+            const auto result = state->device.getQueryPoolResults(*state->pool, 0,
+                state->count * 2, state->count * 4 * sizeof(Word), values.data(), sizeof(Word) * 2,
+                vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+            for (std::size_t i = 0; i < state->count; ++i) {
+                auto& e = state->entries[i];
+                e.available = result == vk::Result::eSuccess && values[i * 4 + 1] && values[i * 4 + 3];
+                if (e.available) { e.gpu_begin = values[i * 4]; e.gpu_end = values[i * 4 + 2]; }
+            }
+        }
+        Report("complete");
+    }
+    // Scheduler destruction only: do not free queries while submitted commands still reference them.
+    template <typename Master>
+    void Shutdown(Master& master) {
+        if (!state || !state->pool) return;
+        if (state->last_submitted && !master.IsFree(state->last_submitted)) master.Wait(state->last_submitted);
+        state->stopped = true;
+        // A begun, unsubmitted batch is intentionally excluded from the query count.
+        current = nullptr;
+        Collect(master.KnownGpuTick());
+    }
+#ifdef DREAMS_SUBMISSION_SPAN_TESTING
+    const State* Inspect() const { return state.get(); }
+    void ExpireForTest() { if (state) state->deadline = 0; }
+#endif
+private:
+    void Report(const char* reason) noexcept {
+        state->reported = true;
+        state->pool.reset();
+        try {
+            const auto name = std::to_string(state->owner);
+            std::ofstream out(Root() / ("submissions-" + name + ".tsv"));
+            out << "tick\tbegin_ns\tsubmit_enter_ns\tqueue_enter_ns\tqueue_return_ns\tsubmit_return_ns"
+                   "\tknown_before\tknown_after\twaits\tsignals\twait0\tvalue0\twait1\tvalue1"
+                   "\tgpu_begin\tgpu_end\tresult\tavailable\n";
+            for (std::size_t i = 0; i < state->count; ++i) {
+                const auto& e = state->entries[i];
+                out << e.tick << '\t' << e.begin_ns << '\t' << e.submit_enter_ns << '\t'
+                    << e.queue_enter_ns << '\t' << e.queue_return_ns << '\t' << e.submit_return_ns
+                    << '\t' << e.known_before << '\t' << e.known_after << '\t' << e.wait_count
+                    << '\t' << e.signal_count << '\t' << e.wait_handles[0] << '\t' << e.wait_values[0]
+                    << '\t' << e.wait_handles[1] << '\t' << e.wait_values[1] << '\t' << e.gpu_begin
+                    << '\t' << e.gpu_end << '\t' << e.result << '\t' << e.available << '\n';
+            }
+            out.flush();
+            if (!out) return;
+            std::ofstream done(Root() / ("complete-" + name + ".txt"));
+            done.precision(17);
+            done << "reason=" << reason << "\nentries=" << state->count
+                 << "\ntimestamp_valid_bits=" << state->valid_bits
+                 << "\ntimestamp_period_ns=" << state->period_ns
+                 << "\nadditional_render_submissions=0\nadditional_render_waits=0\n"
+                 << "clocks_calibrated=false\nspans_include_dependency_waits=true\n";
+        } catch (...) {}
+    }
+    std::unique_ptr<State> state;
+    Token current{};
+    Word next_check{};
+};
+} // namespace Vulkan::DreamsSubmissionSpan
