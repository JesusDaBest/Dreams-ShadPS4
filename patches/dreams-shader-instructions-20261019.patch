+// Read the existing completed-update counter, never presentation or GPU timing.
+// The signature restricts this to the verified Dreams executable layout.
+#ifdef _WIN32
+static void DrawDreamsGameFps() {
+    if (MemoryPatcher::g_game_serial != "CUSA04301") {
+        return;
+    }
+    struct State {
+        uintptr_t base{};
+        double next_sample{}, window_start{};
+        u64 count{};
+        double fps{};
+        bool verified{}, have_count{}, have_rate{};
+    };
+    static State state;
+    const auto base = MemoryPatcher::g_eboot_address;
+    const double now = GetTime();
+    if (base != state.base) {
+        state = {};
+        state.base = base;
+    }
+    if (base && now >= state.next_sample) {
+        state.next_sample = now + 0.25;
+        const auto read = [](uintptr_t address, void* data, size_t size) {
+            SIZE_T copied{};
+            return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(address),
+                                     data, size, &copied) && copied == size;
+        };
+        if (!state.verified) {
+            // inc qword ptr [rip+...] at the completed-update accounting site.
+            constexpr std::array<u8, 16> expected = {
+                0x48,0xff,0x05,0x76,0xad,0xc5,0x03,0x45,
+                0x84,0xf6,0x74,0x19,0x48,0x8d,0x3d,0x32};
+            std::array<u8, 16> actual{};
+            state.verified = read(base + 0x8fd90b, actual.data(), actual.size()) &&
+                             actual == expected;
+        }
+        u64 count{};
+        if (state.verified && read(base + 0x4558688, &count, sizeof(count))) {
+            if (!state.have_count || count < state.count || now < state.window_start) {
+                state.count = count;
+                state.window_start = now;
+                state.have_count = true;
+                state.have_rate = false;
+            } else if (now - state.window_start >= 1.0) {
+                state.fps = static_cast<double>(count - state.count) / (now - state.window_start);
+                state.have_rate = true;
+                state.count = count;
+                state.window_start = now;
+            }
+        } else {
+            state.have_count = state.have_rate = false;
+        }
+    }
+    if (state.have_rate) {
+        Text("Game: %.1f FPS", state.fps);
+    } else {
+        TextUnformatted("Game: -- FPS");
+    }
+    if (IsItemHovered()) {
+        SetTooltip("Dreams completed gameplay updates per second.\n"
+                   "Measured separately from emulator rendering FPS.");
+    }
+}
