+// Diagnostic only: exact R8 blocks written by one existing GatherVoxels dispatch.
+namespace SourceDensityOutput {
+constexpr u32 MaxGroups = 4096;
+constexpr u64 MaxBytes = u64{MaxGroups} * 512;
+struct Block { u32 group, logical, physical; };
+static bool Plan(std::span<const u16> lookup, u32 start, u32 groups,
+                 std::vector<Block>& blocks, std::vector<vk::BufferImageCopy>& copies) {
+    if (!groups || groups > MaxGroups || start > UINT32_MAX - (groups - 1) ||
+        (u64{start} + groups - 1) / 64 >= lookup.size()) return false;
+    std::vector<Block> planned;
+    std::vector<vk::BufferImageCopy> regions;
+    for (u32 i = 0; i < groups; ++i) {
+        const u32 logical = start + i;
+        const u32 physical = u32{lookup[logical >> 6]} * 64 + (logical & 63);
+        // The atlas has 256 * 256 * 16 bricks. Never wrap an invalid allocation.
+        if (physical >= 256 * 256 * 16) return false;
+        planned.push_back({i, logical, physical});
+        regions.push_back(vk::BufferImageCopy{
+            .bufferOffset = u64{i} * 512,
+            .imageSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+            .imageOffset = {s32((physical & 255) * 8),
+                            s32(((physical >> 8) & 255) * 8), s32((physical >> 16) * 8)},
+            .imageExtent = {8, 8, 8}});
+    }
+    blocks = std::move(planned);
+    copies = std::move(regions);
+    return true;
+}
+
+static bool Save(Scheduler& scheduler, VideoCore::BufferCache& cache, auto& image,
+                 std::span<const u16> lookup, u32 start, u32 groups, u64& used,
+                 const std::filesystem::path& output) {
+    std::vector<Block> blocks;
+    std::vector<vk::BufferImageCopy> copies;
+    if (!Plan(lookup, start, groups, blocks, copies)) return false;
+    const u64 bytes = u64{groups} * 512;
+    if (used > 256_MB || bytes > 256_MB - used ||
+        image.info.pixel_format != vk::Format::eR8Unorm || image.info.num_bits != 8 ||
+        image.info.size.width != 2048 || image.info.size.height != 2048 ||
+        image.info.size.depth != 128 || image.info.resources.levels != 1 ||
+        image.info.resources.layers != 1 || image.info.num_samples != 1 ||
+        image.info.props.is_block || image.info.props.is_depth || image.info.props.has_stencil ||
+        image.backing->subresource_states.size() > 1 ||
+        image.backing->image.image_ci.samples != vk::SampleCountFlagBits::e1 ||
+        image.backing->image.image_ci.extent != vk::Extent3D{2048, 2048, 128}) return false;
+    scheduler.EndRendering();
+    auto& download = cache.GetUtilityBuffer(VideoCore::MemoryUsage::Download);
+    const auto [data, offset] = download.Map(bytes, 4);
+    if (!data) return false;
+    download.Commit();
+    const auto saved = image.backing->state;
+    const auto saved_subresources = image.backing->subresource_states;
+    for (auto& copy : copies) copy.bufferOffset += offset;
+    image.Download(copies, download.Handle(), offset, bytes);
+    const auto& restore = saved_subresources.empty() ? saved : saved_subresources[0];
+    const auto barriers = image.GetBarriers(restore.layout, restore.access_mask,
+                                           restore.pl_stage, std::nullopt);
+    if (!barriers.empty()) scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+        .imageMemoryBarrierCount = static_cast<u32>(barriers.size()),
+        .pImageMemoryBarriers = barriers.data()});
+    image.backing->state = saved;
+    image.backing->subresource_states = saved_subresources;
+    scheduler.Finish();
+    download.InvalidateMappedRange(offset, bytes);
+    used += bytes;
+    u64 hash{};
+    bool ok = WriteDreamsCaptureBytes(output / "density-r8.bin",
+        std::span<const u8>{data, static_cast<size_t>(bytes)}, hash);
+    std::string rows{"group\tlogical\tphysical\tfile_offset\n"};
+    for (const auto& block : blocks) rows += fmt::format("{}\t{}\t{}\t{}\n",
+        block.group, block.logical, block.physical, u64{block.group} * 512);
+    ok &= WriteDreamsCaptureText(output / "density-r8-blocks.tsv", rows);
+    ok &= WriteDreamsCaptureText(output / "density-r8-status.tsv", fmt::format(
+        "complete\t{}\ngroups\t{}\nstart\t{}\nbytes\t{}\nhash\t{:#x}\n"
+        "boundary\timmediately-after-existing-direct-dispatch\n", ok, groups, start, bytes, hash));
+    return ok;
+}
