+static std::vector<u8> Records(Session& session, std::string_view name, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, vk::DescriptorBufferInfo binding, u64 adjustment,
+    std::span<const u32> ids, u32 stride) {
+    std::vector<u8> data;
