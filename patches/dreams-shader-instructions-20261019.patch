+    const U32 exponent{ir.BitwiseAnd(bits, ir.Imm32(0x7f800000U))};
+    const U32 fraction{ir.BitwiseAnd(bits, ir.Imm32(0x007fffffU))};
+    const U1 sign = ir.INotEqual(ir.BitwiseAnd(bits, ir.Imm32(0x80000000U)), ir.Imm32(0));
+    const U1 exponent_zero = ir.IEqual(exponent, ir.Imm32(0));
+    const U1 exponent_full = ir.IEqual(exponent, ir.Imm32(0x7f800000U));
+    const U1 fraction_zero = ir.IEqual(fraction, ir.Imm32(0));
+    const U1 quiet = ir.INotEqual(ir.BitwiseAnd(fraction, ir.Imm32(0x00400000U)), ir.Imm32(0));
+    const U32 normal_class{ir.Select(sign, ir.Imm32(3), ir.Imm32(8))};
+    const U32 subnormal_class{ir.Select(sign, ir.Imm32(4), ir.Imm32(7))};
+    const U32 zero_class{ir.Select(sign, ir.Imm32(5), ir.Imm32(6))};
+    const U32 infinity_class{ir.Select(sign, ir.Imm32(2), ir.Imm32(9))};
+    const U32 nan_class{ir.Select(quiet, ir.Imm32(1), ir.Imm32(0))};
+    const U32 low_exponent_class{ir.Select(fraction_zero, zero_class, subnormal_class)};
+    const U32 high_exponent_class{ir.Select(fraction_zero, infinity_class, nan_class)};
+    const U32 finite_class{ir.Select(exponent_zero, low_exponent_class, normal_class)};
