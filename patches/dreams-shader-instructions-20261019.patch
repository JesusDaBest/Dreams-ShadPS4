+// Private, bounded diagnostic. The caller retains its existing synchronous Finish.
+// Include after Vulkan types are available. No asynchronous download is instrumented.
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+
+namespace Vulkan::DreamsReadbackGpuSpan {
+using Word = std::uint64_t;
+using Clock = std::chrono::steady_clock;
+inline constexpr std::size_t Capacity = 64;
+
+inline Word Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+}
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_READBACK_GPU_SPAN_DIR");
+        return value ? std::filesystem::path{value} : std::filesystem::path{};
+    }();
+    return path;
+}
+inline Word TimestampDelta(Word first, Word last, unsigned bits) {
+    if (!bits || bits > 64) return 0;
+    const Word mask = bits == 64 ? std::numeric_limits<Word>::max() : (Word{1} << bits) - 1;
+    return (last - first) & mask;
+}
+struct Request {
+    Word ns{}, address{}, bytes{}, is_write{}, execute_ns{};
+    Request(Word address, Word bytes, bool is_write)
+        : ns(Root().empty() ? 0 : Now()), address(address), bytes(bytes), is_write(is_write) {}
+    Request() = default;
+};
+inline thread_local Request current_request;
+struct RequestScope {
+    Request previous{current_request};
+    explicit RequestScope(const Request& value) {
+        current_request = value;
+        if (value.ns) current_request.execute_ns = Now();
+    }
+    ~RequestScope() { current_request = previous; }
+};
+struct Entry {
+    Request request{};
+    Word address{}, size{}, padded_bytes{}, copy_count{}, tick{}, known_before{}, known_after{};
+    Word start_ns{}, setup_ns{}, before_finish_ns{}, after_finish_ns{}, collected_ns{};
+    Word gpu_start{}, gpu_end{}, gpu_delta{};
+    int result{};
+    bool available{};
+};
+struct State {
+    vk::UniqueQueryPool pool;
+    vk::Device device;
+    Word owner{};
+    unsigned valid_bits{};
+    double period_ns{};
+    Word next_check{}, deadline{};
+    std::size_t count{};
+    bool active{}, finished{}, in_scope{};
+    std::array<Entry, Capacity> entries{};
+};
+inline thread_local State state;
+
+inline void Report(const char* reason) noexcept {
+    state.finished = true;
+    state.active = false;
+    // Every timestamp submitted by this recorder belongs to a download whose
+    // original Finish has already returned. There are no query commands in a later batch.
+    state.pool.reset();
+    try {
+        std::ofstream out(Root() / "gpu-copy-spans.tsv", std::ios::trunc);
+        out << "id\trequest_ns\texecute_ns\trequest_address\trequest_bytes\tis_write"
+               "\twindow_address\twindow_size\tpadded_bytes\tcopy_count\ttick"
+               "\tknown_before\tknown_after\tstart_ns\tsetup_ns\tbefore_finish_ns"
+               "\tafter_finish_ns\tcollected_ns\tgpu_start\tgpu_end\tgpu_delta\tresult\tavailable\n";
+        for (std::size_t i = 0; i < state.count; ++i) {
+            const auto& e = state.entries[i];
+            out << i + 1 << '\t' << e.request.ns << '\t' << e.request.execute_ns << '\t'
+                << e.request.address << '\t' << e.request.bytes << '\t' << e.request.is_write
+                << '\t' << e.address << '\t' << e.size << '\t' << e.padded_bytes << '\t'
+                << e.copy_count << '\t' << e.tick << '\t' << e.known_before << '\t'
+                << e.known_after << '\t' << e.start_ns << '\t' << e.setup_ns << '\t'
+                << e.before_finish_ns << '\t' << e.after_finish_ns << '\t' << e.collected_ns
+                << '\t' << e.gpu_start << '\t' << e.gpu_end << '\t' << e.gpu_delta
+                << '\t' << e.result << '\t' << e.available << '\n';
+        }
+        out.flush();
+        if (!out) return;
+        std::ofstream done(Root() / "complete.txt", std::ios::trunc);
+        done.precision(17);
+        done << "reason=" << reason << "\nscheduler=" << state.owner << "\nentries=" << state.count
+             << "\ntimestamp_valid_bits=" << state.valid_bits
+             << "\ntimestamp_period_ns=" << state.period_ns
+             << "\nadditional_submissions=0\nadditional_waits=0\n"
+             << "gpu_span_includes_barrier_dependencies_and_may_include_prior_work=true\n"
+             << "gpu_and_cpu_clocks_are_not_calibrated=true\n";
+    } catch (...) {
+        // Recording failure must not change guest execution.
+    }
+}
+
+template <typename Instance, typename Scheduler>
+class Scope {
+public:
+    Scope(const Instance& instance, Scheduler& scheduler, Word address, Word size,
+          Word padded_bytes, Word copy_count, bool allowed)
+        : scheduler(scheduler) {
+        try {
+            if (!allowed || Root().empty() || state.finished || state.in_scope) return;
+            const Word now = Now();
+            if (!state.active) {
+                if (now < state.next_check) return;
+                state.next_check = now + 500'000'000;
+                std::error_code error;
+                if (!std::filesystem::exists(Root() / "arm.request", error)) return;
+                state.device = instance.GetDevice();
+                const auto physical = instance.GetPhysicalDevice();
+                const auto families = physical.getQueueFamilyProperties();
+                const auto family = instance.GetGraphicsQueueFamilyIndex();
+                if (family >= families.size() || !families[family].timestampValidBits) {
+                    Report("timestamps-unsupported");
+                    return;
+                }
+                state.valid_bits = families[family].timestampValidBits;
+                state.period_ns = physical.getProperties().limits.timestampPeriod;
+                auto [result, pool] = state.device.createQueryPoolUnique(vk::QueryPoolCreateInfo{
+                    .queryType = vk::QueryType::eTimestamp, .queryCount = 2});
+                if (result != vk::Result::eSuccess) {
+                    Report("query-allocation-failed");
+                    return;
+                }
+                state.pool = std::move(pool);
+                state.owner = reinterpret_cast<Word>(&scheduler);
+                state.active = true;
+                state.deadline = now + 2'000'000'000;
+            }
+            if (state.owner != reinterpret_cast<Word>(&scheduler)) return;
+            if (now >= state.deadline || state.count == Capacity) {
+                Report("deadline");
+                return;
+            }
+            state.in_scope = true;
+            entry = &state.entries[state.count];
+            *entry = Entry{.request = current_request, .address = address, .size = size,
+                           .padded_bytes = padded_bytes, .copy_count = copy_count,
+                           .start_ns = now, .setup_ns = Now() - now};
+        } catch (...) {
+            // No GPU command has been recorded yet; pool cleanup is safe here.
+            Report("setup-failed");
+        }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+    void Begin(vk::CommandBuffer commands) {
+        if (!entry) return;
+        entry->tick = scheduler.CurrentTick();
+        commands.resetQueryPool(*state.pool, 0, 2);
+        commands.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe, *state.pool, 0);
+    }
+    void End(vk::CommandBuffer commands) {
+        if (entry) commands.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, *state.pool, 1);
+    }
+    void BeforeFinish() {
+        if (!entry) return;
+        entry->known_before = scheduler.GetMasterSemaphore()->KnownGpuTick();
+        entry->before_finish_ns = Now();
+    }
+    // Call only after the ORIGINAL blocking Finish, never instead of it.
+    void AfterFinish() {
+        if (!entry) return;
+        entry->after_finish_ns = Now();
+        entry->known_after = scheduler.GetMasterSemaphore()->KnownGpuTick();
+        std::array<Word, 4> values{};
+        const auto result = state.device.getQueryPoolResults(*state.pool, 0, 2, sizeof(values),
+            values.data(), sizeof(Word) * 2,
+            vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+        entry->result = static_cast<int>(result);
+        entry->available = result == vk::Result::eSuccess && values[1] && values[3];
+        if (entry->available) {
+            entry->gpu_start = values[0];
+            entry->gpu_end = values[2];
+            entry->gpu_delta = TimestampDelta(values[0], values[2], state.valid_bits);
+        }
+        entry->collected_ns = Now();
+        ++state.count;
+        state.in_scope = false;
+        entry = nullptr;
+        if (state.count == Capacity || Now() >= state.deadline)
+            Report(state.count == Capacity ? "capacity" : "deadline");
+    }
+private:
+    Scheduler& scheduler;
+    Entry* entry{};
+};
+} // namespace Vulkan::DreamsReadbackGpuSpan
