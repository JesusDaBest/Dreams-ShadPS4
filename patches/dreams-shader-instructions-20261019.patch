+                                         ir.Imm32(0));
+            return ir.LogicalAnd(sign, ir.LogicalNot(ir.FPIsNan(value)));
+        }
+        case 504:
+            return ir.LogicalNot(ir.LogicalOr(ir.FPIsNan(value), ir.FPIsInf(value)));
+        }
+    }
