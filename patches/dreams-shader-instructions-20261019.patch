+// Private, explicitly armed diagnostic. No shader or guest-data modifications.
+namespace DetailResultCapture {
+struct Window {
+    std::filesystem::path root;
+    std::chrono::steady_clock::time_point deadline;
+    u64 bytes{};
+    u32 epoch{};
+    u32 events{};
+    bool active{};
+};
+static Window window;
+static constexpr u64 MaxBytes = 96_MB;
+static constexpr u64 MaxPrefix = 2_MB;
+static constexpr u32 MaxEvents = 16;
+
+static bool Target(u64 hash) {
+    return hash == 0x61b54af5 || hash == 0x44c189d5 || hash == 0x5650b8f7 ||
+           hash == 0xd049fb84 || hash == 0x16f35a48 || hash == 0x62a348b1 ||
+           hash == 0x8b19605c;
+}
+
+static bool EnabledFor(const Shader::Info& cs) {
+    return Target(cs.pgm_hash) &&
+        DreamsEnvironment<"SHADPS4_DREAMS_DETAIL_RESULT_CAPTURE_DIR">() &&
+        Common::ElfInfo::Instance().GameSerial() == "CUSA04301";
+}
+
+static bool SaveGds(const std::filesystem::path& path, Scheduler& scheduler,
+                    VideoCore::BufferCache& cache) {
+    const auto* gds = cache.GetGdsBuffer();
+    std::array<u8,45*sizeof(u32)> data{};
+    if (gds->SizeBytes() < 0xc00 + data.size()) return false;
+    // Use the existing GPU copy, memory barriers, fence wait, and mapped-range invalidation.
+    // A bare CPU read of mapped GDS would not establish visibility of the completed write.
+    if (!ReadDreamsBoundBufferForCapture(scheduler,cache,
+            vk::DescriptorBufferInfo{gds->Handle(),0xc00,data.size()},0,data)) return false;
+    u64 hash{};
+    return WriteDreamsCaptureBytes(path,data,hash);
+}
+
+static std::filesystem::path Begin(const Shader::Info& cs, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, std::span<const vk::DescriptorBufferInfo> bindings,
+    std::span<const u32> spirv, std::span<const u8> push,
+    std::array<u32,3> dimensions, VAddr indirect_address,
+    vk::DescriptorBufferInfo indirect_binding) {
+    if (!Target(cs.pgm_hash)) return {};
+    const char* directory = DreamsEnvironment<"SHADPS4_DREAMS_DETAIL_RESULT_CAPTURE_DIR">();
+    if (!directory || Common::ElfInfo::Instance().GameSerial() != "CUSA04301") return {};
+    const std::filesystem::path root{directory};
+    std::error_code error;
+    const auto now = std::chrono::steady_clock::now();
+    if (std::filesystem::remove(root/"capture.request",error)) {
+        if (window.epoch >= 4) return {};
+        window.root = root/fmt::format("epoch-{:02}",++window.epoch);
+        window.events = 0;
+        window.bytes = 0;
+        window.deadline = now + std::chrono::seconds{10};
+        window.active = true;
+    }
+    if (!window.active) return {};
+    if (now > window.deadline || window.events >= MaxEvents || window.bytes >= MaxBytes) {
+        window.active = false;
+        WriteDreamsCaptureText(window.root/"window-complete.txt","bounded capture ended\n");
+        return {};
+    }
+    const auto output = window.root/fmt::format("event-{:02}-{:08x}",++window.events,cs.pgm_hash);
+    std::filesystem::create_directories(output,error);
+    if (error) { window.active=false; return {}; }
+    u64 hash{};
+    bool dims_valid = indirect_address == 0;
+    if (indirect_address) {
+        // Capture the exact buffer/offset passed to dispatchIndirect, without resolving the
+        // guest address again and potentially replacing a cached buffer or uploading CPU data.
+        dims_valid = ReadDreamsBoundBufferForCapture(scheduler,cache,indirect_binding,
+            0,std::span<u8>{reinterpret_cast<u8*>(dimensions.data()),sizeof(dimensions)});
+    }
+    bool files_ok = !spirv.empty();
+    files_ok &= WriteDreamsCaptureWords(output/"shader.spv",spirv,hash);
+    files_ok &= WriteDreamsCaptureWords(output/"srt.bin",cs.flattened_ud_buf,hash);
+    files_ok &= WriteDreamsCaptureWords(output/"user-data.bin",cs.user_data,hash);
+    files_ok &= WriteDreamsCaptureBytes(output/"push.bin",push,hash);
+    const bool gds_pre_ok = SaveGds(output/"gds-pre.bin",scheduler,cache);
+    std::string metadata=fmt::format(
+        "shader\t{:#x}\nindirect\t{}\nargs_address\t{:#x}\ndimensions_valid\t{}\n"
+        "dimensions\t{}\t{}\t{}\nmax_buffer_prefix\t{}\nwindow_byte_budget\t{}\n"
+        "shader_changed\tfalse\ninputs_are_prefixes\ttrue\ncompletion_waits_added\ttrue\n"
+        "shader_srt_push_files_ok\t{}\ngds_pre_ok\t{}\n",
+        cs.pgm_hash,indirect_address!=0,indirect_address,dims_valid,
+        dimensions[0],dimensions[1],dimensions[2],MaxPrefix,MaxBytes,files_ok,gds_pre_ok);
+    for (u32 index=0;index<cs.buffers.size() && index<bindings.size();++index) {
+        const auto& desc=cs.buffers[index];
+        const auto& bound=bindings[index];
+        metadata+=fmt::format("binding\t{}\tkind\t{}\twritten\t{}\n",
+            index,static_cast<u32>(desc.buffer_type),desc.is_written);
+        if (desc.IsSpecial()) continue;
+        const auto sharp=desc.GetSharp(cs);
+        const u64 declared=sharp.GetSize();
+        metadata+=fmt::format("buffer\t{}\tguest\t{:#x}\tdeclared\t{}\tstride\t{}\trecords\t{}\n",
+            index,sharp.base_address,declared,sharp.stride,sharp.num_records);
+        if (!declared || !bound.buffer || bound.range==VK_WHOLE_SIZE || bound.range<declared) {
+            metadata+=fmt::format("buffer_skipped\t{}\tinvalid-or-unbounded-descriptor\n",index);
+            continue;
+        }
+        const u64 adjustment=bound.range-declared;
+        const u64 bytes=std::min(declared,MaxPrefix);
+        if (bytes>MaxBytes-window.bytes) {
+            metadata+=fmt::format("buffer_skipped\t{}\twindow-budget\n",index);
+            continue;
+        }
+        std::vector<u8> data(static_cast<size_t>(bytes));
+        bool ok=ReadDreamsBoundBufferForCapture(scheduler,cache,bound,adjustment,data);
+        if (ok) ok=WriteDreamsCaptureBytes(output/fmt::format("buffer-{:02}.bin",index),data,hash);
+        window.bytes+=bytes;
+        metadata+=fmt::format("buffer_read\t{}\tbytes\t{}\tcomplete\t{}\tok\t{}\n",
+            index,bytes,bytes==declared,ok);
+    }
+    WriteDreamsCaptureText(output/"metadata.tsv",metadata);
+    return output;
+}
+
+static void End(const std::filesystem::path& output, Scheduler& scheduler,
+                VideoCore::BufferCache& cache) {
+    if (output.empty()) return;
+    const bool ok=SaveGds(output/"gds-post.bin",scheduler,cache);
+    WriteDreamsCaptureText(output/"dispatch-complete.txt",
+        ok ? "GPU completion waited; post counter copy and file succeeded\n" : "post counter capture failed\n");
+    if (window.events>=MaxEvents || window.bytes>=MaxBytes) {
+        window.active=false;
+        WriteDreamsCaptureText(window.root/"window-complete.txt","bounded capture ended\n");
+    }
+}
+} // namespace DetailResultCapture
