+static void LogDreamsFlipBufferSample(VideoOutPort* port, s32 index, s64 flip_arg, bool eop) {
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+
+    static std::atomic<u32> g_dreams_flip_capture_count{};
+    if (g_dreams_flip_capture_count.fetch_add(1, std::memory_order_relaxed) >= 8) {
+        return;
+    }
+
+    BufferAttributeGroup group{};
+    uintptr_t address = 0;
+    {
+        std::unique_lock lock{port->port_mutex};
+        if (index < 0 || index >= static_cast<s32>(port->buffer_slots.size())) {
+            return;
+        }
+        const auto& buffer = port->buffer_slots[index];
+        if (buffer.group_index < 0 || buffer.group_index >= static_cast<s32>(port->groups.size())) {
+            return;
+        }
+        group = port->groups[buffer.group_index];
+        address = buffer.address_left;
+    }
+
+    if (address == 0 || !group.is_occupied || !Is32BppPixelFormat(group.attrib.pixel_format)) {
+        return;
+    }
+
+    if (ShouldBypassDreamsLateEofGuestBuffer(address)) {
+        static std::atomic<u32> dreams_flip_sample_skip_logs{};
+        const auto logged = dreams_flip_sample_skip_logs.fetch_add(1, std::memory_order_relaxed);
+        if (logged < 24) {
+            AppendDreamsLiveDiag("flip_buffer skip_late_sample addr=%#llx", 
+                                 static_cast<unsigned long long>(address));
+        }
+        return;
+    }
+
+    const u64 row_bytes = static_cast<u64>(group.attrib.pitch_in_pixel) *
+                          PixelFormatBpp(group.attrib.pixel_format);
+    const u64 surface_bytes = row_bytes * group.attrib.height;
+    constexpr u64 sample_count = 256;
+    u64 nonzero_samples = 0;
+    const auto* words = reinterpret_cast<const u32*>(address);
+    const u64 word_count = surface_bytes / sizeof(u32);
+    if (words != nullptr && word_count > 0) {
+        for (u64 i = 0; i < sample_count; ++i) {
+            const u64 sample_index = (i * word_count) / sample_count;
+            if (words[sample_index] != 0) {
+                ++nonzero_samples;
+            }
+        }
+    }
+
+    LOG_WARNING(Lib_VideoOut,
+                "Dreams flip buffer memory sample: bufferIndex={} addr={:#x} size={:#x} "
+                "samples_nonzero={}/{} pitch={} height={} fmt={} flip_arg={} eop={}",
+                index, address, surface_bytes, nonzero_samples, sample_count,
+                group.attrib.pitch_in_pixel, group.attrib.height,
+                GetPixelFormatString(group.attrib.pixel_format), flip_arg, eop);
+}
