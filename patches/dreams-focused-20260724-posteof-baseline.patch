+
+bool IsDreamsLateVoTailDispatch768Context() {
+    constexpr u32 kDrawKind = MakeDreamsGpuSubmissionKind('D', 'R', 'W', 'N');
+    constexpr u32 kSkipKind = MakeDreamsGpuSubmissionKind('S', 'K', 'I', 'P');
+    std::scoped_lock lock{g_dreams_gpu_submission_mutex};
+    const u64 last_seq = g_dreams_gpu_submission_record.seq;
+    const bool has_dreams_video_eof = Libraries::AvPlayer::HasDreamsVideoReachedEof();
+    const auto is_generic_tail_skip_target = [](const u64 target_addr) {
+        return target_addr == 0x300400000ull || target_addr == 0x2ffc00000ull;
+    };
+    const auto matches_tail_draw_record = [&](const DreamsGpuSubmissionRecord& record) {
+        return (record.kind == kDrawKind && record.shader_a == 0x7dce010c2bc41c67ull &&
+                record.shader_b == 0x786700308cf16961ull &&
+                record.target_addr == 0x300400000ull && record.dim_x == 3 && record.dim_y == 1 &&
+                record.dim_z == 0) ||
+               (has_dreams_video_eof && record.kind == kSkipKind && record.shader_a == 0 &&
+                record.shader_b == 0 && is_generic_tail_skip_target(record.target_addr) &&
+                record.dim_x == 3 && record.dim_y == 1 && record.dim_z == 0);
+    };
+    const auto matches_tail_draw_back = [&](const u64 back) {
+        if (last_seq <= back) {
+            return false;
+        }
+        const u64 seq = last_seq - back;
+        const auto& record = g_dreams_gpu_submission_history[seq % kDreamsGpuSubmissionHistorySize];
+        return record.seq == seq && matches_tail_draw_record(record);
+    };
+    return (matches_tail_draw_record(g_dreams_gpu_submission_record) &&
+            HasDreamsLateVoTailPreludeLocked(last_seq)) ||
+           (matches_tail_draw_back(1) && matches_tail_draw_back(2) &&
+            HasDreamsLateVoTailPreludeLocked(last_seq - 2)) ||
+           (matches_tail_draw_back(1) && HasDreamsLateVoTailPreludeLocked(last_seq - 1));
+}
