+    if (!image_id) {
+        if (logged < 24) {
+            AppendDreamsLiveDiag("presenter tracked_source lookup_failed addr=%#llx size=%ux%u pitch=%u fmt=%#x",
+                                 static_cast<unsigned long long>(guest_address), width, height,
+                                 pitch_pixels, pixel_format);
+        }
+        if (logged < 24) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams tracked source image lookup failed: addr={:#x} size={}x{} "
+                        "pitch={} pixel_format={:#x}",
+                        guest_address, width, height, pitch_pixels, pixel_format);
+        }
+        return nullptr;
+    }
+    auto& image = texture_cache.GetImage(image_id);
+    if (image.info.guest_address != guest_address) {
+        if (logged < 24) {
+            AppendDreamsLiveDiag(
+                "presenter tracked_source alias_mismatch image=%u requested=%#llx resolved=%#llx fmt=%#x",
+                image_id.index, static_cast<unsigned long long>(guest_address),
+                static_cast<unsigned long long>(image.info.guest_address), pixel_format);
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams tracked source alias mismatch: image_id={} requested={:#x} "
+                        "resolved={:#x} pixel_format={:#x}",
+                        image_id.index, guest_address, image.info.guest_address, pixel_format);
+        }
+        return nullptr;
+    }
+    const bool rgba_image_format = image.info.pixel_format == vk::Format::eR8G8B8A8Unorm ||
+                                   image.info.pixel_format == vk::Format::eR8G8B8A8Srgb;
+    const bool ten_bit_image_format =
+        image.info.pixel_format == vk::Format::eA2R10G10B10UnormPack32 ||
+        image.info.pixel_format == vk::Format::eA2B10G10R10UnormPack32;
+    if ((is_rgba_tracked_format && !rgba_image_format) ||
+        (is_10bit_tracked_format && !ten_bit_image_format)) {
+        if (logged < 24) {
+            AppendDreamsLiveDiag("presenter tracked_source bad_format image=%u addr=%#llx fmt=%u",
+                                 image_id.index, static_cast<unsigned long long>(guest_address),
+                                 static_cast<u32>(image.info.pixel_format));
+        }
+        if (logged < 24) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams tracked source image format unsupported: image_id={} addr={:#x} "
+                        "fmt={}",
+                        image_id.index, guest_address, vk::to_string(image.info.pixel_format));
+        }
+        return nullptr;
+    }
+
+    const u32 image_flags = static_cast<u32>(image.flags);
+    const bool gpu_modified =
+        (image_flags & static_cast<u32>(VideoCore::ImageFlagBits::GpuModified)) != 0;
+    const bool cpu_dirty =
+        (image_flags & static_cast<u32>(VideoCore::ImageFlagBits::CpuDirty)) != 0;
+    const bool prefer_gpu_authored_eof_tracked_source =
+        Common::ElfInfo::Instance().GameSerial() == "CUSA04301" && is_10bit_tracked_format &&
+        Libraries::AvPlayer::HasDreamsVideoReachedEof();
+    const bool force_cpu_refresh =
+        Common::ElfInfo::Instance().GameSerial() == "CUSA04301" && is_10bit_tracked_format &&
+        !prefer_gpu_authored_eof_tracked_source;
+    const bool skip_cpu_refresh = prefer_gpu_authored_eof_tracked_source
+                                      ? (image.usage.vo_surface != 0 ||
+                                         image.usage.render_target != 0 ||
+                                         (gpu_modified && !cpu_dirty))
+                                      : (!force_cpu_refresh && (image.usage.render_target != 0 ||
+                                                                (gpu_modified && !cpu_dirty)));
+    if (!skip_cpu_refresh) {
+        texture_cache.UpdateImage(image_id);
+    }
+    if (logged < 24) {
+        AppendDreamsLiveDiag(
+            "presenter tracked_source refresh image=%u addr=%#llx flags=%#x rt=%u vo=%u force_cpu=%u prefer_gpu_eof=%u skipped=%u",
+            image_id.index, static_cast<unsigned long long>(image.info.guest_address), image_flags,
+            static_cast<u32>(image.usage.render_target), static_cast<u32>(image.usage.vo_surface),
+            force_cpu_refresh ? 1u : 0u, prefer_gpu_authored_eof_tracked_source ? 1u : 0u,
+            skip_cpu_refresh ? 1u : 0u);
+    }
+    if (force_cpu_refresh && logged < 24) {
+        LOG_WARNING(Render_Vulkan,
+                    "Forcing Dreams tracked-source CPU refresh before present: image_id={} "
+                    "addr={:#x} flags={:#x} usage(rt={},vo={})",
+                    image_id.index, image.info.guest_address, image_flags,
+                    static_cast<u32>(image.usage.render_target),
+                    static_cast<u32>(image.usage.vo_surface));
+    }
+
+    Frame* frame = GetRenderFrame();
+    const auto frame_subresources = vk::ImageSubresourceRange{
+        .aspectMask = vk::ImageAspectFlagBits::eColor,
+        .baseMipLevel = 0,
+        .levelCount = 1,
+        .baseArrayLayer = 0,
+        .layerCount = VK_REMAINING_ARRAY_LAYERS,
+    };
+    const auto pre_barrier = vk::ImageMemoryBarrier2{
+        .srcStageMask = vk::PipelineStageFlagBits2::eColorAttachmentOutput,
+        .srcAccessMask = vk::AccessFlagBits2::eColorAttachmentRead,
+        .dstStageMask = vk::PipelineStageFlagBits2::eColorAttachmentOutput,
+        .dstAccessMask = vk::AccessFlagBits2::eColorAttachmentWrite,
+        .oldLayout = vk::ImageLayout::eUndefined,
+        .newLayout = vk::ImageLayout::eColorAttachmentOptimal,
+        .image = frame->image,
+        .subresourceRange{frame_subresources},
+    };
+
+    auto& scheduler = present_thread ? present_scheduler : draw_scheduler;
+    scheduler.EndRendering();
+    const auto cmdbuf = scheduler.CommandBuffer();
+    cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+        .imageMemoryBarrierCount = 1,
+        .pImageMemoryBarriers = &pre_barrier,
+    });
+
+    VideoCore::ImageViewInfo view_info{};
+    view_info.format = GetFrameViewFormat(tracked_format);
+    view_info.mapping.a = vk::ComponentSwizzle::eOne;
+
+    auto image_view = *image.FindView(view_info).image_view;
+    const vk::Extent2D image_size = {image.info.size.width, image.info.size.height};
+    expected_ratio = static_cast<float>(image_size.width) / static_cast<float>(image_size.height);
+
+    u32 capture_game_only_count = VideoCore::ConsumeGameOnlyScreenshotRequests();
+    std::vector<ScreenshotReadback> pending_screenshots;
+    if (capture_game_only_count > 0) {
+        pending_screenshots.reserve(1);
+        pending_screenshots.emplace_back(
+            instance, scheduler, ScreenshotKind::GameOnly,
+            BuildScreenshotPaths(ScreenshotKind::GameOnly, capture_game_only_count),
+            image_size.width, image_size.height, image.info.pixel_format, false);
+        auto& readback = pending_screenshots.back();
+        image.Transit(vk::ImageLayout::eTransferSrcOptimal, vk::AccessFlagBits2::eTransferRead, {},
+                      cmdbuf);
+        CopyImageToReadback(cmdbuf, image.GetImage(), vk::ImageLayout::eTransferSrcOptimal,
+                            readback);
+    }
+
+    image.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderRead, {},
+                  cmdbuf);
+    image_view = fsr_pass.Render(cmdbuf, image_view, image_size, {frame->width, frame->height},
+                                 fsr_settings, frame->is_hdr);
+    pp_pass.Render(cmdbuf, image_view, image_size, *frame, pp_settings);
+
+    frame->ready_semaphore = scheduler.GetMasterSemaphore()->Handle();
+    frame->ready_tick = scheduler.CurrentTick();
+    if (!pending_screenshots.empty()) {
+        auto deferred_screenshots =
+            std::make_shared<std::vector<ScreenshotReadback>>(std::move(pending_screenshots));
+        scheduler.DeferPriorityOperation(
+            [deferred_screenshots]() { SavePendingScreenshots(*deferred_screenshots); });
+    }
+    SubmitInfo info{};
+    scheduler.Flush(info);
+
+    static std::atomic<u32> dreams_tracked_source_logs{};
+    if (dreams_tracked_source_logs.fetch_add(1, std::memory_order_relaxed) < 24) {
+        AppendDreamsLiveDiag("presenter tracked_source prepared image=%u addr=%#llx size=%ux%u pitch=%u",
+                             image_id.index, static_cast<unsigned long long>(guest_address),
+                             image.info.size.width, image.info.size.height, image.info.pitch);
+        LOG_WARNING(Render_Vulkan,
+                    "Prepared Dreams tracked source frame: image_id={} addr={:#x} size={}x{} "
+                    "pitch={}",
+                    image_id.index, guest_address, image.info.size.width, image.info.size.height,
+                    image.info.pitch);
+    }
+    return frame;
+}
