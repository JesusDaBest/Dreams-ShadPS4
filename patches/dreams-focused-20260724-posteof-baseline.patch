+bool NeedsDreamsArrayViewOverride(const Shader::Info& stage, const Shader::ImageResource& image_desc,
+                                  const AmdGpu::Image& tsharp,
+                                  const VideoCore::TextureCache::ImageDesc& desc,
+                                  const u32 descriptor_binding) {
+    static_cast<void>(stage);
+    static_cast<void>(image_desc);
+    static_cast<void>(tsharp);
+    static_cast<void>(desc);
+    static_cast<void>(descriptor_binding);
+
+    // Keep the original guest image/view typing for now. The Dreams-only 2D-to-array rewrite is
+    // active on the current crashing path, so disable it while we verify whether it is the source
+    // of the AMD Vulkan driver fault.
+    return false;
+}
+
+bool NeedsDreamsVolumeArrayViewOverride(const Shader::Info& stage,
+                                        const Shader::ImageResource& image_desc,
+                                        const VideoCore::TextureCache::ImageDesc& desc) {
+    static_cast<void>(stage);
+    static_cast<void>(image_desc);
+    static_cast<void>(desc);
+    return false;
+}
+
+void ApplyDreamsArrayViewOverride(const AmdGpu::Image& tsharp,
+                                  VideoCore::TextureCache::ImageDesc& desc) {
+    desc.view_info.type = AmdGpu::ImageType::Color2DArray;
+    desc.view_info.range.base.layer = tsharp.base_array;
+    const auto requested_layers = std::max<u32>(tsharp.last_array + 1, tsharp.base_array + 1);
+    const auto available_layers = std::max<u32>(desc.info.resources.layers, 1u);
+    const auto max_array = std::min<u32>(requested_layers, available_layers);
+    desc.view_info.range.extent.layers =
+        max_array > tsharp.base_array ? max_array - tsharp.base_array : 1;
+}
+
+void ApplyDreamsVolumeArrayViewOverride(VideoCore::TextureCache::ImageDesc& desc) {
+    desc.view_info.type = AmdGpu::ImageType::Color2DArray;
+    desc.view_info.range.base.layer = 0;
+    desc.view_info.range.extent.layers =
+        std::max(desc.info.size.depth >> desc.view_info.range.base.level, 1u);
+}
+
+u32 PackDreamsA2R10G10B10(const u8 r, const u8 g, const u8 b) {
+    const u32 r10 = (static_cast<u32>(r) * 1023u + 127u) / 255u;
+    const u32 g10 = (static_cast<u32>(g) * 1023u + 127u) / 255u;
+    const u32 b10 = (static_cast<u32>(b) * 1023u + 127u) / 255u;
+    return (3u << 30) | (r10 << 20) | (g10 << 10) | b10;
+}
+
+bool ShouldBypassDreamsGuestGpuOps() {
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return false;
+    }
+
+    const bool has_dreams_video_eof = Libraries::AvPlayer::HasDreamsVideoReachedEof();
+    if (has_dreams_video_eof) {
+        return false;
+    }
+
+    // Passive tracked-source registration is useful for presentation probing, but the heavier
+    // guest-GPU bypass should only activate once decoded AV frames exist or the explicit
+    // tracked-takeover fallback has been engaged.
+    return Libraries::AvPlayer::HasDreamsVideoSnapshot() ||
+           Libraries::AvPlayer::GetDreamsCpuCompositeGeneration() != 0 ||
+           g_dreams_tracked_takeover_active.load(std::memory_order_relaxed);
+}
+
+bool ShouldLogDreamsGpuDiagToSpdlog() {
+    return Common::ElfInfo::Instance().GameSerial() != "CUSA04301" ||
+           !Libraries::AvPlayer::HasDreamsSeenVideoSnapshot();
+}
+
+bool ShouldSkipDreamsTrackedTakeoverGpuWork(const bool is_dreams,
+                                            const bool has_dreams_tracked_source,
+                                            const bool has_dreams_video_snapshot,
+                                            const bool has_dreams_video_eof) {
+    if (!is_dreams) {
+        return false;
+    }
+    const bool has_dreams_advanced_tracked_source =
+        Libraries::AvPlayer::HasDreamsAdvancedTrackedGpuSource();
+    const bool has_dreams_cpu_composite =
+        Libraries::AvPlayer::GetDreamsCpuCompositeGeneration() != 0;
+    if (has_dreams_cpu_composite && !has_dreams_video_eof) {
+        return true;
+    }
+    if (has_dreams_tracked_source && !has_dreams_video_snapshot && !has_dreams_video_eof &&
+        !has_dreams_advanced_tracked_source &&
+        Libraries::AvPlayer::HasDreamsFlipBufferSnapshot() &&
+        Libraries::AvPlayer::GetDreamsFlipBufferSnapshotGeneration() >= 8) {
+        return true;
+    }
+    if (!g_dreams_tracked_takeover_active.load(std::memory_order_relaxed)) {
+        return false;
+    }
+    return has_dreams_tracked_source && !has_dreams_video_snapshot && !has_dreams_video_eof &&
+           !has_dreams_advanced_tracked_source;
+}
+
+bool IsDreamsTrackedTakeoverActive() {
+    return g_dreams_tracked_takeover_active.load(std::memory_order_relaxed);
+}
