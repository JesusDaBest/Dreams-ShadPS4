+bool IsDreamsBlank10BitTrackedSource() {
+    u64 guest_address{};
+    u32 width{};
+    u32 height{};
+    u32 pitch_pixels{};
+    u32 pixel_format{};
+    if (!Libraries::AvPlayer::GetDreamsTrackedGpuSource(&guest_address, &width, &height,
+                                                        &pitch_pixels, &pixel_format)) {
+        return false;
+    }
+
+    switch (static_cast<PixelFormat>(pixel_format)) {
+    case PixelFormat::A2R10G10B10:
+    case PixelFormat::A2R10G10B10Srgb:
+    case PixelFormat::A2R10G10B10Bt2020Pq:
+        break;
+    default:
+        return false;
+    }
+
+    constexpr u64 kTenBitPixelBytes = 4;
+    const u64 row_bytes = static_cast<u64>(pitch_pixels) * kTenBitPixelBytes;
+    const u64 surface_bytes = row_bytes * height;
+    const auto* words = reinterpret_cast<const u32*>(guest_address);
+    const u64 word_count = surface_bytes / sizeof(u32);
+    if (words == nullptr || word_count == 0) {
+        return false;
+    }
+
+    constexpr u64 sample_count = 256;
+    u64 nonzero_samples = 0;
+    for (u64 i = 0; i < sample_count; ++i) {
+        const u64 sample_index = (i * word_count) / sample_count;
+        if (words[sample_index] != 0) {
+            ++nonzero_samples;
+        }
+    }
+
+    if (nonzero_samples == 0) {
+        static std::atomic<u32> dreams_blank_tracked_source_logs{};
+        const auto logged =
+            dreams_blank_tracked_source_logs.fetch_add(1, std::memory_order_relaxed);
+        if (logged < 24) {
+            AppendDreamsLiveDiag(
+                "tracked_source blank_10bit addr=%#llx size=%ux%u pitch=%u fmt=%u nonzero=%llu/%llu",
+                static_cast<unsigned long long>(guest_address), width, height, pitch_pixels,
+                pixel_format, static_cast<unsigned long long>(nonzero_samples),
+                static_cast<unsigned long long>(sample_count));
+        }
+        return true;
+    }
+
+    return false;
+}
