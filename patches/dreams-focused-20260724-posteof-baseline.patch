+bool Rasterizer::IsProblematicDreamsCompute(const Pipeline* pipeline) {
+    if (!pipeline->IsCompute()) {
+        return false;
+    }
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return false;
+    }
+
+    const bool has_dreams_video_eof = Libraries::AvPlayer::HasDreamsVideoReachedEof();
+    const bool has_dreams_tracked_source = Libraries::AvPlayer::HasDreamsTrackedGpuSource();
+    if (!has_dreams_video_eof || !has_dreams_tracked_source) {
+        return false;
+    }
+
+    const auto& info = pipeline->GetStage(Shader::LogicalStage::Compute);
+    const auto& cs_pgm = liverpool->GetCsRegs();
+    const bool post_eof_takeover_crash_cluster =
+        (info.pgm_hash == 0x0000000047a9f764ull && cs_pgm.dim_x == 64 && cs_pgm.dim_y == 64 &&
+         cs_pgm.dim_z == 4) ||
+        (info.pgm_hash == 0x00000000cfbf6b00ull && cs_pgm.dim_z == 4 &&
+         ((cs_pgm.dim_x == 4 && cs_pgm.dim_y == 4) || (cs_pgm.dim_x == 2 && cs_pgm.dim_y == 2) ||
+          (cs_pgm.dim_x == 1 && cs_pgm.dim_y == 1)));
+    if (!post_eof_takeover_crash_cluster) {
+        return false;
+    }
+
+    static std::atomic<u32> dreams_problematic_compute_skip_logs{};
+    const auto logged =
+        dreams_problematic_compute_skip_logs.fetch_add(1, std::memory_order_relaxed);
+    RecordDreamsGpuSubmission(MakeDreamsGpuSubmissionKind('S', 'K', 'I', 'P'), info.pgm_hash, 0, 0,
+                              cs_pgm.dim_x, cs_pgm.dim_y, cs_pgm.dim_z);
+    if (logged < 64) {
+        AppendDreamsLiveDiag("problematic_compute skip cs=%#llx dims=%ux%ux%u eof=%u tracked=%u",
+                             static_cast<unsigned long long>(info.pgm_hash), cs_pgm.dim_x,
+                             cs_pgm.dim_y, cs_pgm.dim_z, has_dreams_video_eof ? 1u : 0u,
+                             has_dreams_tracked_source ? 1u : 0u);
+        LOG_WARNING(Render_Vulkan,
+                    "Skipping Dreams problematic post-EOF compute cluster: cs={:#x} dims={}x{}x{}",
+                    info.pgm_hash, cs_pgm.dim_x, cs_pgm.dim_y, cs_pgm.dim_z);
+    }
+    return true;
+}
