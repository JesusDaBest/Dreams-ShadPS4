+void AppendDreamsLiveDiag(const char* fmt, ...) {
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+    const auto path =
+        (Common::FS::GetUserPath(Common::FS::PathType::LogDir) / "dreams-live-diag.log").string();
