+s32 FindDreamsBufferIndexByAddress(VideoOutPort* port, const uintptr_t guest_address) {
+    std::unique_lock lock{port->port_mutex};
+    for (s32 i = 0; i < static_cast<s32>(port->buffer_slots.size()); ++i) {
+        const auto& buffer = port->buffer_slots[i];
+        if (buffer.group_index < 0 || buffer.group_index >= static_cast<s32>(port->groups.size())) {
+            continue;
+        }
+        if (buffer.address_left == guest_address) {
+            return i;
+        }
+    }
+    return -1;
+}
