+                    } else if (!dreams_av_phase_active && ++idle_refresh_divider >= 4 &&
+                               DrawCurrentBuffer()) {
+                        idle_refresh_divider = 0;
+                    } else if (!is_dreams && ImGui::Core::MustKeepDrawing()) {
                         DrawLastFrame();
                     }
                 }
             } else {
+                idle_refresh_divider = 0;
                 Flip(request);
