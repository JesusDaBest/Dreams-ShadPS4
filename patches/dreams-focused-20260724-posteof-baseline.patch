+bool HasDreamsActiveRgbaTrackedSource(u64* guest_address_out = nullptr) {
+    u64 guest_address{};
+    u32 width{};
+    u32 height{};
+    u32 pitch_pixels{};
+    u32 pixel_format{};
+    if (!Libraries::AvPlayer::GetDreamsTrackedGpuSource(&guest_address, &width, &height,
+                                                        &pitch_pixels, &pixel_format)) {
+        return false;
+    }
+    if (pixel_format != static_cast<u32>(Libraries::VideoOut::PixelFormat::A8B8G8R8Srgb) ||
+        guest_address == 0 || width < 1280 || height < 720 || pitch_pixels < width) {
+        return false;
+    }
+    if (guest_address_out != nullptr) {
+        *guest_address_out = guest_address;
+    }
+    return true;
+}
+
+bool HasDreamsAdvancedTrackedSource(u64* guest_address_out = nullptr) {
+    u64 guest_address{};
+    u32 width{};
+    u32 height{};
+    u32 pitch_pixels{};
+    u32 pixel_format{};
+    if (!Libraries::AvPlayer::GetDreamsTrackedGpuSource(&guest_address, &width, &height,
