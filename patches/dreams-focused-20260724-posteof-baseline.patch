+void RecordDreamsGpuSubmission(const u32 kind, const u64 shader_a, const u64 shader_b,
+                               const u64 target_addr, const u32 dim_x, const u32 dim_y,
+                               const u32 dim_z) {
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+    std::scoped_lock lock{g_dreams_gpu_submission_mutex};
+    const u64 seq = g_dreams_gpu_submission_record.seq + 1;
+    g_dreams_gpu_submission_record = DreamsGpuSubmissionRecord{
+        .seq = seq,
+        .shader_a = shader_a,
+        .shader_b = shader_b,
+        .target_addr = target_addr,
+        .dim_x = dim_x,
+        .dim_y = dim_y,
+        .dim_z = dim_z,
+        .kind = kind,
+    };
+    g_dreams_gpu_submission_history[seq % kDreamsGpuSubmissionHistorySize] =
+        g_dreams_gpu_submission_record;
+}
+
+void LogDreamsGpuSubmissionOnDeviceLost() {
+    if (Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+    std::scoped_lock lock{g_dreams_gpu_submission_mutex};
+    LOG_ERROR(Render_Vulkan,
+              "Dreams last GPU submission before device loss: seq={} kind={} shader_a={:#x} "
+              "shader_b={:#x} target_addr={:#x} dims={}x{}x{}",
+              g_dreams_gpu_submission_record.seq,
+              DreamsGpuSubmissionKindName(g_dreams_gpu_submission_record.kind),
+              g_dreams_gpu_submission_record.shader_a, g_dreams_gpu_submission_record.shader_b,
+              g_dreams_gpu_submission_record.target_addr, g_dreams_gpu_submission_record.dim_x,
+              g_dreams_gpu_submission_record.dim_y, g_dreams_gpu_submission_record.dim_z);
+    const u64 last_seq = g_dreams_gpu_submission_record.seq;
+    const u64 first_seq =
+        last_seq > kDreamsGpuSubmissionHistorySize ? last_seq - kDreamsGpuSubmissionHistorySize + 1
+                                                   : 1;
+    for (u64 seq = first_seq; seq <= last_seq; ++seq) {
+        const auto& record = g_dreams_gpu_submission_history[seq % kDreamsGpuSubmissionHistorySize];
+        if (record.seq != seq) {
+            continue;
+        }
+        LOG_ERROR(Render_Vulkan,
+                  "Dreams GPU history: seq={} kind={} shader_a={:#x} shader_b={:#x} "
+                  "target_addr={:#x} dims={}x{}x{}",
+                  record.seq, DreamsGpuSubmissionKindName(record.kind), record.shader_a,
+                  record.shader_b, record.target_addr, record.dim_x, record.dim_y, record.dim_z);
+    }
+}
