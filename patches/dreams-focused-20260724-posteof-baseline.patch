+bool MatchesRecentDreamsGpuSubmission(const u64 last_seq, const u64 back, const u32 kind,
+                                      const u64 shader_a, const u64 shader_b,
+                                      const u64 target_addr, const u32 dim_x,
+                                      const u32 dim_y, const u32 dim_z) {
