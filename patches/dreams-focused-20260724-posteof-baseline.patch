+void StartDreamsSameBufferFlipMonitor(VideoOutPort* port, s32 handle, u32 buf_id) {
+    if (buf_id >= MaxDisplayBuffers) {
+        return;
+    }
+
+    bool expected = false;
+    if (!g_dreams_same_buffer_monitor_active[buf_id].compare_exchange_strong(expected, true)) {
+        return;
+    }
+
+    std::thread([port, handle, buf_id]() {
+        using namespace std::chrono_literals;
+
+        constexpr u32 kDreamsBootstrapSubmitLimit = 16;
+        constexpr u32 kDreamsAvPhaseSubmitLimit = 64;
+        const auto deadline = std::chrono::steady_clock::now() + 180s;
+        u32 bootstrap_submits = 0;
+        u32 av_phase_submits = 0;
+        auto recovered_since = std::chrono::steady_clock::time_point{};
+        auto last_present_advance = std::chrono::steady_clock::time_point{};
+        u64 last_observed_presented = 0;
+        bool forced_video_eof = false;
+        while (std::chrono::steady_clock::now() < deadline) {
+            const auto now = std::chrono::steady_clock::now();
+            bool should_submit = false;
+            bool bootstrap_submit = false;
+            bool cpu_only_bootstrap_submit = false;
+            bool cpu_only_eof_submit = false;
+            bool eof_keepalive_submit = false;
+            s32 current_buffer = -1;
+            s32 pending_flips = 0;
+            s32 submit_index = static_cast<s32>(buf_id);
+            s64 flip_arg = 0;
+            u64 label_value = 0;
+            u64 presented_flips = 0;
+            const bool has_dreams_video = Libraries::AvPlayer::HasDreamsVideoSnapshot();
+            const bool dreams_video_eof = Libraries::AvPlayer::HasDreamsVideoReachedEof();
+            const bool dreams_av_init_started = Libraries::AvPlayer::HasDreamsAvPlayerInitStarted();
+            const bool has_dreams_tracked_source = Libraries::AvPlayer::HasDreamsTrackedGpuSource();
+            const bool has_dreams_advanced_tracked_source =
+                Libraries::AvPlayer::HasDreamsAdvancedTrackedGpuSource();
+            const bool has_dreams_rgba_tracked_source =
+                has_dreams_tracked_source && HasDreamsRgbaTrackedSourceMetadata();
+            const bool has_dreams_presentable_tracked_source =
+                has_dreams_tracked_source && HasDreamsPresentableTrackedSourceMetadata();
+            const bool has_dreams_cpu_composite =
+                Libraries::AvPlayer::GetDreamsCpuCompositeGeneration() != 0;
+            const u64 dreams_flip_generation =
+                Libraries::AvPlayer::GetDreamsFlipBufferSnapshotGeneration();
+            {
+                std::unique_lock lock{port->port_mutex};
+                if (!port->is_open) {
+                    break;
+                }
+                current_buffer = port->flip_status.current_buffer;
+                pending_flips = port->flip_status.flip_pending_num;
+                flip_arg = port->flip_status.flip_arg + 1;
+                presented_flips = port->flip_status.count;
+                if (presented_flips != last_observed_presented) {
+                    last_observed_presented = presented_flips;
+                    last_present_advance = now;
+                }
+                if (buf_id < port->buffer_labels.size()) {
+                    label_value = port->buffer_labels[buf_id];
+                }
+                if (has_dreams_video && current_buffer >= 0 &&
+                    current_buffer < static_cast<s32>(MaxDisplayBuffers)) {
+                    submit_index = current_buffer;
+                }
+                should_submit = false;
+                if (has_dreams_video && !dreams_video_eof && pending_flips == 0 &&
+                    current_buffer >= 0 &&
+                    current_buffer < static_cast<s32>(MaxDisplayBuffers) &&
+                    av_phase_submits < kDreamsAvPhaseSubmitLimit) {
+                    // Keep submitting bounded same-buffer flips while intro AV frames are live so
+                    // the main presenter path keeps advancing instead of waiting for idle timing.
+                    submit_index = current_buffer;
+                    should_submit = submit_index >= 0;
+                } else if (!has_dreams_video && !dreams_video_eof &&
+                           !has_dreams_advanced_tracked_source && presented_flips >= 1 &&
+                           pending_flips == 0 && current_buffer == static_cast<s32>(buf_id) &&
+                           bootstrap_submits < kDreamsBootstrapSubmitLimit) {
+                    const bool tracked_bootstrap_stalled =
+                        !has_dreams_tracked_source ||
+                        (last_present_advance != std::chrono::steady_clock::time_point{} &&
+                         (now - last_present_advance) >= 150ms);
+                    const bool recovered_bootstrap_ready = dreams_flip_generation >= 1;
+                    if (recovered_bootstrap_ready && tracked_bootstrap_stalled) {
+                        submit_index = current_buffer;
+                        bootstrap_submit = submit_index >= 0;
+                        cpu_only_bootstrap_submit =
+                            bootstrap_submit && recovered_bootstrap_ready &&
+                            !has_dreams_tracked_source;
+                    }
+                }
+            }
+
+            if (dreams_video_eof && pending_flips == 0 && !eof_keepalive_submit && !should_submit) {
+                static std::atomic<u32> dreams_eof_keepalive_block_logs{};
+                const auto blocked =
+                    dreams_eof_keepalive_block_logs.fetch_add(1, std::memory_order_relaxed);
+                if (blocked < 48) {
+                    AppendDreamsLiveDiag(
+                        "same_buffer_eof_block handle=%d buf=%u current_buffer=%d submit=%d "
+                        "presented=%llu has_video=%d tracked=%d adv=%d rgba=%d "
+                        "keepalive=%u tracked_allowed=%d pending=%d flip=%llu",
+                        handle, buf_id, current_buffer, submit_index,
+                        static_cast<unsigned long long>(presented_flips), has_dreams_video,
+                        has_dreams_tracked_source, has_dreams_advanced_tracked_source,
+                        has_dreams_rgba_tracked_source, 0u, 0, pending_flips,
+                        static_cast<unsigned long long>(dreams_flip_generation));
+                }
+            }
+
+            const bool dreams_waiting_for_av_bootstrap =
+                !forced_video_eof && !has_dreams_video && !dreams_video_eof &&
+                !dreams_av_init_started && !has_dreams_tracked_source &&
+                !has_dreams_cpu_composite && dreams_flip_generation >= 3 &&
+                presented_flips >= 10;
+            if (dreams_waiting_for_av_bootstrap) {
+                if (recovered_since == std::chrono::steady_clock::time_point{}) {
+                    recovered_since = now;
+                } else if (now - recovered_since >= 250ms) {
+                    static std::atomic<u32> dreams_pre_av_wait_logs{};
+                    const auto wait_logged =
+                        dreams_pre_av_wait_logs.fetch_add(1, std::memory_order_relaxed);
+                    if (wait_logged < 16) {
+                        LOG_WARNING(Lib_VideoOut,
+                                    "Dreams pre-AV bootstrap still waiting: presented={} "
+                                    "flip_gen={} pending={} current_buffer={} buf_id={} "
+                                    "has_video={} video_eof={} tracked_source={} "
+                                    "cpu_composite={} av_init_started={}",
+                                    presented_flips, dreams_flip_generation, pending_flips,
+                                    current_buffer, buf_id, has_dreams_video, dreams_video_eof,
+                                    has_dreams_tracked_source, has_dreams_cpu_composite,
+                                    dreams_av_init_started);
+                    }
+                }
+            } else if (!dreams_video_eof && (dreams_flip_generation < 3 || presented_flips < 10 ||
+                                             dreams_av_init_started)) {
+                recovered_since = {};
+            }
+
+            if (should_submit || bootstrap_submit || eof_keepalive_submit) {
+                const auto log_index =
+                    g_dreams_same_buffer_monitor_logs.fetch_add(1, std::memory_order_relaxed);
+                if (log_index < 64) {
+                    LOG_WARNING(Lib_VideoOut,
+                                "Dreams same-buffer flip synth: handle={} buf_id={} submit_index={} "
+                                "flip_arg={} label={} current_buffer={} pending={} presented={} "
+                                "has_video={} video_eof={} tracked_source={} cpu_composite={} "
+                                "bootstrap_flips={} eof_keepalive_flips={}",
+                                handle, buf_id, submit_index, flip_arg, label_value,
+                                current_buffer, pending_flips, presented_flips,
+                                has_dreams_video, dreams_video_eof, has_dreams_tracked_source,
+                                has_dreams_cpu_composite, bootstrap_submits, 0u);
+                }
+                if (log_index < 32) {
+                    AppendDreamsLiveDiag(
+                        "same_buffer_synth handle=%d buf=%u submit=%d presented=%llu has_video=%d "
+                        "eof=%d tracked=%d cpu=%d bootstrap=%u keepalive=%u",
+                        handle, buf_id, submit_index, static_cast<unsigned long long>(presented_flips),
+                        has_dreams_video, dreams_video_eof, has_dreams_tracked_source,
+                        has_dreams_cpu_composite, bootstrap_submits, 0u);
+                }
+                if (bootstrap_submit || eof_keepalive_submit) {
+                    const bool cpu_only_synthetic_submit =
+                        cpu_only_bootstrap_submit || cpu_only_eof_submit;
+                    const bool submitted =
+                        cpu_only_synthetic_submit
+                            ? driver->CompleteDreamsSyntheticFlip(port, submit_index, flip_arg)
+                            : driver->SubmitDreamsSyntheticFlip(port, submit_index, flip_arg);
+                    if (!submitted) {
+                        break;
+                    }
+                } else if (!driver->SubmitFlip(port, submit_index, flip_arg, false)) {
+                    break;
+                }
+                if (bootstrap_submit) {
+                    ++bootstrap_submits;
+                }
+                if (has_dreams_video && !dreams_video_eof && should_submit) {
+                    ++av_phase_submits;
+                }
+                std::this_thread::sleep_for(8ms);
+                continue;
+            }
+
+            std::this_thread::sleep_for(4ms);
+        }
+
+        g_dreams_same_buffer_monitor_active[buf_id].store(false, std::memory_order_relaxed);
+    }).detach();
+}
