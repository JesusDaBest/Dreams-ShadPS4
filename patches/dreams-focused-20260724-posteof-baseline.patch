+        clamp_dreams_video_wait && sem.index == 48 && result == ORBIS_KERNEL_ERROR_ETIMEDOUT &&
+        (!dreams_video_eof || Libraries::AvPlayer::HasDreamsTrackedGpuSource());
+    if (synthesize_dreams_video_tick) {
+        result = ORBIS_OK;
+        if (wait_timeout != nullptr) {
+            *wait_timeout = original_timeout > effective_timeout ? original_timeout - effective_timeout
+                                                                 : 1u;
+        }
+        static std::atomic<u32> dreams_video_wait_synthetic_wakes{};
+        const auto sample =
+            dreams_video_wait_synthetic_wakes.fetch_add(1, std::memory_order_relaxed);
+        if (sample < 64) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams VideoPlayerUpdate semaphore synthesized wake: sem={} name='{}' "
+                        "needCount={} thread='{}' eof={} tracked={} cpu={}",
+                        sem.index, orbis_sems[sem]->name, needCount, thread_name,
+                        dreams_video_eof, Libraries::AvPlayer::HasDreamsTrackedGpuSource(),
+                        Libraries::AvPlayer::GetDreamsCpuCompositeGeneration() != 0);
+        }
+    }
+    if (dreams_main_wait) {
+        static std::atomic<u32> dreams_main_sema_wait_exits{};
+        const auto sample = dreams_main_sema_wait_exits.fetch_add(1, std::memory_order_relaxed);
+        if (sample < 128) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams main semaphore wait exit: thread='{}' sem={} name='{}' "
+                        "result={:#x} remaining_timeout_us={} token_after={} waiters_after={} "
+                        "post_av={}",
+                        thread_name, sem.index, orbis_sems[sem]->name, result,
+                        wait_timeout != nullptr ? *wait_timeout : 0, token_count_after,
+                        waiters_after, IsDreamsPostAv());
+        }
+        if (IsDreamsPostAv()) {
+            static std::atomic<u32> dreams_main_post_av_sema_wait_exits{};
+            const auto post_av_sample =
+                dreams_main_post_av_sema_wait_exits.fetch_add(1, std::memory_order_relaxed);
+            if (post_av_sample < 128) {
+                LOG_WARNING(Lib_Kernel,
+                            "Dreams main POST-AV semaphore wait exit: thread='{}' sem={} "
+                            "name='{}' result={:#x} remaining_timeout_us={} token_after={} "
+                            "waiters_after={}",
+                            thread_name, sem.index, orbis_sems[sem]->name, result,
+                            wait_timeout != nullptr ? *wait_timeout : 0, token_count_after,
+                            waiters_after);
+            }
+        }
+    }
+    if (dreams_post_av_wait) {
+        static std::atomic<u32> dreams_post_av_sema_wait_exits{};
+        const auto sample =
+            dreams_post_av_sema_wait_exits.fetch_add(1, std::memory_order_relaxed);
+        if (sample < 96) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams post-AV semaphore wait exit: thread='{}' sem={} name='{}' "
+                        "result={:#x} remaining_timeout_us={}",
+                        thread_name, sem.index, orbis_sems[sem]->name, result,
+                        wait_timeout != nullptr ? *wait_timeout : 0);
+        }
+    }
+    if (clamp_dreams_video_wait) {
+        *pTimeout = *wait_timeout;
+        if (result == ORBIS_KERNEL_ERROR_ETIMEDOUT) {
+            static std::atomic<u32> dreams_video_wait_timeouts{};
+            const auto sample = dreams_video_wait_timeouts.fetch_add(1, std::memory_order_relaxed);
+            if (sample < 32) {
+                LOG_WARNING(Lib_Kernel,
+                            "Dreams VideoPlayerUpdate semaphore timed out without synthetic wake: "
+                            "sem={} name='{}' needCount={}",
+                            sem.index, orbis_sems[sem]->name, needCount);
+            }
+        }
+    }
+
+    return result;
 }
 
 s32 PS4_SYSV_ABI sceKernelSignalSema(OrbisKernelSema sem, s32 signalCount) {
     if (!orbis_sems.is_allocated(sem)) {
         return ORBIS_KERNEL_ERROR_ESRCH;
     }
+    DreamsSemCallerTraceConfig* sem_trace = nullptr;
+    if (Common::ElfInfo::Instance().GameSerial() == "CUSA04301") {
+        sem_trace = GetDreamsSemTraceConfig(sem);
+    }
+    if (Common::ElfInfo::Instance().GameSerial() == "CUSA04301" && sem.index == 48) {
+        const auto caller = _ReturnAddress();
+        static std::atomic<u32> dreams_video_wait_signals{};
+        const auto sample = dreams_video_wait_signals.fetch_add(1, std::memory_order_relaxed);
+        if (sample < 32) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams video semaphore signal: thread='{}' sem={} name='{}' count={} "
+                        "caller={:#x}",
+                        Common::GetCurrentThreadName(), sem.index, orbis_sems[sem]->name,
+                        signalCount, reinterpret_cast<u64>(caller));
+            DumpDreamsSemCallerBytes("sem48", "signal", caller, g_dreams_sem48_signal_caller_dumped);
+        }
+    }
+    if (sem_trace != nullptr && sem.index != 48) {
+        const auto caller = _ReturnAddress();
+        const auto token_count_before = orbis_sems[sem]->PeekCount();
+        const auto waiters_before = orbis_sems[sem]->WaiterCount();
+        const auto sample = sem_trace->signal_logs->fetch_add(1, std::memory_order_relaxed);
+        if (sample < 128) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams {} signal caller: thread='{}' sem={} name='{}' count={} "
+                        "token_before={} waiters_before={} caller={:#x}",
+                        sem_trace->label, Common::GetCurrentThreadName(), sem.index,
+                        orbis_sems[sem]->name, signalCount, token_count_before, waiters_before,
+                        reinterpret_cast<u64>(caller));
+            DumpDreamsSemCallerBytes(sem_trace->label, "signal", caller,
+                                     *sem_trace->signal_dumped);
+        }
+    }
     if (!orbis_sems[sem]->Signal(signalCount)) {
         return ORBIS_KERNEL_ERROR_EINVAL;
     }
+    if (sem_trace != nullptr && sem.index != 48) {
+        static std::atomic<u32> dreams_targeted_signal_result_logs{};
+        const auto sample =
+            dreams_targeted_signal_result_logs.fetch_add(1, std::memory_order_relaxed);
+        if (sample < 128) {
+            LOG_WARNING(Lib_Kernel,
+                        "Dreams {} signal applied: thread='{}' sem={} name='{}' count={} "
+                        "token_after={} waiters_after={}",
+                        sem_trace->label, Common::GetCurrentThreadName(), sem.index,
+                        orbis_sems[sem]->name, signalCount, orbis_sems[sem]->PeekCount(),
+                        orbis_sems[sem]->WaiterCount());
+        }
+    }
     return ORBIS_OK;
 }
 
