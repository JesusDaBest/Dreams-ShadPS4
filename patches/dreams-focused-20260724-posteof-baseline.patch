+Frame* Presenter::PrepareDreamsFlipSnapshotFrame(bool present_thread) {
+    if (!Libraries::AvPlayer::HasDreamsFlipBufferSnapshot()) {
+        return nullptr;
+    }
+
+    constexpr u32 kDreamsFlipPreviewWidth = 1280;
+    constexpr u32 kDreamsFlipPreviewHeight = 720;
+    Frame* frame = GetRenderFrame();
+    if (frame->width != kDreamsFlipPreviewWidth || frame->height != kDreamsFlipPreviewHeight) {
+        RecreateFrame(frame, kDreamsFlipPreviewWidth, kDreamsFlipPreviewHeight);
+    }
+    const u64 byte_size = static_cast<u64>(frame->width) * frame->height * 4;
+
+    auto staging =
+        std::make_shared<VideoCore::UniqueBuffer>(instance.GetDevice(), instance.GetAllocator());
+    VmaAllocationInfo alloc_info{};
+    const vk::BufferCreateInfo buffer_info = {
+        .size = byte_size,
+        .usage = vk::BufferUsageFlagBits::eTransferSrc,
+    };
+    staging->Create(buffer_info, VideoCore::MemoryUsage::Upload, &alloc_info);
+    ASSERT_MSG(alloc_info.pMappedData != nullptr, "Dreams flip staging buffer is not mapped");
+
+    if (!Libraries::AvPlayer::BlitDreamsFlipBufferSnapshotToB8G8R8A8(
+            alloc_info.pMappedData, frame->width, frame->width, frame->height)) {
+        std::memset(alloc_info.pMappedData, 0, static_cast<size_t>(byte_size));
+    }
+
+    const auto surface_format = swapchain.GetSurfaceFormat().format;
+    if (surface_format == vk::Format::eR8G8B8A8Unorm ||
+        surface_format == vk::Format::eR8G8B8A8Srgb) {
+        auto* pixels = static_cast<u8*>(alloc_info.pMappedData);
+        for (u64 i = 0; i < byte_size; i += 4) {
+            std::swap(pixels[i + 0], pixels[i + 2]);
+        }
+    }
+
+    auto& scheduler = present_thread ? present_scheduler : draw_scheduler;
+    scheduler.EndRendering();
+    const auto cmdbuf = scheduler.CommandBuffer();
+
+    constexpr vk::ImageSubresourceRange simple_subresource = {
+        .aspectMask = vk::ImageAspectFlagBits::eColor,
+        .levelCount = 1,
+        .layerCount = 1,
+    };
+    const auto pre_barrier = vk::ImageMemoryBarrier2{
+        .srcStageMask = vk::PipelineStageFlagBits2::eColorAttachmentOutput,
+        .srcAccessMask = vk::AccessFlagBits2::eColorAttachmentRead,
+        .dstStageMask = vk::PipelineStageFlagBits2::eTransfer,
+        .dstAccessMask = vk::AccessFlagBits2::eTransferWrite,
+        .oldLayout = vk::ImageLayout::eUndefined,
+        .newLayout = vk::ImageLayout::eTransferDstOptimal,
+        .image = frame->image,
+        .subresourceRange = simple_subresource,
+    };
+    cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+        .imageMemoryBarrierCount = 1,
+        .pImageMemoryBarriers = &pre_barrier,
+    });
+
+    const vk::BufferImageCopy copy_region = {
+        .bufferOffset = 0,
+        .bufferRowLength = frame->width,
+        .bufferImageHeight = frame->height,
+        .imageSubresource =
+            {
+                .aspectMask = vk::ImageAspectFlagBits::eColor,
+                .mipLevel = 0,
+                .baseArrayLayer = 0,
+                .layerCount = 1,
+            },
+        .imageOffset = {0, 0, 0},
+        .imageExtent = {frame->width, frame->height, 1},
+    };
+    cmdbuf.copyBufferToImage(static_cast<vk::Buffer>(*staging), frame->image,
+                             vk::ImageLayout::eTransferDstOptimal, copy_region);
+
+    u32 capture_game_only_count = VideoCore::ConsumeGameOnlyScreenshotRequests();
+    if (capture_game_only_count == 0 &&
+        Common::ElfInfo::Instance().GameSerial() == "CUSA04301" &&
+        Libraries::AvPlayer::HasDreamsVideoReachedEof()) {
+        static std::atomic<u32> dreams_flip_snapshot_capture_requests{};
+        const auto request_index =
+            dreams_flip_snapshot_capture_requests.fetch_add(1, std::memory_order_relaxed);
+        if (request_index < 4) {
+            capture_game_only_count = 1;
+            AppendDreamsLiveDiag("presenter eof_flip_snapshot capture_request=%u",
+                                 request_index + 1);
+        }
+    }
+    std::vector<ScreenshotReadback> pending_screenshots;
+    if (capture_game_only_count > 0) {
+        pending_screenshots.reserve(1);
+        pending_screenshots.emplace_back(
+            instance, scheduler, ScreenshotKind::GameOnly,
+            BuildScreenshotPaths(ScreenshotKind::GameOnly, capture_game_only_count), frame->width,
+            frame->height, surface_format, false);
+        auto& readback = pending_screenshots.back();
+        const auto screenshot_barrier = vk::ImageMemoryBarrier2{
+            .srcStageMask = vk::PipelineStageFlagBits2::eTransfer,
+            .srcAccessMask = vk::AccessFlagBits2::eTransferWrite,
+            .dstStageMask = vk::PipelineStageFlagBits2::eTransfer,
+            .dstAccessMask = vk::AccessFlagBits2::eTransferRead,
+            .oldLayout = vk::ImageLayout::eTransferDstOptimal,
+            .newLayout = vk::ImageLayout::eTransferSrcOptimal,
+            .image = frame->image,
+            .subresourceRange = simple_subresource,
+        };
+        cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+            .imageMemoryBarrierCount = 1,
+            .pImageMemoryBarriers = &screenshot_barrier,
+        });
+        CopyImageToReadback(cmdbuf, frame->image, vk::ImageLayout::eTransferSrcOptimal, readback);
+        const auto post_capture_barrier = vk::ImageMemoryBarrier2{
+            .srcStageMask = vk::PipelineStageFlagBits2::eTransfer,
+            .srcAccessMask = vk::AccessFlagBits2::eTransferRead,
+            .dstStageMask = vk::PipelineStageFlagBits2::eFragmentShader,
+            .dstAccessMask = vk::AccessFlagBits2::eShaderRead,
+            .oldLayout = vk::ImageLayout::eTransferSrcOptimal,
+            .newLayout = vk::ImageLayout::eGeneral,
+            .image = frame->image,
+            .subresourceRange = simple_subresource,
+        };
+        cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+            .imageMemoryBarrierCount = 1,
+            .pImageMemoryBarriers = &post_capture_barrier,
+        });
+    } else {
+        const auto post_barrier = vk::ImageMemoryBarrier2{
+            .srcStageMask = vk::PipelineStageFlagBits2::eTransfer,
+            .srcAccessMask = vk::AccessFlagBits2::eTransferWrite,
+            .dstStageMask = vk::PipelineStageFlagBits2::eFragmentShader,
+            .dstAccessMask = vk::AccessFlagBits2::eShaderRead,
+            .oldLayout = vk::ImageLayout::eTransferDstOptimal,
+            .newLayout = vk::ImageLayout::eGeneral,
+            .image = frame->image,
+            .subresourceRange = simple_subresource,
+        };
+        cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+            .imageMemoryBarrierCount = 1,
+            .pImageMemoryBarriers = &post_barrier,
+        });
+    }
+
+    frame->ready_semaphore = scheduler.GetMasterSemaphore()->Handle();
+    frame->ready_tick = scheduler.CurrentTick();
+    scheduler.DeferOperation([staging = std::move(staging)] {});
+    if (!pending_screenshots.empty()) {
+        auto deferred_screenshots =
+            std::make_shared<std::vector<ScreenshotReadback>>(std::move(pending_screenshots));
+        scheduler.DeferPriorityOperation(
+            [deferred_screenshots]() { SavePendingScreenshots(*deferred_screenshots); });
+    }
+    SubmitInfo info{};
+    scheduler.Flush(info);
+
+    return frame;
+}
