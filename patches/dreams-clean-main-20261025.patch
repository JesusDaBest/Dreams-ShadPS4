+namespace VideoCore {
+
+constexpr bool ContainsResources(SubresourceExtent available, SubresourceExtent requested) {
+    return available.levels >= requested.levels && available.layers >= requested.layers;
+}
+
+constexpr bool ContainsResourceRange(SubresourceExtent available, SubresourceExtent requested,
+                                     u32 mip, u32 layer) {
+    return mip <= available.levels && requested.levels <= available.levels - mip &&
+           layer <= available.layers && requested.layers <= available.layers - layer;
+}
+
+constexpr SubresourceExtent UnionResources(SubresourceExtent a, SubresourceExtent b) {
+    return {std::max(a.levels, b.levels), std::max(a.layers, b.layers)};
+}
+
+inline void ExpandImageResources(ImageInfo& info, SubresourceExtent resources) {
+    if (info.resources == resources) {
+        return;
+    }
+    ASSERT(ContainsResources(resources, info.resources));
+    const auto old_resources = info.resources;
+    ASSERT(old_resources.levels > 0 && old_resources.layers > 0 && resources.levels <= 16);
+    std::array<ImageInfo::MipInfo, 16> old_layout{};
+    std::copy_n(info.mips_layout.begin(), old_resources.levels, old_layout.begin());
+    info.resources = resources;
+    info.UpdateSize();
+    u64 offset = 0;
+    for (u32 mip = 0; mip < resources.levels; ++mip) {
+        auto& layout = info.mips_layout[mip];
+        if (mip < old_resources.levels) {
+            // Render/depth targets can specify a larger stored slice than their visible
+            // dimensions. Preserve that existing stride when adding mips or layers.
+            layout = old_layout[mip];
+            ASSERT(layout.size % old_resources.layers == 0);
+            const u64 bytes = static_cast<u64>(layout.size / old_resources.layers) * resources.layers;
+            ASSERT(bytes <= std::numeric_limits<u32>::max());
+            layout.size = static_cast<u32>(bytes);
+        }
+        ASSERT(offset + layout.size <= std::numeric_limits<u32>::max());
+        layout.offset = static_cast<u32>(offset);
+        offset += layout.size;
+    }
+    info.guest_size = static_cast<u32>(offset);
+}
+
+struct TilingInfo {
+    u32 bank_swizzle{};
+    u32 micro_tiled_mips{};
+    u32 num_mips{};
+    u32 num_texels{};
+    std::array<ImageInfo::MipInfo, 16> mips{};
+    std::array<std::array<u32, 4>, 16> valid_extent{};
+};
+static_assert(sizeof(TilingInfo) == 528);
+static_assert(offsetof(TilingInfo, valid_extent) == 272);
+
+inline TilingInfo MakeTilingInfo(const ImageInfo& info, u32 levels) {
+    ASSERT(levels > 0 && levels <= info.resources.levels && levels <= 16);
+    TilingInfo params{};
+    params.bank_swizzle = info.bank_swizzle;
+    params.num_mips = levels;
+    const u32 block = info.props.is_block ? 4 : 1;
+    for (u32 mip = 0; mip < levels; ++mip) {
+        params.mips[mip] = info.mips_layout[mip];
+        auto& layout = params.mips[mip];
+        params.num_texels += layout.size / (info.num_bits / 8);
+        layout.pitch /= block;
+        layout.height /= block;
+        params.valid_extent[mip] = {
+            (std::max(info.size.width >> mip, 1u) + block - 1) / block,
+            (std::max(info.size.height >> mip, 1u) + block - 1) / block,
+            std::max(info.size.depth >> mip, 1u) * info.resources.layers, 0};
+        if (mip > 0 && AmdGpu::IsMacroTiled(info.array_mode)) {
+            // Match the unaligned dimensions passed by ImageInfo::UpdateSize.
+            u32 width = std::max((info.pitch >> mip) + block - 1, block) / block;
+            u32 height = std::max((info.size.height >> mip) + block - 1, block) / block;
+            if (info.props.is_pow2) {
+                width = std::bit_ceil(width);
+                height = std::bit_ceil(height);
+            }
+            const auto [tile_width, tile_height] =
+                GetMacroTileExtents(info.tile_mode, info.num_bits, info.num_samples, info.alt_tile);
+            if (width < tile_width || height < tile_height) {
+                params.micro_tiled_mips |= 1u << mip;
+            }
+        }
+    }
+    return params;
+}
+
+inline vk::BufferImageCopy MakeImageDownloadCopy(const ImageInfo& info, u32 mip) {
+    const auto& layout = info.mips_layout[mip];
+    return {
+        .bufferOffset = layout.offset,
+        .bufferRowLength = layout.pitch,
+        .bufferImageHeight = layout.height,
+        .imageSubresource = {
+            .aspectMask = info.props.is_depth ? vk::ImageAspectFlagBits::eDepth
+                                             : vk::ImageAspectFlagBits::eColor,
+            .mipLevel = mip, .baseArrayLayer = 0, .layerCount = info.resources.layers,
+        },
+        .imageOffset = {0, 0, 0},
+        .imageExtent = {std::max(info.size.width >> mip, 1u),
+                        std::max(info.size.height >> mip, 1u),
+                        std::max(info.size.depth >> mip, 1u)},
+    };
+}
+
+inline bool ImageHasTransferPadding(const ImageInfo& info) {
+    const auto params = MakeTilingInfo(info, info.resources.levels);
+    for (u32 mip = 0; mip < params.num_mips; ++mip) {
+        const auto& valid = params.valid_extent[mip];
+        const auto& layout = params.mips[mip];
+        const u64 visible_bytes = static_cast<u64>(valid[0]) * valid[1] * valid[2] * (info.num_bits / 8);
+        if (layout.pitch != valid[0] || layout.height != valid[1] || layout.size != visible_bytes) {
+            return true;
+        }
+    }
+    return false;
+}
