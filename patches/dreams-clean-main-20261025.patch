+namespace VideoCore::DreamsOcclusionClear {
+// OcclusionClearBinaryOutput.cs: one linear, bounds-checked dword zero per lane.
+// Its allocation also backs the previous frame's spherical-harmonic image.
+inline bool Matches(const Shader::InfoPersistent& info) {
+    return info.pgm_hash == 0x2fa79a88 && info.l_stage == Shader::LogicalStage::Compute &&
+        info.images.empty() && info.buffers.size() == 2 &&
+        info.buffers[0].buffer_type == Shader::BufferType::Guest &&
+        info.buffers[0].is_written && !info.buffers[0].is_formatted &&
+        info.buffers[1].buffer_type == Shader::BufferType::Flatbuf &&
+        !info.buffers[1].is_written;
+}
+
+inline u64 CompleteBytes(const AmdGpu::Buffer& sharp, std::array<u32,3> local,
+                         std::array<u32,3> groups, u32 base_x) {
+    const u64 bytes = u64(sharp.num_records) * sizeof(u32);
+    if (!sharp.base_address || sharp.base_address % 4 || !sharp.num_records ||
+        sharp.type || sharp.stride != 4 || sharp.swizzle_enable || sharp.cache_swizzle ||
+        sharp.add_tid_enable || sharp.GetSize() != bytes ||
+        local != std::array<u32,3>{64,1,1} || groups[1] != 1 || groups[2] != 1 ||
+        base_x || u64(groups[0]) * 64 < sharp.num_records) return 0;
+    return bytes;
+}
