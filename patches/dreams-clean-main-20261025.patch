+        info.tile_mode == AmdGpu::TileMode::DisplayLinearAligned;
+    const bool macro = info.props.is_tiled && info.tile_mode == AmdGpu::TileMode::Thin2DThin &&
+        info.array_mode == AmdGpu::ArrayMode::Array2DTiledThin1 &&
+        mip.pitch % 128 == 0 && mip.height % 64 == 0;
+    if (!linear && !macro) return {};
+    std::vector<vk::BufferImageCopy> copies;
+    // A 64 KiB prefix occupies only the first 128x64 macrotile for this layout.
+    const u32 width = macro ? std::min(info.size.width,128u) : info.size.width;
+    const u32 height = macro ? std::min(info.size.height,64u) :
+        std::min(info.size.height,u32((bytes/8+mip.pitch-1)/mip.pitch));
