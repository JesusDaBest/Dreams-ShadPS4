+        info.pixel_format != vk::Format::eR16G16B16A16Sfloat || info.num_bits != 64 ||
+        info.num_samples != 1 || info.resources.levels != 1 || info.resources.layers != 1 ||
+        info.size.depth != 1 || info.props.is_volume || info.props.is_block ||
+        info.props.is_depth || info.props.has_stencil || info.alt_tile || info.bank_swizzle ||
+        !info.size.width || !info.size.height) return {};
