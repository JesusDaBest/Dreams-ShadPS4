+TEST(GcnSwizzle, QuadBroadcastIndicesAreConstant) {
+    for (u32 lane_pattern = 0; lane_pattern < 256; ++lane_pattern) {
+        const u32 pattern = 0x8000U | lane_pattern;
+        const std::array<u64, 1> instructions{0xd8d40000U | pattern};
+        const auto spirv = TranslateToSpirv(instructions, true);
+        std::unordered_set<u32> constants;
+        u32 broadcasts = 0;
+        for (size_t offset = 5; offset < spirv.size();) {
+            const u32 word_count = spirv[offset] >> 16;
+            const auto opcode = static_cast<spv::Op>(spirv[offset] & 0xffff);
+            ASSERT_GT(word_count, 0U);
+            ASSERT_LE(offset + word_count, spirv.size());
+            if (opcode == spv::OpConstant) {
+                constants.insert(spirv[offset + 2]);
+            } else if (opcode == spv::OpGroupNonUniformQuadBroadcast) {
+                ++broadcasts;
+                EXPECT_TRUE(constants.contains(spirv[offset + 5])) << pattern;
+            }
+            offset += word_count;
+        }
+        EXPECT_GE(broadcasts, 1U);
+        EXPECT_LE(broadcasts, 4U);
+    }
+}
+
+TEST_F(GcnTest, ds_swizzle_quad_permutations) {
+    const auto runner_result = gcn_test::Runner::instance();
+    ASSERT_TRUE(runner_result.has_value()) << runner_result.error().message;
+    auto* runner = *runner_result;
+    for (u32 pattern : {0x8000U, 0x80b1U, 0x80e4U, 0x801bU, 0x805aU}) {
+        const std::array<u64, 1> instructions{0xd8d40000U | pattern};
+        const auto spirv = TranslateToSpirv(instructions, true);
+        const auto result = runner->run<std::array<u32, 32>>(spirv, std::array<u32, 4>{});
+        ASSERT_TRUE(result.has_value()) << result.error().message;
+        for (u32 lane = 0; lane < 32; ++lane) {
+            const u32 source = (lane & ~3U) | ((pattern >> (2 * (lane & 3U))) & 3U);
+            EXPECT_EQ((*result)[lane], source + 1) << pattern << ":" << lane;
+        }
+    }
+}
