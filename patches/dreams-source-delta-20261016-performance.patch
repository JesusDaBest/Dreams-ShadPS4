diff --git a/src/shader_recompiler/dreams_gpu_scalar_read.h b/src/shader_recompiler/dreams_gpu_scalar_read.h
new file mode 100644
index 000000000..b219c786e
--- /dev/null
+++ b/src/shader_recompiler/dreams_gpu_scalar_read.h
@@ -0,0 +1,158 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <map>
+#include <optional>
+#include <vector>
+
+#include "shader_recompiler/ir/program.h"
+
+namespace Shader::Optimization {
+
+inline bool DreamsGpuScalarTablesEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_GPU_NUMERIC_TABLE");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+using DreamsGpuScalarTableKey = std::array<u32, 2>; // root SGPR, parent word (or direct)
+constexpr u32 DreamsDirectScalarTable = ~u32{0};
+
+inline std::optional<u32> ScalarTableRoot(const IR::Inst* pointer) {
+    if (!pointer || pointer->GetOpcode() != IR::Opcode::CompositeConstructU32x2)
+        return {};
+    const auto* low = pointer->Arg(0).TryInstRecursive();
+    const auto* high = pointer->Arg(1).TryInstRecursive();
+    if (!low || !high || low->GetOpcode() != IR::Opcode::GetUserData ||
+        high->GetOpcode() != IR::Opcode::GetUserData)
+        return {};
+    const u32 root = static_cast<u32>(low->Arg(0).ScalarReg());
+    if (root >= NUM_USER_DATA_REGS - 1 ||
+        static_cast<u32>(high->Arg(0).ScalarReg()) != root + 1)
+        return {};
+    return root;
+}
+
+// Keep separate leaves separate: the two captured compute shaders read several
+// numeric tables, including the same camera data through a nested SRT pointer.
+// Candidate matching is independent of the read index and its uses, so a mixed
+// or dynamically indexed table can be rejected as a whole.
+inline std::optional<DreamsGpuScalarTableKey> GetDreamsGpuScalarTableKey(
+    const Info& info, const IR::Inst& inst) {
+    if (inst.GetOpcode() != IR::Opcode::ReadConst)
+        return {};
+    const auto* pointer = inst.Arg(0).TryInstRecursive();
+    if (!pointer || pointer->GetOpcode() != IR::Opcode::CompositeConstructU32x2)
+        return {};
+    const bool first = info.l_stage == LogicalStage::Compute && info.pgm_hash == 0xbb773aed;
+    const bool second = info.l_stage == LogicalStage::Compute && info.pgm_hash == 0x80aed032;
+    if (info.l_stage != LogicalStage::Compute &&
+        info.l_stage != LogicalStage::Vertex && info.l_stage != LogicalStage::Fragment)
+        return {};
+    if (const auto root = ScalarTableRoot(pointer)) {
+        if (*root == 2 && !first && !second)
+            return DreamsGpuScalarTableKey{*root, DreamsDirectScalarTable};
+        return {};
+    }
+    if (!first && !second)
+        return {};
+    const auto* low = pointer->Arg(0).TryInstRecursive();
+    const auto* high = pointer->Arg(1).TryInstRecursive();
+    if (!low || !high || low->GetOpcode() != IR::Opcode::ReadConst ||
+        high->GetOpcode() != IR::Opcode::ReadConst || !low->Arg(1).IsImmediate() ||
+        !high->Arg(1).IsImmediate() || low->Arg(1).U32() >= 4096 ||
+        high->Arg(1).U32() != low->Arg(1).U32() + 1)
+        return {};
+    const auto root = ScalarTableRoot(low->Arg(0).TryInstRecursive());
+    if (!root || root != ScalarTableRoot(high->Arg(0).TryInstRecursive()) ||
+        (*root != 0 && !(first && *root == 2)))
+        return {};
+    return DreamsGpuScalarTableKey{*root, low->Arg(1).U32()};
+}
+
+inline bool IsDreamsGpuScalarTableRead(const Info& info, const IR::Inst& inst) {
+    return GetDreamsGpuScalarTableKey(info, inst).has_value();
+}
+
+inline bool ScalarReadHasOnlyFloatUses(const IR::Inst& inst, u32 depth = 0) {
+    if (depth > 16)
+        return false;
+    for (const auto& use : inst.Uses()) {
+        const auto opcode = use.user->GetOpcode();
+        if ((opcode == IR::Opcode::SetScalarRegister || opcode == IR::Opcode::SetVectorRegister) &&
+            !use.user->HasUses()) {
+            // SSA has already forwarded register reads to their definitions.
+            // These unused assignments remain until the later dead-code pass;
+            // they do not consume a value at runtime.
+            continue;
+        }
+        if (opcode == IR::Opcode::Identity) {
+            if (!ScalarReadHasOnlyFloatUses(*use.user, depth + 1))
+                return false;
+        } else if (use.user->GetOpcode() != IR::Opcode::BitCastF32U32) {
+            // Includes descriptor composites, integer data, and nested pointers.
+            return false;
+        }
+    }
+    return true;
+}
+
+inline bool ScalarReadHasFloatUses(const IR::Inst& inst, u32 depth = 0) {
+    if (depth > 16)
+        return false;
+    return std::ranges::any_of(inst.Uses(), [&](const auto& use) {
+        return use.user->GetOpcode() == IR::Opcode::BitCastF32U32 ||
+               (use.user->GetOpcode() == IR::Opcode::Identity &&
+                ScalarReadHasFloatUses(*use.user, depth + 1));
+    });
+}
+
+struct DreamsGpuScalarTable {
+    DreamsGpuScalarTableKey key;
+    std::vector<IR::Inst*> reads;
+};
+
+inline std::vector<DreamsGpuScalarTable> FindDreamsGpuScalarTables(const IR::Program& program) {
+    struct Candidate {
+        bool valid = true;
+        bool has_float = false;
+        std::vector<IR::Inst*> reads;
+    };
+    std::map<DreamsGpuScalarTableKey, Candidate> candidates;
+    constexpr u32 max_index = 63;
+    for (auto* block : program.post_order_blocks) {
+        for (auto& inst : *block) {
+            const auto key = GetDreamsGpuScalarTableKey(program.info, inst);
+            if (!key)
+                continue;
+            auto& candidate = candidates[*key];
+            if (!inst.Arg(1).IsImmediate() || inst.Arg(1).U32() > max_index ||
+                !ScalarReadHasOnlyFloatUses(inst))
+                candidate.valid = false;
+            candidate.has_float |= ScalarReadHasFloatUses(inst);
+            candidate.reads.push_back(&inst);
+        }
+    }
+    std::vector<DreamsGpuScalarTable> tables;
+    for (auto& [key, candidate] : candidates) {
+        if (candidate.valid && candidate.has_float)
+            tables.push_back({key, std::move(candidate.reads)});
+    }
+    return tables;
+}
+
+inline std::vector<IR::Inst*> FindDreamsGpuScalarTable(const IR::Program& program) {
+    std::vector<IR::Inst*> reads;
+    for (const auto& table : FindDreamsGpuScalarTables(program))
+        reads.insert(reads.end(), table.reads.begin(), table.reads.end());
+    return reads;
+}
+
+} // namespace Shader::Optimization
