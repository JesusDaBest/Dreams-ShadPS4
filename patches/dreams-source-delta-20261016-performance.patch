+void Rasterizer::CaptureDreamsFrameResources(const Shader::Info& stage) {
+    if(!dreams_frame_capture_active || dreams_frame_capture_event>512) return;
+    scheduler.EndRendering();
+    const auto prefix=fmt::format("stage-{}",static_cast<u32>(stage.l_stage));
+    u64 hash{};std::string meta=fmt::format("hash\t{:#x}\nstage\t{}\n",stage.pgm_hash,static_cast<u32>(stage.l_stage));
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+".spv"),pipeline_cache.GetCurrentShaderSpirv(stage.l_stage),hash);
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+"-srt.bin"),stage.flattened_ud_buf,hash);
+    WriteDreamsCaptureBytes(dreams_frame_capture_event_path/"gpu-regs.bin",std::span<const u8>{reinterpret_cast<const u8*>(&liverpool->regs),sizeof(liverpool->regs)},hash);
+    WriteDreamsCaptureWords(dreams_frame_capture_event_path/(prefix+"-user-data.bin"),stage.user_data,hash);
+    WriteDreamsCaptureBytes(dreams_frame_capture_event_path/"push-data.bin",std::span<const u8>{reinterpret_cast<const u8*>(&push_data),sizeof(push_data)},hash);
+    for(u32 index=0;index<stage.buffers.size();++index) {
+        const auto& desc=stage.buffers[index];if(desc.IsSpecial()) continue;
+        const auto sharp=desc.GetSharp(stage);const u64 bytes=sharp.GetSize();
+        meta+=fmt::format("buffer{}\t{:#x}+{}\n",index,sharp.base_address,bytes);
+        if((dreams_frame_capture_event_path.filename()=="post" && !desc.is_written) || !dreams_frame_capture_material || !bytes || bytes>(static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */ && stage.pgm_hash==0x7ba4de5d?256_MB:(stage.l_stage==Shader::LogicalStage::Compute?64_MB:4_MB)) || dreams_frame_capture_bytes+bytes>(static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */?1024_MB:4096_MB) || !memory->IsValidMapping(sharp.base_address,bytes)) continue;
+        const auto [source,offset]=buffer_cache.ObtainBuffer(sharp.base_address,static_cast<u32>(bytes),false);
+        if(!source) continue;
+        std::vector<u8> data(static_cast<size_t>(bytes));
+        bool ok=true;
+        for(u64 chunk=0;chunk<bytes && ok;chunk+=16_MB) {
+            const u64 amount=std::min<u64>(16_MB,bytes-chunk);
+            ok=ReadDreamsBoundBufferForCapture(scheduler,buffer_cache,
+                vk::DescriptorBufferInfo{source->Handle(),offset,bytes},chunk,
+                std::span<u8>{data}.subspan(chunk,amount));
+        }
+        if(ok) WriteDreamsCaptureBytes(dreams_frame_capture_event_path/fmt::format("{}-buffer{}.bin",prefix,index),data,hash);
+        dreams_frame_capture_bytes+=bytes;meta+=fmt::format("buffer{}_read\t{}\n",index,ok);
+    }
+    for(u32 index=0;index<stage.samplers.size();++index) {
+        const auto sharp=stage.samplers[index].GetSharp(stage);
+        WriteDreamsCaptureBytes(dreams_frame_capture_event_path/fmt::format("{}-sampler{}.bin",prefix,index),
+            std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},hash);
+    }
+    for(u32 index=0;index<image_bindings.size();++index) {
+        const auto& entry=image_bindings[index];if(!entry.first) continue;
+        auto& image=texture_cache.GetImage(entry.first);
+        meta+=fmt::format("image{}\tguest={:#x};{}x{}x{};format={}\n",index,image.info.guest_address,
+            image.info.size.width,image.info.size.height,image.info.size.depth,vk::to_string(image.info.pixel_format));
+        const bool saved=dreams_frame_capture_material && CaptureDreamsFrameImage(entry.first,dreams_frame_capture_event_path/fmt::format("{}-image{}.bin",prefix,index));
+        meta+=fmt::format("image{}_saved\t{}\n",index,saved);
+    }
+    WriteDreamsCaptureText(dreams_frame_capture_event_path/(prefix+"-resources.tsv"),meta);
+    WriteDreamsCaptureText(dreams_frame_capture_root/"progress.tsv",dreams_frame_capture_log);
+}
