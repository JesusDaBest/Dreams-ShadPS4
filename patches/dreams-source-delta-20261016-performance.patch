@@ -0,0 +1,65 @@
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+#include "common/logging/log.h"
+
+namespace DreamsCpuTiming {
+enum Category { Direct, Indirect, Draw, DrawIndirect, Bind, ComputePipeline, GraphicsPipeline,
+                FindBuffer, SyncBuffer, Wait, Finish, BindBuffers, BindTextures, RefreshResources,
+                DmaSync, Count };
+inline constexpr std::array<const char*, Count> Names{
+    "direct", "indirect", "draw", "draw_indirect", "bind", "compute_pipeline",
+    "graphics_pipeline", "find_buffer", "sync_buffer", "wait", "finish", "bind_buffers",
+    "bind_textures", "refresh_resources", "dma_sync"};
+using Clock = std::chrono::steady_clock;
+struct State {
+    std::array<double, Count> milliseconds{};
+    std::array<unsigned long long, Count> calls{};
+    Clock::time_point report = Clock::now();
+};
+inline thread_local State state;
+struct Scope;
+inline thread_local Scope* current{};
+struct Scope {
+    Category category;
+    bool active;
+    Scope* parent{};
+    Clock::time_point begin{};
+    double children{};
+    explicit Scope(Category category_) : category(category_), active([] {
+        static const bool enabled = [] {
+            const char* value = std::getenv("SHADPS4_DREAMS_CPU_TIMING");
+            return value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }()) {
+        if (!active) return;
+        parent = current;
+        current = this;
+        begin = Clock::now();
+    }
+    ~Scope() {
+        if (!active) return;
+        const auto now = Clock::now();
+        const double elapsed = std::chrono::duration<double, std::milli>(now - begin).count();
+        state.milliseconds[category] += elapsed - children;
+        ++state.calls[category];
+        current = parent;
+        if (parent) {
+            parent->children += elapsed;
+            return;
+        }
+        const double seconds = std::chrono::duration<double>(now - state.report).count();
+        if (seconds < 1.0) return;
+        for (unsigned i = 0; i < Count; ++i) {
+            if (state.calls[i]) LOG_WARNING(Render_Vulkan,
+                "Dreams CPU timing category={} calls={} self_ms={:.3f} interval_s={:.3f}",
+                Names[i], state.calls[i], state.milliseconds[i], seconds);
+        }
+        state = {};
+    }
+};
+} // namespace DreamsCpuTiming
