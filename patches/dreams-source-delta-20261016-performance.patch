+// Conservatively bound scalar table indexing; unknown/wrapping arithmetic stays unbounded.
+static u32 InlineScalarIndexMaximum(const IR::Value value, u32 depth = 0) {
+    constexpr u32 Unknown = std::numeric_limits<u32>::max();
+    if (value.IsImmediate()) return value.U32();
+    if (depth >= 16) return Unknown;
+    const auto* inst = value.InstRecursive();
+    const auto bound = [&](u32 arg) { return InlineScalarIndexMaximum(inst->Arg(arg), depth + 1); };
+    switch (inst->GetOpcode()) {
+    case IR::Opcode::UMin32:
+    case IR::Opcode::BitwiseAnd32:
+        return std::min(bound(0), bound(1));
+    case IR::Opcode::UMinTri32:
+        return std::min({bound(0), bound(1), bound(2)});
+    case IR::Opcode::IAdd32: {
+        const u64 result = u64{bound(0)} + bound(1);
+        return result <= Unknown ? static_cast<u32>(result) : Unknown;
+    }
+    case IR::Opcode::ShiftLeftLogical32: {
+        if (!inst->Arg(1).IsImmediate()) return Unknown;
+        const u32 shift = inst->Arg(1).U32() & 31;
+        const u32 maximum = bound(0);
+        return maximum <= (Unknown >> shift) ? maximum << shift : Unknown;
+    }
+    case IR::Opcode::ShiftRightLogical32:
+        return inst->Arg(1).IsImmediate() ? bound(0) >> (inst->Arg(1).U32() & 31) : Unknown;
+    case IR::Opcode::BitFieldUExtract: {
+        if (!inst->Arg(2).IsImmediate()) return Unknown;
+        const u32 width = inst->Arg(2).U32();
+        return width < 32 ? (u32{1} << width) - 1 : Unknown;
+    }
+    default:
+        return Unknown;
+    }
