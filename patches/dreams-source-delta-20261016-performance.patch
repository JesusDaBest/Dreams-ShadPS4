+static bool CaptureDreamsSelectorParity(const Shader::Info& cs, Scheduler& scheduler,
+    VideoCore::BufferCache& cache, std::span<const vk::DescriptorBufferInfo> buffers,
+    bool before, vk::DescriptorBufferInfo args = {}) {
+    const char* root = DreamsEnvironment<"SHADPS4_DREAMS_CANDIDATE_SHADER_DIR">();
+    if (!root || cs.pgm_hash != 0x7aa925e9 || buffers.size() < 4) return false;
+    const std::filesystem::path directory{root};
+    std::error_code error;
+    if (!std::filesystem::remove(directory / (before ? "selector-parity.trigger" : "selector-parity-post.trigger"), error)) return false;
+    std::string manifest;
+    u64 hash{};
+    const auto read = [&](u32 binding, u64 offset, u64 bytes, const std::string& name, std::vector<u8>& data) {
+        if (!bytes || bytes > 2_MB || binding >= buffers.size()) return false;
+        const auto& bound = buffers[binding];
+        u64 adjustment{};
+        if (!cs.buffers[binding].IsSpecial()) {
+            const auto sharp = cs.buffers[binding].GetSharp(cs);
+            if (bound.range == VK_WHOLE_SIZE || bound.range < sharp.GetSize() || offset > sharp.GetSize() || bytes > sharp.GetSize()-offset) return false;
+            adjustment = bound.range-sharp.GetSize();
+        } else if (bound.range == VK_WHOLE_SIZE || offset > bound.range || bytes > bound.range-offset) return false;
+        data.resize(static_cast<size_t>(bytes));
+        const bool ok = ReadDreamsBoundBufferForCapture(scheduler, cache, bound, adjustment+offset, data);
+        manifest += fmt::format("{}_offset\t{}\n{}_bytes\t{}\n{}_ok\t{}\n", name, offset, name, bytes, name, ok);
+        if (ok) WriteDreamsCaptureBytes(directory / (name+".bin"), data, hash);
+        return ok;
+    };
+    if (cs.buffers[3].buffer_type != Shader::BufferType::GdsBuffer) {
+        WriteDreamsCaptureText(directory / "selector-parity-error.txt", "Unexpected GDS binding; capture rejected.\n");
+        return false;
+    }
+    std::vector<u8> gds;
+    bool ok = read(3, 0, 64_KB, before ? "parity-pre-gds" : "parity-post-gds", gds);
+    if (ok && before) {
+        std::array<u32, 3> dims{};
+        ok &= ReadDreamsBoundBufferForCapture(scheduler, cache, args, 0,
+            std::span<u8>{reinterpret_cast<u8*>(dims.data()), sizeof(dims)});
+        WriteDreamsCaptureWords(directory / "parity-dims.bin", dims, hash);
+        u32 active{}; std::memcpy(&active, gds.data()+324*4, 4);
+        manifest += fmt::format("active\t{}\ndims\t{}x{}x{}\n", active, dims[0], dims[1], dims[2]);
+        ok &= active && active <= 65536;
+        std::vector<u8> selectors;
+        if (ok) ok &= read(1, 0, u64{active}*4, "parity-selectors", selectors);
+        if (ok) {
+            u32 first=~0u, last{};
+            for(u32 i=0;i<active;++i) {u32 v{};std::memcpy(&v,selectors.data()+i*4,4);v >>= 10;first=std::min(first,v);last=std::max(last,v);}
+            std::vector<u8> lookup;
+            ok &= read(2, u64{first}*8, (u64{last}-first+1)*8, "parity-lookup", lookup);
+        }
+        if(ok) WriteDreamsCaptureText(directory / "selector-parity-post.trigger", "1\n");
+    } else if (ok) {
+        u32 a{},b{};std::memcpy(&a,gds.data()+351*4,4);std::memcpy(&b,gds.data()+352*4,4);
+        std::vector<u8> output;
+        ok &= read(0,0,std::max<u64>(8,std::max(a,b)*u64{8}),"parity-output",output);
+    }
+    manifest += fmt::format("complete\t{}\n",ok);
+    WriteDreamsCaptureText(directory / (before ? "parity-pre-manifest.tsv" : "parity-post-manifest.tsv"),manifest);
+    return true;
+}
