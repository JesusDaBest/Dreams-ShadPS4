+static void TraceDreamsResetEvent(std::string_view event, u64 shader, VAddr base, u64 size,
+                                 u64 detail = 0) {
+    if (!TraceDreamsResetEnabled()) return;
+    static std::string phase;
+    static std::ofstream stream;
+    static auto last_poll = std::chrono::steady_clock::time_point{};
+    static auto phase_started = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    const auto root = std::filesystem::path{static_cast<const char*>(nullptr) /* release: DIAG_RESET_DIR disabled */};
+    if (now - last_poll > std::chrono::milliseconds{100}) {
+        last_poll = now;
+        std::ifstream marker{root / "phase.txt"};
+        std::string next;
+        std::getline(marker, next);
+        if (next != phase) {
+            if (stream.is_open()) stream.close();
+            phase = next;
+            phase_started = now;
+            if (phase == "smush" || phase == "transition" || phase == "cleared" ||
+                phase == "menu" || phase == "pause") {
+                stream.open(root / (phase + ".tsv"), std::ios::app);
+            }
+        }
+        if (stream.is_open()) stream.flush();
+    }
+    if (!stream.is_open() || now - phase_started > std::chrono::seconds{120}) return;
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(now.time_since_epoch()).count();
+    stream << fmt::format("{}\t{}\t{:#x}\t{:#x}\t{}\t{}\n", us, event, shader, base, size, detail);
+}
