+static bool HandleDreamsSceneResourceReadiness(EXCEPTION_POINTERS* exception) noexcept {
+    constexpr u64 GateOffset = 0x9c44f7;
+    if (exception == nullptr || exception->ExceptionRecord == nullptr ||
+        exception->ContextRecord == nullptr || MemoryPatcher::g_eboot_address == 0 ||
+        reinterpret_cast<u64>(exception->ExceptionRecord->ExceptionAddress) !=
+            MemoryPatcher::g_eboot_address + GateOffset) {
+        return false;
+    }
+    const u64 base = MemoryPatcher::g_eboot_address;
+    auto* context = exception->ContextRecord;
+    const HANDLE process = GetCurrentProcess();
+    const auto read = [process](u64 address, void* value, std::size_t size) {
+        SIZE_T copied{};
+        return ReadProcessMemory(process, reinterpret_cast<const void*>(address), value, size,
+                                 &copied) && copied == size;
+    };
+    u32 floor{};
+    u8 ready_input{}, other_wait{};
+    if (!read(base + 0x44d4b40, &floor, sizeof(floor)) ||
+        !read(context->Rsp + 0x973, &ready_input, sizeof(ready_input)) ||
+        !read(context->Rsp + 0x970, &other_wait, sizeof(other_wait))) {
+        return false;
+    }
+    const auto result = DreamsSceneReadiness::EvaluateGate(
+        static_cast<u32>(context->Rax), context->Rdx, context->EFlags,
+        static_cast<u8>(context->Rcx), ready_input, other_wait, floor, [&] {
+            return DreamsSceneReadiness::ReferencedResourcesReady(base, context->R10, read);
+        });
+    context->Rax = result.rax;
+    context->Rdx = result.rdx;
+    context->EFlags = result.flags;
+    context->Rip = base + (result.wait ? 0x9c4552 : 0x9c451b);
+    return true;
+}
