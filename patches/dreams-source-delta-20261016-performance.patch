diff --git a/src/core/dreams_scene_readiness.h b/src/core/dreams_scene_readiness.h
new file mode 100644
index 000000000..22cb0666b
--- /dev/null
+++ b/src/core/dreams_scene_readiness.h
@@ -0,0 +1,151 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace Core::DreamsSceneReadiness {
+
+// CUSA04301 1.00. The resource counter can stop advancing when a resource was
+// released in the same snapshot. That permits bypassing the counter wait only
+// after the resources still referenced by the candidate scene have completed.
+// In particular, an unavailable auxiliary resource must not turn a new sculpt
+// (primary == 0xffff) into a supposedly ready scene with a missing surface.
+template <typename Read>
+bool ReferencedResourcesReady(std::uint64_t base, std::uint64_t root, Read&& read) noexcept {
+    constexpr std::uint32_t MaxObjects = 16384;
+    constexpr std::uint16_t ResourceSlots = 4096;
+    constexpr std::uint16_t None = 0xffff;
+    if (root == 0 || root > UINT64_MAX - 0x19497d0 || base > UINT64_MAX - 0x44d1738) {
+        return false;
+    }
+    const auto scalar = [&](std::uint64_t address, auto& value) {
+        return read(address, &value, sizeof(value));
+    };
+    std::uint32_t count{};
+    std::int32_t link{};
+    std::uint64_t table{};
+    std::uint8_t special_enabled{};
+    if (!scalar(root + 0x10b58c0, count) || count > MaxObjects ||
+        !scalar(root + 0x279484, link) || !scalar(base + 0x44d1730, table) ||
+        !scalar(base + 0x28ca538, special_enabled) ||
+        table > UINT64_MAX - ResourceSlots * 0x38) {
+        return false;
+    }
+    struct Special {
+        std::uint32_t id0{};
+        std::uint32_t id1{};
+        std::uint16_t slot{None};
+    };
+    std::array<Special, 4> specials{};
+    if (special_enabled) {
+        for (std::size_t i = 0; i < specials.size(); ++i) {
+            const auto address = base + 0x28ca4d0 + i * 0x1c;
+            if (!scalar(address - 8, specials[i].id0) ||
+                !scalar(address - 4, specials[i].id1) || !scalar(address, specials[i].slot)) {
+                return false;
+            }
+        }
+    }
+    std::array<std::uint64_t, ResourceSlots / 64> checked{};
+    const auto resource_ready = [&](std::uint16_t slot) {
+        if (slot >= ResourceSlots || table == 0) {
+            return false;
+        }
+        const auto mask = std::uint64_t{1} << (slot & 63);
+        if (checked[slot >> 6] & mask) {
+            return true;
+        }
+        std::uint8_t active{};
+        std::uint32_t payload{};
+        const auto address = table + std::uint64_t{slot} * 0x38;
+        if (!scalar(address + 0x1c, active) || !active ||
+            !scalar(address + 0x20, payload) || payload == UINT32_MAX) {
+            return false;
+        }
+        checked[slot >> 6] |= mask;
+        return true;
+    };
+    for (std::uint32_t steps = 0; link != -1; ++steps) {
+        // Object links encode a signed 22-bit index in their low bits.
+        const auto index = static_cast<std::int32_t>(
+            (static_cast<std::uint32_t>(link) & 0x3fffff) ^ 0x200000) - 0x200000;
+        if (steps >= count || index < 0 || static_cast<std::uint32_t>(index) >= count) {
+            return false;
+        }
+        std::uint64_t object{};
+        if (!scalar(root + 0x10958c0 + std::uint64_t(index) * 8, object)) {
+            return false;
+        }
+        if (object) {
+            std::array<std::byte, 0x174> bytes{};
+            if (object > UINT64_MAX - bytes.size() || !read(object, bytes.data(), bytes.size())) {
+                return false;
+            }
+            std::uint32_t id{}, header{}, model_input{};
+            std::uint16_t primary{}, auxiliary{};
+            std::memcpy(&id, bytes.data(), sizeof(id));
+            std::memcpy(&header, bytes.data() + 0xc, sizeof(header));
+            std::memcpy(&model_input, bytes.data() + 0x170, sizeof(model_input));
+            std::memcpy(&primary, bytes.data() + 0x40, sizeof(primary));
+            std::memcpy(&auxiliary, bytes.data() + 0x42, sizeof(auxiliary));
+            if ((header & 0x7f) == 1 && model_input != UINT32_MAX) {
+                bool special_selected = false;
+                if (special_enabled) {
+                    for (const auto& special : specials) {
+                        if (special.slot != None && (id == special.id0 || id == special.id1)) {
+                            if (!resource_ready(special.slot)) {
+                                return false;
+                            }
+                            special_selected = true;
+                            break;
+                        }
+                    }
+                }
+                if (!special_selected) {
+                    // A pending auxiliary is requested replacement work, even
+                    // if an older primary is temporarily available to render.
+                    const auto requested = auxiliary != None ? auxiliary : primary;
+                    if (!resource_ready(requested)) {
+                        return false;
+                    }
+                }
+            }
+        }
+        if (!scalar(root + 0x19397d0 + std::uint64_t(index) * 4, link)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+struct GateResult {
+    std::uint64_t rax{};
+    std::uint64_t rdx{};
+    std::uint32_t flags{};
+    bool wait{};
+};
+
+// Emulate the 36-byte compatibility gate, with its counter exception guarded
+// by actual resource readiness. Both resume sites overwrite flags before use;
+// still preserve the defined OR/setcc register and flag effects exactly.
+template <typename Ready>
+GateResult EvaluateGate(std::uint32_t current, std::uint64_t rdx, std::uint32_t flags,
+                        std::uint8_t cl, std::uint8_t ready_input, std::uint8_t other_wait,
+                        std::uint32_t floor, Ready&& resources_ready) noexcept {
+    const bool original_wait = (flags & (0x1u | 0x40u)) == 0; // SETA after CMP current, watermark
+    const bool resource_wait = original_wait && (current != floor || !resources_ready());
+    auto value = static_cast<std::uint8_t>(resource_wait + (ready_input == 0));
+    value |= other_wait | cl;
+    const auto or_flags = (value == 0 ? 0x40u : 0) | (value & 0x80u) |
+                          (std::popcount(static_cast<unsigned>(value)) % 2 == 0 ? 0x4u : 0);
+    return {(current & ~0xffu) | value, (rdx & ~0xffull) | original_wait,
+            (flags & ~(0x1u | 0x4u | 0x40u | 0x80u | 0x800u)) | or_flags, value != 0};
+}
+
+} // namespace Core::DreamsSceneReadiness
