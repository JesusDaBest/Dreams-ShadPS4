+bool Rasterizer::CaptureDreamsFrameImage(VideoCore::ImageId id,const std::filesystem::path& path) {
+    if(!id) return false;
+    auto& image=texture_cache.GetImage(id);
+    const u64 bytes=u64{image.info.size.width}*image.info.size.height*image.info.size.depth*image.info.num_bits/8;
+    if(!bytes || bytes>16_MB || image.info.props.is_block ||
+       image.info.resources.layers!=1 || image.info.resources.levels!=1) return false;
+    if(dreams_frame_capture_bytes+bytes>(static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */?1024_MB:4096_MB)) {dreams_frame_capture_truncated=true;return false;}
+    scheduler.EndRendering();
+    auto& download=buffer_cache.GetUtilityBuffer(VideoCore::MemoryUsage::Download);
+    const auto [data,offset]=download.Map(bytes,4);if(!data) return false;
+    download.Commit();
+    const auto saved=image.backing->state;
+    const auto saved_subresources=image.backing->subresource_states;
+    const std::array copies{vk::BufferImageCopy{.bufferOffset=offset,
+        .imageSubresource={image.info.props.is_depth?vk::ImageAspectFlagBits::eDepth:vk::ImageAspectFlagBits::eColor,0,0,1},
+        .imageExtent={image.info.size.width,image.info.size.height,image.info.size.depth}}};
+    image.Download(copies,download.Handle(),offset,bytes);
+    const auto restore=[&](const auto& state,auto range) {
+        const auto barriers=image.GetBarriers(state.layout,state.access_mask,state.pl_stage,range);
+        if(!barriers.empty()) scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+            .imageMemoryBarrierCount=static_cast<u32>(barriers.size()),.pImageMemoryBarriers=barriers.data()});
+    };
+    if(saved_subresources.empty()) restore(saved,std::optional<VideoCore::SubresourceRange>{});
+    else restore(saved_subresources[0],std::optional{VideoCore::SubresourceRange{
+        .base={.level=0,.layer=0},.extent={.levels=1,.layers=1}}});
+    image.backing->state=saved;image.backing->subresource_states=saved_subresources;
+    scheduler.Finish();download.InvalidateMappedRange(offset,bytes);
+    u64 hash{};const bool ok=WriteDreamsCaptureBytes(path,std::span<const u8>{data,static_cast<size_t>(bytes)},hash);
+    dreams_frame_capture_bytes+=bytes;
+    WriteDreamsCaptureText(path.string()+".tsv",fmt::format("guest\t{:#x}\nwidth\t{}\nheight\t{}\nformat\t{}\nbytes\t{}\nhash\t{:#x}\nwritten\t{}\n",
+        image.info.guest_address,image.info.size.width,image.info.size.height,vk::to_string(image.info.pixel_format),bytes,hash,ok));
+    return ok;
+}
