+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "common/types.h"
+
+namespace AmdGpu {
+
+// Keep one runnable command stream from monopolizing the interpreter while
+// another guest queue is waiting. This runs only between complete PM4 packets;
+// it neither completes GPU work nor changes ordering within a guest queue.
+class QueuePacketBudget {
+public:
+    explicit QueuePacketBudget(bool enabled_) : enabled{enabled_} {}
+
+    bool ShouldYield(bool other_work) {
+        if (!enabled || ++packets < PacketLimit) {
+            return false;
+        }
+        packets = 0;
+        return other_work;
+    }
+
+    static constexpr u32 PacketLimit = 32;
+
+private:
+    bool enabled;
+    u32 packets{};
+};
+
+} // namespace AmdGpu
