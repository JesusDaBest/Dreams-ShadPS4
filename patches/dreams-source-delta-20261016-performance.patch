index 000000000..c8618fdd1
--- /dev/null
+++ b/src/video_core/renderer_vulkan/host_passes/dreams_native_volume_pass.h
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Private opt-in native volume traversal. Inputs are live bound GPU resources.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <span>
+#include <vector>
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_platform.h"
+#include "video_core/renderer_vulkan/vk_shader_util.h"
+#include "video_core/renderer_vulkan/host_passes/native_volume_spv.h"
+
+namespace Vulkan::HostPasses {
+class DreamsNativeVolumePass {
+public:
+    static constexpr u32 MaxRoots=64;
+    static constexpr u32 CapacityPerRoot=8192;
+    static constexpr u32 MaxVisits=65536;
+    static constexpr vk::DeviceSize FallbackOffset=MaxRoots*sizeof(VkDrawIndexedIndirectCommand);
+    explicit DreamsNativeVolumePass(const Instance& instance_):instance(instance_),device(instance.GetDevice()) {
+        leaf_buffer=Allocate(u64{MaxRoots}*CapacityPerRoot*16,false);
+        result_buffer=Allocate(MaxRoots*16,false);
+        instance_buffer=Allocate(u64{MaxRoots}*CapacityPerRoot*8,false);
+        command_buffer=Allocate((MaxRoots+1)*sizeof(VkDrawIndexedIndirectCommand),false);
+        summary_buffer=Allocate(16,true);
+        summary_mapped=Check<"map native volume summary">(device.mapMemory(*summary_buffer.memory,0,16));
+        traversal=CreatePipeline(NativeVolumeSpv::Enumerate,7);
+        finalize=CreatePipeline(NativeVolumeSpv::PrepareDraws,5);
+        instance_info={*instance_buffer.buffer,0,instance_buffer.size};
+    }
+    ~DreamsNativeVolumePass() {if(summary_mapped) device.unmapMemory(*summary_buffer.memory);}
+    void BeginEpoch(vk::CommandBuffer cmd,u64 object_base) {
+        pending=true;ready=false;++epoch;source_object_base=object_base;source_coordinate_base=0;
+        Barrier(cmd,vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead|vk::AccessFlagBits2::eMemoryWrite,
+            vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferWrite);
+        cmd.fillBuffer(*result_buffer.buffer,0,result_buffer.size,0);
+        Barrier(cmd,vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eComputeShader,
+            vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eShaderStorageWrite);
+    }
+    bool AcceptsObjectBank(u64 base) const {return pending && base==source_object_base;}
+    void CancelEpoch() {pending=false;ready=false;}
+    bool Pending() const {return pending;}
+    bool Matches(u64 object_base,u64 coordinate_base) const {
+        return ready && object_base==source_object_base && coordinate_base==source_coordinate_base;
+    }
+    u64 Epoch() const {return epoch;}
+    bool Reported() const {return reported || epoch==last_report_epoch || (report_attempts>=8 && epoch<last_report_epoch+120);}
+    void MarkReported(u32 count,u32 status) {last_report_epoch=epoch;++report_attempts;reported=count>0 && status==0;}
+    std::array<u32,4> ReadSummaryAfterFinish() const {
+        std::array<u32,4> value{};std::memcpy(value.data(),summary_mapped,16);return value;
+    }
+    const vk::DescriptorBufferInfo& InstanceInfo() const {return instance_info;}
+    vk::Buffer Commands() const {return *command_buffer.buffer;}
+
+    // Input views: root queue, packed child table, coordinate words, GDS, objects.
+    bool Capture(vk::CommandBuffer cmd,std::span<const vk::DescriptorBufferInfo,5> input,
+                 u64 object_base,u64 coordinate_base) {
+        if(!pending || object_base!=source_object_base) return false;
+        if(ready && coordinate_base!=source_coordinate_base) {CancelEpoch();return false;}
+        for(const auto& view:input)
+            if(!view.buffer || view.range==0 || view.range==VK_WHOLE_SIZE) return false;
+        if(input[0].range<8 || input[1].range<24 || input[2].range<4 ||
+            input[3].range<322*4 || input[4].range<108*4) return false;
+        const auto count=std::min<u64>(input[1].range/24,input[2].range/4);
+        if(count==0 || count>1048576) return false;
+        Barrier(cmd,vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead|vk::AccessFlagBits2::eMemoryWrite,
+            vk::PipelineStageFlagBits2::eComputeShader,
+            vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eShaderStorageWrite);
+        const std::array views{input[0],input[1],input[2],View(leaf_buffer),
+            View(result_buffer),input[3],input[4]};
+        Bind(cmd,traversal,views,static_cast<u32>(count));
+        cmd.dispatch((MaxRoots+63)/64,1,1);
+        source_object_base=object_base;source_coordinate_base=coordinate_base;
+        ready=true;return true;
+    }
+
+    void Prepare(vk::CommandBuffer cmd,vk::Buffer original,vk::DeviceSize original_offset) {
+        // Finish previous reads before reusing owned command/instance buffers,
+        // and make guest indirect writes visible to the bounded command copy.
+        Barrier(cmd,vk::PipelineStageFlagBits2::eAllCommands,
+            vk::AccessFlagBits2::eMemoryRead|vk::AccessFlagBits2::eMemoryWrite,
+            vk::PipelineStageFlagBits2::eTransfer|vk::PipelineStageFlagBits2::eComputeShader,
+            vk::AccessFlagBits2::eTransferRead|vk::AccessFlagBits2::eTransferWrite|
+            vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eShaderStorageWrite);
+        cmd.copyBuffer(original,*command_buffer.buffer,vk::BufferCopy{
+            .srcOffset=original_offset,.dstOffset=FallbackOffset,.size=sizeof(VkDrawIndexedIndirectCommand)});
+        Barrier(cmd,vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eComputeShader,
+            vk::AccessFlagBits2::eShaderStorageRead|vk::AccessFlagBits2::eShaderStorageWrite);
+        const std::array views{View(leaf_buffer),View(result_buffer),View(instance_buffer),
+            View(command_buffer),View(summary_buffer)};
+        Bind(cmd,finalize,views,0);
+        cmd.dispatch((MaxRoots*CapacityPerRoot+63)/64,1,1);
+        Barrier(cmd,vk::PipelineStageFlagBits2::eComputeShader,vk::AccessFlagBits2::eShaderStorageWrite,
+            vk::PipelineStageFlagBits2::eDrawIndirect|vk::PipelineStageFlagBits2::eVertexShader|
+            vk::PipelineStageFlagBits2::eHost,
+            vk::AccessFlagBits2::eIndirectCommandRead|vk::AccessFlagBits2::eShaderStorageRead|
+            vk::AccessFlagBits2::eHostRead);
+    }
+private:
+    struct OwnedBuffer {
+        vk::UniqueDeviceMemory memory;
+        vk::UniqueBuffer buffer;
+        vk::DeviceSize size{};
+    };
+    struct PipelineState {
+        vk::UniqueDescriptorSetLayout set_layout;
+        vk::UniquePipelineLayout layout;
+        vk::UniquePipeline pipeline;
+    };
+    OwnedBuffer Allocate(vk::DeviceSize size,bool host) {
+        OwnedBuffer result;result.size=size;
+        result.buffer=Check<"create native volume buffer">(device.createBufferUnique({
+            .size=size,.usage=vk::BufferUsageFlagBits::eStorageBuffer|
+                vk::BufferUsageFlagBits::eIndirectBuffer|vk::BufferUsageFlagBits::eTransferDst,
+            .sharingMode=vk::SharingMode::eExclusive}));
+        const auto requirements=device.getBufferMemoryRequirements(*result.buffer);
+        const auto required=host?vk::MemoryPropertyFlagBits::eHostVisible|
+            vk::MemoryPropertyFlagBits::eHostCoherent:vk::MemoryPropertyFlagBits::eDeviceLocal;
+        const auto& properties=instance.GetMemoryProperties();
+        u32 type=UINT32_MAX;
+        for(u32 index=0;index<properties.memoryTypeCount;++index)
+            if((requirements.memoryTypeBits&(1u<<index)) &&
