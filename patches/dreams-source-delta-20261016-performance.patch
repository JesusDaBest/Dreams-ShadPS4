+// Private one-shot diagnostic readback. No replacement shaders or extra scene draws.
+void Rasterizer::CaptureDreamsFrameBegin(const Pipeline* pipeline) {
+    const char* generation=static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */;
+    const char* root=generation?generation:static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_FRAME_DIR disabled */;
+    if(!root || Common::ElfInfo::Instance().GameSerial()!="CUSA04301") return;
+    bool surface=false,material=false,gather=false,csg=false,compute=false;
+    std::string mode;
+    if(generation) { std::ifstream input{std::filesystem::path{root}/"capture-mode.txt"}; input>>mode; }
+    static bool csg_chain_started{};
+    static u32 generation_epoch{};
+    if(generation && !dreams_frame_capture_active) {
+        std::error_code reset_error;
+        if(std::filesystem::remove(std::filesystem::path{root}/"capture-reset.request",reset_error)) {
+            generation_epoch=0; csg_chain_started=false;
+        }
+    }
+    for(const auto* stage:pipeline->GetStages()) if(stage) {
+        compute |= stage->l_stage==Shader::LogicalStage::Compute;
+        gather |= stage->pgm_hash==0x7ba4de5d;
+        csg |= stage->pgm_hash==0x61b54af5 || stage->pgm_hash==0x44c189d5 ||
+               stage->pgm_hash==0x5650b8f7 || stage->pgm_hash==0xd049fb84 ||
+               stage->pgm_hash==0x16f35a48 ||
+               (stage->pgm_hash==0x62a348b1 && stage->flattened_ud_buf.size()>36 &&
+                stage->flattened_ud_buf[36]!=0);
+        surface |= stage->l_stage==Shader::LogicalStage::Fragment && stage->pgm_hash==0xce3b8413;
+        material |= stage->l_stage==Shader::LogicalStage::Fragment && stage->pgm_hash==0xdcc325c2;
+    }
+    std::error_code error;
+    if(!dreams_frame_capture_active) {
+        if(generation && !g_dreams_generation_dispatch_has_work) return;
+        if(!(generation?(mode=="csg"?(csg || (csg_chain_started && compute)):gather):surface) || !std::filesystem::remove(std::filesystem::path{root}/"frame.request",error)) return;
+        if(generation && generation_epoch>=(mode=="csg"?8u:64u)) return;
+        if(generation && mode=="csg") csg_chain_started=true;
+        dreams_frame_capture_root=generation?std::filesystem::path{root}/fmt::format("epoch-{:02}",++generation_epoch):std::filesystem::path{root};
+        dreams_frame_capture_active=true;dreams_frame_capture_material=generation!=nullptr;
+        dreams_frame_capture_truncated=false;dreams_frame_capture_event=0;
+        dreams_frame_capture_posts=0;dreams_frame_capture_bytes=0;
+        dreams_frame_capture_log="schema\t1\nboundary\tselected-producer-to-GPU-submit-end\ncommand-replay\tfalse\ncustom-rendering\tfalse\n";
+        std::filesystem::create_directories(dreams_frame_capture_root/"surface",error);
+        std::filesystem::create_directories(dreams_frame_capture_root/"material-inputs",error);
+        std::filesystem::create_directories(dreams_frame_capture_root/"surface/material-gpu-output",error);
+        if(!generation) WriteDreamsCaptureText(dreams_frame_capture_root/"surface/capture.trigger","ce3b8413 3706083c 0\n");
+        LOG_WARNING(Render_Vulkan,"Private scene readback started: {}",root);
+    }
+    if(material && !dreams_frame_capture_material) {
+        dreams_frame_capture_material=true;
+        WriteDreamsCaptureText(dreams_frame_capture_root/"material-inputs/capture.trigger","original inputs\n");
+        WriteDreamsCaptureText(dreams_frame_capture_root/"surface/material-gpu-output/capture.trigger","original outputs\n");
+    }
+    ++dreams_frame_capture_event;
+    if(dreams_frame_capture_event>512) {dreams_frame_capture_truncated=true;return;}
+    dreams_frame_capture_event_path=dreams_frame_capture_root/fmt::format("event-{:03}",dreams_frame_capture_event);
+    std::filesystem::create_directories(dreams_frame_capture_event_path,error);
+    dreams_frame_capture_log+=fmt::format("event\t{}\n",dreams_frame_capture_event);
+}
