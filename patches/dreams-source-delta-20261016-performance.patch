 namespace VideoCore {
 
+static bool DreamsPooledTilingAllocationsEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_POOLED_TILING_ALLOCATIONS");
+        return value && std::string_view{value} == "1";
+    }();
+    return enabled && Common::ElfInfo::Instance().GameSerial() == "CUSA04301";
+}
+
 struct TilingInfo {
     u32 bank_swizzle;
     u32 num_slices;
@@ -87,7 +98,12 @@ TileManager::ScratchBuffer TileManager::GetScratchBuffer(u32 size) {
     };
 
     const VmaAllocationCreateInfo alloc_info{
-        .flags = VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT,
+        // Let VMA reuse its blocks instead of allocating/freeing VkDeviceMemory for
+        // every scratch buffer. Deferred destruction still protects in-flight work,
+        // and VMA can choose a dedicated allocation when required by the driver.
+        .flags = DreamsPooledTilingAllocationsEnabled()
+                     ? VmaAllocationCreateFlags{}
+                     : VmaAllocationCreateFlags{VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT},
         .usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE,
     };
 
