diff --git a/src/common/precise_cpu_store.h b/src/common/precise_cpu_store.h
new file mode 100644
index 000000000..13087d055
--- /dev/null
+++ b/src/common/precise_cpu_store.h
@@ -0,0 +1,158 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <limits>
+#include "common/decoder.h"
+#include "common/signal_context.h"
+
+#if defined(_WIN32) && defined(ARCH_X86_64)
+#include <windows.h>
+#endif
+
+namespace Common {
+
+using CpuStoreCallback = bool (*)(void*, VAddr, const void*, u32);
+
+// Emulate only ordinary, fully decoded stores. A declined callback must not change
+// memory; in that case the original fault path retries the instruction normally.
+inline bool TryHandleCpuStore(void* context, VAddr fault_address, void* userdata,
+                              CpuStoreCallback write) {
+#if defined(_WIN32) && defined(ARCH_X86_64)
+    if (!write || !IsWriteError(context)) {
+        return false;
+    }
+    auto& registers = *static_cast<EXCEPTION_POINTERS*>(context)->ContextRecord;
+    const auto code = registers.Rip;
+    // Do not let decoding itself touch the next page from a fault handler.
+    const size_t available = std::min<u64>(15, 4096 - (code & 4095));
+    ZydisDecodedInstruction instruction;
+    ZydisDecodedOperand operands[ZYDIS_MAX_OPERAND_COUNT];
+    if (!ZYAN_SUCCESS(Decoder::Instance()->decodeInstruction(
+            instruction, operands, reinterpret_cast<void*>(code), available)) ||
+        instruction.address_width != 64 || instruction.operand_count_visible != 2 ||
+        (instruction.attributes & (ZYDIS_ATTRIB_HAS_LOCK | ZYDIS_ATTRIB_HAS_REP |
+                                   ZYDIS_ATTRIB_HAS_REPE | ZYDIS_ATTRIB_HAS_REPNE)) ||
+        operands[0].type != ZYDIS_OPERAND_TYPE_MEMORY ||
+        operands[0].actions != ZYDIS_OPERAND_ACTION_WRITE ||
+        operands[0].mem.type != ZYDIS_MEMOP_TYPE_MEM ||
+        (operands[0].mem.segment != ZYDIS_REGISTER_DS &&
+         operands[0].mem.segment != ZYDIS_REGISTER_SS)) {
+        return false;
+    }
+    const std::array<u64, 16> gpr{
+        registers.Rax, registers.Rcx, registers.Rdx, registers.Rbx,
+        registers.Rsp, registers.Rbp, registers.Rsi, registers.Rdi,
+        registers.R8, registers.R9, registers.R10, registers.R11,
+        registers.R12, registers.R13, registers.R14, registers.R15};
+    const auto read_gpr = [&](ZydisRegister reg, u64& value) {
+        if (reg == ZYDIS_REGISTER_NONE) {
+            value = 0;
+            return true;
+        }
+        if (ZydisRegisterGetClass(reg) != ZYDIS_REGCLASS_GPR64) {
+            return false;
+        }
+        const auto id = ZydisRegisterGetId(reg);
+        if (id < 0 || id >= gpr.size()) {
+            return false;
+        }
+        value = gpr[id];
+        return true;
+    };
+    const auto& mem = operands[0].mem;
+    u64 base, index;
+    if (!read_gpr(mem.base, base) || !read_gpr(mem.index, index)) {
+        return false;
+    }
+    const u64 scale = mem.index == ZYDIS_REGISTER_NONE ? 1 : mem.scale;
+    if (!scale || index > std::numeric_limits<u64>::max() / scale ||
+        base > std::numeric_limits<u64>::max() - index * scale) {
+        return false;
+    }
+    base += index * scale;
+    const s64 displacement = mem.disp.size ? mem.disp.value : 0;
+    const u64 magnitude = displacement < 0 ? u64(-(displacement + 1)) + 1 : u64(displacement);
+    if ((displacement < 0 && base < magnitude) ||
+        (displacement >= 0 && base > std::numeric_limits<u64>::max() - magnitude)) {
+        return false;
+    }
+    const VAddr address = displacement < 0 ? base - magnitude : base + magnitude;
+    const u32 size = operands[0].size / 8;
+    if (!size || address > std::numeric_limits<u64>::max() - size ||
+        fault_address < address || fault_address - address >= size) {
+        return false;
+    }
+    alignas(32) std::array<u8, 32> value{};
+    if (instruction.mnemonic == ZYDIS_MNEMONIC_MOV && (size == 4 || size == 8)) {
+        u64 scalar;
+        if (operands[1].type == ZYDIS_OPERAND_TYPE_IMMEDIATE) {
+            scalar = operands[1].imm.is_signed ? static_cast<u64>(operands[1].imm.value.s)
+                                               : operands[1].imm.value.u;
+        } else if (operands[1].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+                   operands[1].size == size * 8 &&
+                   ZydisRegisterGetClass(operands[1].reg.value) ==
+                       (size == 4 ? ZYDIS_REGCLASS_GPR32 : ZYDIS_REGCLASS_GPR64)) {
+            const auto id = ZydisRegisterGetId(operands[1].reg.value);
+            if (id < 0 || id >= gpr.size()) {
+                return false;
+            }
+            scalar = gpr[id];
+        } else {
+            return false;
+        }
+        std::memcpy(value.data(), &scalar, size);
+    } else if ((instruction.mnemonic == ZYDIS_MNEMONIC_VMOVUPS ||
+                instruction.mnemonic == ZYDIS_MNEMONIC_MOVUPS) && (size == 16 || size == 32) &&
+               operands[1].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+               operands[1].size == size * 8 &&
+               ZydisRegisterGetClass(operands[1].reg.value) ==
+                   (size == 16 ? ZYDIS_REGCLASS_XMM : ZYDIS_REGCLASS_YMM) &&
+               (instruction.encoding == ZYDIS_INSTRUCTION_ENCODING_VEX ||
+                instruction.encoding == ZYDIS_INSTRUCTION_ENCODING_LEGACY)) {
+        const auto id = ZydisRegisterGetId(operands[1].reg.value);
+        if (id < 0 || id >= 16 ||
+            (registers.ContextFlags & CONTEXT_FLOATING_POINT) != CONTEXT_FLOATING_POINT) {
+            return false;
+        }
+        std::memcpy(value.data(), reinterpret_cast<const u8*>(&registers.Xmm0) + id * 16, 16);
+        if (size == 32) {
+            // Windows saves the upper halves separately. Never read live YMM
+            // registers here: decoder/callback code may already have clobbered them.
+            if ((registers.ContextFlags & CONTEXT_XSTATE) != CONTEXT_XSTATE) {
+                return false;
+            }
+            DWORD64 features{};
+            if (!GetXStateFeaturesMask(&registers, &features)) {
+                return false;
+            }
+            if (features & XSTATE_MASK_AVX) {
+                DWORD length{};
+                const auto* upper = static_cast<const u8*>(
+                    LocateXStateFeature(&registers, XSTATE_AVX, &length));
+                if (!upper || length < (id + 1) * 16) {
+                    return false;
+                }
+                std::memcpy(value.data() + 16, upper + id * 16, 16);
+            }
+            // An absent AVX feature is the architectural initial state: all upper
+            // halves are zero. The value buffer already contains those zero bits.
+        }
+    } else {
+        return false;
+    }
+    if (!write(userdata, address, value.data(), size)) {
+        return false;
+    }
+    registers.Rip += instruction.length;
+    return true;
+#else
+    return false;
+#endif
+}
+
+} // namespace Common
