@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace Vulkan {
+
+template <std::size_t Size>
+struct DreamsEnvironmentName {
+    char text[Size];
+
+    constexpr DreamsEnvironmentName(const char (&name)[Size]) {
+        for (std::size_t i = 0; i < Size; ++i) {
+            text[i] = name[i];
+        }
+    }
+};
+
+// Launch options do not change during rendering. Cache misses as well as values:
+// even an absent diagnostic variable otherwise scans the CRT environment every
+// draw/dispatch. Own the string so later environment allocation cannot invalidate
+// it. A cached trigger *path* still permits its file to be created/removed live.
+template <DreamsEnvironmentName Name>
+const char* DreamsEnvironment() {
+    static const std::optional<std::string> value = []() -> std::optional<std::string> {
+        if (const char* text = std::getenv(Name.text)) {
+            return std::string{text};
+        }
+        return std::nullopt;
+    }();
+    return value ? value->c_str() : nullptr;
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h b/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h
new file mode 100644
index 000000000..e612a6882
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_primary_queue_probe.h
@@ -0,0 +1,50 @@
+// Private diagnostic only: compare 2bf queue ordering without changing shader arithmetic.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace Vulkan::DreamsPrimaryQueueProbe {
+
+constexpr bool CanOrder(std::uint32_t x, std::uint32_t y, std::uint32_t z,
+                        std::uint32_t tx, std::uint32_t ty, std::uint32_t tz,
+                        std::uint32_t sx, std::uint32_t sy, std::uint32_t sz,
+                        bool wave64, bool ordered_launch) {
+    return x != 0 && x <= 4096 && y == 1 && z == 1 && tx == 64 && ty == 1 && tz == 1 &&
+           sx == 0 && sy == 0 && sz == 0 && wave64 && ordered_launch;
+}
+
+struct QueueAudit {
+    std::uint32_t records{};
+    std::uint32_t duplicate_roots{};
+    std::uint32_t invalid_roots{};
+    std::uint32_t descending_roots{};
+};
+
+// Binding 1 contains (packed-node, original-root-index) pairs. Each accepted input root is
+// appended once; DOC changes its position, not the root ID. Never interpret pairs as sculpt count.
+inline QueueAudit Audit(std::span<const std::uint32_t> queue, std::uint32_t root_count) {
+    QueueAudit result{};
+    if (queue.size() % 2 != 0) {
+        result.invalid_roots = 1;
+        return result;
+    }
+    result.records = static_cast<std::uint32_t>(queue.size() / 2);
+    std::vector<std::uint32_t> roots;
+    roots.reserve(result.records);
+    for (std::size_t i = 1; i < queue.size(); i += 2) {
+        const auto root = queue[i];
+        result.invalid_roots += root >= root_count;
+        result.descending_roots += i > 1 && root < queue[i - 2];
+        roots.push_back(root);
+    }
+    std::ranges::sort(roots);
+    for (std::size_t i = 1; i < roots.size(); ++i) {
+        result.duplicate_roots += roots[i] == roots[i - 1];
+    }
+    return result;
+}
+
+} // namespace Vulkan::DreamsPrimaryQueueProbe
diff --git a/src/video_core/renderer_vulkan/dreams_stall_trace.h b/src/video_core/renderer_vulkan/dreams_stall_trace.h
new file mode 100644
index 000000000..900adf401
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_stall_trace.h
@@ -0,0 +1,62 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+#include "common/logging/log.h"
+#include "core/debug_state.h"
+
+namespace DreamsStallTrace {
+using Clock = std::chrono::steady_clock;
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_STALL_TRACE");
+        return value && std::string_view(value) == "1";
+    }();
+    return enabled;
+}
+inline const auto epoch = Clock::now();
+inline double Milliseconds(Clock::duration duration) {
+    return std::chrono::duration<double, std::milli>(duration).count();
+}
+struct Scope {
+    const char* category;
+    u64 identifier;
+    bool enabled = Enabled();
+    Clock::time_point start{};
+    explicit Scope(const char* name, u64 id = 0) : category(name), identifier(id) {
+        if (enabled) start = Clock::now();
+    }
+    ~Scope() {
+        if (!enabled) return;
+        const auto end = Clock::now();
+        const double elapsed = Milliseconds(end-start);
+        if (elapsed >= 3.0) LOG_WARNING(Render_Vulkan,
+            "Dreams stall category={} id={:#x} elapsed_ms={:.3f} end_ms={:.3f} frame={}",
+            category,identifier,elapsed,Milliseconds(end-epoch),DebugState.GetFrameNum());
+    }
+};
+inline void Frame() {
+    if (!Enabled()) return;
+    static auto previous = Clock::now();
+    static auto report = previous;
+    static std::array<double, 120> samples{};
+    static unsigned count{};
+    const auto now = Clock::now();
+    const double elapsed = Milliseconds(now-previous);
+    previous = now;
+    if (elapsed >= 45.0) LOG_WARNING(Render_Vulkan,
+        "Dreams stall category=frame_gap elapsed_ms={:.3f} end_ms={:.3f} frame={}",
+        elapsed,Milliseconds(now-epoch),DebugState.GetFrameNum());
+    samples[count++] = elapsed;
+    if (Milliseconds(now-report)<1000.0 && count<samples.size()) return;
+    std::sort(samples.begin(),samples.begin()+count);
+    LOG_WARNING(Render_Vulkan,
+        "Dreams frame timing samples={} median_ms={:.3f} p95_ms={:.3f} max_ms={:.3f} end_ms={:.3f} frame={}",
+        count,samples[count/2],samples[(count-1)*95/100],samples[count-1],
+        Milliseconds(now-epoch),DebugState.GetFrameNum());
+    count=0;
+    report=now;
+}
+} // namespace DreamsStallTrace
diff --git a/src/video_core/renderer_vulkan/dreams_wait_probe.h b/src/video_core/renderer_vulkan/dreams_wait_probe.h
new file mode 100644
index 000000000..3fb75481b
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dreams_wait_probe.h
@@ -0,0 +1,137 @@
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <source_location>
+#include <thread>
+
+namespace Vulkan::DreamsWaitProbe {
+using Clock = std::chrono::steady_clock;
+struct Entry {
+    const char* file{};
+    unsigned line{};
+    const char* kind{};
+    unsigned long long calls{}, nanoseconds{};
+};
+struct Writer { unsigned long long shader{}, base{}, size{}; };
+struct Readback { unsigned long long page{}, shader{}, calls{}, bytes{}; };
+struct State {
+    std::array<Entry, 256> entries{};
+    std::array<Writer, 512> writers{};
+    std::array<Readback, 512> readbacks{};
+    unsigned writer_cursor{};
+    unsigned long long request_address{}, dropped_readbacks{};
+    Clock::time_point next_check{}, deadline{}, next_report{};
+    bool active{}, finished{};
+};
+inline thread_local State state;
+inline std::mutex output_mutex;
+inline const std::filesystem::path& Root() {
+    static const auto path = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_WAIT_PROBE_DIR");
+        return value ? std::filesystem::path(value) : std::filesystem::path{};
+    }();
+    return path;
+}
+inline void Report() {
+    std::scoped_lock lock(output_mutex);
+    std::ofstream out(Root() / "waits.tsv", std::ios::app);
+    std::ofstream addresses(Root() / "readback-addresses.tsv", std::ios::app);
+    for (const auto& readback : state.readbacks) {
+        if (readback.calls) addresses << readback.page << '\t' << readback.shader << '\t'
+            << readback.calls << '\t' << readback.bytes << '\n';
+    }
+    addresses << "dropped\t0\t" << state.dropped_readbacks << "\t0\n";
+    state.readbacks = {};
+    state.dropped_readbacks = 0;
+    for (const auto& entry : state.entries) {
+        if (entry.calls) {
+            out << std::this_thread::get_id() << '\t' << entry.kind << '\t'
+                << entry.file << '\t' << entry.line << '\t' << entry.calls << '\t'
+                << entry.nanoseconds << '\n';
+        }
+    }
+    state.entries = {};
+}
+inline void ObserveWriter(unsigned long long shader, unsigned long long base,
+                          unsigned long long size) {
+    if (!state.active || state.finished) return;
+    state.writers[state.writer_cursor++ % state.writers.size()] = {shader, base, size};
+}
+inline void ObserveDownload(unsigned long long bytes) {
+    if (!state.active || state.finished) return;
+    const auto address = state.request_address;
+    unsigned long long shader{};
+    for (unsigned i = 0; i < state.writers.size(); ++i) {
+        const auto& writer = state.writers[(state.writer_cursor - 1 - i) % state.writers.size()];
+        if (address >= writer.base && address - writer.base < writer.size) {
+            shader = writer.shader;
+            break;
+        }
+    }
+    const auto page = address & ~4095ULL;
+    for (auto& entry : state.readbacks) {
+        if (!entry.calls || (entry.page == page && entry.shader == shader)) {
+            entry.page = page;
+            entry.shader = shader;
+            ++entry.calls;
+            entry.bytes += bytes;
+            return;
+        }
+    }
+    ++state.dropped_readbacks;
+}
+class Scope {
+public:
+    Scope(const char* kind, std::source_location source) : kind(kind), source(source) {
+        if (Root().empty() || state.finished) return;
+        const auto now = Clock::now();
+        if (!state.active && now >= state.next_check) {
+            state.next_check = now + std::chrono::seconds(1);
+            std::error_code error;
+            if (std::filesystem::exists(Root() / "arm.request", error)) {
+                state.active = true;
+                state.deadline = now + std::chrono::seconds(30);
+                state.next_report = now + std::chrono::seconds(5);
+            }
+        }
+        if (!state.active) return;
+        if (now >= state.deadline) {
+            Report();
+            state.finished = true;
+            state.active = false;
+            return;
+        }
+        enabled = true;
+        start = now;
+    }
+    ~Scope() {
+        if (!enabled) return;
+        const auto now = Clock::now();
+        for (auto& entry : state.entries) {
+            if (!entry.file || (entry.file == source.file_name() &&
+                                entry.line == source.line() && entry.kind == kind)) {
+                entry.file = source.file_name();
+                entry.line = source.line();
+                entry.kind = kind;
+                ++entry.calls;
+                entry.nanoseconds += std::chrono::duration_cast<std::chrono::nanoseconds>(now-start).count();
+                break;
+            }
+        }
+        if (now >= state.next_report) {
+            Report();
+            state.next_report = now + std::chrono::seconds(5);
+        }
+    }
+private:
+    const char* kind;
+    std::source_location source;
+    Clock::time_point start{};
+    bool enabled{};
+};
+}
diff --git a/src/video_core/renderer_vulkan/host_passes/dreams_native_volume_pass.h b/src/video_core/renderer_vulkan/host_passes/dreams_native_volume_pass.h
