+struct DreamsPrimaryQueueProbeState {
+    std::filesystem::path root;
+    std::filesystem::path pending_tail;
+    std::chrono::steady_clock::time_point last_poll{};
+    bool ordered{};
+    u32 remaining{};
+    u32 ordinal{};
+};
+
+static DreamsPrimaryQueueProbeState& PrimaryQueueProbeState() {
+    static DreamsPrimaryQueueProbeState state = [] {
+        DreamsPrimaryQueueProbeState result;
+        const char* root = DreamsEnvironment<"SHADPS4_DREAMS_PRIMARY_QUEUE_PROBE_DIR">();
+        if (root != nullptr && root[0] != '\0') {
+            result.root = root;
+        }
+        return result;
+    }();
+    return state;
+}
+
+static void PollPrimaryQueueProbe() {
+    auto& state = PrimaryQueueProbeState();
+    if (state.root.empty()) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - state.last_poll < std::chrono::milliseconds{250}) {
+        return;
+    }
+    state.last_poll = now;
+    std::string mode;
+    std::ifstream input{state.root / "mode.txt"};
+    std::getline(input, mode);
+    if ((mode == "native" || mode == "ordered") && state.ordered != (mode == "ordered")) {
+        state.ordered = mode == "ordered";
+        LOG_WARNING(Render_Vulkan, "Dreams primary queue comparison mode={}", mode);
+    }
+    std::error_code error;
+    if (state.remaining == 0 && std::filesystem::remove(state.root / "capture.request", error)) {
+        state.remaining = 3;
+    }
+}
+
+static bool ReadPrimaryQueueProbeGds(Scheduler& scheduler, VideoCore::BufferCache& cache,
+                                     std::array<u32, 384>& words) {
+    auto* gds = cache.GetGdsBuffer();
+    if (gds->mapped_data.size() < sizeof(words)) {
+        return false;
+    }
+    scheduler.EndRendering();
+    const vk::BufferMemoryBarrier2 barrier{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eHost,
+        .dstAccessMask = vk::AccessFlagBits2::eHostRead,
+        .buffer = gds->Handle(),
+        .offset = 0,
+        .size = sizeof(words),
+    };
+    scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+        .bufferMemoryBarrierCount = 1, .pBufferMemoryBarriers = &barrier});
+    scheduler.Finish();
+    gds->InvalidateMappedRange(0, sizeof(words));
+    std::memcpy(words.data(), gds->mapped_data.data(), sizeof(words));
+    return true;
+}
