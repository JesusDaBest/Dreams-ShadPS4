+void Rasterizer::CaptureDreamsFramePost() {
+    if(!dreams_frame_capture_active || !dreams_frame_capture_material || dreams_frame_capture_event>512) return;
+    ++dreams_frame_capture_posts;
+    const auto* pipeline=pipeline_cache.GetGraphicsPipeline();
+    const u32 mask=pipeline?pipeline->GetGraphicsKey().mrt_mask:0;
+    for(u32 index=0;index<cb_descs.size();++index) if(cb_descs[index].first && (mask & (1u<<index)) && liverpool->regs.color_target_mask.GetMask(index)) {
+        CaptureDreamsFrameImage(cb_descs[index].first,dreams_frame_capture_event_path/fmt::format("post-mrt{}.bin",index));
+    }
+}
+
+void Rasterizer::CaptureDreamsFrameEnd() {
+    if(!dreams_frame_capture_active) return;
+    for(u32 index=0;index<image_bindings.size();++index) if(image_bindings[index].first) CaptureDreamsFrameImage(image_bindings[index].first,dreams_frame_capture_root/fmt::format("submission-final-image{}.bin",index));
+    dreams_frame_capture_active=false;
+    if(const char* generation=static_cast<const char*>(nullptr) /* release: DIAGNOSTIC_GENERATION_DIR disabled */) {
+        WriteDreamsCaptureText(std::filesystem::path{generation}/"frame.request","next generation epoch\n");
+    }
+    const bool inputs=std::filesystem::exists(dreams_frame_capture_root/"material-inputs/inputs-complete.txt");
+    const bool outputs=std::filesystem::exists(dreams_frame_capture_root/"surface/material-gpu-output/complete.txt");
+    dreams_frame_capture_log+=fmt::format("events\t{}\npost_draws\t{}\nsmall_readback_bytes\t{}\nmaterial_inputs\t{}\nmaterial_outputs\t{}\nevent_limit_reached\t{}\n",
+        dreams_frame_capture_event,dreams_frame_capture_posts,dreams_frame_capture_bytes,inputs,outputs,dreams_frame_capture_truncated);
+    WriteDreamsCaptureText(dreams_frame_capture_root/"submission-complete.tsv",dreams_frame_capture_log);
+    LOG_WARNING(Render_Vulkan,"Private scene readback ended: events={} inputs={} outputs={} {}",
+        dreams_frame_capture_event,inputs,outputs,dreams_frame_capture_root.string());
+}
+
+void Rasterizer::CaptureDreamsMaterialInputs(const GraphicsPipeline* pipeline, bool is_indexed, u32 index_offset, bool is_indirect, VAddr command_address, u32 command_stride, u32 max_commands, VAddr count_address) {
+    const char* candidate_directory=DreamsEnvironment<"SHADPS4_DREAMS_CANDIDATE_SHADER_DIR">();
+    if (candidate_directory && Common::ElfInfo::Instance().GameSerial()=="CUSA04301") {
+        const auto candidate_stages=pipeline->GetStages();
+        const char* candidate_target_text = DreamsEnvironment<"SHADPS4_DREAMS_CANDIDATE_FRAGMENT_HASH">();
+        u64 candidate_target = candidate_target_text ? std::strtoull(candidate_target_text, nullptr, 16) : 0x55ae1619;
+        u64 vertex_target{};
+        u32 skip_target{};
+        const std::filesystem::path candidate_output{candidate_directory};
+        std::error_code candidate_error;
+        const bool armed = std::filesystem::exists(candidate_output / "capture.trigger", candidate_error);
+        static u32 matching_draws{};
+        if (!armed) matching_draws = 0;
+        if (armed) {
+            std::ifstream request(candidate_output / "capture.trigger");
+            u64 requested_fragment{};
+            if (request >> std::hex >> requested_fragment) {
+                candidate_target = requested_fragment;
+                request >> std::hex >> vertex_target >> std::dec >> skip_target;
+            }
+        }
+        const bool candidate = armed && std::ranges::any_of(candidate_stages,[candidate_target](const Shader::Info* stage) {
+            return stage && stage->l_stage==Shader::LogicalStage::Fragment && stage->pgm_hash==candidate_target;
+        }) && (!vertex_target || std::ranges::any_of(candidate_stages,[vertex_target](const Shader::Info* stage) {
+            return stage && stage->l_stage==Shader::LogicalStage::Vertex && stage->pgm_hash==vertex_target;
+        }));
+        if (candidate && matching_draws++ >= skip_target &&
+            std::filesystem::remove(candidate_output / "capture.trigger",candidate_error)) {
+            matching_draws = 0;
+            u64 candidate_hash{};
+            bool candidate_ok=WriteDreamsCaptureWords(candidate_output / "vs.spv",
+                pipeline_cache.GetCurrentShaderSpirv(Shader::LogicalStage::Vertex),candidate_hash);
+            candidate_ok &= WriteDreamsCaptureWords(candidate_output / "fs.spv",
+                pipeline_cache.GetCurrentShaderSpirv(Shader::LogicalStage::Fragment),candidate_hash);
+            std::string candidate_metadata{"phase\tshader-resource-description\ncomplete-draw\tfalse\n"};
+            for (const auto* stage:candidate_stages) {
+                if (!stage) continue;
+                const auto prefix=fmt::format("stage-{}",static_cast<u32>(stage->l_stage));
+                candidate_metadata+=fmt::format("{}_hash\t{:#x}\n",prefix,stage->pgm_hash);
+                candidate_ok &= WriteDreamsCaptureWords(candidate_output / (prefix+"-srt.bin"),stage->flattened_ud_buf,candidate_hash);
+                candidate_ok &= WriteDreamsCaptureWords(candidate_output / (prefix+"-user-data.bin"),stage->user_data,candidate_hash);
+                for (u32 index=0;index<stage->buffers.size();++index) {
+                    const auto& desc=stage->buffers[index];
+                    if (desc.IsSpecial()) {
+                        candidate_metadata+=fmt::format("{}_buffer{}_special\t{}\n",prefix,index,static_cast<u32>(desc.buffer_type));
+                        continue;
+                    }
+                    const auto sharp=desc.GetSharp(*stage);
+                    candidate_metadata+=fmt::format("{}_buffer{}\t{:#x}+{};stride={}\n",prefix,index,sharp.base_address,sharp.GetSize(),sharp.stride);
+                    candidate_ok &= WriteDreamsCaptureBytes(candidate_output / fmt::format("{}-buffer{}-descriptor.bin",prefix,index),
+                        std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},candidate_hash);
+                }
+                for (u32 index=0;index<stage->images.size();++index) {
+                    const auto sharp=stage->images[index].GetSharp(*stage);
+                    candidate_ok &= WriteDreamsCaptureBytes(candidate_output / fmt::format("{}-image{}-descriptor.bin",prefix,index),
+                        std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},candidate_hash);
+                }
+                for (u32 index=0;index<stage->samplers.size();++index) {
+                    const auto sharp=stage->samplers[index].GetSharp(*stage);
+                    candidate_ok &= WriteDreamsCaptureBytes(candidate_output / fmt::format("{}-sampler{}.bin",prefix,index),
+                        std::span<const u8>{reinterpret_cast<const u8*>(&sharp),sizeof(sharp)},candidate_hash);
+                }
+                candidate_metadata+=fmt::format("{}_images\t{}\n{}_samplers\t{}\n",prefix,stage->images.size(),prefix,stage->samplers.size());
+            }
+            const auto& candidate_regs = liverpool->regs;
+            candidate_metadata += fmt::format("indirect\t{}\ncommand_address\t{:#x}\n", is_indirect, command_address);
+            candidate_metadata += fmt::format("indexed\t{}\nindex_offset\t{}\nvertex_count\t{}\ninstance_count\t{}\n",
+                is_indexed, index_offset, candidate_regs.num_indices,
+                candidate_regs.num_instances.NumInstances());
+            candidate_ok &= WriteDreamsCaptureBytes(candidate_output / "gpu-regs.bin",
+                std::span<const u8>{reinterpret_cast<const u8*>(&candidate_regs), sizeof(candidate_regs)}, candidate_hash);
+            // Optional one-shot geometry readback. Hard limits exclude textures and large arenas.
+            if (is_indirect) {
+                const u32 command_size = is_indexed ? 20 : 16;
+                u32 draw_count = max_commands;
+                bool count_ok = true;
+                if (count_address) {
+                    const auto [counter, counter_offset] = buffer_cache.ObtainBuffer(count_address, 4, false);
+                    count_ok = counter && ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                        vk::DescriptorBufferInfo{counter->Handle(), counter_offset, 4}, 0,
+                        std::span<u8>{reinterpret_cast<u8*>(&draw_count), 4});
+                    draw_count = std::min(draw_count, max_commands);
+                }
+                const u32 captured_stride = command_stride ? command_stride : command_size;
+                std::vector<u8> all_commands;
+                bool commands_ok = count_ok && captured_stride >= command_size && draw_count <= 4096;
+                const u64 list_bytes = draw_count ? u64{draw_count - 1} * captured_stride + command_size : 0;
+                commands_ok &= list_bytes <= 256_KB;
+                if (commands_ok && list_bytes) {
+                    const auto [list, list_offset] = buffer_cache.ObtainBuffer(command_address, static_cast<u32>(list_bytes), false);
+                    all_commands.resize(static_cast<size_t>(list_bytes));
+                    commands_ok = list && ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                        vk::DescriptorBufferInfo{list->Handle(), list_offset, list_bytes}, 0, all_commands);
+                    if (commands_ok) WriteDreamsCaptureBytes(candidate_output / "indirect-commands-all.gpu.bin", all_commands, candidate_hash);
+                }
+                candidate_metadata += fmt::format("indirect_draw_count\t{}\nindirect_command_stride\t{}\nindirect_commands_complete\t{}\n", draw_count, captured_stride, commands_ok);
+                const auto [source, source_offset] = buffer_cache.ObtainBuffer(command_address, command_size, false);
+                std::array<u8, 20> command_bytes{};
+                const bool command_ok = source && ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                    vk::DescriptorBufferInfo{source->Handle(), source_offset, command_size}, 0,
+                    std::span<u8>{command_bytes}.first(command_size));
+                candidate_metadata += fmt::format("indirect_command_download_ok\t{}\n", command_ok);
+                if (command_ok) {
+                    WriteDreamsCaptureBytes(candidate_output / "indirect-command.gpu.bin",
+                        std::span<const u8>{command_bytes}.first(command_size), candidate_hash);
+                    u32 actual_instances{};
+                    std::memcpy(&actual_instances, command_bytes.data() + 4, sizeof(actual_instances));
+                    candidate_metadata += fmt::format("indirect_actual_instances\t{}\n", actual_instances);
+                    // A selected preview draw needs its real GPU command, not the
+                    // unrelated nominal Liverpool counts. No texture readback.
+                    if (is_indexed) {
+                        u32 actual_indices{}, first_index{}, first_instance{};
+                        std::memcpy(&actual_indices, command_bytes.data(), 4);
+                        std::memcpy(&first_index, command_bytes.data() + 8, 4);
+                        std::memcpy(&first_instance, command_bytes.data() + 16, 4);
+                        candidate_metadata += fmt::format("indirect_actual_indices\t{}\n"
+                            "indirect_first_index\t{}\nindirect_first_instance\t{}\n",
+                            actual_indices, first_index, first_instance);
+                        // One-shot bounded preview record capture from the actual draw bindings.
+                        for (const auto* stage : candidate_stages) {
+                            if (!stage || stage->pgm_hash != 0x3706083c || stage->buffers.size() < 5 ||
+                                !actual_instances || actual_instances > 4096) continue;
+                            size_t bound_base{};
+                            for (const auto* previous : candidate_stages) {
+                                if (previous == stage) break;
+                                if (previous) bound_base += previous->buffers.size();
+                            }
+                            u64 downloaded{};
+                            const auto read_slice = [&](u32 binding, u64 offset, u64 bytes, std::vector<u8>& data) {
+                                const auto sharp = stage->buffers[binding].GetSharp(*stage);
+                                if (!bytes || bytes > 4_MB || downloaded + bytes > 8_MB ||
+                                    offset > sharp.GetSize() || bytes > sharp.GetSize() - offset ||
+                                    bound_base + binding >= buffer_infos.size()) return false;
+                                const auto& bound = buffer_infos[bound_base + binding];
+                                if (bound.range == VK_WHOLE_SIZE || bound.range < sharp.GetSize()) return false;
+                                data.resize(static_cast<size_t>(bytes));
+                                downloaded += bytes;
+                                const bool ok = ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                                    bound, bound.range - sharp.GetSize() + offset, data);
+                                candidate_metadata += fmt::format("vs370_buffer{}_offset\t{}\nvs370_buffer{}_bytes\t{}\nvs370_buffer{}_read_ok\t{}\n",
+                                    binding, offset, binding, bytes, binding, ok);
+                                if (ok) WriteDreamsCaptureBytes(candidate_output / fmt::format("vs370-buffer{}.gpu.bin", binding), data, candidate_hash);
+                                return ok;
+                            };
+                            std::vector<u8> records;
+                            if (!read_slice(3, u64{first_instance} * 8, u64{actual_instances} * 8, records)) continue;
+                            u32 min_key = ~0u, max_key{}, min_object = ~0u, max_object{};
+                            for (u32 instance = 0; instance < actual_instances; ++instance) {
+                                u32 key{}, object{};
+                                std::memcpy(&key, records.data() + u64{instance} * 8, 4);
+                                std::memcpy(&object, records.data() + u64{instance} * 8 + 4, 4);
+                                key &= 0xffffff; object &= 0xffff;
+                                min_key = std::min(min_key, key); max_key = std::max(max_key, key);
+                                min_object = std::min(min_object, object); max_object = std::max(max_object, object);
+                            }
+                            std::vector<u8> data;
+                            read_slice(0, u64{min_object} * 432, (u64{max_object} - min_object + 1) * 432, data);
+                            for (u32 binding : {1u, 2u, 4u}) {
+                                const u64 stride = binding == 4 ? 16 : 4;
+                                read_slice(binding, u64{min_key} * stride, (u64{max_key} - min_key + 1) * stride, data);
+                            }
+                            candidate_metadata += fmt::format("vs370_download_bytes\t{}\nvs370_source\tsettled-vulkan-binding\n", downloaded);
+                        }
+                        for (const auto* stage : candidate_stages) {
+                            if (!stage || stage->pgm_hash != 0xd25db925 || stage->buffers.size() < 3)
+                                continue;
+                            const auto sharp = stage->buffers[0].GetSharp(*stage);
+                            u64 first_selector = first_instance;
+                            u64 end_selector = first_selector + actual_instances;
+                            if (commands_ok && is_indexed) {
+                                for (u32 command = 0; command < draw_count; ++command) {
+                                    u32 instances{}, first{};
+                                    std::memcpy(&instances, all_commands.data() + u64{command} * captured_stride + 4, 4);
+                                    std::memcpy(&first, all_commands.data() + u64{command} * captured_stride + 16, 4);
+                                    if (!instances) continue;
+                                    first_selector = std::min(first_selector, u64{first});
+                                    end_selector = std::max(end_selector, u64{first} + instances);
+                                }
+                            }
+                            const u64 offset = first_selector * 4;
+                            const u64 count = std::min<u64>(end_selector - first_selector, 262144);
+                            const u64 bytes = count * 4;
+                            if (!bytes || offset > sharp.GetSize() || bytes > sharp.GetSize() - offset)
+                                continue;
+                            size_t bound_base{};
+                            bool bound_found{};
+                            for (const auto* bound_stage : candidate_stages) {
+                                if (!bound_stage) continue;
+                                if (bound_stage == stage) { bound_found = true; break; }
+                                bound_base += bound_stage->buffers.size();
+                            }
+                            std::vector<u8> selected(static_cast<size_t>(bytes));
+                            const bool bound_valid = bound_found && bound_base < buffer_infos.size() &&
+                                buffer_infos[bound_base].range != VK_WHOLE_SIZE &&
+                                buffer_infos[bound_base].range >= sharp.GetSize();
+                            const bool read = bound_valid && ReadDreamsBoundBufferForCapture(
+                                scheduler, buffer_cache, buffer_infos[bound_base],
+                                buffer_infos[bound_base].range - sharp.GetSize() + offset, selected);
+                            candidate_metadata += fmt::format("d25_selector_prefix_read_ok\t{}\n"
+                                "d25_selector_prefix_count\t{}\nd25_selector_prefix_complete\t{}\n"
+                                "d25_selector_source\tsettled-vulkan-binding\n"
+                                "d25_selector_first\t{}\n",
+                                read, count, count == end_selector - first_selector, first_selector);
+                            if (read) WriteDreamsCaptureBytes(candidate_output / "d25-selectors-prefix.gpu.bin",
+                                selected, candidate_hash);
+                        }
+                    }
+                }
+            }
+            if ((!is_indirect || dreams_frame_capture_active) && DreamsEnvironment<"SHADPS4_DREAMS_CANDIDATE_GEOMETRY_CAPTURE">()) {
+                u64 downloaded{};
+                bool geometry_ok = true;
+                const auto save_buffer = [&](const std::string& name, VAddr address, u64 size) {
+                    if (!size || !address || size > (dreams_frame_capture_active ? 256_MB : 4_MB) ||
+                        downloaded + size > (dreams_frame_capture_active ? 512_MB : 8_MB) ||
+                        !memory->IsValidMapping(address, size)) return false;
+                    const auto [source, offset] = buffer_cache.ObtainBuffer(address, static_cast<u32>(size), false);
+                    if (!source) return false;
+                    std::vector<u8> bytes(static_cast<size_t>(size));
+                    downloaded += size;
+                    if (!ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                        vk::DescriptorBufferInfo{source->Handle(), offset, size}, 0, bytes)) return false;
+                    return WriteDreamsCaptureBytes(candidate_output / name, bytes, candidate_hash);
+                };
+                for (const auto* stage : candidate_stages) {
+                    if (!stage) continue;
+                    for (u32 i = 0; i < stage->buffers.size(); ++i) {
+                        const auto& desc = stage->buffers[i];
+                        if (desc.IsSpecial()) continue;
+                        const auto sharp = desc.GetSharp(*stage);
+                        const auto name = fmt::format("stage-{}-buffer{}.bin", static_cast<u32>(stage->l_stage), i);
+                        u64 capture_offset{};
+                        u64 capture_size = sharp.GetSize();
+                        // Audited 8593 vertex accesses: (SRT[28] + instance) * 136,
+                        // with immediate adjacent records in the connected-surface branch.
+                        if (stage->pgm_hash == 0x8593ecd8 && i == 0 &&
+                            stage->flattened_ud_buf.size() > 28) {
+                            const u64 first = stage->flattened_ud_buf[28];
+                            const u64 instances = candidate_regs.num_instances.NumInstances();
+                            const u64 capacity = sharp.GetSize() / 136;
+                            const u64 begin = first ? first - 1 : 0;
+                            const u64 end = std::min(capacity, first + instances + 1);
+                            capture_offset = begin * 136;
+                            capture_size = end > begin ? (end - begin) * 136 : 0;
+                            candidate_metadata += fmt::format("{}_slice_offset\t{}\n{}_slice_size\t{}\n{}_first_record\t{}\n{}_negative_neighbor_available\t{}\n",
+                                name, capture_offset, name, capture_size, name, first, name, first != 0);
+                        }
+                        const bool saved = capture_offset <= std::numeric_limits<VAddr>::max() - sharp.base_address &&
+                            save_buffer(name, sharp.base_address + capture_offset, capture_size);
+                        candidate_metadata += fmt::format("{}_captured\t{}\n", name, saved);
+                        geometry_ok &= saved;
+                    }
+                }
+                if (is_indexed) {
+                    const u64 element_size = candidate_regs.index_buffer_type.index_type == AmdGpu::IndexType::Index16 ? 2 : 4;
+                    const u64 offset = u64{index_offset} * element_size;
+                    const VAddr base = candidate_regs.index_base_address.Address<VAddr>();
+                    geometry_ok &= offset <= std::numeric_limits<VAddr>::max() - base &&
+                        save_buffer("indices.bin", base + offset, u64{candidate_regs.num_indices} * element_size);
+                }
+                candidate_metadata += fmt::format("geometry_buffers_complete\t{}\ngeometry_download_bytes\t{}\ngeometry_source\tguest-address-buffer-cache\n",
+                    geometry_ok, downloaded);
+            }
+            candidate_metadata+=fmt::format("metadata_complete\t{}\n",candidate_ok);
+            WriteDreamsCaptureText(candidate_output / "manifest.tsv",candidate_metadata);
+        }
+    }
+    const char* directory = DreamsEnvironment<"SHADPS4_DREAMS_MATERIAL_CAPTURE_DIR">();
+    if (!directory || Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+    const auto stages = pipeline->GetStages();
+    const bool is_material = std::ranges::any_of(stages, [](const Shader::Info* stage) {
+        return stage && stage->l_stage == Shader::LogicalStage::Fragment &&
+               stage->pgm_hash == 0xdcc325c2;
+    });
+    if (!is_material) return;
+    const std::filesystem::path output{directory};
+    std::error_code error;
+    static u32 selection_attempts{};
+    if (!std::filesystem::exists(output / "capture.trigger", error)) {
+        selection_attempts = 0;
+        return;
+    }
+    const auto select_sculpt_draw = [&]() {
+        if (dreams_material_fragment_image_bindings.size() < 5) return false;
+        const auto id = dreams_material_fragment_image_bindings[4].first;
+        if (!id) return false;
+        auto& image = texture_cache.GetImage(id);
+        if (image.info.pixel_format != vk::Format::eR32G32Uint ||
+            image.info.size.depth != 1 || image.info.resources.layers != 1 ||
+            image.info.resources.levels != 1) return false;
+        const u64 bytes=u64{image.info.size.width}*image.info.size.height*8;
+        if (!bytes || bytes > 16_MB) return false;
+        auto& download=buffer_cache.GetUtilityBuffer(VideoCore::MemoryUsage::Download);
+        const auto [data,offset]=download.Map(bytes,4);
+        if (!data) return false;
+        download.Commit();
+        const auto saved=image.backing->state;
+        const auto saved_subresources=image.backing->subresource_states;
+        const std::array copies{vk::BufferImageCopy{.bufferOffset=offset,
+            .imageSubresource={vk::ImageAspectFlagBits::eColor,0,0,1},
+            .imageExtent={image.info.size.width,image.info.size.height,1}}};
+        image.Download(copies,download.Handle(),offset,bytes);
+        const auto restore=[&](const auto& state,auto range) {
+            const auto barriers=image.GetBarriers(state.layout,state.access_mask,state.pl_stage,range);
+            if (!barriers.empty()) scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+                .imageMemoryBarrierCount=static_cast<u32>(barriers.size()),.pImageMemoryBarriers=barriers.data()});
+        };
+        if (saved_subresources.empty()) restore(saved,std::optional<VideoCore::SubresourceRange>{});
+        else restore(saved_subresources[0],std::optional{VideoCore::SubresourceRange{
+            .base={.level=0,.layer=0},.extent={.levels=1,.layers=1}}});
+        image.backing->state=saved;
+        image.backing->subresource_states=saved_subresources;
+        scheduler.Finish();
+        download.InvalidateMappedRange(offset,bytes);
+        u64 sculpt_pixels{};
+        for (u64 position=4;position<bytes;position+=8) {
+            u32 packed;
+            std::memcpy(&packed,data+position,sizeof(packed));
+            sculpt_pixels += (packed >> 30)==1;
+        }
+        WriteDreamsCaptureText(output / "capture-selection.tsv",
+            fmt::format("attempt\t{}\nsculpt_pixels\t{}\n",selection_attempts,sculpt_pixels));
+        return sculpt_pixels != 0;
+    };
+    ++selection_attempts;
+    if (!select_sculpt_draw()) {
+        if (selection_attempts>=4) {
+            std::filesystem::remove(output / "capture.trigger",error);
+            WriteDreamsCaptureText(output / "selection-failed.txt",
+                "No sculpt-tagged material draw found in four candidates; capture stopped.\n");
+        }
+        return;
+    }
+    if (!std::filesystem::remove(output / "capture.trigger", error)) return;
+    selection_attempts=0;
+    std::filesystem::remove(output / "selection-failed.txt",error);
+    scheduler.Finish();
+    std::string metadata{"schema\t1\nphase\tmaterial-inputs\ncomplete-frame\tfalse\n"};
+    bool ok = true;
+    u64 hash{};
+    ok &= WriteDreamsCaptureWords(output / "vs.spv",
+        pipeline_cache.GetCurrentShaderSpirv(Shader::LogicalStage::Vertex), hash);
+    ok &= WriteDreamsCaptureWords(output / "fs.spv",
+        pipeline_cache.GetCurrentShaderSpirv(Shader::LogicalStage::Fragment), hash);
+    const auto save_struct = [&](const char* name, const auto& value) {
+        return WriteDreamsCaptureBytes(output / name,
+            std::span<const u8>{reinterpret_cast<const u8*>(&value), sizeof(value)}, hash);
+    };
+    ok &= save_struct("gpu-regs.bin", liverpool->regs);
+    ok &= save_struct("push-data.bin", push_data);
+    ok &= save_struct("graphics-key.bin", pipeline->GetGraphicsKey());
+    for (const auto* stage : pipeline->GetStages()) {
+        if (!stage) continue;
+        const auto prefix = fmt::format("stage-{}", static_cast<u32>(stage->l_stage));
+        ok &= WriteDreamsCaptureWords(output / (prefix + "-srt.bin"), stage->flattened_ud_buf, hash);
+        ok &= WriteDreamsCaptureWords(output / (prefix + "-user-data.bin"), stage->user_data, hash);
