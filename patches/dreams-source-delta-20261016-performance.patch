+bool MemoryManager::TryReadBacking(VAddr address, void* dest, u64 size) {
+    if (!dest || !size || address > std::numeric_limits<VAddr>::max() - size) {
+        return false;
+    }
+    std::shared_lock lk{mutex};
+    auto next_vma = vma_map.upper_bound(address);
+    if (next_vma == vma_map.begin()) {
+        return false;
+    }
+    const auto& vma = std::prev(next_vma)->second;
+    if ((vma.type != VMAType::Direct && vma.type != VMAType::Flexible &&
+         vma.type != VMAType::Pooled) ||
+        !True(vma.prot & MemoryProt::CpuRead) || address < vma.base) {
+        return false;
+    }
+    const u64 offset = address - vma.base;
+    if (offset >= vma.size || size > vma.size - offset) {
+        return false;
+    }
+    auto next_phys = vma.phys_areas.upper_bound(offset);
+    if (next_phys == vma.phys_areas.begin()) {
+        return false;
+    }
+    const auto& [phys_offset, phys] = *std::prev(next_phys);
+    const u64 in_phys = offset - phys_offset;
+    if (in_phys >= phys.size || size > phys.size - in_phys) {
+        return false;
+    }
+    // Decline a split mapping without touching dest. The ordinary fault path
+    // remains responsible for unsupported ranges and genuinely GPU-dirty data.
+    std::memcpy(dest, impl.BackingBase() + phys.base + in_phys, size);
+    return true;
+}
+
+bool MemoryManager::TryStoreBacking(VAddr address, const void* data, u32 size) {
+    const u32 alignment = size <= 8 ? size : 4;
+    if (!data || (size != 4 && size != 8 && size != 16 && size != 32) ||
+        address % alignment != 0 ||
+        address > std::numeric_limits<VAddr>::max() - size) {
+        return false;
+    }
+    std::shared_lock lk{mutex};
+    auto next_vma = vma_map.upper_bound(address);
+    if (next_vma == vma_map.begin()) {
+        return false;
+    }
+    const auto& vma = std::prev(next_vma)->second;
+    if ((vma.type != VMAType::Direct && vma.type != VMAType::Flexible &&
+         vma.type != VMAType::Pooled) ||
+        !True(vma.prot & MemoryProt::CpuWrite) || address < vma.base) {
+        return false;
+    }
+    const u64 offset = address - vma.base;
+    if (offset >= vma.size || size > vma.size - offset) {
+        return false;
+    }
+    auto next_phys = vma.phys_areas.upper_bound(offset);
+    if (next_phys == vma.phys_areas.begin()) {
+        return false;
+    }
+    const auto& [phys_offset, phys] = *std::prev(next_phys);
+    const u64 in_phys = offset - phys_offset;
+    if (in_phys >= phys.size || size > phys.size - in_phys ||
+        (phys.base + in_phys) % alignment != 0) {
+        return false;
+    }
+    auto* target = impl.BackingBase() + phys.base + in_phys;
+    if (size == 4) {
+        u32 value;
+        std::memcpy(&value, data, 4);
+        *reinterpret_cast<u32*>(target) = value;
+    } else if (size == 8) {
+        u64 value;
+        std::memcpy(&value, data, 8);
+        *reinterpret_cast<u64*>(target) = value;
+    } else {
+        std::memcpy(target, data, size);
+    }
+    return true;
+}
