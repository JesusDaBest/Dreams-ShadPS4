+void Rasterizer::ResetOrderedCount(const Shader::Info& stage) {
+    if (stage.uses_ordered_count) {
+        const auto* marker_gds = buffer_cache.GetGdsBuffer();
+        scheduler.ConfigureOrderedMarkers(marker_gds->Handle(), marker_gds->mapped_data.data(),
+                                          Shader::GdsOrderedTicketOffset + sizeof(u32));
+        static bool logged{};
+        if (!logged) {
+            LOG_WARNING(Render, "Experimental ordered-count port active; private ticket offset {:#x}",
+                        Shader::GdsOrderedTicketOffset);
+            logged = true;
+        }
+        buffer_cache.FillBuffer(Shader::GdsOrderedTicketOffset, sizeof(u32), 0, true);
+    }
+}
