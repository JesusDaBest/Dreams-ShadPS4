+static bool FinalizeDreamsB535InstructionTrace(
+    VideoCore::Buffer* gds, const std::filesystem::path& directory) {
+    if (!Shader::DreamsCompat::CaptureB535InstructionTrace()) {
+        return true;
+    }
+
+    constexpr u64 CaptureOffset = static_cast<u64>(B535Microtrace::BaseDword) * sizeof(u32);
+    constexpr u64 CaptureSize = static_cast<u64>(B535Microtrace::DwordCount) * sizeof(u32);
+    if (CaptureOffset + CaptureSize > gds->SizeBytes() ||
+        CaptureOffset + CaptureSize > gds->mapped_data.size()) {
+        LOG_ERROR(Render_Vulkan,
+                  "Dreams B535 instruction trace range {:#x}+{:#x} exceeds buffer {:#x}/{:#x}",
+                  CaptureOffset, CaptureSize, gds->SizeBytes(), gds->mapped_data.size());
+        return false;
+    }
+
+    gds->InvalidateMappedRange(CaptureOffset, CaptureSize);
+    const auto* capture_words =
+        reinterpret_cast<const u32*>(gds->mapped_data.data() + CaptureOffset);
+    const std::span<const u32> words{capture_words, B535Microtrace::DwordCount};
+    const auto word = [&](u32 absolute_dword) -> u32 {
+        return words[absolute_dword - B535Microtrace::BaseDword];
+    };
+
+    u64 raw_hash{};
+    bool success =
+        WriteDreamsCaptureWords(directory / "b535-instruction-microtrace.bin", words, raw_hash);
+
+    std::string instructions =
+        "step\tpc\topcode\topcode_name\tencoding\tencoding_name\tclass\tclass_name\t"
+        "category\tcategory_name\tlength\tsrc_count\tdst_count\tcontrol_lo\tcontrol_hi";
+    for (u32 operand = 0; operand < B535Microtrace::OperandCount; ++operand) {
+        const std::string_view prefix = operand < Shader::Gcn::GcnMaxSrcCount ? "src" : "dst";
+        const u32 index = operand < Shader::Gcn::GcnMaxSrcCount
+                              ? operand
+                              : operand - Shader::Gcn::GcnMaxSrcCount;
+        instructions += fmt::format(
+            "\t{}{}_field\t{}{}_field_name\t{}{}_type\t{}{}_type_name\t{}{}_code\t"
+            "{}{}_modifiers\t{}{}_aux",
+            prefix, index, prefix, index, prefix, index, prefix, index, prefix, index, prefix,
+            index, prefix, index);
+    }
+    instructions += '\n';
+
+    u32 instruction_rows{};
+    for (u32 step = 0; step < B535Microtrace::StepCount; ++step) {
+        const u32 pc = B535Microtrace::FirstPc + step * sizeof(u32);
+        if (word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataValid)) == 0) {
+            continue;
+        }
+        ++instruction_rows;
+        const u32 opcode_raw =
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataOpcode));
+        const u32 encoding_raw =
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataEncoding));
+        const u32 class_raw =
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataClass));
+        const u32 category_raw =
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataCategory));
+        instructions += fmt::format(
+            "{}\t0x{:04x}\t0x{:08x}\t{}\t0x{:08x}\t{}\t0x{:08x}\t{}\t0x{:08x}\t{}\t"
+            "{}\t{}\t{}\t0x{:08x}\t0x{:08x}",
+            step, pc, opcode_raw,
+            magic_enum::enum_name(static_cast<Shader::Gcn::Opcode>(opcode_raw)), encoding_raw,
+            magic_enum::enum_name(static_cast<Shader::Gcn::InstEncoding>(encoding_raw)), class_raw,
+            magic_enum::enum_name(static_cast<Shader::Gcn::InstClass>(class_raw)), category_raw,
+            magic_enum::enum_name(static_cast<Shader::Gcn::InstCategory>(category_raw)),
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataLength)),
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataSrcCount)),
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataDstCount)),
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataControlLo)),
+            word(B535Microtrace::MetadataDword(pc, B535Microtrace::MetadataControlHi)));
+        for (u32 operand = 0; operand < B535Microtrace::OperandCount; ++operand) {
+            const u32 field = word(B535Microtrace::OperandMetadataDword(pc, operand, 0));
+            const u32 type = word(B535Microtrace::OperandMetadataDword(pc, operand, 1));
+            instructions += fmt::format(
+                "\t0x{:08x}\t{}\t0x{:08x}\t{}\t0x{:08x}\t0x{:08x}\t0x{:08x}", field,
+                magic_enum::enum_name(static_cast<Shader::Gcn::OperandField>(field)), type,
+                magic_enum::enum_name(static_cast<Shader::Gcn::ScalarType>(type)),
+                word(B535Microtrace::OperandMetadataDword(pc, operand, 2)),
+                word(B535Microtrace::OperandMetadataDword(pc, operand, 3)),
+                word(B535Microtrace::OperandMetadataDword(pc, operand, 4)));
+        }
+        instructions += '\n';
+    }
+    success &= WriteDreamsCaptureText(directory / "b535-instruction-metadata.tsv", instructions);
+
+    constexpr std::array<std::string_view, B535Microtrace::RecordDwords> RecordNames{
+        "valid",       "identity",     "record",       "pre_vcc",      "pre_src0_lo",
+        "pre_src0_hi", "pre_src1_lo",  "pre_src1_hi",  "pre_src2_lo",  "pre_src2_hi",
+        "pre_src3_lo", "pre_src3_hi",  "post_dst0_lo", "post_dst0_hi", "post_vcc",
+    };
+    std::string records = "bank\tworkgroup\tlane\tobject\tstep\tpc";
+    for (const auto name : RecordNames) {
+        records += fmt::format("\t{}", name);
+    }
+    records += '\n';
+    u32 record_rows{};
+    u32 complete_rows{};
+    u32 incomplete{};
+    for (u32 bank = 0; bank < B535Microtrace::LaneBanks; ++bank) {
+        for (u32 step = 0; step < B535Microtrace::StepCount; ++step) {
+            const u32 pc = B535Microtrace::FirstPc + step * sizeof(u32);
+            const u32 valid = word(B535Microtrace::RecordDword(
+                bank, pc, B535Microtrace::Valid));
+            if (valid == 0) {
+                continue;
+            }
+            ++record_rows;
+            const bool complete =
+                valid == (B535Microtrace::PreValid | B535Microtrace::PostValid);
+            complete_rows += complete;
+            incomplete += !complete;
+            const u32 record =
+                word(B535Microtrace::RecordDword(bank, pc, B535Microtrace::Record));
+            records += fmt::format("{}\t{}\t{}\t{}\t{}\t0x{:04x}", bank,
+                                   bank / B535Microtrace::LanesPerWorkgroup,
+                                   bank % B535Microtrace::LanesPerWorkgroup, record & 0xffff,
+                                   step, pc);
+            for (u32 field = 0; field < B535Microtrace::RecordDwords; ++field) {
+                records += fmt::format("\t0x{:08x}",
+                                       word(B535Microtrace::RecordDword(bank, pc, field)));
+            }
+            records += '\n';
+        }
+    }
+    success &= WriteDreamsCaptureText(directory / "b535-instruction-microtrace.tsv", records);
+
+    const u32 magic = words[B535Microtrace::HeaderMagic];
+    const u32 schema = words[B535Microtrace::HeaderSchema];
+    std::array<u32, 4> seen_masks{};
+    u32 seen_lanes{};
+    for (u32 i = 0; i < seen_masks.size(); ++i) {
+        seen_masks[i] = words[B535Microtrace::HeaderSeenMask0 + i];
+        seen_lanes += std::popcount(seen_masks[i]);
+    }
+    const bool header_valid = magic == B535Microtrace::Magic &&
+                              schema == B535Microtrace::Schema && seen_lanes != 0;
+    const bool trace_valid = header_valid && instruction_rows != 0 && record_rows != 0;
+    const std::string manifest = fmt::format(
+        "magic=0x{:08x}\nschema={}\ntrace_revision={}\nraw_hash=0x{:016x}\n"
+        "base_dword=0x{:x}\ndword_count=0x{:x}\ntarget_pass={}\n"
+        "pc_first=0x{:x}\npc_last=0x{:x}\nstep_count={}\nmetadata_dwords={}\n"
+        "record_dwords={}\nmax_workgroups={}\nlanes_per_workgroup={}\nlane_banks={}\n"
+        "seen_mask0=0x{:08x}\nseen_mask1=0x{:08x}\nseen_mask2=0x{:08x}\n"
+        "seen_mask3=0x{:08x}\nseen_lanes={}\ninstruction_rows={}\nrecord_rows={}\n"
+        "complete_rows={}\npre_only_rows={}\nheader_valid={}\ntrace_valid={}\n"
+        "modifier_bits=0:neg,1:neg_hi,2:abs,3:sext,4:op_sel,5:op_sel_hi,6:clamp,"
+        "7:dpp_present,8..11:sdwa_dst,12..15:sdwa_sel,16:dpp_bc,20..23:dpp_row_mask,"
+        "24..27:dpp_bank_mask\n"
+        "operand_order=src0,src1,src2,src3,dst0,dst1\n",
+        magic, schema, Shader::DreamsCompat::B535InstructionTraceCacheRevision, raw_hash,
+        B535Microtrace::BaseDword, B535Microtrace::DwordCount, B535Microtrace::TargetPass,
+        B535Microtrace::FirstPc, B535Microtrace::LastPc, B535Microtrace::StepCount,
+        B535Microtrace::MetadataDwords, B535Microtrace::RecordDwords,
+        B535Microtrace::MaxWorkgroups, B535Microtrace::LanesPerWorkgroup,
+        B535Microtrace::LaneBanks, seen_masks[0], seen_masks[1], seen_masks[2], seen_masks[3],
+        seen_lanes, instruction_rows, record_rows, complete_rows, incomplete, header_valid,
+        trace_valid);
+    success &=
+        WriteDreamsCaptureText(directory / "b535-instruction-microtrace-manifest.txt", manifest);
+    if (!trace_valid) {
+        LOG_ERROR(Render_Vulkan,
+                  "Dreams B535 all-lane instruction trace is invalid header={} instructions={} "
+                  "records={} seen_lanes={}",
+                  header_valid, instruction_rows, record_rows, seen_lanes);
+    } else {
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams B535 all-lane trace complete instructions={} records={} lanes={} "
+                    "pre_only={} hash={:#x}",
+                    instruction_rows, record_rows, seen_lanes, incomplete, raw_hash);
+    }
+    return success;
+}
+
+static bool WriteDreamsMetadataCapture(VideoCore::Buffer* gds,
+                                       const std::filesystem::path& directory) {
+    const auto& chain = g_dreams_ordered_chain_capture;
+    bool success = true;
+    const auto write_words = [&](std::string_view name, const std::vector<u32>& values) {
+        if (values.empty()) {
+            return;
+        }
+        u64 ignored_hash{};
+        success &= WriteDreamsCaptureWords(directory / name, values, ignored_hash);
+    };
+    write_words("metadata-63dd-descriptors.bin", chain.metadata_producer_descriptors);
+    write_words("metadata-a3-descriptors.bin", chain.metadata_consumer_descriptors);
+    write_words("metadata-63dd-flat.bin", chain.metadata_producer_flattened);
+    write_words("metadata-a3-flat.bin", chain.metadata_consumer_flattened);
+    write_words("metadata-input-rows-before-63dd.bin",
+                chain.metadata_producer_input_rows_pre);
+    write_words("metadata-input-keys-before-63dd.bin",
+                chain.metadata_producer_input_keys_pre);
+    write_words("metadata-counts-after-63dd.bin", chain.metadata_producer_counts_post);
+    write_words("metadata-records-after-63dd.bin", chain.metadata_producer_records_post);
+    write_words("metadata-counts-before-a3.bin", chain.metadata_consumer_counts_pre);
+    write_words("metadata-records-before-a3.bin", chain.metadata_consumer_records_pre);
+
+    const bool count_tables_equal = chain.metadata_producer_post_valid &&
+                                    chain.metadata_consumer_pre_valid &&
+                                    chain.metadata_producer_counts_post ==
+                                        chain.metadata_consumer_counts_pre;
+    const bool record_tables_equal = chain.metadata_producer_post_valid &&
+                                     chain.metadata_consumer_pre_valid &&
+                                     chain.metadata_producer_records_post ==
+                                         chain.metadata_consumer_records_pre;
+    std::string manifest = fmt::format(
+        "producer_shader=0x{:08x}\nproducer_sequence={}\nproducer_post_valid={}\n"
+        "consumer_shader=0x{:08x}\nconsumer_sequence={}\nconsumer_pre_valid={}\n"
+        "producer_dims={}x{}x{}\nproducer_base={}\nproducer_count={}\n"
+        "consumer_dims={}x{}x{}\nconsumer_base={}\nconsumer_count={}\n"
+        "producer_input_row_words={}\nproducer_input_key_words={}\n"
+        "producer_count_words={}\nproducer_record_words={}\nconsumer_count_words={}\n"
+        "consumer_record_words={}\nprovenance_rows={}\nfocus_row_positions={}\nconsumer_attempts={}\n"
+        "count_tables_equal={}\nrecord_tables_equal={}\n",
+        Shader::DreamsCompat::A3LookupProducerShader, chain.metadata_producer_sequence,
+        chain.metadata_producer_post_valid, Shader::DreamsCompat::B1TransformWriterShader,
+        chain.metadata_consumer_sequence, chain.metadata_consumer_pre_valid,
+        chain.metadata_producer_dims[0], chain.metadata_producer_dims[1],
+        chain.metadata_producer_dims[2], chain.metadata_producer_base,
+        chain.metadata_producer_count, chain.metadata_consumer_dims[0],
+        chain.metadata_consumer_dims[1], chain.metadata_consumer_dims[2],
+        chain.metadata_consumer_base, chain.metadata_consumer_count,
+        chain.metadata_producer_input_rows_pre.size(),
+        chain.metadata_producer_input_keys_pre.size(),
+        chain.metadata_producer_counts_post.size(),
+        chain.metadata_producer_records_post.size(),
+        chain.metadata_consumer_counts_pre.size(),
+        chain.metadata_consumer_records_pre.size(), chain.metadata_provenance_row_count,
+        chain.metadata_focus_row_positions.size(), chain.metadata_consumer_attempts.size(),
+        count_tables_equal, record_tables_equal);
+    const auto append_descriptors = [&](std::string_view owner,
+                                        const std::vector<u32>& descriptors) {
+        for (u32 index = 0; index + 4 <= descriptors.size(); index += 4) {
+            AmdGpu::Buffer sharp{};
+            std::memcpy(&sharp, descriptors.data() + index, sizeof(sharp));
+            manifest += fmt::format(
+                "{}_binding{}={:#x}+{:#x},stride:{},records:{}\n", owner, index / 4,
+                static_cast<u64>(sharp.base_address), sharp.GetSize(),
+                static_cast<u32>(sharp.stride), static_cast<u32>(sharp.num_records));
+        }
+    };
+    append_descriptors("producer", chain.metadata_producer_descriptors);
+    append_descriptors("consumer", chain.metadata_consumer_descriptors);
+    manifest += fmt::format("input_writer_matches={}\n", chain.metadata_input_writers.size());
+    for (u32 index = 0; index < chain.metadata_focus_row_positions.size(); ++index) {
+        manifest += fmt::format("focus_row_position{}={}\n", index,
+                                chain.metadata_focus_row_positions[index]);
+    }
+    success &= WriteDreamsCaptureText(directory / "metadata-table-manifest.txt", manifest);
+
+    std::string attempts =
+        "attempt\tsequence\tdim_x\tdim_y\tdim_z\tbase\tcount\tend\t"
+        "contains_focus_row\tfocus_invocations\tfocus_seen_mask\tconsumer_pre_valid\n";
+    for (u32 index = 0; index < chain.metadata_consumer_attempts.size(); ++index) {
+        const auto& attempt = chain.metadata_consumer_attempts[index];
+        attempts += fmt::format(
+            "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t0x{:08x}\t{}\n", index + 1,
+            attempt.sequence, attempt.dims[0], attempt.dims[1], attempt.dims[2], attempt.base,
+            attempt.count, u64{attempt.base} + attempt.count, attempt.contains_focus_row,
+            attempt.focus_invocations, attempt.focus_seen_mask, attempt.consumer_pre_valid);
+    }
+    success &= WriteDreamsCaptureText(directory / "metadata-a3-attempts.tsv", attempts);
+
+    std::string writers =
+        "newest\ttarget_mask\tsequence\tdispatch\tshader\tstage\tkind\tbinding\t"
+        "declared_write\tbase\tsize\tstride\tsource\n";
+    for (u32 index = 0; index < chain.metadata_input_writers.size(); ++index) {
+        const auto& match = chain.metadata_input_writers[index];
+        const auto& writer = match.writer;
+        writers += fmt::format(
+            "{}\t0x{:x}\t{}\t{}\t0x{:08x}\t{}\t{}\t{}\t{}\t{:#x}\t{:#x}\t{}\t{:#x}\n",
+            index, match.target_mask, writer.sequence, writer.dispatch_sequence,
+            writer.shader_hash, static_cast<u32>(writer.stage), static_cast<u32>(writer.kind),
+            writer.binding_index, writer.declared_write, writer.base, writer.size, writer.stride,
+            writer.source);
+    }
+    success &= WriteDreamsCaptureText(directory / "metadata-input-writers.tsv", writers);
+
+    if (Shader::DreamsCompat::CaptureB1WriterProvenance()) {
+        namespace A3Focus = Shader::DreamsCompat::B1WriterProvenance;
+        constexpr u64 focus_offset = static_cast<u64>(A3Focus::BaseDword) * sizeof(u32);
+        constexpr u64 focus_size = static_cast<u64>(A3Focus::HeaderDwords) * sizeof(u32);
+        if (focus_offset + focus_size > gds->SizeBytes() ||
+            focus_offset + focus_size > gds->mapped_data.size()) {
+            LOG_ERROR(Render_Vulkan,
+                      "Dreams A3 focus header is outside private GDS during metadata "
+                      "finalization");
+            return false;
+        }
+        gds->InvalidateMappedRange(focus_offset, focus_size);
+        const auto* live_focus_words =
+            reinterpret_cast<const u32*>(gds->mapped_data.data() + focus_offset);
+        const auto* focus_words =
+            chain.metadata_focus_header.size() == A3Focus::HeaderDwords
+                ? chain.metadata_focus_header.data()
+                : live_focus_words;
+        u64 focus_hash{};
+        success &= WriteDreamsCaptureWords(
+            directory / "metadata-a3-focus.bin",
+            std::span<const u32>{focus_words, A3Focus::HeaderDwords}, focus_hash);
+        const auto focus_word = [&](u32 absolute_dword) {
+            return focus_words[absolute_dword - A3Focus::BaseDword];
+        };
+        std::string focus = fmt::format(
+            "magic\t0x{:08x}\nschema\t{}\nfocus_input_v13\t0x{:08x}\n"
+            "captured_input_v13\t0x{:08x}\nrow\t0x{:06x}\nseen_mask\t0x{:08x}\n"
+            "hit_mask\t0x{:08x}\nprobe_overflow_mask\t0x{:08x}\n"
+            "comparison_mask\t0x{:08x}\ninvocation_count\t{}\n"
+            "invocation_row_xor\t0x{:06x}\ninvocation_row_sum\t0x{:08x}\n"
+            "final_count\t{}\nfinal_v17_zero_count\t{}\nfinal_force_count\t{}\n"
+            "final_selected_sign_count\t{}\n\n"
+            "child\tprobe\ttarget_key\tinitial_hash\tbucket_count\tprobe_index\t"
+            "loaded_key\tloaded_payload\tkey_match\tchild_hit\n",
+            focus_word(A3Focus::FocusMagicDword), focus_word(A3Focus::FocusSchemaDword),
+            A3Focus::FocusInputV13, focus_word(A3Focus::FocusInputDword),
+            focus_word(A3Focus::FocusRowDword), focus_word(A3Focus::FocusSeenMaskDword),
+            focus_word(A3Focus::FocusHitMaskDword),
+            focus_word(A3Focus::FocusProbeOverflowMaskDword),
+            focus_word(A3Focus::FocusComparisonMaskDword),
+            focus_word(A3Focus::FocusInvocationCountDword),
+            focus_word(A3Focus::FocusInvocationRowXorDword),
+            focus_word(A3Focus::FocusInvocationRowSumDword),
+            focus_word(A3Focus::FocusFinalCountDword),
+            focus_word(A3Focus::FocusFinalV17ZeroCountDword),
+            focus_word(A3Focus::FocusFinalForceCountDword),
+            focus_word(A3Focus::FocusFinalSelectedSignCountDword));
+        const u32 hit_mask = focus_word(A3Focus::FocusHitMaskDword);
+        for (u32 child = 0; child < A3Focus::FocusMaxChildren; ++child) {
+            const u32 target_key = focus_word(A3Focus::FocusTargetKeyBaseDword + child);
+            const u32 initial_hash = focus_word(A3Focus::FocusInitialHashBaseDword + child);
+            const u32 bucket_count = focus_word(A3Focus::FocusBucketCountBaseDword + child);
+            for (u32 probe = 0; probe < A3Focus::FocusMaxProbes; ++probe) {
+                const u32 slot = child * A3Focus::FocusMaxProbes + probe;
+                const u32 probe_index =
+                    focus_word(A3Focus::FocusProbeIndexBaseDword + slot);
+                const u32 loaded_key = focus_word(A3Focus::FocusLoadedKeyBaseDword + slot);
+                const u32 loaded_payload =
+                    focus_word(A3Focus::FocusLoadedPayloadBaseDword + slot);
+                focus += fmt::format(
+                    "{}\t{}\t0x{:08x}\t0x{:08x}\t{}\t0x{:08x}\t0x{:08x}\t"
+                    "0x{:08x}\t{}\t{}\n",
+                    child, probe + 1, target_key, initial_hash, bucket_count, probe_index,
+                    loaded_key, loaded_payload, loaded_key == target_key,
+                    (hit_mask >> child) & 1);
+            }
+        }
+        success &= WriteDreamsCaptureText(directory / "metadata-a3-focus.tsv", focus);
+
+        const u32 provenance_rows = chain.metadata_provenance_row_count;
+        if (provenance_rows != 0) {
+            constexpr std::array provenance_bases{
+                A3Focus::SiteMaskBaseDword,
+                A3Focus::TagBaseDword,
+                A3Focus::ValueBaseDword,
+                A3Focus::SourceBaseDword,
+            };
+            constexpr std::array<std::string_view, 4> provenance_names{
+                "metadata-a3-row-site-mask.bin",
+                "metadata-a3-row-tag.bin",
+                "metadata-a3-row-value.bin",
+                "metadata-a3-row-source.bin",
+            };
+            std::array<const u32*, provenance_bases.size()> provenance_words{};
+            const u64 provenance_size = static_cast<u64>(provenance_rows) * sizeof(u32);
+            for (u32 index = 0; index < provenance_bases.size(); ++index) {
+                const u64 provenance_offset =
+                    static_cast<u64>(provenance_bases[index]) * sizeof(u32);
+                if (provenance_offset + provenance_size > gds->SizeBytes() ||
+                    provenance_offset + provenance_size > gds->mapped_data.size()) {
+                    LOG_ERROR(Render_Vulkan,
+                              "Dreams A3 compact provenance range {} is outside private GDS",
+                              index);
+                    return false;
+                }
+                gds->InvalidateMappedRange(provenance_offset, provenance_size);
+                provenance_words[index] =
+                    reinterpret_cast<const u32*>(gds->mapped_data.data() + provenance_offset);
+                u64 provenance_hash{};
+                success &= WriteDreamsCaptureWords(
+                    directory / provenance_names[index],
+                    std::span<const u32>{provenance_words[index], provenance_rows},
+                    provenance_hash);
+            }
+            std::string rows =
+                "row\tsite_mask\ttag\tvalue\tsource\tinvocations\tinput_sign\ts32_bit0\t"
+                "v17_zero\tv20_mask_nonzero\tpredicate\tselected_sign\ts28_sign\t"
+                "lookup_hit_mask\tforce\n";
+            for (u32 row = 0; row < provenance_rows; ++row) {
+                const u32 site_mask = provenance_words[0][row];
+                const u32 tag = provenance_words[1][row];
+                const u32 value = provenance_words[2][row];
+                const u32 source = provenance_words[3][row];
+                if ((site_mask | tag | value | source) == 0) {
+                    continue;
+                }
+                const bool force = (tag & 0x8e) == 0x8e;
+                rows += fmt::format(
+                    "0x{:06x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t{}\t{}\t{}\t"
+                    "{}\t{}\t{}\t{}\t{}\t0x{:02x}\t{}\n",
+                    row, site_mask, tag, value, source,
+                    site_mask >> A3Focus::FocusInvocationCountShift, tag & 1, (tag >> 1) & 1,
+                    (tag >> 2) & 1, (tag >> 3) & 1, (tag >> 4) & 1, (tag >> 5) & 1,
+                    (tag >> 6) & 1, (tag >> A3Focus::FocusHitMaskShift) & 0xff, force);
+            }
+            success &= WriteDreamsCaptureText(directory / "metadata-a3-rows.tsv", rows);
+        }
+    }
+
+    if (!Shader::DreamsCompat::CaptureA3LookupProducerTrace()) {
+        return success;
+    }
+
+    namespace ProducerTrace = Shader::DreamsCompat::A3LookupProducerTrace;
+    constexpr u64 trace_offset = static_cast<u64>(ProducerTrace::BaseDword) * sizeof(u32);
+    constexpr u64 trace_size = static_cast<u64>(ProducerTrace::DwordCount) * sizeof(u32);
+    if (trace_offset + trace_size > gds->SizeBytes() ||
+        trace_offset + trace_size > gds->mapped_data.size()) {
+        LOG_ERROR(Render_Vulkan,
+                  "Dreams 63dd producer trace range is outside private GDS during metadata "
+                  "finalization");
+        return false;
+    }
+    gds->InvalidateMappedRange(trace_offset, trace_size);
+    const auto* trace_words =
+        reinterpret_cast<const u32*>(gds->mapped_data.data() + trace_offset);
+    const u32 next_record =
+        trace_words[ProducerTrace::NextRecordDword - ProducerTrace::BaseDword];
+    const u32 record_count = std::min(next_record, ProducerTrace::MaxRecords);
+    const u32 captured_dwords =
+        ProducerTrace::HeaderDwords + record_count * ProducerTrace::RecordDwords;
+    u64 producer_trace_hash{};
+    success &= WriteDreamsCaptureWords(
+        directory / "metadata-63dd-events.bin",
+        std::span<const u32>{trace_words, captured_dwords}, producer_trace_hash);
+
+    std::string events =
+        "record\tpc\twg_x\twg_y\twg_z\tlocal_x\tlane\tglobal_x\tordinal\t"
+        "pair_slot\tcount_slot\tkey\tpayload\told_key\told_payload\tflags\n";
+    events.reserve(static_cast<size_t>(record_count) * 160);
+    u32 valid_records{};
+    for (u32 record_index = 0; record_index < record_count; ++record_index) {
+        const auto* record = trace_words + ProducerTrace::HeaderDwords +
+                             record_index * ProducerTrace::RecordDwords;
+        if (record[ProducerTrace::Valid] != ProducerTrace::RecordValid) {
+            continue;
+        }
+        ++valid_records;
+        events += fmt::format(
+            "{}\t0x{:04x}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t0x{:08x}\t"
+            "0x{:08x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\n",
+            record_index, record[ProducerTrace::SitePc], record[ProducerTrace::WorkgroupX],
+            record[ProducerTrace::WorkgroupY], record[ProducerTrace::WorkgroupZ],
+            record[ProducerTrace::LocalInvocationX], record[ProducerTrace::Lane],
+            record[ProducerTrace::GlobalInvocationX], record[ProducerTrace::Ordinal],
+            record[ProducerTrace::PairSlot], record[ProducerTrace::CountSlot],
+            record[ProducerTrace::Key], record[ProducerTrace::Payload],
+            record[ProducerTrace::OldKey], record[ProducerTrace::OldPayload],
+            record[ProducerTrace::SiteFlags]);
+    }
+    success &= WriteDreamsCaptureText(directory / "metadata-63dd-events.tsv", events);
+    const u32 overflow = trace_words[ProducerTrace::OverflowDword - ProducerTrace::BaseDword];
+    const u32 pair_events =
+        trace_words[ProducerTrace::PairEventCountDword - ProducerTrace::BaseDword];
+    const u32 count_events =
+        trace_words[ProducerTrace::CountEventCountDword - ProducerTrace::BaseDword];
+    success &= WriteDreamsCaptureText(
+        directory / "metadata-63dd-events-manifest.txt",
+        fmt::format(
+            "magic=0x{:08x}\nschema={}\nnext_record={}\ncaptured_records={}\n"
+            "valid_records={}\noverflow={}\npair_events={}\ncount_events={}\n"
+            "raw_hash=0x{:016x}\n",
+            trace_words[ProducerTrace::MagicDword - ProducerTrace::BaseDword],
+            trace_words[ProducerTrace::SchemaDword - ProducerTrace::BaseDword], next_record,
+            record_count, valid_records, overflow, pair_events, count_events,
+            producer_trace_hash));
+    return success;
+}
+
+static bool FinalizeDreamsB535MembershipCapture(VideoCore::Buffer* gds) {
+    auto& capture = g_dreams_b535_membership_capture;
+    const auto directory = DreamsB535MembershipCaptureDirectory();
+    if (!directory) {
+        FailDreamsB535MembershipCapture("capture directory is unavailable");
+        return false;
+    }
+
+    constexpr u64 CaptureOffset = static_cast<u64>(B535Capture::BaseDword) * sizeof(u32);
+    constexpr u64 CaptureSize = static_cast<u64>(B535Capture::DwordCount) * sizeof(u32);
+    if (CaptureOffset + CaptureSize > gds->SizeBytes() ||
+        CaptureOffset + CaptureSize > gds->mapped_data.size()) {
+        FailDreamsB535MembershipCapture(fmt::format(
+            "private GDS capture range {:#x}+{:#x} exceeds buffer size {:#x}/mapped {:#x}",
+            CaptureOffset, CaptureSize, gds->SizeBytes(), gds->mapped_data.size()));
+        return false;
+    }
+
+    gds->InvalidateMappedRange(CaptureOffset, CaptureSize);
+    const auto* capture_words =
+        reinterpret_cast<const u32*>(gds->mapped_data.data() + CaptureOffset);
+    const std::span<const u32> words{capture_words, B535Capture::DwordCount};
+    u64 raw_hash{};
+    bool success = WriteDreamsCaptureWords(*directory / "b535-membership.bin", words, raw_hash);
+    success &= FinalizeDreamsB535InstructionTrace(gds, *directory);
+
+    namespace B1Provenance = Shader::DreamsCompat::B1WriterProvenance;
+    std::span<const u32> b1_provenance_words{};
+    if (Shader::DreamsCompat::CaptureB1WriterProvenance()) {
+        constexpr u64 ProvenanceOffset =
+            static_cast<u64>(B1Provenance::BaseDword) * sizeof(u32);
+        constexpr u64 ProvenanceSize =
+            static_cast<u64>(B1Provenance::DwordCount) * sizeof(u32);
+        if (ProvenanceOffset + ProvenanceSize > gds->SizeBytes() ||
+            ProvenanceOffset + ProvenanceSize > gds->mapped_data.size()) {
+            FailDreamsB535MembershipCapture(fmt::format(
+                "B1 provenance range {:#x}+{:#x} exceeds buffer size {:#x}/mapped {:#x}",
+                ProvenanceOffset, ProvenanceSize, gds->SizeBytes(), gds->mapped_data.size()));
+            return false;
+        }
+        gds->InvalidateMappedRange(ProvenanceOffset, ProvenanceSize);
+        const auto* provenance_words =
+            reinterpret_cast<const u32*>(gds->mapped_data.data() + ProvenanceOffset);
+        b1_provenance_words = {provenance_words, B1Provenance::DwordCount};
+    }
+
+    constexpr std::array<std::string_view, B535Capture::RecordDwords> FieldNames{
+        "valid",
+        "pass",
+        "workgroup",
+        "lane",
+        "identity",
+        "record",
+        "object_index",
+        "object95",
+        "object96",
+        "object97",
+        "object36",
+        "root65",
+        "root66",
+        "root67",
+        "lod_t",
+        "lod_branch_mask_lo",
+        "lod_branch_mask_hi",
+        "reject_v8",
+        "reject_v3",
+        "reject_v5",
+        "reject_v1",
+        "reject_v4",
+        "sat_reject",
+        "coarse_gate_v2",
+        "nested_v19",
+        "nested_v39",
+        "nested_v33",
+        "nested_v5",
+        "nested_v1",
+        "nested_v2",
+        "nested_v9",
+        "score_input",
+        "score_scale",
+        "score_slope",
+        "score_product",
+        "raw_score",
+        "score",
+        "candidate_active",
+        "output_index",
+        "selector_limit",
+        "occlusion_result",
+        "output_role",
+        "pair_level",
+        "projected_bound",
+        "nge_afc_v4",
+        "nge_afc_v2",
+        "nge_b38_v3",
+        "nge_b38_v47",
+        "flags",
+        "gate1_original_vcc",
+        "gate1_force_applied",
+        "input_b1",
+    };
+    static_assert(FieldNames.size() == B535Capture::RecordDwords);
+
+    std::string table;
+    table.reserve(1_MB);
+    for (u32 field = 0; field < FieldNames.size(); ++field) {
+        if (field != 0) {
+            table += '\t';
+        }
+        table += FieldNames[field];
+    }
+    table += "\tlod_t_f32\tprojected_bound_f32\tobject36_f32\tscore_input_f32"
+             "\tscore_scale_f32\tscore_slope_f32\tscore_product_f32\trole_name\n";
+
+    std::array<u32, B535Capture::MaxPasses> valid_rows{};
+    std::string provenance_table =
+        "pass\tworkgroup\tlane\tidentity\trow\tconsumer_b1\twriter_mask\ta3_flags\t"
+        "a3_lookup_probe_mask\ta3_lookup_hit_mask\ta3_focus_invocations\t"
+        "latest_writer\tpc\temitted_value\tvalue_match\ta3_input_v13\tinput_bit31\t"
+        "force_predicate\ts32_bit0\tv17_zero\tv20_mask_nonzero\tselected_bit31\t"
+        "level_bit4\tflags_valid\toriginal_level\n";
+    std::vector<u32> provenance_tuples;
+    std::vector<u32> provenance_identities;
+    capture.dropped_records.clear();
+    capture.input_records.clear();
+    for (u32 pass = 0; pass < capture.pass_count; ++pass) {
+        const u32 workgroups = std::min(capture.dims[pass][0], B535Capture::MaxWorkgroupsPerPass);
+        for (u32 workgroup = 0; workgroup < workgroups; ++workgroup) {
+            for (u32 lane = 0; lane < B535Capture::LanesPerWorkgroup; ++lane) {
+                const u32 record_offset =
+                    B535Capture::RecordDword(pass, workgroup, lane, 0) - B535Capture::BaseDword;
+                const auto record = words.subspan(record_offset, B535Capture::RecordDwords);
+                if (record[B535Capture::Valid] == 0) {
+                    continue;
+                }
+                ++valid_rows[pass];
+                for (u32 field = 0; field < B535Capture::RecordDwords; ++field) {
+                    table += field == 0 ? fmt::format("0x{:08x}", record[field])
+                                        : fmt::format("\t0x{:08x}", record[field]);
+                }
+                const u32 role = record[B535Capture::OutputRole];
+                if ((record[B535Capture::Flags] & B535Capture::InputValid) != 0) {
+                    const std::array<u32, 2> input{record[B535Capture::Identity],
+                                                   record[B535Capture::Record]};
+                    if (std::ranges::find(capture.input_records, input) ==
+                        capture.input_records.end()) {
+                        capture.input_records.push_back(input);
+                    }
+
+                    const u32 identity = record[B535Capture::Identity];
+                    const u32 row = identity & 0x00ffffffU;
+                    if (!b1_provenance_words.empty() && row < B1Provenance::MaxRows &&
+                        std::ranges::find(provenance_identities, identity) ==
+                            provenance_identities.end()) {
+                        provenance_identities.push_back(identity);
+                        const u32 writer_mask = b1_provenance_words
+                            [B1Provenance::SiteMaskBaseDword - B1Provenance::BaseDword + row];
+                        const u32 a3_flags = b1_provenance_words
+                            [B1Provenance::TagBaseDword - B1Provenance::BaseDword + row];
+                        const u32 emitted = b1_provenance_words
+                            [B1Provenance::ValueBaseDword - B1Provenance::BaseDword + row];
+                        const u32 source = b1_provenance_words
+                            [B1Provenance::SourceBaseDword - B1Provenance::BaseDword + row];
+                        const u32 consumer = record[B535Capture::InputB1];
+                        const bool value_match = (writer_mask & 0xfU) != 0 && emitted == consumer;
+                        u64 writer_hash{};
+                        u32 writer_pc{};
+                        std::string_view writer = "unwritten";
+                        if ((writer_mask & B1Provenance::Transform2020Bit) != 0) {
+                            writer_hash = Shader::DreamsCompat::B1TransformWriterShader;
+                            writer_pc = 0x2020;
+                            writer = "a3-transform";
+                        } else if ((writer_mask & B1Provenance::Gather3c44Bit) != 0) {
+                            writer_hash = Shader::DreamsCompat::GatherVoxelsShader;
+                            writer_pc = 0x3c44;
+                            writer = "7ba-gather-copy";
+                        } else if ((writer_mask & B1Provenance::Gather2278Bit) != 0) {
+                            writer_hash = Shader::DreamsCompat::GatherVoxelsShader;
+                            writer_pc = 0x2278;
+                            writer = "7ba-gather-sentinel";
+                        } else if ((writer_mask & B1Provenance::Seed144Bit) != 0) {
+                            writer_hash = Shader::DreamsCompat::B1SeedWriterShader;
+                            writer_pc = 0x144;
+                            writer = "4ebe-seed";
+                        }
+                        provenance_table += fmt::format(
+                            "{}\t{}\t{}\t0x{:08x}\t0x{:06x}\t0x{:08x}\t0x{:08x}\t0x{:08x}\t"
+                            "0x{:02x}\t0x{:02x}\t{}\t"
+                            "{}:{:08x}\t"
+                            "0x{:04x}\t0x{:08x}\t{}\t0x{:08x}\t{}\t{}\t{}\t{}\t{}\t{}\t"
+                            "{}\t{}\t0x{:02x}\n",
+                            pass, workgroup, lane, identity, row, consumer, writer_mask, a3_flags,
+                            (writer_mask >> B1Provenance::FocusProbeMaskShift) & 0xff,
+                            (a3_flags >> B1Provenance::FocusHitMaskShift) & 0xff,
+                            writer_mask >> B1Provenance::FocusInvocationCountShift,
+                            writer, writer_hash, writer_pc, emitted, value_match, source,
+                            a3_flags & 1, (a3_flags >> 4) & 1, (a3_flags >> 1) & 1,
+                            (a3_flags >> 2) & 1, (a3_flags >> 3) & 1,
+                            (a3_flags >> 5) & 1, (a3_flags >> 6) & 1,
+                            (a3_flags >> 7) & 1, (a3_flags >> 20) & 0x1f);
+                        const std::array tuple{pass, workgroup, lane, identity, row, consumer,
+                                               writer_mask, a3_flags, emitted, source,
+                                               static_cast<u32>(value_match)};
+                        provenance_tuples.insert(provenance_tuples.end(), tuple.begin(),
+                                                 tuple.end());
+                    }
+                }
+                if ((record[B535Capture::Flags] & B535Capture::InputValid) != 0 && role == 0) {
+                    const std::array<u32, 2> dropped{record[B535Capture::Identity],
+                                                     record[B535Capture::Record]};
+                    if (std::ranges::find(capture.dropped_records, dropped) ==
+                        capture.dropped_records.end()) {
+                        capture.dropped_records.push_back(dropped);
+                    }
+                }
+                const std::string_view role_name = role == 0   ? "drop"
+                                                   : role == 1 ? "child-b6"
+                                                   : role == 2 ? "terminal-b5"
+                                                   : role == 4 ? "terminal-b4"
+                                                   : role == 8 ? "terminal-b3"
+                                                               : "multiple";
+                table +=
+                    fmt::format("\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n",
+                                std::bit_cast<float>(record[B535Capture::LodT]),
+                                std::bit_cast<float>(record[B535Capture::ProjectedBound]),
+                                std::bit_cast<float>(record[B535Capture::Object36]),
+                                std::bit_cast<float>(record[B535Capture::ScoreInput]),
+                                std::bit_cast<float>(record[B535Capture::ScoreScale]),
+                                std::bit_cast<float>(record[B535Capture::ScoreSlope]),
+                                std::bit_cast<float>(record[B535Capture::ScoreProduct]), role_name);
+            }
+        }
+    }
+    success &= WriteDreamsCaptureText(*directory / "b535-membership.tsv", table);
+    u64 provenance_hash{};
+    if (!b1_provenance_words.empty()) {
+        success &= WriteDreamsCaptureText(*directory / "b1-writer-provenance.tsv",
+                                          provenance_table);
+        success &= WriteDreamsCaptureWords(*directory / "b1-writer-provenance.bin",
+                                           provenance_tuples, provenance_hash);
+
+        const auto focus_word = [&](u32 absolute_dword) {
+            return b1_provenance_words[absolute_dword - B1Provenance::BaseDword];
+        };
+        std::string focus_table = fmt::format(
+            "magic\t0x{:08x}\nschema\t{}\nfocus_input_v13\t0x{:08x}\n"
+            "captured_input_v13\t0x{:08x}\nrow\t0x{:06x}\nseen_mask\t0x{:08x}\n"
+            "hit_mask\t0x{:08x}\nprobe_overflow_mask\t0x{:08x}\n"
+            "comparison_mask\t0x{:08x}\ninvocation_count\t{}\n"
+            "invocation_row_xor\t0x{:06x}\ninvocation_row_sum\t0x{:08x}\n"
+            "final_count\t{}\nfinal_v17_zero_count\t{}\nfinal_force_count\t{}\n"
+            "final_selected_sign_count\t{}\n\n"
+            "child\tprobe\ttarget_key\tinitial_hash\tbucket_count\tprobe_index\t"
+            "loaded_key\tloaded_payload\tkey_match\tchild_hit\n",
+            focus_word(B1Provenance::FocusMagicDword),
+            focus_word(B1Provenance::FocusSchemaDword), B1Provenance::FocusInputV13,
+            focus_word(B1Provenance::FocusInputDword),
+            focus_word(B1Provenance::FocusRowDword),
+            focus_word(B1Provenance::FocusSeenMaskDword),
+            focus_word(B1Provenance::FocusHitMaskDword),
+            focus_word(B1Provenance::FocusProbeOverflowMaskDword),
+            focus_word(B1Provenance::FocusComparisonMaskDword),
+            focus_word(B1Provenance::FocusInvocationCountDword),
+            focus_word(B1Provenance::FocusInvocationRowXorDword),
+            focus_word(B1Provenance::FocusInvocationRowSumDword),
+            focus_word(B1Provenance::FocusFinalCountDword),
+            focus_word(B1Provenance::FocusFinalV17ZeroCountDword),
+            focus_word(B1Provenance::FocusFinalForceCountDword),
+            focus_word(B1Provenance::FocusFinalSelectedSignCountDword));
+        const u32 hit_mask = focus_word(B1Provenance::FocusHitMaskDword);
+        for (u32 child = 0; child < B1Provenance::FocusMaxChildren; ++child) {
+            const u32 target_key =
+                focus_word(B1Provenance::FocusTargetKeyBaseDword + child);
+            const u32 initial_hash =
+                focus_word(B1Provenance::FocusInitialHashBaseDword + child);
+            const u32 bucket_count =
+                focus_word(B1Provenance::FocusBucketCountBaseDword + child);
+            for (u32 probe = 0; probe < B1Provenance::FocusMaxProbes; ++probe) {
+                const u32 slot = child * B1Provenance::FocusMaxProbes + probe;
+                const u32 probe_index =
+                    focus_word(B1Provenance::FocusProbeIndexBaseDword + slot);
+                const u32 loaded_key =
+                    focus_word(B1Provenance::FocusLoadedKeyBaseDword + slot);
+                const u32 loaded_payload =
+                    focus_word(B1Provenance::FocusLoadedPayloadBaseDword + slot);
+                focus_table += fmt::format(
+                    "{}\t{}\t0x{:08x}\t0x{:08x}\t{}\t0x{:08x}\t0x{:08x}\t"
+                    "0x{:08x}\t{}\t{}\n",
+                    child, probe + 1, target_key, initial_hash, bucket_count, probe_index,
+                    loaded_key, loaded_payload, loaded_key == target_key,
+                    (hit_mask >> child) & 1);
+            }
+        }
+        success &= WriteDreamsCaptureText(*directory / "a3-focus-lookup.tsv", focus_table);
+        u64 focus_hash{};
+        success &= WriteDreamsCaptureWords(
+            *directory / "a3-focus-lookup.bin",
+            b1_provenance_words.first(B1Provenance::HeaderDwords), focus_hash);
+    }
+
+    success &= WriteDreamsMetadataCapture(gds, *directory);
+
+    std::vector<u32> dropped_words;
+    dropped_words.reserve(capture.dropped_records.size() * 2);
+    for (const auto& dropped : capture.dropped_records) {
+        dropped_words.insert(dropped_words.end(), dropped.begin(), dropped.end());
+    }
+    u64 dropped_hash{};
+    success &= WriteDreamsCaptureWords(*directory / "dropped-records.bin", dropped_words,
+                                       dropped_hash);
+
+    const u32 overflow = words[B535Capture::OverflowDword - B535Capture::BaseDword];
+    std::string manifest =
+        fmt::format("shader=0x{:08x}\nraw_hash=0x{:016x}\nbase_dword=0x{:x}\ndword_count=0x{:x}\n"
+                    "record_dwords={}\nmax_passes={}\nmax_workgroups_per_pass={}\npass_count={}\n"
+                    "overflow={}\ndropped_records={}\ndropped_records_hash=0x{:016x}\n"
+                    "gate1_force_first_failure={}\n"
+                    "b1_provenance_schema={}\nb1_provenance_rows={}\n"
+                    "b1_provenance_hash=0x{:016x}\n",
+                    Shader::DreamsCompat::TraversalShader, raw_hash, B535Capture::BaseDword,
+                    B535Capture::DwordCount, B535Capture::RecordDwords, B535Capture::MaxPasses,
+                    B535Capture::MaxWorkgroupsPerPass, capture.pass_count, overflow,
+                    capture.dropped_records.size(), dropped_hash,
+                    Shader::DreamsCompat::ForceB535FirstGateFailure(), B1Provenance::Schema,
+                    provenance_identities.size(), provenance_hash);
+    for (u32 pass = 0; pass < capture.pass_count; ++pass) {
+        manifest += fmt::format("pass{}=sequence:{},dims:{}x{}x{},valid_rows:{}\n", pass,
+                                capture.sequences[pass], capture.dims[pass][0],
+                                capture.dims[pass][1], capture.dims[pass][2], valid_rows[pass]);
+    }
+    manifest += "output_role_bits=1:child-b6,2:terminal-b5,4:terminal-b4,8:terminal-b3,0:drop\n"
+                "nge_vcc_flags=0x40000000:afc_vcc,0x80000000:b38_vcc\n"
+                "b1_writer_mask_bits=0x1:a3@2020,0x2:7ba@2278,0x4:7ba@3c44,0x8:4ebe@144\n"
+                "flags=raw bitfield from dreams_compat.h B535MembershipCapture\n";
+    success &= WriteDreamsCaptureText(*directory / "manifest.txt", manifest);
+
+    if (!success || overflow != 0) {
+        FailDreamsB535MembershipCapture(
+            !success ? "one or more capture files could not be written"
+                     : "capture workgroup envelope overflowed; no lanes were silently omitted");
+        return false;
+    }
+    success &= WriteDreamsCaptureText(*directory / "complete.txt", "complete\n");
+    capture.active = false;
+    capture.complete = success;
+    capture.failed = !success;
+    LOG_WARNING(Render_Vulkan,
+                "Dreams B535 membership capture complete passes={} raw_hash={:#x} directory={}",
+                capture.pass_count, raw_hash, directory->string());
+    return success;
+}
