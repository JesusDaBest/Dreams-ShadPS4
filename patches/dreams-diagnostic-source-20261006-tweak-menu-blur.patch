+           TraceDreamsSceneStream() || TraceDreamsFleckRendering() ||
+           g_dreams_visibility_count_trace_active || TraceDreamsVisibilityLists() ||
+           TraceDreamsModelRecord() || TraceDreamsSlowDrawArgs() || TraceDreamsResetEnabled();
+}
