+                            "extent={}x{} pitch={} bits={} file={}",
+                            cb, image_id.index, image.info.guest_address, image.info.size.width,
+                            image.info.size.height, image.info.pitch, image.info.num_bits,
+                            file.string());
+            }
+        }
+    }
+
+    ResetBindings();
