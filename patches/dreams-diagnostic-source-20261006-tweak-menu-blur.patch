+static bool HandleDreamsRecordCreatorTrace(EXCEPTION_POINTERS* exception) noexcept {
+    constexpr u64 Offset = 0x1556ba0;
+    if (!exception || !exception->ExceptionRecord || !exception->ContextRecord ||
+        MemoryPatcher::g_eboot_address == 0) return false;
+    const u64 address = reinterpret_cast<u64>(exception->ExceptionRecord->ExceptionAddress);
+    if (address != MemoryPatcher::g_eboot_address + Offset) return false;
+    const HANDLE process = GetCurrentProcess();
+    CONTEXT* context = exception->ContextRecord;
+    constexpr u8 Original = 0x55;
+    SIZE_T written = 0;
+    if (!WriteProcessMemory(process, reinterpret_cast<void*>(address), &Original, 1, &written) ||
+        written != 1) return false;
+    FlushInstructionCache(process, reinterpret_cast<void*>(address), 1);
+    char buffer[2048]{};
+    int length = _snprintf_s(buffer, sizeof(buffer), _TRUNCATE,
+        "record_creator type=%u glyph=%u caller=0x%llx rbp=0x%llx rsp=0x%llx\r\n",
+        static_cast<unsigned>(context->Rdi), static_cast<unsigned>(context->Rsi),
+        static_cast<unsigned long long>(ReadDreamsU64(process, context->Rsp)),
+        static_cast<unsigned long long>(context->Rbp),
+        static_cast<unsigned long long>(context->Rsp));
+    // Bounded frame-pointer walk. Read helpers safely reject inaccessible guest memory.
+    u64 frame = context->Rbp;
+    for (unsigned i = 0; i < 8 && frame != 0 && length > 0; ++i) {
+        const u64 next = ReadDreamsU64(process, frame);
+        const u64 caller = ReadDreamsU64(process, frame + 8);
+        const int added = _snprintf_s(buffer + length, sizeof(buffer) - length, _TRUNCATE,
+            "frame=%u address=0x%llx caller=0x%llx\r\n", i,
+            static_cast<unsigned long long>(frame), static_cast<unsigned long long>(caller));
+        if (added <= 0) break;
+        length += added;
+        if (next <= frame || next - frame > 0x100000) break;
+        frame = next;
+    }
+    const HANDLE file = CreateFileW(L"dreams-record-creator-trace.txt", FILE_APPEND_DATA,
+        FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+        DWORD bytes = 0;
+        if (length > 0) WriteFile(file, buffer, static_cast<DWORD>(length), &bytes, nullptr);
+        CloseHandle(file);
+    }
+    context->Rsp -= sizeof(u64);
+    if (!WriteProcessMemory(process, reinterpret_cast<void*>(context->Rsp), &context->Rbp,
+                            sizeof(u64), &written) || written != sizeof(u64)) return false;
+    context->Rip = address + 1;
+    return true;
+}
