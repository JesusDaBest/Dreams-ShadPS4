+
+static bool FinalizeDreamsQueueProducerCapture() {
+    auto& capture = g_dreams_ordered_chain_capture;
+    if (!capture.producer_valid || capture.directory.empty()) {
+        return false;
+    }
+
+    std::error_code request_error;
+    const bool consumed =
+        std::filesystem::remove(capture.directory / "producer.request", request_error);
+    if (request_error || !consumed) {
+        LOG_ERROR(Render_Vulkan, "Dreams 2bf producer capture request could not be consumed: {}",
+                  request_error ? request_error.message() : "request was absent");
+        return false;
+    }
+
+    const std::filesystem::path output = capture.directory / "producer";
+    std::error_code directory_error;
+    std::filesystem::create_directories(output, directory_error);
+    if (directory_error) {
+        LOG_ERROR(Render_Vulkan, "Dreams 2bf producer capture directory failed: {}",
+                  directory_error.message());
+        return false;
+    }
+
+    const auto write_words = [&](std::string_view name, std::span<const u32> words) {
+        u64 ignored_hash{};
+        return WriteDreamsCaptureWords(output / name, words, ignored_hash);
+    };
+    bool files_ok = true;
+    files_ok &= write_words("userdata.bin", capture.producer_userdata);
+    files_ok &= write_words("srt-raw.bin", capture.producer_srt_raw);
+    files_ok &= write_words("srt-flat.bin", capture.producer_srt_flat);
+    files_ok &= write_words("buffer-descriptors.bin", capture.producer_buffer_descriptors);
+    files_ok &= write_words("gds-pre.bin", capture.producer_gds_pre);
+    files_ok &= write_words("gds-post.bin", capture.producer_gds_post);
+    files_ok &= write_words("b0-pre.bin", capture.producer_b0_pre);
+    files_ok &= write_words("b0-post-cpu.bin", capture.producer_b0_post);
+    files_ok &= write_words("b0-post-gpu.bin", capture.producer_b0_gpu_post);
+    files_ok &= write_words("b1-queue-pre.bin", capture.producer_b1_queue_pre);
+    files_ok &= write_words("b1-queue-post-cpu.bin", capture.producer_b1_queue_post);
+    files_ok &= write_words("b1-queue-post-gpu.bin", capture.producer_b1_queue_gpu_post);
+    files_ok &= write_words("b2-pre.bin", capture.producer_b2_pre);
+    files_ok &= write_words("b2-post-cpu.bin", capture.producer_b2_post);
+    files_ok &= write_words("b2-post-gpu.bin", capture.producer_b2_gpu_post);
+    files_ok &= write_words("b3-input.bin", capture.producer_b3_input);
+    files_ok &= write_words("b4-keys.bin", capture.producer_b4_keys);
+    files_ok &= write_words("b4-rows.bin", capture.producer_b4_rows);
+    files_ok &= write_words("store-probe.bin", capture.producer_store_probe);
+
+    const auto gds_word = [&](u32 index, const std::vector<u32>& words) {
+        return index < words.size() ? words[index] : 0;
+    };
+    const std::string summary = fmt::format(
+        "shader\t0x{:016x}\nsequence\t{}\ndims\t{}x{}x{}\nthreads\t{}x{}x{}\n"
+        "start\t{}x{}x{}\nactive_records\t{}\nqueue_begin\t{}\nqueue_end\t{}\n"
+        "gds320_pre\t{}\ngds320_post\t{}\ngds321_pre\t{}\ngds321_post\t{}\n"
+        "gds508_pre\t{}\ngds508_post\t{}\nb0_pre_hash\t0x{:016x}\n"
+        "b0_post_cpu_hash\t0x{:016x}\nb0_post_gpu_hash\t0x{:016x}\n"
+        "b1_post_gpu_hash\t0x{:016x}\nb2_post_gpu_hash\t0x{:016x}\n",
+        Shader::DreamsCompat::QueueProducerShader, capture.producer_sequence,
+        capture.producer_dims[0], capture.producer_dims[1], capture.producer_dims[2],
+        capture.producer_threads[0], capture.producer_threads[1], capture.producer_threads[2],
+        capture.producer_start[0], capture.producer_start[1], capture.producer_start[2],
+        capture.producer_active_records, capture.producer_queue_begin, capture.producer_queue_end,
+        gds_word(320, capture.producer_gds_pre), gds_word(320, capture.producer_gds_post),
+        gds_word(321, capture.producer_gds_pre), gds_word(321, capture.producer_gds_post),
+        gds_word(Shader::DreamsCompat::QueueProducerPrimaryOrderedCounterIndex,
+                 capture.producer_gds_pre),
+        gds_word(Shader::DreamsCompat::QueueProducerPrimaryOrderedCounterIndex,
+                 capture.producer_gds_post),
+        HashDreamsTraceWords(capture.producer_b0_pre),
+        HashDreamsTraceWords(capture.producer_b0_post),
+        HashDreamsTraceWords(capture.producer_b0_gpu_post),
+        HashDreamsTraceWords(capture.producer_b1_queue_gpu_post),
+        HashDreamsTraceWords(capture.producer_b2_gpu_post));
+    files_ok &= WriteDreamsCaptureText(output / "summary.tsv", summary);
+    files_ok &= WriteDreamsCaptureText(
+        output / (files_ok ? "complete.txt" : "failed.txt"),
+        files_ok ? "complete\n" : "one or more producer files could not be written\n");
+    LOG_WARNING(Render_Vulkan,
+                "Dreams 2bf producer-only capture {} sequence={} queue={}..{} directory={}",
+                files_ok ? "complete" : "failed", capture.producer_sequence,
+                capture.producer_queue_begin, capture.producer_queue_end, output.string());
+    return files_ok;
+}
