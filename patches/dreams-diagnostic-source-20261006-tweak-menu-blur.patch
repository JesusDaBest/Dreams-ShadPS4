+Id MinU32(EmitContext& ctx, Id value, u32 limit) {
+    const Id limit_id = ctx.ConstU32(limit);
+    const Id in_range = ctx.OpULessThanEqual(ctx.U1[1], value, limit_id);
+    return ctx.OpSelect(ctx.U32[1], in_range, value, limit_id);
