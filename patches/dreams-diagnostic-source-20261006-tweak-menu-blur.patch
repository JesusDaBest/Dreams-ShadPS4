+        index = ctx.OpIAdd(ctx.U32[1], index, offset);
+    }
+    const auto [id, pointer_type] = buffer.Alias(EmitContext::PointerType::U32);
+    return ctx.OpAccessChain(pointer_type, id, ctx.u32_zero_value, index);
