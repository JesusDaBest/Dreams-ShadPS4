+static std::string HexPreview(const void* data, u64 size) {
+    const auto* bytes = static_cast<const u8*>(data);
+    const auto preview_size = std::min<u64>(size, 32);
+    std::string preview;
+    preview.reserve(preview_size * 3);
+    for (u64 i = 0; i < preview_size; ++i) {
+        fmt::format_to(std::back_inserter(preview), "{:02x}{}", bytes[i],
+                       i + 1 == preview_size ? "" : " ");
+    }
+    return preview;
