+        "  \"candidate_geometry_records\": {},\n"
+        "  \"raw_candidate_records\": {},\n"
+        "  \"upstream_dispatch_records\": {},\n"
+        "  \"raw_candidate_note\": \"Raw VS inputs only; unseen records are not represented in "
+        "candidate-interface.bin\",\n"
+        "  \"files\": {{\n{}  }}\n"
+        "}}\n",
+        capture.active_count, Shader::DreamsCompat::VisibilityListOrderedLanesPerWorkgroup,
+        capture.producer_sequence, capture.producer_dims[0], capture.producer_dims[1],
+        capture.producer_dims[2], capture.producer_threads[0], capture.producer_threads[1],
+        capture.producer_threads[2], capture.producer_start[0], capture.producer_start[1],
+        capture.producer_start[2], capture.producer_dispatch_initiator,
+        capture.producer_active_records, capture.producer_queue_begin, capture.producer_queue_end,
+        capture.producer_srt_base, capture.producer_store_probe.size(),
+        capture.traversal_pass0_sequence, capture.traversal_pass0_dims[0],
+        capture.traversal_pass0_dims[1], capture.traversal_pass0_dims[2],
+        capture.traversal_pass0_queue_base, capture.traversal_pass0_queue_count,
+        g_dreams_b535_membership_capture.pass_count, capture.d8_start_sequence, d8_dimensions,
+        d8_sequences,
+        capture.list_sequence,
+        capture.list_dims[0], capture.list_dims[1], capture.list_dims[2], capture.initial_a,
+        capture.initial_b, capture.final_a, capture.final_b, instances, capture.index_size,
+        Vertices, Attributes, capture.d8_input.size(), capture.lookup.size() / 2,
+        capture.list_output.size() / 2, capture.candidate_records.size() / 2,
+        capture.raw_candidate_records.size() / 2, capture.upstream_dispatches.size(),
+        file_manifest);
+    if (!WriteDreamsCaptureText(capture.directory / "dispatch.json", dispatch) ||
+        !WriteDreamsCaptureText(capture.directory / "complete.txt", "complete\n")) {
+        FailDreamsOrderedChainCapture("dispatch manifest could not be written");
+        return false;
+    }
+    capture.phase = DreamsOrderedChainCaptureState::Phase::Complete;
+    LOG_WARNING(Render_Vulkan,
+                "Dreams aligned ordered-chain capture complete active={} draw_instances={} "
+                "lookup_records={} directory={}",
+                capture.active_count, instances, capture.lookup.size() / 2,
+                capture.directory.string());
+    return true;
+}
