+static void AppendDreamsSculptDocCounterRows(std::string& table, std::string_view stage,
+                                             u64 dispatch_sequence, bool stage_valid,
+                                             const DreamsSculptDocCounterSnapshot& snapshot) {
+    const auto append = [&](std::string_view family, u32 slot, u32 gds_index, u32 value) {
+        table += fmt::format("1\t{}\t{}\t{}\t{}\t{}\t{}\t{:#x}\t{}\n", stage,
+                             dispatch_sequence, stage_valid, snapshot.mapped, family, slot,
+                             gds_index, value);
+    };
+    for (u32 doc = 0; doc < static_cast<u32>(snapshot.b535.size()); ++doc) {
+        append("b535", doc, Shader::DreamsCompat::TraversalOrderedCounterIndices[doc],
+               snapshot.b535[doc]);
+    }
+    for (u32 pass = 0; pass < static_cast<u32>(snapshot.d8.size()); ++pass) {
+        append("d8", pass, Shader::DreamsCompat::VisibilityCandidateOrderedCounterDword(pass),
+               snapshot.d8[pass]);
+    }
+    for (u32 doc = 0; doc < static_cast<u32>(snapshot.list_7aa.size()); ++doc) {
+        append("7aa", doc, Shader::DreamsCompat::VisibilityListOrderedCounterIndices[doc],
+               snapshot.list_7aa[doc]);
+    }
+    append("84aa", 0, Shader::DreamsCompat::SculptOrderedCounterIndex, snapshot.sculpt_84aa);
+    append("f030", 0, Shader::DreamsCompat::SculptSurfaceOrderedCounterIndex,
+           snapshot.surface_f030);
+}
