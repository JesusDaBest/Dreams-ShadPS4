+static bool OverlapsDreamsRange(VAddr lhs_base, u64 lhs_size, VAddr rhs_base, u64 rhs_size) {
+    return lhs_base != 0 && rhs_base != 0 && lhs_size != 0 && rhs_size != 0 &&
+           lhs_base < rhs_base + rhs_size && rhs_base < lhs_base + lhs_size;
+}
+
+static bool TraceDreamsF030Arena() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_F030_ARENA_TRACE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled && Common::ElfInfo::Instance().GameSerial() == "CUSA04301";
+}
+
+static u32 DreamsF030ArenaOverlapMask(VAddr base, u64 size) {
+    if (!TraceDreamsF030Arena() || !g_dreams_f030_arena_trace.active) {
+        return 0;
+    }
+    return static_cast<u32>(OverlapsDreamsRange(base, size,
+                                                g_dreams_f030_arena_trace.count.base,
+                                                g_dreams_f030_arena_trace.count.size)) |
+           (static_cast<u32>(OverlapsDreamsRange(base, size,
+                                                 g_dreams_f030_arena_trace.records.base,
+                                                 g_dreams_f030_arena_trace.records.size))
+            << 1);
+}
+
+static void LogDreamsF030ArenaAccess(std::string_view kind, VAddr primary, u64 primary_size,
+                                     VAddr secondary = 0, u64 secondary_size = 0) {
+    auto& trace = g_dreams_f030_arena_trace;
+    if (!TraceDreamsF030Arena() || !trace.active || trace.binding_logs >= 512) {
+        return;
+    }
+    const u32 primary_overlap = DreamsF030ArenaOverlapMask(primary, primary_size);
+    const u32 secondary_overlap = DreamsF030ArenaOverlapMask(secondary, secondary_size);
+    if (primary_overlap == 0 && secondary_overlap == 0) {
+        return;
+    }
+    ++trace.binding_logs;
+    LOG_WARNING(Render_Vulkan,
+                "Dreams f030 arena access generation={} producer_sequence={} sequence={} "
+                "kind={} primary={:#x}+{:#x} primary_overlap={:#x} "
+                "secondary={:#x}+{:#x} secondary_overlap={:#x}",
+                trace.generation, trace.producer_sequence, g_compute_dispatch_sequence, kind,
+                primary, primary_size, primary_overlap, secondary, secondary_size,
+                secondary_overlap);
+}
+
+template <typename Regs>
+static void LogDreamsF030VertexInputs(const GraphicsPipeline& pipeline, const Regs& regs,
+                                      std::string_view draw_kind) {
+    if (!TraceDreamsF030Arena() || !g_dreams_f030_arena_trace.active) {
+        return;
+    }
+    VertexInputs<vk::VertexInputAttributeDescription2EXT> attributes;
+    VertexInputs<vk::VertexInputBindingDescription2EXT> bindings;
+    VertexInputs<vk::VertexInputBindingDivisorDescriptionEXT> divisors;
+    VertexInputs<AmdGpu::Buffer> guest_buffers;
+    pipeline.GetVertexInputs(attributes, bindings, divisors, guest_buffers,
+                             regs.vgt_instance_step_rate_0, regs.vgt_instance_step_rate_1);
+    const auto& vertex = pipeline.GetStage(Shader::LogicalStage::Vertex);
+    for (u32 index = 0; index < guest_buffers.size(); ++index) {
+        const auto& buffer = guest_buffers[index];
+        if (DreamsF030ArenaOverlapMask(buffer.base_address, buffer.GetSize()) == 0) {
+            continue;
+        }
+        LogDreamsF030ArenaAccess(
+            fmt::format("{}-vertex-vs-{:#x}-slot-{}", draw_kind, vertex.pgm_hash, index),
+            buffer.base_address, buffer.GetSize());
+    }
+}
+
+static u32 DreamsTerminalOutputOverlapMask(VAddr base, u64 size) {
+    u32 mask{};
+    for (u32 index = 0; index < g_dreams_terminal_output_ranges.size(); ++index) {
+        mask |= static_cast<u32>(OverlapsDreamsRange(base, size,
+                                                     g_dreams_terminal_output_ranges[index].base,
+                                                     g_dreams_terminal_output_ranges[index].size))
+                << index;
+    }
+    return mask;
+}
+
+static bool LogDreamsTerminalShaderOverlaps(std::string_view kind, u64 sequence,
+                                            const Shader::Info& stage) {
+    bool found{};
+    for (u32 index = 0; index < stage.buffers.size(); ++index) {
+        const auto& desc = stage.buffers[index];
+        if (desc.IsSpecial()) {
+            continue;
+        }
+        const auto sharp = desc.GetSharp(stage);
+        const u32 overlap_mask =
+            DreamsTerminalOutputOverlapMask(sharp.base_address, sharp.GetSize());
+        if (overlap_mask == 0) {
+            continue;
+        }
+        found = true;
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams terminal bound consumer kind={} sequence={} stage={} shader={:#x} "
+                    "buffer={} write={} base={:#x}+{:#x} stride={} records={} "
+                    "overlap_mask={:#x} terminal_records={}",
+                    kind, sequence, static_cast<u32>(stage.l_stage), stage.pgm_hash, index,
+                    desc.is_written, sharp.base_address, sharp.GetSize(), sharp.stride,
+                    sharp.num_records, overlap_mask, g_dreams_terminal_record_count);
+    }
+    return found;
+}
+
+static bool RememberDreamsSceneGeneratedRange(VAddr base, u64 size) {
+    if (base == 0 || size == 0) {
+        return false;
+    }
+    const DreamsTrackedBufferRange range{.base = base, .size = size};
+    const auto begin = g_dreams_scene_generated_ranges.begin();
+    const auto end = begin + g_dreams_scene_generated_range_count;
+    if (std::ranges::find(begin, end, range) != end ||
+        g_dreams_scene_generated_range_count == g_dreams_scene_generated_ranges.size()) {
+        return false;
+    }
+    g_dreams_scene_generated_ranges[g_dreams_scene_generated_range_count++] = range;
+    return true;
+}
+
+static void RememberDreamsVisibilityInputWriter(const DreamsBufferWriter& writer) {
+    if (!writer.declared_write) {
+        return;
+    }
+    const bool overlaps_input =
+        std::ranges::any_of(g_dreams_visibility_input_ranges, [&](auto range) {
+            return OverlapsDreamsRange(writer.base, writer.size, range.base, range.size);
+        });
+    if (!overlaps_input) {
+        return;
+    }
+
+    const auto same_writer = [&](const DreamsBufferWriter& candidate) {
+        return candidate.shader_hash == writer.shader_hash && candidate.stage == writer.stage &&
+               candidate.kind == writer.kind && candidate.binding_index == writer.binding_index &&
+               candidate.base == writer.base && candidate.size == writer.size &&
+               candidate.stride == writer.stride && candidate.source == writer.source;
+    };
+    if (auto existing = std::ranges::find_if(g_dreams_visibility_input_writers, same_writer);
+        existing != g_dreams_visibility_input_writers.end()) {
+        *existing = writer;
+        return;
+    }
+    g_dreams_visibility_input_writers.push_back(writer);
+}
+
+static void SetDreamsVisibilityInputRanges(DreamsTrackedBufferRange records,
+                                           DreamsTrackedBufferRange aux) {
+    const std::array ranges{records, aux};
+    if (ranges == g_dreams_visibility_input_ranges) {
+        return;
+    }
+    g_dreams_visibility_input_ranges = ranges;
+    g_dreams_visibility_input_writers.clear();
+    for (const auto& writer : g_dreams_buffer_writers) {
+        RememberDreamsVisibilityInputWriter(writer);
+    }
+}
+
+static void RecordDreamsBufferWriter(DreamsBufferWriter writer) {
+    TraceDreamsResetEvent("buffer-writer", writer.shader_hash, writer.base, writer.size,
+                         static_cast<u64>(writer.kind));
+    if (g_dreams_sculpt_args_upstream_window.active && writer.declared_write) {
+        auto& window = g_dreams_sculpt_args_upstream_window;
+        window.writers[window.writer_count % window.MaxWriters] = writer;
+        ++window.writer_count;
+    }
+    const std::array<u64, 9> catalog_key{
+        writer.shader_hash,
+        static_cast<u64>(writer.stage),
+        static_cast<u64>(writer.kind),
+        writer.binding_index,
+        writer.declared_write,
+        writer.base,
+        writer.size,
+        writer.stride,
+        writer.source,
+    };
+    auto catalog =
+        g_dreams_buffer_writer_catalog
+            .try_emplace(catalog_key,
+                         DreamsBufferWriterCatalogEntry{.first = writer,
+                                                        .last = writer,
+                                                        .count = 0})
+            .first;
+    catalog->second.last = writer;
+    ++catalog->second.count;
+    g_dreams_buffer_writers.push_back(writer);
+    RememberDreamsVisibilityInputWriter(writer);
+    constexpr size_t MaxDreamsBufferWriterHistory = 65536;
+    if (g_dreams_buffer_writers.size() > MaxDreamsBufferWriterHistory) {
+        g_dreams_buffer_writers.pop_front();
+    }
+}
