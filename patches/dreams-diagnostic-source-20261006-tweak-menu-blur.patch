index 000000000..6e0d760f2
--- /dev/null
+++ b/src/video_core/host_shaders/dreams_ordered_prefix.comp
@@ -0,0 +1,59 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+
+layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
+
+layout(std430, binding = 0) buffer global_data_share {
+    uint gds[];
+};
+
+layout(push_constant) uniform push_constants {
+    uvec4 streams[5];
+    uint stream_count;
+    uint entry_stride;
+    uint group_count_from_gds_mask;
+    uint matrix_group_count;
+    uint matrix_stream_count;
+    uint matrix_counter_base;
+    uint matrix_counter_row_stride;
+    uint matrix_counter_columns;
+    uint matrix_scratch_base;
+    uint matrix_scratch_stream_stride;
+};
+
+void main() {
+    const bool matrix_mode = matrix_stream_count != 0;
+    const uint stream_index =
+        matrix_mode ? gl_GlobalInvocationID.x : gl_LocalInvocationID.x;
+    const uint active_stream_count = matrix_mode ? matrix_stream_count : stream_count;
+    if (stream_index >= active_stream_count) {
+        return;
+    }
+
+    uvec4 stream;
+    uint count;
+    if (matrix_mode) {
+        const uint row = stream_index / matrix_counter_columns;
+        const uint column = stream_index % matrix_counter_columns;
+        stream = uvec4(matrix_group_count,
+                       matrix_counter_base + row * matrix_counter_row_stride + column,
+                       matrix_scratch_base + stream_index * matrix_scratch_stream_stride, 0);
+        count = matrix_group_count;
+    } else {
+        stream = streams[stream_index];
+        const bool group_count_from_gds =
+            (group_count_from_gds_mask & (1u << stream_index)) != 0;
+        count = group_count_from_gds ? min(gds[stream.w], stream.x) : stream.x;
+    }
+
+    uint running = gds[stream.y];
+    for (uint group = 0; group < count; ++group) {
+        const uint entry = stream.z + group * entry_stride;
+        const uint payload = gds[entry];
+        gds[entry + 1] = running;
+        running += payload;
+    }
+    gds[stream.y] = running;
+}
diff --git a/src/video_core/host_shaders/dreams_post_vs_replay.vert b/src/video_core/host_shaders/dreams_post_vs_replay.vert
new file mode 100644
index 000000000..8f189e32d
--- /dev/null
+++ b/src/video_core/host_shaders/dreams_post_vs_replay.vert
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+
+#extension GL_ARB_shader_viewport_layer_array : require
+
+// One record contains the raw post-VS bits captured for a single vertex:
+// Position, Param0, Param1, Param2, and the render-target layer. Keeping the
+// storage as uints prevents the host from canonicalizing NaNs or otherwise
+// changing a floating-point bit pattern before it reaches the fragment stage.
+layout(set = 0, binding = 6, std430) readonly buffer CapturedPostVs {
+    uint words[];
+} captured_post_vs;
+
+layout(location = 0) out vec4 out_attr0;
+layout(location = 1) out vec4 out_attr1;
+layout(location = 2) out vec4 out_attr2;
+
+const uint VerticesPerInstance = 8u;
+const uint WordsPerVertex = 17u;
+
+vec4 LoadVec4(uint word_offset) {
+    return uintBitsToFloat(uvec4(captured_post_vs.words[word_offset + 0u],
+                                captured_post_vs.words[word_offset + 1u],
+                                captured_post_vs.words[word_offset + 2u],
+                                captured_post_vs.words[word_offset + 3u]));
+}
+
+void main() {
+    const uint record_index =
+        uint(gl_InstanceIndex) * VerticesPerInstance + uint(gl_VertexIndex);
+    const uint word_offset = record_index * WordsPerVertex;
+
+    gl_Position = LoadVec4(word_offset + 0u);
+    out_attr0 = LoadVec4(word_offset + 4u);
+    out_attr1 = LoadVec4(word_offset + 8u);
+    out_attr2 = LoadVec4(word_offset + 12u);
+    gl_Layer = int(captured_post_vs.words[word_offset + 16u]);
+}
