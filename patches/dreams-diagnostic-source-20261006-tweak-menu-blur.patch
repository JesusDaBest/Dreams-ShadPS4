+        if (!capture.failed && capture.captured == DreamsVs370InterfaceCaptureOccurrences) {
+            capture.armed = false;
+            capture.complete = true;
+            bool parity_valid = capture.group_count == 1;
+            for (u32 index = 1; index < capture.captured; ++index) {
+                parity_valid &= capture.pass_keys[index] != capture.pass_keys[index - 1];
+                if (index >= 2) {
+                    parity_valid &= capture.pass_keys[index] == capture.pass_keys[index - 2];
+                }
+            }
+
+            std::string analysis;
+            analysis += "key\tvalue\n";
+            analysis += fmt::format("schema\t1\ncaptures\t{}\ngroups\t{}\nparity_valid\t{}\n",
+                                    capture.captured, capture.group_count, parity_valid);
+            for (u32 group = 0; group < capture.group_count; ++group) {
+                u32 first = std::numeric_limits<u32>::max();
+                bool inputs_stable = true;
+                bool interface_stable = true;
+                bool validity_complete = true;
+                u32 members{};
+                for (u32 index = 0; index < capture.captured; ++index) {
+                    if (capture.pass_groups[index] != group) {
+                        continue;
+                    }
+                    ++members;
+                    validity_complete &= capture.validity_complete[index];
+                    if (first == std::numeric_limits<u32>::max()) {
+                        first = index;
+                    } else {
+                        inputs_stable &= capture.input_hashes[index] == capture.input_hashes[first];
+                        interface_stable &=
+                            capture.interface_hashes[index] == capture.interface_hashes[first];
+                    }
+                }
+                const std::string_view classification =
+                    members < 2
+                        ? "insufficient_repeats"
+                        : (!validity_complete
+                               ? "capture_incomplete"
+                               : (!inputs_stable ? "requires_record_aligned_comparison"
+                                                 : (!interface_stable ? "vs_output_nondeterministic"
+                                                                      : "vs_boundary_stable")));
+                analysis += fmt::format("group_{}\tmembers={};inputs_stable={};interface_stable={};"
+                                        "validity_complete={};classification={}\n",
+                                        group, members, inputs_stable, interface_stable,
+                                        validity_complete, classification);
+            }
+            WriteDreamsCaptureText(dreams_vs370_pending_capture.output_directory / "analysis.tsv",
+                                   analysis);
+            WriteDreamsCaptureText(
+                dreams_vs370_pending_capture.output_directory / "complete.txt",
+                "One exact nonzero sculpt draw captured. The offline replay bundle is ready.\n");
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams VS370 interface capture complete captures={} groups={} "
+                        "parity_valid={} directory={}",
+                        capture.captured, capture.group_count, parity_valid,
+                        dreams_vs370_pending_capture.output_directory.string());
+        }
+    }
+
+    if (gpu_profile_ordinal != 0) {
+        scheduler.Finish();
+        u64 vertex_hash{};
+        u64 fragment_hash{};
+        for (const auto* shader : pipeline->GetStages()) {
+            if (shader == nullptr) {
+                continue;
+            }
+            if (shader->l_stage == Shader::LogicalStage::Vertex) {
+                vertex_hash = shader->pgm_hash;
+            } else if (shader->l_stage == Shader::LogicalStage::Fragment) {
+                fragment_hash = shader->pgm_hash;
+            }
+        }
+        const auto elapsed = std::chrono::duration<double, std::milli>(
+                                 std::chrono::steady_clock::now() - gpu_profile_start)
+                                 .count();
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams GPU profile #{} kind=draw-indirect indexed={} vs={:#x} fs={:#x} "
+                    "max_count={} stride={} elapsed={:.3f}ms",
+                    gpu_profile_ordinal, is_indexed, vertex_hash, fragment_hash, max_count, stride,
+                    elapsed);
+    }
+
+    if (trace_dreams_paint_visibility_indirect) {
+        dump_dreams_paint_visibility_target("after");
+    }
+
+    const bool dreams_visibility_draw =
+        dreams_fragment_hash == 0x2b6d3647 || dreams_fragment_hash == 0xce3b8413;
+    if (dreams_visibility_dump_dir && dreams_visibility_draw &&
+        ++dreams_visibility_dump_draw_count == 3) {
+        const auto dump_target = [&](std::string_view role, VideoCore::ImageId image_id) {
+            if (!image_id) {
+                return;
+            }
+            const auto& image = texture_cache.GetImage(image_id);
+            const auto file =
+                *dreams_visibility_dump_dir /
+                fmt::format("frame{:02}-{}-{:#x}-{}x{}-pitch{}-bits{}.bin",
+                            dreams_visibility_dump_frame_index, role, image.info.guest_address,
+                            image.info.size.width, image.info.size.height, image.info.pitch,
+                            image.info.num_bits);
+            texture_cache.DumpImageLinear(image_id, file);
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams visibility target dumped frame={} role={} id={} guest={:#x} "
+                        "extent={}x{} pitch={} bits={} file={}",
+                        dreams_visibility_dump_frame_index, role, image_id.index,
+                        image.info.guest_address, image.info.size.width, image.info.size.height,
+                        image.info.pitch, image.info.num_bits, file.string());
+        };
+        dump_target("color", cb_descs[0].first);
+        dump_target("depth", db_desc.first);
+        ++dreams_visibility_dump_frame_index;
+        if (--dreams_visibility_dump_frames_remaining == 0) {
+            dreams_visibility_dump_dir.reset();
+        }
+    }
+
+    ResetBindings();
+}
