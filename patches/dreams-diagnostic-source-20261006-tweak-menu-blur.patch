+
+static DreamsSculptDocCounterSnapshot CaptureDreamsSculptDocCounters(
+    std::span<const u8> mapped_gds) {
+    DreamsSculptDocCounterSnapshot snapshot{};
+    snapshot.mapped = true;
+    const auto read = [&](u32 index, u32& value) {
+        const u64 byte_offset = static_cast<u64>(index) * sizeof(u32);
+        if (byte_offset + sizeof(value) > mapped_gds.size()) {
+            snapshot.mapped = false;
+            return;
+        }
+        std::memcpy(&value, mapped_gds.data() + byte_offset, sizeof(value));
+    };
+    for (u32 doc = 0; doc < static_cast<u32>(snapshot.b535.size()); ++doc) {
+        read(Shader::DreamsCompat::TraversalOrderedCounterIndices[doc], snapshot.b535[doc]);
+    }
+    for (u32 pass = 0; pass < static_cast<u32>(snapshot.d8.size()); ++pass) {
+        read(Shader::DreamsCompat::VisibilityCandidateOrderedCounterDword(pass), snapshot.d8[pass]);
+    }
+    for (u32 doc = 0; doc < static_cast<u32>(snapshot.list_7aa.size()); ++doc) {
+        read(Shader::DreamsCompat::VisibilityListOrderedCounterIndices[doc],
+             snapshot.list_7aa[doc]);
+    }
+    read(Shader::DreamsCompat::SculptOrderedCounterIndex, snapshot.sculpt_84aa);
+    read(Shader::DreamsCompat::SculptSurfaceOrderedCounterIndex, snapshot.surface_f030);
+    return snapshot;
+}
