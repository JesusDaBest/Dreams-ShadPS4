+void WriteOrderedCrashMarker(vk::CommandBuffer command, vk::Buffer buffer, u64 offset, u32 value) {
+    const vk::BufferMemoryBarrier2 barrier{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+        .buffer = buffer,
+        .offset = offset,
+        .size = sizeof(u32),
+    };
+    const vk::DependencyInfo dependency{.bufferMemoryBarrierCount = 1,
+                                         .pBufferMemoryBarriers = &barrier};
+    command.pipelineBarrier2(dependency);
+    command.writeBufferMarkerAMD(vk::PipelineStageFlagBits::eAllCommands, buffer, offset, value);
+    command.pipelineBarrier2(dependency);
+}
+} // namespace
+
+void Scheduler::ConfigureOrderedMarkers(vk::Buffer buffer, const u8* mapped, u64 offset) {
+    if (!instance.IsAmdBufferMarkerSupported()) return;
+    if (!ordered_marker_mapped) {
+        LOG_WARNING(Render_Vulkan, "Ordered-count GPU execution markers active at offset {:#x}", offset);
+    }
+    ordered_marker_buffer = buffer;
+    ordered_marker_mapped = mapped;
+    ordered_marker_offset = offset;
+}
+
+void Scheduler::BeginOrderedMarker(u64 shader, u64 sequence) {
+    if (!ordered_marker_mapped) return;
+    ordered_marker_sequence = static_cast<u32>(sequence);
+    ordered_marker_records[ordered_marker_record_index++ % ordered_marker_records.size()] =
+        {ordered_marker_sequence, shader};
+    WriteOrderedCrashMarker(current_cmdbuf, ordered_marker_buffer, ordered_marker_offset,
+                            ordered_marker_sequence);
+}
+
+void Scheduler::EndOrderedMarker() {
+    if (!ordered_marker_mapped) return;
+    WriteOrderedCrashMarker(current_cmdbuf, ordered_marker_buffer,
+                            ordered_marker_offset + sizeof(u32), ordered_marker_sequence);
+}
+
