+static bool DreamsOrderedChainCaptureEnabled() {
+    return DreamsOrderedChainCaptureDirectory().has_value() &&
+           Common::ElfInfo::Instance().GameSerial() == "CUSA04301" &&
+           !Shader::DreamsCompat::CaptureA3LookupProducerTrace() &&
+           g_dreams_ordered_chain_capture.phase !=
+               DreamsOrderedChainCaptureState::Phase::Complete &&
+           g_dreams_ordered_chain_capture.phase != DreamsOrderedChainCaptureState::Phase::Failed;
