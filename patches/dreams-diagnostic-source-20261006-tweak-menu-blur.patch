+void EmitConditionalStore(EmitContext& ctx, Id condition, u32 handle, u32 index, Id value) {
+    const Id store_label = ctx.OpLabel();
+    const Id merge_label = ctx.OpLabel();
+    ctx.OpSelectionMerge(merge_label, spv::SelectionControlMask::MaskNone);
+    ctx.OpBranchConditional(condition, store_label, merge_label);
+
+    ctx.AddLabel(store_label);
+    StoreBufferU32(ctx, handle, index, value);
+    ctx.OpBranch(merge_label);
+
+    ctx.AddLabel(merge_label);
+}
