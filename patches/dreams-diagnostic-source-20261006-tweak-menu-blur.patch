+static bool DreamsOrderedChainAllowsVsCapture() {
+    const char* value = std::getenv("SHADPS4_DREAMS_ORDERED_CHAIN_CAPTURE_DIR");
+    if (value == nullptr || value[0] == '\0') {
+        return true;
+    }
+    const auto phase = g_dreams_ordered_chain_capture.phase;
+    return phase == DreamsOrderedChainCaptureState::Phase::WaitingForVs370 ||
+           phase == DreamsOrderedChainCaptureState::Phase::WaitingForVs370Interface;
