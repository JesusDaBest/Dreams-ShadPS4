+static void FailDreamsOrderedChainCapture(std::string_view reason) {
+    auto& capture = g_dreams_ordered_chain_capture;
+    if (capture.phase == DreamsOrderedChainCaptureState::Phase::Complete ||
+        capture.phase == DreamsOrderedChainCaptureState::Phase::Failed) {
+        return;
+    }
+    capture.phase = DreamsOrderedChainCaptureState::Phase::Failed;
+    LOG_ERROR(Render_Vulkan, "Dreams ordered-chain capture failed: {}", reason);
+    if (!capture.directory.empty()) {
+        WriteDreamsCaptureText(capture.directory / "failed.txt", fmt::format("{}\n", reason));
+    }
+}
