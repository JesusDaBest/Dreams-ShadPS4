+        case OperandField::VccZ: {
+            const IR::U1 zero = ir.LogicalAnd(ir.IEqual(ir.GetVccLo(), ir.Imm32(0)),
+                                              ir.IEqual(ir.GetVccHi(), ir.Imm32(0)));
