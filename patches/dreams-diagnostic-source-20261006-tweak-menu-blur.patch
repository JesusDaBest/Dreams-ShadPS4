+static bool HandleDreamsMenuInputTrace(EXCEPTION_POINTERS* exception) noexcept {
+    // Verified live 48-byte writer fingerprint at mapped offset 0x10b59c0.
+    constexpr u64 Offset = 0x10b59c0;
+    if (exception == nullptr || exception->ExceptionRecord == nullptr ||
+        exception->ContextRecord == nullptr || MemoryPatcher::g_eboot_address == 0) {
+        return false;
+    }
+    const u64 address = reinterpret_cast<u64>(exception->ExceptionRecord->ExceptionAddress);
+    if (address != MemoryPatcher::g_eboot_address + Offset) {
+        return false;
+    }
+    const HANDLE process = GetCurrentProcess();
+    CONTEXT* context = exception->ContextRecord;
+    // Restore immediately: only the first call traps, so normal UI updates stay at full speed.
+    constexpr u8 Original = 0x55;
+    SIZE_T written = 0;
+    WriteProcessMemory(process, reinterpret_cast<void*>(address), &Original, 1, &written);
+    FlushInstructionCache(process, reinterpret_cast<void*>(address), 1);
+    const u64 caller = ReadDreamsU64(process, context->Rsp);
+    const u64 root_object = ReadDreamsU64(process, context->R8);
+    const u64 world = root_object != 0 ? ReadDreamsU64(process, root_object + 8) : 0;
+    const u32 thing = ReadDreamsU32(process, context->R8 + 0x10);
+    char buffer[1024]{};
+    const int length = _snprintf_s(
+        buffer, sizeof(buffer), _TRUNCATE,
+        "menu_input caller=0x%llx property=%u sub_property=%u value=0x%llx "
+        "context=0x%llx root_object=0x%llx world=0x%llx thing=%u "
+        "slots=%u thing_count=%u\r\n",
+        static_cast<unsigned long long>(caller), static_cast<unsigned>(context->Rdi & 0xffff),
+        static_cast<unsigned>(context->Rdx & 0xff),
+        static_cast<unsigned long long>(context->Rsi),
+        static_cast<unsigned long long>(context->R8),
+        static_cast<unsigned long long>(root_object), static_cast<unsigned long long>(world),
+        thing, world != 0 ? ReadDreamsU32(process, world + 0x780d0) : 0,
+        world != 0 ? ReadDreamsRootCount(process, world) : 0);
+    const HANDLE file = CreateFileW(L"dreams-menu-input-trace.txt", FILE_APPEND_DATA,
+        FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file != INVALID_HANDLE_VALUE) {
+        DWORD bytes = 0;
+        if (length > 0) WriteFile(file, buffer, static_cast<DWORD>(length), &bytes, nullptr);
+        CloseHandle(file);
+    }
+    // Replay the replaced one-byte push rbp, preserving guest execution.
+    context->Rsp -= sizeof(u64);
+    WriteProcessMemory(process, reinterpret_cast<void*>(context->Rsp), &context->Rbp,
+                       sizeof(u64), &written);
+    context->Rip = address + 1;
+    return true;
+}
