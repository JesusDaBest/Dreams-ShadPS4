+static bool ConsumeDreamsGatherFocusTraceRequest() {
+    if (!TraceDreamsGatherFocus()) {
+        return false;
+    }
+    const char* trigger = std::getenv("SHADPS4_DREAMS_GATHER_FOCUS_TRACE_TRIGGER_FILE");
+    if (trigger == nullptr || trigger[0] == '\0') {
+        return false;
+    }
+    std::error_code ec;
+    const bool consumed = std::filesystem::remove(trigger, ec);
+    if (ec) {
+        LOG_ERROR(Render_Vulkan, "Failed to consume Dreams Gather focus trigger {}: {}", trigger,
+                  ec.message());
+    }
+    return consumed && !ec;
+}
