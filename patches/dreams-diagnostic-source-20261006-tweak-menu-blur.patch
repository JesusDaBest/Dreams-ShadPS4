+static void CaptureDreamsSelectorProducer(const Shader::Info& cs, Scheduler& scheduler,
+                                         VideoCore::BufferCache& buffer_cache,
+                                         std::span<const vk::DescriptorBufferInfo> buffers,
+                                         bool indirect, bool fast_path = false, std::span<const u32> shader_words = {}) {
+    const char* root = std::getenv("SHADPS4_DREAMS_CANDIDATE_SHADER_DIR");
+    if (!root || Common::ElfInfo::Instance().GameSerial() != "CUSA04301") return;
+    const std::filesystem::path directory{root};
+    std::error_code error;
+    if (!fast_path && !shader_words.empty() &&
+        std::filesystem::exists(directory / "compute-shader-export.trigger", error)) {
+        std::ifstream request(directory / "compute-shader-export.trigger");
+        u64 target{};request >> std::hex >> target;request.close();
+        if (target == cs.pgm_hash && std::filesystem::remove(directory / "compute-shader-export.trigger", error)) {
+            const auto prefix = fmt::format("compute-live-{:08x}", target);
+            u64 hash{};
+            WriteDreamsCaptureWords(directory / (prefix+".spv"), shader_words, hash);
+            WriteDreamsCaptureWords(directory / (prefix+"-srt.bin"), cs.flattened_ud_buf, hash);
+            WriteDreamsCaptureWords(directory / (prefix+"-user-data.bin"), cs.user_data, hash);
+            std::string manifest;
+            for(u32 i=0;i<cs.buffers.size();++i) {
+                const auto& desc=cs.buffers[i];
+                if(desc.IsSpecial()) {manifest+=fmt::format("buffer{}_special\t{}\n",i,static_cast<u32>(desc.buffer_type));continue;}
+                const auto sharp=desc.GetSharp(cs);
+                manifest+=fmt::format("buffer{}_base\t{:#x}\nbuffer{}_size\t{}\n",i,sharp.base_address,i,sharp.GetSize());
+            }
+            WriteDreamsCaptureText(directory / (prefix+"-manifest.tsv"), manifest);
+        }
+    }
+    if (!fast_path && cs.pgm_hash == 0x7aa925e9 && !shader_words.empty() &&
+        std::filesystem::remove(directory / "selector-shader.trigger", error)) {
+        u64 hash{};
+        WriteDreamsCaptureWords(directory / "selector-live.spv", shader_words, hash);
+        WriteDreamsCaptureWords(directory / "selector-live-srt.bin", cs.flattened_ud_buf, hash);
+        WriteDreamsCaptureWords(directory / "selector-live-user-data.bin", cs.user_data, hash);
+    }
+    static u32 remaining{};
+    static std::string rows;
+    if (std::filesystem::remove(directory / "compute-writers.trigger", error)) {
+        remaining = 4096;
+        rows = "sequence\tshader\tindirect\tfast_path\tbinding\twrite\tbase\tsize\n";
+    }
+    if (remaining) {
+        for (u32 i = 0; i < cs.buffers.size(); ++i) {
+            if (cs.buffers[i].IsSpecial()) continue;
+            const auto sharp = cs.buffers[i].GetSharp(cs);
+            rows += fmt::format("{}\t{:#x}\t{}\t{}\t{}\t{}\t{:#x}\t{}\n",
+                g_compute_dispatch_sequence, cs.pgm_hash, indirect, fast_path, i, cs.buffers[i].is_written,
+                sharp.base_address, sharp.GetSize());
+        }
+        if (--remaining == 0) WriteDreamsCaptureText(directory / "compute-writers.tsv", rows);
+    }
+    if (!fast_path && cs.pgm_hash == 0x7aa925e9 &&
+        std::filesystem::remove(directory / "preview-inputs.trigger", error)) {
+        std::string manifest = fmt::format("shader\t{:#x}\nsequence\t{}\nphase\tpost-compaction\n", cs.pgm_hash, g_compute_dispatch_sequence);
+        u64 hash{};
+        for (u32 binding = 0; binding < cs.buffers.size() && binding < buffers.size(); ++binding) {
+            const auto& desc = cs.buffers[binding];
+            if (desc.IsSpecial()) continue;
+            const auto sharp = desc.GetSharp(cs);
+            const u64 bytes = std::min<u64>(sharp.GetSize(), binding == 2 ? 1_MB : 256_KB);
+            const auto& bound = buffers[binding];
+            std::vector<u8> data(static_cast<size_t>(bytes));
+            const bool valid = bytes && bound.range != VK_WHOLE_SIZE && bound.range >= sharp.GetSize();
+            const bool read = valid && ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+                bound, bound.range - sharp.GetSize(), data);
+            manifest += fmt::format("buffer{}_base\t{:#x}\nbuffer{}_size\t{}\nbuffer{}_captured_bytes\t{}\nbuffer{}_read_ok\t{}\nbuffer{}_complete\t{}\n",
+                binding, sharp.base_address, binding, sharp.GetSize(), binding, bytes, binding, read, binding, bytes == sharp.GetSize());
+            if (read) WriteDreamsCaptureBytes(directory / fmt::format("preview-input-buffer{}.gpu.bin", binding), data, hash);
+        }
+        WriteDreamsCaptureWords(directory / "preview-input-srt.bin", cs.flattened_ud_buf, hash);
+        WriteDreamsCaptureWords(directory / "preview-input-user-data.bin", cs.user_data, hash);
+        WriteDreamsCaptureText(directory / "preview-input-manifest.tsv", manifest);
+    }
+    if (fast_path || cs.pgm_hash != 0x1e7dbccf || cs.buffers.empty() || cs.buffers[0].IsSpecial() ||
+        !std::filesystem::remove(directory / "selector-producer.trigger", error)) return;
+    const auto sharp = cs.buffers[0].GetSharp(cs);
+    const u64 bytes = std::min<u64>(sharp.GetSize(), 64_KB);
+    std::vector<u8> output(static_cast<size_t>(bytes));
+    const bool valid = bytes && !buffers.empty() && buffers[0].range != VK_WHOLE_SIZE &&
+        buffers[0].range >= sharp.GetSize();
+    const bool read = valid && ReadDreamsBoundBufferForCapture(scheduler, buffer_cache,
+        buffers[0], buffers[0].range - sharp.GetSize(), output);
+    u64 hash{};
+    if (read) WriteDreamsCaptureBytes(directory / "selector-producer-bound.gpu.bin", output, hash);
+    WriteDreamsCaptureText(directory / "selector-producer-manifest.tsv",
+        fmt::format("shader\t{:#x}\nsequence\t{}\nindirect\t{}\nbase\t{:#x}\nsize\t{}\ncaptured_bytes\t{}\nread_ok\t{}\nsource\tsettled-vulkan-binding\n",
+            cs.pgm_hash, g_compute_dispatch_sequence, indirect, sharp.base_address, sharp.GetSize(), bytes, read));
+    WriteDreamsCaptureText(directory / "capture.trigger", "3f6e1a00 d25db925 0\n");
+}
