+static void FailDreamsB535MembershipCapture(std::string_view reason) {
+    auto& capture = g_dreams_b535_membership_capture;
+    capture.active = false;
+    capture.failed = true;
+    LOG_ERROR(Render_Vulkan, "Dreams B535 membership capture failed: {}", reason);
+    if (const auto directory = DreamsB535MembershipCaptureDirectory()) {
+        WriteDreamsCaptureText(*directory / "failed.txt", fmt::format("{}\n", reason));
+    }
+}
