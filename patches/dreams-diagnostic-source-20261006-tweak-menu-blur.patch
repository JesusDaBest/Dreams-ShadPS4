+static const std::optional<std::filesystem::path>& DreamsOrderedChainCaptureDirectory() {
+    static const std::optional<std::filesystem::path> directory = [] {
+        const char* value = std::getenv("SHADPS4_DREAMS_ORDERED_CHAIN_CAPTURE_DIR");
+        if (value == nullptr || value[0] == '\0') {
+            return std::optional<std::filesystem::path>{};
+        }
+        std::filesystem::path output{value};
+        std::error_code error;
+        std::filesystem::create_directories(output, error);
+        if (error) {
+            LOG_ERROR(Render_Vulkan, "Failed to create ordered-chain capture directory {}: {}",
+                      output.string(), error.message());
+            return std::optional<std::filesystem::path>{};
+        }
+        g_dreams_ordered_chain_capture.directory = output;
+        std::filesystem::remove(output / "complete.txt", error);
+        error.clear();
+        std::filesystem::remove(output / "failed.txt", error);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams aligned d8 -> 7aa -> VS370 capture waiting for capture.request: {}",
+                    output.string());
+        return std::optional<std::filesystem::path>{std::move(output)};
+    }();
+    return directory;
+}
