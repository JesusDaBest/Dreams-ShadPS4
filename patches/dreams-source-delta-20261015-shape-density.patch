+static thread_local bool g_dreams_generation_dispatch_has_work = true;
+
+// Private experiment: publish the two bounded hash-probe seed arrays before GatherVoxels.
+// The shader reads seed[i + 5], i=1..count[bucket]. A missing BDA page returns zero;
+// processing that fault after the dispatch cannot repair a one-shot cooked volume.
+static void ApplyDreamsGatherBdaPrewarm(const Shader::Info& info,
+                                       Core::MemoryManager* memory,
+                                       VideoCore::BufferCache& buffer_cache) {
+    const char* mode = std::getenv("SHADPS4_DREAMS_GATHER_BDA_PREWARM");
+    if (!mode || info.pgm_hash != Shader::DreamsCompat::GatherVoxelsShader ||
+        Common::ElfInfo::Instance().GameSerial() != "CUSA04301") {
+        return;
+    }
+    const bool apply = std::string_view{mode} == "1";
+    // Bindings and selector limits correspond to the original shader's two hash tables.
+    constexpr std::array<u32, 2> bindings{13, 8};
+    constexpr std::array<u32, 2> selectors{108, 114};
+    constexpr std::array<u32, 2> roots{2, 4};
+    constexpr u64 MaxTableBytes = 8 * 1024 * 1024;
+    constexpr u64 MaxSeedBytes = 1024 * 1024;
+    constexpr VAddr AddressLimit = VAddr{VideoCore::BufferCache::CACHING_NUMPAGES}
+                                    << VideoCore::BufferCache::CACHING_PAGEBITS;
+    static u32 reports{};
+    static u32 calls{};
+    if (calls++ >= 32 && !apply) return;
+    for (u32 table = 0; table < 2; ++table) {
+        if (info.user_data.size() <= roots[table] + 1 ||
+            info.flattened_ud_buf.size() <= selectors[table] ||
+            info.buffers.size() <= bindings[table] || info.buffers[bindings[table]].IsSpecial()) {
+            continue;
+        }
+        const auto sharp = info.buffers[bindings[table]].GetSharp(info);
+        const u64 count = u64{info.flattened_ud_buf[selectors[table]]} + 1;
+        const u64 bytes = count * sizeof(u32);
+        const VAddr root = VAddr{info.user_data[roots[table]]} |
+                           (VAddr{info.user_data[roots[table] + 1]} << 32);
+        if (!sharp.base_address || bytes > MaxTableBytes || bytes > sharp.GetSize() ||
+            sharp.stride != sizeof(u32) ||
+            !memory->IsValidMapping(sharp.base_address, bytes)) {
+            continue;
+        }
+        buffer_cache.ReadMemory(sharp.base_address, bytes);
+        if (buffer_cache.IsRegionGpuModified(sharp.base_address, bytes)) {
+            continue;
+        }
+        const auto* counts = std::bit_cast<const u32*>(sharp.base_address);
+        u32 maximum{};
+        for (u64 i = 0; i < count; ++i) {
+            maximum = std::max(maximum, counts[i]);
+        }
+        const u64 seed_bytes = u64{maximum} * sizeof(u32);
+        constexpr u64 FirstByte = 6 * sizeof(u32);
+        if (!maximum || seed_bytes > MaxSeedBytes || !root || root >= AddressLimit ||
+            FirstByte > AddressLimit - root || seed_bytes > AddressLimit - root - FirstByte ||
+            !memory->IsValidMapping(root + FirstByte, seed_bytes)) {
+            continue;
+        }
+        const VAddr address = root + FirstByte;
+        const bool registered = buffer_cache.IsRegionRegistered(address, seed_bytes);
+        if (apply) {
+            buffer_cache.FindBuffer(address, static_cast<u32>(seed_bytes));
+            buffer_cache.SynchronizeBuffersInRange(address, seed_bytes);
+        }
+        if (reports++ < 64) {
+            LOG_WARNING(Render_Vulkan,
+                        "Dreams Gather BDA table={} root={:#x} buckets={} max_probe={} "
+                        "bytes={} registered_before={} apply={} registered_after={}",
