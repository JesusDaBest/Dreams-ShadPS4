+        const u64 expected_offset = overlap_begin - expected_base;
+        const auto actual = std::span<const u8>{std::bit_cast<const u8*>(overlap_begin),
+                                               static_cast<size_t>(overlap_size)};
+        const auto expected_slice = expected.subspan(static_cast<size_t>(expected_offset),
+                                                     static_cast<size_t>(overlap_size));
+        u64 mismatch_bytes{};
+        for (u64 index = 0; index < overlap_size; ++index) {
+            mismatch_bytes += actual[index] != expected_slice[index];
+        }
+        const auto metadata = fmt::format(
+            "schema\t2\nf030_sequence\t{}\nfiveac_sequence\t{}\n"
+            "guest_rip\t{:#x}\nrequest_base\t{:#x}\nrequest_size\t{}\n"
+            "overlap_base\t{:#x}\n"
+            "overlap_size\t{}\nexpected_offset\t{}\nexpected_fnv1a64\t{:#x}\n"
+            "actual_fnv1a64\t{:#x}\nmismatch_bytes\t{}\nmatch\t{}\n",
+            capture.f030_sequence, capture.fiveac_sequence, read_pc, address, size,
+            overlap_begin, overlap_size, expected_offset, HashDreamsTraceBytes(expected_slice),
+            HashDreamsTraceBytes(actual), mismatch_bytes, mismatch_bytes == 0);
+        const bool written = !capture.directory.empty() &&
+                             WriteDreamsCaptureText(
+                                 capture.directory / fmt::format("cpu-{}-read.tsv", name),
+                                 metadata);
+        LOG_WARNING(Render_Vulkan,
+                    "Dreams 5ac CPU handoff {} sequence={} guest_rip={:#x} request={:#x}+{} "
+                    "overlap={:#x}+{} mismatch_bytes={} written={}",
+                    name, capture.fiveac_sequence, read_pc, address, size, overlap_begin,
+                    overlap_size, mismatch_bytes, written);
+        seen = true;
+    };
+
+    observe_range("count", capture.count_base, capture.expected_count, capture.count_seen);
+    observe_range("records", capture.records_base, capture.expected_records,
+                  capture.records_seen);
+    if (capture.count_seen && capture.records_seen) {
+        const bool written = !capture.directory.empty() &&
+                             WriteDreamsCaptureText(
+                                 capture.directory / "cpu-handoff-complete.txt", "complete\n");
+        capture.active = false;
+        if (!written) {
+            LOG_ERROR(Render_Vulkan,
+                      "Dreams 5ac CPU-handoff completion marker could not be written");
+        }
+    }
+}
