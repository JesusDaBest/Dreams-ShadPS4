+    const VAddr request_end = address + size;
+    const auto observe_range = [&](std::string_view name, VAddr expected_base,
+                                   std::span<const u8> expected, bool& seen) {
+        if (seen || expected.empty() ||
+            expected_base > std::numeric_limits<VAddr>::max() - expected.size()) {
+            return;
+        }
+        const VAddr expected_end = expected_base + expected.size();
+        const VAddr overlap_begin = std::max(address, expected_base);
+        const VAddr overlap_end = std::min(request_end, expected_end);
+        if (overlap_begin >= overlap_end) {
+            return;
