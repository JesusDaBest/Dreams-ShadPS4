+static bool PopulateDreamsGatherVoxelsWriteTrace(
+    std::span<DreamsSculptAtlasUnknownObservation> observations, VideoCore::Buffer& gds) {
+    constexpr u64 TraceBegin =
+        static_cast<u64>(GatherVoxelsWriteCapture::MaxValueBaseDword) * sizeof(u32);
+    constexpr u64 TraceEnd =
+        static_cast<u64>(GatherVoxelsWriteCapture::EndDword) * sizeof(u32);
+    if (TraceEnd > gds.SizeBytes() || TraceEnd > gds.mapped_data.size()) {
+        return false;
+    }
+
+    for (auto& observation : observations) {
+        const bool in_domain = observation.x >= 0 && observation.y >= 0 &&
+                               observation.z >= 0 &&
+                               static_cast<u32>(observation.x) <
+                                   GatherVoxelsWriteCapture::Width &&
+                               static_cast<u32>(observation.y) <
+                                   GatherVoxelsWriteCapture::Height &&
+                               static_cast<u32>(observation.z) <
+                                   GatherVoxelsWriteCapture::Depth;
+        observation.gather_voxels_write_trace_in_domain = in_domain;
+        if (!in_domain) {
+            continue;
+        }
+
+        const u32 index = GatherVoxelsWriteCapture::TexelDword(
+            static_cast<u32>(observation.x), static_cast<u32>(observation.y),
+            static_cast<u32>(observation.z));
+        const u64 max_offset = static_cast<u64>(
+                                   GatherVoxelsWriteCapture::MaxValueBaseDword + index) *
+                               sizeof(u32);
+        const u64 min_inverse_offset = static_cast<u64>(
+                                           GatherVoxelsWriteCapture::MinInverseBaseDword + index) *
+                                       sizeof(u32);
+        ASSERT(max_offset >= TraceBegin && max_offset + sizeof(u32) <= TraceEnd);
+        ASSERT(min_inverse_offset >= TraceBegin &&
+               min_inverse_offset + sizeof(u32) <= TraceEnd);
+        gds.InvalidateMappedRange(max_offset, sizeof(u32));
+        gds.InvalidateMappedRange(min_inverse_offset, sizeof(u32));
+        u32 encoded_max{};
+        u32 encoded_min_inverse{};
+        std::memcpy(&encoded_max, gds.mapped_data.data() + max_offset, sizeof(u32));
+        std::memcpy(&encoded_min_inverse,
+                    gds.mapped_data.data() + min_inverse_offset, sizeof(u32));
+        if (encoded_max == 0 && encoded_min_inverse == 0) {
+            continue;
+        }
+        const auto valid_encoding = [](u32 encoded) {
+            return encoded >= GatherVoxelsWriteCapture::EncodedBias &&
+                   encoded < GatherVoxelsWriteCapture::EncodedBias + 256;
+        };
+        if (!valid_encoding(encoded_max) || !valid_encoding(encoded_min_inverse)) {
+            return false;
+        }
+        observation.gather_voxels_write_trace_seen = true;
+        observation.gather_voxels_write_trace_max =
+            encoded_max - GatherVoxelsWriteCapture::EncodedBias;
+        observation.gather_voxels_write_trace_min =
+            255 - (encoded_min_inverse - GatherVoxelsWriteCapture::EncodedBias);
+        if (observation.gather_voxels_write_trace_min >
+            observation.gather_voxels_write_trace_max) {
+            return false;
+        }
+    }
+    return true;
+}
