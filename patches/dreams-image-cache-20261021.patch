+constexpr uint32_t Magic = 0x44425031;
+constexpr uint32_t Version = 2;
+constexpr uint32_t Buttons = 0x0010fffe;
+constexpr uint32_t Motion = 1;
+constexpr uint32_t Touch = 2;
+constexpr uint32_t Screenshot = 4;
+constexpr uint64_t MaxLease = 2000;
+
+struct Command {
+    uint64_t issued_ms{};
+    uint64_t expires_ms{};
+    uint32_t enabled{};
+    uint32_t buttons{};
+    uint32_t axes[6]{128, 128, 128, 128, 0, 0};
+    uint32_t flags{};
+    uint32_t touch_down{};
+    float touch_x{}, touch_y{};
+    float gyro[3]{};
+    float orientation[4]{0, 0, 0, 1};
+};
+static_assert(sizeof(Command) == 96);
+
+struct Status {
+    uint64_t sampled_ms{};
+    uint64_t guest_timestamp{};
+    uint32_t accepted_sequence{};
+    uint32_t error{};
+    uint32_t active{};
+    uint32_t connected{};
+    uint32_t buttons{};
+    uint32_t axes[6]{};
+    uint32_t touch_down{};
+    float orientation[4]{};
+};
+static_assert(sizeof(Status) == 80);
+
+struct Shared {
+    uint32_t magic{}, version{}, bytes{}, pid{};
+    uint64_t process_birth{};
+    volatile LONG command_sequence{};
+    uint32_t reserved{};
+    Command command{};
+    volatile LONG status_sequence{};
+    uint32_t reserved2{};
+    Status status{};
+};
+static_assert(offsetof(Shared, command) == 32);
+static_assert(offsetof(Shared, status_sequence) == 128);
+static_assert(offsetof(Shared, status) == 136);
+static_assert(sizeof(Shared) == 216);
+
+inline bool Valid(const Command& c, uint64_t now) {
+    if (c.enabled > 1 || (c.buttons & ~Buttons) ||
+        (c.flags & ~(Motion | Touch | Screenshot)) ||
+        ((c.flags & Screenshot) && (c.enabled || c.flags != Screenshot)) ||
+        c.touch_down > 1 || c.issued_ms > now || c.expires_ms < c.issued_ms ||
+        c.expires_ms - c.issued_ms > MaxLease) {
+        return false;
+    }
+    for (auto a : c.axes) if (a > 255) return false;
+    if (!std::isfinite(c.touch_x) || !std::isfinite(c.touch_y) ||
+        c.touch_x < 0 || c.touch_x > 1 || c.touch_y < 0 || c.touch_y > 1) return false;
+    for (auto g : c.gyro) if (!std::isfinite(g) || std::abs(g) > 20) return false;
+    float norm = 0;
+    for (auto q : c.orientation) {
+        if (!std::isfinite(q)) return false;
+        norm += q * q;
+    }
+    return norm >= 0.99f && norm <= 1.01f;
+}
+
+// Pure overlay: the user's physical state and smoothing history are never changed.
+inline State Overlay(const State& physical, const Command& c, uint64_t now,
+                     uint64_t touch_started, uint8_t touch_id) {
+    State result = physical;
+    if (!physical.connected || !c.enabled || now >= c.expires_ms || !Valid(c, now))
+        return result;
+    result.buttonsState = static_cast<Libraries::Pad::OrbisPadButtonDataOffset>(c.buttons);
+    for (size_t i = 0; i < 6; ++i) result.axes[i] = static_cast<int>(c.axes[i]);
+    if (c.axes[4]) result.buttonsState |= Libraries::Pad::OrbisPadButtonDataOffset::L2;
+    if (c.axes[5]) result.buttonsState |= Libraries::Pad::OrbisPadButtonDataOffset::R2;
+    if (c.flags & Touch) {
+        result.touchpad[0] = {touch_id, c.touch_down != 0,
+                             static_cast<uint16_t>(c.touch_x * 1920),
+                             static_cast<uint16_t>(c.touch_y * 941)};
+        result.touchpad[1] = {};
+        result.touch_time_since_held_down = c.touch_down ? (now - touch_started) * 1000 : 0;
+    }
+    if (c.flags & Motion) {
+        result.angularVelocity = {c.gyro[0], c.gyro[1], c.gyro[2]};
+        result.orientation = {c.orientation[0], c.orientation[1],
+                              c.orientation[2], c.orientation[3]};
+    }
+    return result;
+}
+
+class Server {
+    std::mutex mutex;
+    HANDLE mapping{};
+    Shared* shared{};
+    const GameController* target{};
+    Command current{};
+    uint32_t sequence{};
+    uint32_t error{};
+    uint64_t touch_started{};
+    uint8_t touch_id{};
