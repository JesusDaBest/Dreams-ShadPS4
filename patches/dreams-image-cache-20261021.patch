+        status.guest_timestamp = physical.time;
+        status.accepted_sequence = sequence;
+        status.error = error;
+        status.active = active;
+        status.connected = result.connected;
+        status.buttons = std::to_underlying(result.buttonsState);
+        for (size_t i = 0; i < 6; ++i) status.axes[i] = result.axes[i];
+        status.touch_down = result.touchpad[0].state;
+        status.orientation[0] = result.orientation.x;
+        status.orientation[1] = result.orientation.y;
+        status.orientation[2] = result.orientation.z;
+        status.orientation[3] = result.orientation.w;
+        InterlockedIncrement(&shared->status_sequence);
+        std::memcpy(&shared->status, &status, sizeof(status));
+        InterlockedIncrement(&shared->status_sequence);
+        return result;
+    }
+};
+
+inline Server& Instance() { static Server server; return server; }
+inline void Register(const GameController* c) { Instance().Register(c); }
+inline State Apply(const GameController* c, const State& s) { return Instance().Apply(c, s); }
+
+} // namespace Input::DreamsBackground
