+static void FinalizeDreamsDynamicReads(const Pipeline* pipeline, Rasterizer& rasterizer,
+                                       VideoCore::BufferCache& cache,
+                                       Pipeline::BufferBarriers& barriers,
+                                       std::span<const vk::DescriptorBufferInfo> bindings) {
+    for (const auto* stage : pipeline->GetStages()) {
+        if (!stage) {
+            continue;
+        }
+        const auto reads = ResolveDreamsDynamicReads(*stage,
+            rasterizer.GetPipelineCache().GetCurrentShaderSpirv(stage->l_stage));
+        if (!reads || !std::ranges::all_of(*reads, [&](const auto& read) {
+                return rasterizer.IsMapped(read.address, read.size);
+            })) {
+            continue;
+        }
+        // BindResources pre-created these ranges. Vertex/index/indirect bindings
+        // and the final descriptor refresh can have joined their buffers since
+        // then, so resolve the current backing and union its uses immediately
+        // before the barriers and draw are submitted.
+        for (const auto& read : *reads) {
+            auto& buffer = cache.GetBuffer(cache.FindBuffer(read.address, read.size));
+            vk::AccessFlags2 descriptor_access{};
+            size_t index{};
+            for (const auto* bound_stage : pipeline->GetStages()) {
+                if (!bound_stage) {
+                    continue;
+                }
+                for (const auto& desc : bound_stage->buffers) {
+                    ASSERT(index < bindings.size());
+                    if (bindings[index++].buffer == buffer.Handle()) {
+                        descriptor_access |= vk::AccessFlagBits2::eShaderRead;
+                        if (desc.is_written) {
+                            descriptor_access |= vk::AccessFlagBits2::eShaderWrite;
+                        }
+                    }
+                }
+            }
+            // A same-state descriptor binding may have emitted no barrier. Its
+            // write still belongs to this draw and must survive the added read.
+            AppendDreamsDynamicReadBarrier(buffer, barriers, descriptor_access);
+        }
+    }
