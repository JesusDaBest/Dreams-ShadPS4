+// A physical-address read is a use of the underlying cached buffer, even though it
+// has no ordinary descriptor. Preserve simultaneous descriptor writes and the
+// original producer scopes of barriers that have not yet been submitted.
+static void AppendDreamsDynamicReadBarrier(VideoCore::Buffer& buffer,
+                                          Pipeline::BufferBarriers& barriers,
+                                          vk::AccessFlags2 descriptor_access = {}) {
+    vk::AccessFlags2 access = vk::AccessFlagBits2::eShaderRead | descriptor_access;
+    bool pending_use = false;
+    for (const auto& pending : barriers) {
+        if (pending.buffer == buffer.Handle()) {
+            access |= pending.dstAccessMask;
+            pending_use = true;
+        }
+    }
+    auto combined = buffer.GetBarrier(access, vk::PipelineStageFlagBits2::eAllCommands, 0,
+        pending_use || bool(access & vk::AccessFlagBits2::eShaderWrite));
+    if (!combined) {
+        return; // Consecutive read-only uses need no additional dependency.
+    }
+    for (const auto& pending : barriers) {
+        if (pending.buffer == buffer.Handle()) {
+            combined->srcStageMask |= pending.srcStageMask;
+            combined->srcAccessMask |= pending.srcAccessMask;
+            combined->dstStageMask |= pending.dstStageMask;
+            combined->dstAccessMask |= pending.dstAccessMask;
+        }
+    }
+    for (size_t i = barriers.size(); i != 0; --i) {
+        if (barriers[i - 1].buffer == buffer.Handle()) {
+            barriers.erase(barriers.begin() + (i - 1));
+        }
+    }
+    barriers.emplace_back(*combined);
+}
